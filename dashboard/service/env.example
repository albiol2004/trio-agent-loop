# ~/.services/trio-dash/env — sourced by svc before `run`.
# Pinned, read-only checkout the service serves (a detached git worktree).
TRIO_DASH_CHECKOUT=$HOME/.services/trio-dash/checkout
TRIO_DASH_PORT=9470
# Workspaces are discovered below these roots: direct children always, and
# deeper directories (to TRIO_DASH_SCAN_DEPTH levels) that hold a loop*/ dir.
# Linked git worktrees are skipped (they carry committed mailbox copies).
# HOME itself is refused as a scan root.
TRIO_DASH_SCAN_ROOTS=$HOME/personal:$HOME/ekona
TRIO_DASH_SCAN_DEPTH=3
# Explicitly registered workspaces outside the scan roots (os.pathsep list).
TRIO_DASH_WORKSPACES=$HOME/workflow-lab:$HOME/omnigent:$HOME/omnigent-dev
# First --workspace is the default root for the registry pages.
TRIO_DASH_WORKSPACE_ARGS="--workspace $HOME/personal/trio-agent-loop --discover"
# Omnigent broker for broker-session liveness (read-only GETs of
# /v1/sessions); unset it to disable. Outages show as "liveness unknown".
TRIO_BOARD_BROKER_URL=http://127.0.0.1:6767
# Set to 0 to keep the dashboard loopback-only.
TRIO_DASH_TAILSCALE=1
# Extra Host names / Origins accepted besides localhost and IP literals.
# `run` adds the workspace's tailnet name and https://<name>:$TRIO_DASH_PORT.
TRIO_DASH_ALLOWED_HOSTS=
TRIO_DASH_ALLOWED_ORIGINS=
