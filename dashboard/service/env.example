# ~/.services/trio-dash/env — sourced by svc before `run`.
# Pinned, read-only checkout the service serves (a detached git worktree).
TRIO_DASH_CHECKOUT=$HOME/.services/trio-dash/checkout
TRIO_DASH_PORT=9470
# Children of these directories are auto-discovered as workspaces (60 s rescan).
TRIO_DASH_SCAN_ROOTS=$HOME/personal:$HOME/ekona
# Fixed workspaces (first one is the default root for the registry pages).
TRIO_DASH_WORKSPACE_ARGS="--workspace $HOME/personal/trio-agent-loop --workspace $HOME/workflow-lab --workspace $HOME/omnigent --workspace $HOME/omnigent-dev --discover"
# Set to 0 to keep the dashboard loopback-only.
TRIO_DASH_TAILSCALE=1
