# --- r15 guard: refuse slices that write outside the mailbox repo -----------
# The check lives in metrics/trio-check.py (`repo_scope_refusals`) so the
# loop core and METRICS_API are untouched; trioctl loads the copy from its
# own release (never a repository's vendored metrics/). Enforced before the
# loop dispatches anything, around every Lead/repair pass, and by
# `run builder --isolate` before it creates a worktree.

#: `run builder --isolate` exit when the r15 guard refuses the slice.
REPO_SCOPE_REFUSED_EXIT = 2

_TRIO_CHECK: list[Any] = []


class RepoScopeRefusal(TrioctlError):
    """A slice writes outside the mailbox repo (r15 guard)."""

    def __init__(self, message: str, lines: list[str]) -> None:
        super().__init__(message)
        self.lines = lines


def _trio_check_candidates() -> list[Path]:
    """Where this release's trio-check.py lives, in lookup order.

    An installed trioctl (install.sh: ``$TRIOCTL_BIN_DIR``) has trio-check.py
    and trio-metrics.py as siblings; a source/release tree has them in
    ``<root>/metrics/`` next to ``<root>/omnigent/trioctl`` (eval-r15a F1).
    """
    here = Path(__file__).resolve().parent
    return [here / "trio-check.py", here.parent / "metrics" / "trio-check.py"]


def _load_trio_check() -> Any:
    """This release's trio-check.py with its sibling trio-metrics.py."""
    if _TRIO_CHECK:
        return _TRIO_CHECK[0]
    candidates = _trio_check_candidates()
    path = next((c for c in candidates if c.is_file()), None)
    if path is None:
        raise TrioctlError(
            "r15 repo-scope guard unavailable: trio-check.py is missing "
            f"(tried {', '.join(str(c) for c in candidates)})"
        )
    loader = importlib.machinery.SourceFileLoader("trio_check_r15", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None or spec.loader is None:
        raise TrioctlError(f"cannot load {path}")
    module = importlib.util.module_from_spec(spec)
    try:
        loader.exec_module(module)
        metrics = module.load_trio_metrics()
    except Exception as exc:  # noqa: BLE001 - a guard that cannot run refuses
        raise TrioctlError(
            f"r15 repo-scope guard unavailable ({type(exc).__name__}: {exc})"
        ) from exc
    _TRIO_CHECK.append((module, metrics))
    return _TRIO_CHECK[0]


def _repo_scope_refusals(
    mailbox: Path, *, slice_id: str | None = None, brief_text: str | None = None
) -> list[str]:
    """r15 guard lines for *mailbox* ([] = nothing to refuse)."""
    module, metrics = _load_trio_check()
    return module.repo_scope_refusals(
        Path(mailbox), metrics, slice_id=slice_id, brief_text=brief_text
    )


def _state_iteration(mailbox: Path) -> str:
    try:
        text = (mailbox / "STATE.md").read_text(encoding="utf-8", errors="replace")
    except OSError:
        return "?"
    match = re.search(r"^\s*(?:-\s+)?iteration\s*:\s*(\S+)", text, re.M | re.I)
    return match.group(1) if match else "?"


def _mark_repo_scope_refused(
    mailbox: Path, lines: list[str], iteration: Any = None
) -> None:
    """LOG.md `- iter N | loop | <line>` per refusal; STATE.md `status: error`.

    Mirrors :func:`_mark_mailbox_held` (other STATE lines are kept).
    """
    iteration = _state_iteration(mailbox) if iteration is None else iteration
    log = mailbox / "LOG.md"
    text = (
        log.read_text(encoding="utf-8", errors="replace")
        if log.is_file()
        else "# Trio loop log\n"
    )
    if text and not text.endswith("\n"):
        text += "\n"
    text += "".join(f"- iter {iteration} | loop | {line}\n" for line in lines)
    log.write_text(text, encoding="utf-8")
    state = mailbox / "STATE.md"
    rows = (
        state.read_text(encoding="utf-8", errors="replace").splitlines()
        if state.is_file()
        else []
    )
    done = False
    for index, row in enumerate(rows):
        if re.match(r"^\s*status\s*:", row, re.I):
            rows[index] = "status: error"
            done = True
    if not done:
        rows.append("status: error")
    state.write_text("\n".join(rows) + "\n", encoding="utf-8")


def _refuse_repo_scope(
    mailbox: Path, role: str, iteration: Any = None
) -> None:
    """Raise RepoScopeRefusal (after logging it) when the guard objects."""
    lines = _repo_scope_refusals(mailbox)
    if not lines:
        return
    # eval-r15a F8: label with STATE.md's committed iteration, so an
    # open-loop refusal never logs the uncommitted candidate N+1 before the
    # driver's own `iter N` line.
    del iteration
    _mark_repo_scope_refused(mailbox, lines)
    for line in lines:
        print(f"trioctl: {line}", file=sys.stderr)
    raise RepoScopeRefusal(
        f"r15 repo-scope guard refused the {role} pass "
        f"({len(lines)} line(s) logged above)",
        lines,
    )


def _require_worktrees() -> Any:
    if worker_worktrees is None:
        raise TrioctlError("worker_worktrees.py is not installed next to trioctl")
    return worker_worktrees


def _command_run_isolated(
    args: argparse.Namespace, config: dict[str, Any], prompt: str
) -> int:
    """Builder in its own worktree; commit + integrate on success.

    Exit 0 only when the worker's changes are merged into the aggregate
    branch. Any other outcome keeps the worktree and reports a retained,
    recoverable state (`omnigent worktrees integrate <id>` retries).
    """
    wt = _require_worktrees()
    if args.role != "builder":
        raise TrioctlError("--isolate applies to builder workers only")
    slice_id = getattr(args, "worker_slice", None)
    if not slice_id:
        raise TrioctlError("--isolate requires --worker-slice <slice-id>")
    mailbox_arg = getattr(args, "worker_events_mailbox", None)
    if not mailbox_arg:
        raise TrioctlError("--isolate requires --mailbox <mailbox dir>")
    repo = wt.repo_toplevel(Path(args.workspace).resolve())
    mailbox = _resolve_mailbox(mailbox_arg, repo)
    # r15 guard: refuse before any worktree exists (never limp into an
    # aggregate that has no copy of the slice's repo).
    refusals = _repo_scope_refusals(mailbox, slice_id=slice_id, brief_text=prompt)
    if refusals:
        for line in refusals:
            print(f"trioctl: {line}", file=sys.stderr)
        return REPO_SCOPE_REFUSED_EXIT
    try:
        record = wt.create(
            repo,
            slice_id=slice_id,
            mailbox=mailbox,
            root=(
                Path(args.worktree_root).expanduser()
                if getattr(args, "worktree_root", None)
                else None
            ),
            run_id=getattr(args, "worker_run_id", None),
        )
    except wt.WorktreeError as exc:
        raise TrioctlError(str(exc)) from exc
    path = Path(record["path"])
    print(
        f"trioctl: isolated builder {record['id']} in {path} "
        f"(branch {record['branch']})",
        file=sys.stderr,
    )
    note = _ISOLATED_BUILDER_NOTE.format(
        path=path, branch=record["branch"], base=record["base"][:12],
        repo=repo, slice=slice_id, mailbox=mailbox,
    )

    def on_spawn(proc: subprocess.Popen[str]) -> None:
        wt.mark_running(repo, record, proc.pid, pgid=proc.pid)

    returncode: int | None = 0
    output = ""
    # The worker is its own session, so a terminal/`timeout`/supervisor
    # signal to this dispatcher no longer reaches it: turn SIGTERM/SIGHUP
    # into KeyboardInterrupt so run_cursor_worker kills the whole group.
    previous = {
        sig: signal.signal(sig, _loop_signal_handler)
        for sig in (signal.SIGTERM, signal.SIGHUP)
    }
    try:
        output = run_cursor_worker(
            args.role,
            config,
            prompt=f"{note}\n\n{prompt}",
            workspace=path,
            timeout=args.timeout,
            events=_worker_event_ctx(args) or None,
            isolated=True,
            on_spawn=on_spawn,
            # Group leader with a bounded lifetime that also dies with this
            # dispatcher (even on SIGKILL), taking its group with it.
            wrap=lambda cmd: wt.watchdog_command(
                cmd, max_seconds=wt.worker_max_seconds(args.timeout)
            ),
        )
    except TrioctlError as exc:
        returncode = 1
        record = wt.load_record(repo, record["id"])
        wt.mark_exited(repo, record, returncode)  # worker_ok stays False
        record = wt._retain(repo, record, "worker_failed", str(exc)[-2000:])
        print(json.dumps(_worktree_view(record), sort_keys=True))
        print(
            f"trioctl: worker failed; worktree retained: {wt.summarize(record)}",
            file=sys.stderr,
        )
        return ISOLATED_RETAINED_EXIT
    except KeyboardInterrupt:
        record = wt.load_record(repo, record["id"])
        wt.mark_exited(repo, record, None)
        wt._retain(repo, record, "interrupted", "dispatcher signalled; worker group killed")
        return 130
    finally:
        for sig, handler in previous.items():
            signal.signal(sig, handler)
    record = wt.load_record(repo, record["id"])
    wt.mark_exited(repo, record, returncode)
    summary = getattr(args, "summary", None) or f"isolated builder {record['id']}"
    record = wt.integrate(repo, record["id"], summary=summary)
    print(output)
    view = _worktree_view(record)
    # The builder's `TARGETED_CHECK: ` line, surfaced so the open-loop Lead
    # can copy it into its REPORT.md ledger mechanically (None = missing).
    view["targeted_check"] = _targeted_check_line(output)
    print(json.dumps(view, sort_keys=True))
    print(f"trioctl: {wt.summarize(record)}", file=sys.stderr)
    return 0 if record.get("state") == "integrated" else ISOLATED_RETAINED_EXIT


TARGETED_CHECK_PREFIX = "TARGETED_CHECK: "
# Tolerant of the decorations models add despite the plain-text contract:
# an optional list bullet / number, backticks, bold or underscores around
# the prefix or the value, any case, any (or no) whitespace after the colon.
_TARGETED_CHECK_RE = re.compile(
    r"^(?:[-*+\u2022]\s+|\d+[.)]\s+)?[`*_]*\s*TARGETED_CHECK[`*_]*\s*:"
    r"[\s`*_]*(?P<rest>.*?)[\s`*_]*$",
    re.IGNORECASE,
)
# The contract's own placeholder, echoed back instead of a real result: a
# value that is only a `<...>` placeholder (optionally after FAILED).
_TARGETED_CHECK_PLACEHOLDER_RE = re.compile(r"^(?:FAILED\s+)?<[^<>]*>$", re.IGNORECASE)
# Any unexpanded `<...>` placeholder anywhere in the value (`PASS <n>`,
# `PASS <count>`, `<n> passed`): a template copied literally, never a pass.
_TARGETED_CHECK_ANY_PLACEHOLDER_RE = re.compile(r"<[^<>]*>")
# Template literals without angle brackets that are equally content-free.
_TARGETED_CHECK_TEMPLATE_LITERALS = frozenset({
    "...", "\u2026", "pass n", "pass <n>", "pass <count>", "line", "counts line",
    "last summary line", "summary",
})
_TARGETED_CHECK_FAILED_RE = re.compile(r"^failed\b", re.IGNORECASE)
# A value that reports failures without the FAILED prefix (pytest's last
# line copied verbatim, e.g. `2 failed, 3 passed`, `1 error`, `no tests
# ran`) is still a failure for the Lead's retire test. Zero counts
# (`| 0 failed`, `0 errors`) are not failures.
_TARGETED_CHECK_FAILURE_TEXT_RE = re.compile(
    r"\b([1-9]\d* failed|[1-9]\d* errors?|no tests ran|FAIL)\b", re.IGNORECASE
)


def _targeted_check_line(output: str | None) -> str | None:
    """The builder's LAST `TARGETED_CHECK:` line, normalized, or None.

    Returned as ``TARGETED_CHECK: <value>`` (decorations stripped, a
    case-insensitive leading ``failed`` upper-cased to ``FAILED``, and a
    value reporting failures without that prefix -- ``N failed``, ``N
    error(s)``, ``no tests ran``, ``FAIL`` -- prefixed with ``FAILED ``) so the
    Lead's "does not start with `TARGETED_CHECK: FAILED`" test is
    mechanical. Empty values, echoed placeholders and template literals
    copied verbatim (``PASS <n>``, ``PASS <count>``, ``<last summary
    line>``, any non-failure value holding an unexpanded ``<...>``) are
    ignored, so a builder that only echoes the template reads as "not
    reported"; the last matching line wins (fix-and-rerun reports the
    rerun).
    """
    found = None
    for line in (output or "").splitlines():
        match = _TARGETED_CHECK_RE.match(line.strip())
        if not match:
            continue
        rest = match.group("rest").strip()
        if not rest or _TARGETED_CHECK_PLACEHOLDER_RE.match(rest):
            continue
        if " ".join(rest.lower().split()) in _TARGETED_CHECK_TEMPLATE_LITERALS:
            continue
        # A non-failure value with an unexpanded placeholder is a template
        # echo, not a result: treat as absent so the Lead re-dispatches.
        # (A real failure may quote `<...>` text, e.g. `FAILED ... <Foo>`,
        # and is kept: it is never retired either way.)
        if (_TARGETED_CHECK_ANY_PLACEHOLDER_RE.search(rest)
                and not _TARGETED_CHECK_FAILED_RE.match(rest)
                and not _TARGETED_CHECK_FAILURE_TEXT_RE.search(rest)):
            continue
        if _TARGETED_CHECK_FAILED_RE.match(rest):
            rest = "FAILED" + rest[len("failed"):]
        elif _TARGETED_CHECK_FAILURE_TEXT_RE.search(rest):
            rest = "FAILED " + rest
        found = TARGETED_CHECK_PREFIX + rest
    return found


def _worktree_view(record: dict[str, Any]) -> dict[str, Any]:
    keys = (
        "id", "slice", "kind", "state", "retained_reason", "retained_detail",
        "acceptance_pending", "path", "branch", "base", "worker_commit",
        "merge_commit", "accepted_by",
    )
    return {"worker_worktree": {k: record.get(k) for k in keys if k in record}}


def _held_session_ids(mailbox: Path | None) -> set[str]:
    if mailbox is None:
        return set()
    return {
        str(record.get("session_id"))
        for _path, record in _held_records(mailbox)
        if record.get("session_id")
    }


def _has_unreadable_hold(mailbox: Path | None) -> bool:
    return mailbox is not None and any(
        not record.get("session_id") for _path, record in _held_records(mailbox)
    )


def _load_loop_core_for(repo: Path) -> Any:
    """The loop core that owns SHIP retirement for *repo* (repo copy first).

    An incompatible repo copy raises (it is never skipped in favour of the
    bundled one: that copy is what drove the repo's loop).
    """
    candidates = [
        repo / "metrics" / "trio_loop.py",
        Path(__file__).resolve().parent.parent / "metrics" / "trio_loop.py",
    ]
    for path in candidates:
        if path.is_file():
            return _load_trio_loop(path.parent.parent)
    return None


def _ship_acceptance(
    mailbox: Path, repo: Path, loop_core: Any = None
) -> dict[str, Any]:
    """Verified SHIP acceptance of an exact revision, or ``{"pending": why}``.

    Reuses the loop core's own retirement contract instead of parsing
    ``commit:`` lines, for lockstep and open-loop alike (both persist
    ``evaluator_attempt``/``evaluated_sha`` before the evaluator runs):
    STATE.md driver-finalized ``shipped`` with a bound attempt and full
    ``evaluated_sha``; ``_ship_retirement_problem`` reports nothing (SHIP
    first line, attempt/evaluated recorded in VERDICT.md, product tree
    unchanged since the pin, ``loop: iteration N — SHIP`` retirement commit
    on HEAD); VERDICT.md tracked with no uncommitted edits. All of it is
    evaluated on one stable snapshot of the inputs (VERDICT.md, STATE.md,
    HEAD, status); a concurrent change yields ``pending``.
    """
    try:
        core = loop_core or _load_loop_core_for(repo)
    except TrioctlError as exc:
        return {"pending": f"loop core not usable: {exc}"}
    if core is None:
        return {"pending": "no loop core (metrics/trio_loop.py) to verify retirement"}
    try:
        before = core._retirement_snapshot(mailbox, repo)
        result = _ship_acceptance_once(mailbox, repo, core)
        after = core._retirement_snapshot(mailbox, repo)
    except Exception as exc:  # noqa: BLE001
        return {"pending": f"acceptance check failed: {type(exc).__name__}"}
    if before != after:
        return {"pending": "mailbox or git state changed during the acceptance check"}
    return result


def _ship_acceptance_once(mailbox: Path, repo: Path, core: Any) -> dict[str, Any]:
    state = core._read_state(mailbox / "STATE.md")
    status = str(state.get("status", "")).strip()
    if status != "shipped":
        return {"pending": f"loop status is {status or 'unset'!r}, not a driver-finalized 'shipped'"}
    evaluated = str(state.get("evaluated_sha", "")).strip()
    attempt = str(state.get("evaluator_attempt", "")).strip()
    try:
        iteration = int(str(state.get("iteration", "")).strip())
    except ValueError:
        return {"pending": "STATE.md iteration is not a number"}
    if not attempt:
        return {"pending": "SHIP is not bound to an evaluator attempt"}
    if not re.fullmatch(r"[0-9a-f]{40}", evaluated):
        return {"pending": "SHIP is not bound to a full evaluated sha"}
    problem = core._ship_retirement_problem(mailbox, iteration, repo)
    if problem is not None:
        return {"pending": f"retirement not verified: {problem[1]}"}
    verdict = mailbox / "VERDICT.md"
    tracked = subprocess.run(
        ["git", "-C", str(repo), "ls-files", "--error-unmatch", "--", str(verdict)],
        capture_output=True, text=True,
    )
    dirty = subprocess.run(
        ["git", "-C", str(repo), "status", "--porcelain", "--", str(verdict)],
        capture_output=True, text=True,
    )
    if tracked.returncode != 0:
        return {"pending": "VERDICT.md is not committed"}
    if dirty.returncode != 0 or dirty.stdout.strip():
        return {"pending": "VERDICT.md has uncommitted edits after retirement"}
    return {"evaluated": evaluated, "iteration": iteration, "attempt": attempt}


# Upper bound on waiting for torn-down sessions' runners to leave their
# worktrees before the final cleanup gives up and retains them.
WORKTREE_SETTLE_SECONDS = 30.0


def _run_worktree_cleanup(
    repo: Path,
    mailbox: Path | None,
    loop_core: Any = None,
    *,
    torn_down: Any = (),
) -> list[dict[str, Any]]:
    """Scoped, idempotent cleanup; an unreadable hold keeps everything.

    *torn_down* names sessions this run just archived and deleted. A
    worktree retained only because those sessions' processes are still
    exiting is re-checked once they have exited (bounded by
    ``WORKTREE_SETTLE_SECONDS``); every guard runs again unchanged.
    """
    wt = _require_worktrees()
    if _has_unreadable_hold(mailbox):
        print(
            "trioctl: unreadable held record; skipping worker worktree cleanup",
            file=sys.stderr,
        )
        return []
    acceptance_for = lambda box: _ship_acceptance(box, repo, loop_core)  # noqa: E731
    results = wt.cleanup(
        repo,
        mailbox=mailbox,
        held_sessions=_held_session_ids(mailbox),
        acceptance_for=acceptance_for,
    )
    settle = wt.settle_candidates(results, torn_down)
    if settle:
        outcomes = wt.await_owner_exit(
            repo, settle, deadline_s=WORKTREE_SETTLE_SECONDS
        )
        if _has_unreadable_hold(mailbox):
            print(
                "trioctl: unreadable held record; not re-checking worktrees "
                "of torn-down sessions",
                file=sys.stderr,
            )
        else:
            rechecked = {
                r["id"]: r
                for r in wt.recheck_settled(
                    repo, outcomes,
                    deadline_s=WORKTREE_SETTLE_SECONDS,
                    held_sessions=_held_session_ids(mailbox),
                    acceptance_for=acceptance_for,
                )
            }
            results = [rechecked.get(r.get("id"), r) for r in results]
    for record in results:
        print(f"trioctl: worktree {wt.summarize(record)}", file=sys.stderr)
    return results


def command_worktrees(args: argparse.Namespace) -> int:
    """create / integrate / finish / status / cleanup task-owned worktrees."""
    wt = _require_worktrees()
    repo = wt.repo_toplevel(Path(getattr(args, "repo", None) or ".").resolve())
    mailbox = (
        _resolve_mailbox(args.mailbox, repo) if getattr(args, "mailbox", None) else None
    )
    try:
        if args.worktrees_command == "create":
            record = wt.create(
                repo,
                slice_id=args.slice,
                mailbox=mailbox,
                root=Path(args.worktree_root).expanduser() if args.worktree_root else None,
                role=args.role,
                detach_at=args.detach_at,
            )
            if args.session_id:
                wt.mark_running(repo, record, None, session_id=args.session_id)
            print(json.dumps(_worktree_view(record), indent=2, sort_keys=True))
            return 0
        if args.worktrees_command == "integrate":
            record = wt.integrate(repo, args.id, summary=args.summary)
            print(json.dumps(_worktree_view(record), indent=2, sort_keys=True))
            return 0 if record.get("state") in ("integrated", "accepted", "removed") else ISOLATED_RETAINED_EXIT
        if args.worktrees_command == "finish":
            record = wt.mark_finished(repo, args.id)
            print(json.dumps(_worktree_view(record), indent=2, sort_keys=True))
            return 0
        if args.worktrees_command == "status":
            rows = [
                _worktree_view(rec)["worker_worktree"] if rec else {"id": wid, "state": "unreadable"}
                for wid, rec in wt.list_records(repo)
                if rec is None or mailbox is None or rec.get("mailbox") == str(mailbox)
            ]
            print(json.dumps(rows, indent=2, sort_keys=True))
            return 0
        if args.worktrees_command == "cleanup":
            results = _run_worktree_cleanup(repo, mailbox)
            print(json.dumps([_worktree_view(r)["worker_worktree"] for r in results], indent=2, sort_keys=True))
            return 0
    except wt.WorktreeError as exc:
        raise TrioctlError(str(exc)) from exc
    raise TrioctlError(f"unknown worktrees command {args.worktrees_command}")


def command_worker_events_report(args: argparse.Namespace) -> int:
    """Offline report of builder subprocess intervals. No live models."""
    if worker_events is None:
        raise TrioctlError("worker_events.py is not installed next to trioctl")
    mailbox = getattr(args, "mailbox", None)
    path = worker_events.resolve_events_path(args.events_file, mailbox)
    if path is None:
        raise TrioctlError("worker events file path is missing or malformed")
    payload = worker_events.report(path, run_id=args.run_id)
    print(json.dumps(payload, indent=2, sort_keys=True))
    return 0


SESSION_FAILURE_STATUSES = {"failed", "error"}


def _session_items(payload: Any) -> list[Any]:
    """Extract item rows from either the API list or envelope response."""
    if isinstance(payload, list):
        return payload
    if isinstance(payload, dict):
        for key in ("items", "data"):
            value = payload.get(key)
            if isinstance(value, list):
                return value
    return []


def _item_role(item: Any) -> str:
    """Read a conversation item's role across API envelope versions."""
    if not isinstance(item, dict):
        return ""
    role = item.get("role")
    if isinstance(role, str):
        return role.lower()
    data = item.get("data")
    role = data.get("role") if isinstance(data, dict) else None
    return role.lower() if isinstance(role, str) else ""


def _is_completed_assistant_message(item: Any) -> bool:
    """Return whether an item is a finished assistant message, not a turn.

    Live Cursor rows use type=message, role=assistant, status=completed.
    type=turn marks turn start and is not terminal. Mid-turn assistant
    progress is also completed, so callers must still require idle-after-
    running.
    """
    if not isinstance(item, dict):
        return False
    if _item_role(item) != "assistant":
        return False
    kind = str(item.get("type") or "message").lower()
    if kind in {"turn", "resource_event"}:
        return False
    if kind not in {"message", "assistant", "response"}:
        return False
    status = str(item.get("status") or "").lower()
    return status in {"completed", "done"}


def _has_completed_assistant_message(payload: Any) -> bool:
    """Return whether any item in a poll page is a finished assistant message."""
    return any(
        _is_completed_assistant_message(item) for item in _session_items(payload)
    )


def _get_latest_items(client: Any, session_id: str) -> Any:
    """Fetch a short newest-first page so wait can see assistant completion."""
    method = getattr(client, "get_items", None)
    if method is None:
        raise TrioctlError("broker client has no session-items method")
    try:
        return method(session_id, limit=10, order="desc")
    except TypeError:
        # Keep small test doubles compatible while the real client uses the
        # explicit API query that prevents downloading the whole transcript.
        return method(session_id)


def _session_runner_id(snapshot: Any) -> str | None:
    """Return a bound runner id, or None when the runner has not attached."""
    if not isinstance(snapshot, dict):
        return None
    value = snapshot.get("runner_id")
    if isinstance(value, str) and value.strip():
        return value.strip()
    return None


def _runner_is_bound(snapshot: Any) -> bool:
    """Treat a missing runner_id field as bound so older fakes still work.

    Live snapshots include ``runner_id``. Null means the pre-running window
    and is never a completion signal. Tests that omit the field are unchanged.
    """
    if not isinstance(snapshot, dict) or "runner_id" not in snapshot:
        return True
    return _session_runner_id(snapshot) is not None


def _wait_for_session(
    client: Any,
    session_id: str,
    *,
    timeout: float,
    interval: float,
    stable_idle: float = 0.0,
) -> Any:
    """Wait until Cursor has run a turn, then stayed idle.

    Live Grok Lead sessions often omit assistant rows from GET /items
    (only a resource_event remains). Cursor-native instead emits an
    early completed assistant ack while the role is still working.
    Completion is therefore idle + bound runner, held for
    ``stable_idle`` seconds, when either:

    - a completed assistant message is present, or
    - the session has been ``running`` and at least one item exists.

    ``running`` resets the dwell. A null ``runner_id`` and a type=turn
    row are never terminal. Failed statuses return at once. Timeouts
    stay distinct.

    Right after an Omnigent restart, a session can cycle bound -> running
    -> idle within seconds with **zero** items (the runner later shows as
    unbound again, ``runner_id: None``): a restart blip, not a completed
    pass. A real turn always leaves at least one item behind (the
    ``terminal_cursor_main`` resource_event), so an idle+bound+saw_running
    snapshot with no items at all is treated as not-yet-terminal instead
    of starting (or continuing) the ``stable_idle`` dwell.

    Why the live dwell is 30 s (``TRIO_OMNIGENT_IDLE_DWELL``; per-kind
    ``TRIO_OMNIGENT_IDLE_DWELL_SLICE_EVAL``, see `_idle_dwell`) -- do not
    lower it blindly:

    - Cursor turns have think/tool gaps where the session reads ``idle``
      while the agent is still working; Cursor-native also posts an early
      completed assistant ack long before the role is done. A short dwell
      turns those gaps into a false "done".
    - Grok (live Lead sessions) often leaves no assistant row at all, only
      a ``resource_event``: the "ran and has items" rule is then the only
      completion signal and needs idle to stick for a while to mean it.
    - The post-restart blip (bound -> running -> idle within seconds)
      is filtered by the zero-items rule above, but a restart landing
      mid-turn can still look idle briefly; the dwell rides that out.

    A premature "done" is expensive: the caller moves on to artifact
    checks and a held/uncertain record while the pane is still writing.
    Each dwell is paid per `_wait` call: when the role artifact is not yet
    on disk after the first wait, `_wait_for_role_artifact` re-enters
    `_wait`, which pays the dwell again.
    """
    if timeout < 0:
        raise TrioctlError("--timeout must be non-negative")
    if interval < 0:
        raise TrioctlError("--interval must be non-negative")
    if stable_idle < 0:
        raise TrioctlError("stable_idle must be non-negative")

    get_session = getattr(client, "get_session", None)
    if get_session is None:
        raise TrioctlError("broker client has no session-wait method")
    saw_running = False
    idle_since: float | None = None
    deadline = time.monotonic() + timeout

    while True:
        items = _get_latest_items(client, session_id)
        snapshot = get_session(session_id)
        status = _session_status(snapshot)
        if status in SESSION_FAILURE_STATUSES:
            return snapshot
        bound = _runner_is_bound(snapshot)
        has_assistant = _has_completed_assistant_message(items)
        now = time.monotonic()

        if status == "running":
            saw_running = True
            idle_since = None
        elif status == "idle" and bound and (
            has_assistant
            or (saw_running and _session_items(items))
        ):
            # Assistant acks and resource_event-only Grok turns both
            # need idle to stick. A post-restart blip is idle+bound
            # after running with zero items and never starts the dwell.
            if idle_since is None:
                idle_since = now
            if now - idle_since >= stable_idle:
                return snapshot
        else:
            idle_since = None

        if now >= deadline:
            raise TrioctlError(
                f"session {session_id} timed out after {timeout:g} seconds"
            )
        remaining = deadline - now
        time.sleep(min(interval, remaining))


def _mailbox_text(path: Path) -> str:
    """Read a mailbox file; missing files count as empty."""
    try:
        return path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return ""


def _mailbox_mtime(path: Path) -> float:
    """Return mtime, or 0 when the file is missing."""
    try:
        return path.stat().st_mtime
    except OSError:
        return 0.0


def _lead_log_line_present(text: str, iteration: int) -> bool:
    """True when LOG.md has this iteration's Lead Format-A line."""
    prefix = f"- iter {iteration} | lead |"
    return any(line.startswith(prefix) for line in text.splitlines())


def _verdict_line_ready(text: str) -> bool:
    """True when the first non-empty VERDICT.md line matches grammar."""
    for raw in text.splitlines():
        line = raw.strip()
        if not line:
            continue
        return bool(_ROLE_VERDICT_RE.match(line))
    return False


_SLICE_SECTION_HEADING_RE = re.compile(r"^##\s+slice\s+\S+\s+@[0-9a-fA-F]{7,40}\b")


def _integration_verdict_text(text: str) -> str:
    """VERDICT.md with every open-loop ``## slice <id> @<sha>`` section removed.

    Open-loop slice-evals append their own sections (with their own
    ``iteration:``/``evaluated:``/``attempt:`` lines) to the same file as
    the integration verdict. A section runs from its heading up to (not
    including) the next ``# ``/``## `` heading that is not itself a slice
    heading, or EOF. Everything else is kept in order, so integration
    field checks see only the integration verdict's own block.
    """
    kept: list[str] = []
    skipping = False
    for line in text.splitlines(keepends=True):
        if _SLICE_SECTION_HEADING_RE.match(line):
            skipping = True
            continue
        if skipping and (line.startswith("# ") or line.startswith("## ")):
            skipping = False
        if not skipping:
            kept.append(line)
    return "".join(kept)


def _verdict_mentions_iteration(text: str, iteration: int) -> bool:
    """True when the verdict names this iteration and no other one.

    Canonical form is an exact ``iteration: N`` field line; the legacy
    ``iteration N`` heading/prose form is still accepted. Numbers are
    whole-word (``iteration 1`` never matches ``iteration 10``). Any
    ``iteration:`` field, or ``#`` heading naming an iteration, that
    disagrees with N rejects the artifact as mismatched.
    """
    want = str(iteration)
    fields = _verdict_field_values(text, "iteration")
    if any(value != want for value in fields):
        return False
    heading_re = re.compile(r"\biteration\s+(\d+)\b", re.IGNORECASE)
    for raw in text.splitlines():
        if raw.lstrip().startswith("#"):
            if any(n != want for n in heading_re.findall(raw)):
                return False
    if fields:
        return True
    return any(n == want for n in heading_re.findall(text))


def _verdict_field_values(text: str, key: str) -> list[str]:
    """Values for exact ``key:`` lines (not a prefix of a longer key)."""
    want_key = key.strip().lower()
    found: list[str] = []
    if not want_key:
        return found
    for raw in text.splitlines():
        line = raw.strip()
        if ":" not in line:
            continue
        name, rest = line.split(":", 1)
        if name.strip().lower() != want_key:
            continue
        got = rest.strip()
        if got:
            found.append(got)
    return found


def _verdict_records_attempt(text: str, attempt: str) -> bool:
    """True when VERDICT.md names this unique evaluator attempt."""
    want = attempt.strip().lower()
    if not want:
        return False
    return any(
        got.lower() == want for got in _verdict_field_values(text, "attempt")
    )


def _verdict_records_sha(text: str, sha: str) -> bool:
    """True when ``evaluated:`` records the expected pinned revision."""
    want = sha.strip().lower()
    if not want:
        return False
    for got in _verdict_field_values(text, "evaluated"):
        value = got.strip().lower()
        if value == want or want.startswith(value) or value.startswith(want):
            return True
    return False


_SLICE_VERDICT_HEADING_RE = re.compile(
    r"^##\s+slice\s+(\S+)\s+@([0-9a-fA-F]{4,40})\s+(?:—|--|-)\s+(SHIP|ITERATE)\s*$"
)
"""Same shape as metrics' ``SLICE_VERDICT_RE`` (``parse_slice_verdicts``),
which the driver's ``wrote_section`` check uses to grade a slice-eval."""


def _slice_section_present(text: str, slice_id: str, sha: str) -> bool:
    """True when VERDICT.md holds ``## slice <slice_id> @<sha> — SHIP|ITERATE``.

    Heading sha matches full-or-prefix either way, as ``_verdict_records_sha``.
    """
    want = sha.strip().lower()
    if not want:
        return False
    for raw in text.splitlines():
        match = _SLICE_VERDICT_HEADING_RE.match(raw.strip())
        if not match or match.group(1) != slice_id:
            continue
        got = match.group(2).lower()
        if got == want or want.startswith(got) or got.startswith(want):
            return True
    return False


def _role_artifact_ready(
    mailbox: Path,
    role: str,
    iteration: int,
    before_text: str,
    before_mtime: float,
    context: dict[str, Any] | None = None,
) -> bool:
    """True when this role wrote a fresh mailbox artifact for this attempt.

    Open-loop slice-eval APPENDS a ``## slice <id> @<sha> — …`` section
    and never a ``VERDICT:`` first line. That kind still needs VERDICT.md
    *content* to change; a stale file that merely exists (or is touched)
    is not this attempt. ``before_mtime`` is kept for callers but is not
    a freshness signal — mtime-only bumps must not accept stale text.
    With ``slice``/``sha`` in the context, the changed text must also hold
    this dispatch's own ``## slice <slice> @<sha> — SHIP|ITERATE`` heading
    (concurrent siblings append to the same file).
    """
    del before_mtime
    if role == "lead":
        path = mailbox / "LOG.md"
        text = _mailbox_text(path)
        if not _lead_log_line_present(text, iteration):
            return False
        return text != before_text
    if role == "evaluator":
        path = mailbox / "VERDICT.md"
        text = _mailbox_text(path)
        if text == before_text:
            return False
        slice_eval = bool(
            context and context.get("kind") == "slice-eval"
        )
        if slice_eval:
            # Scoped to THIS dispatch: under concurrent slice-evals a
            # sibling's append also changes the file, so freshness alone
            # would accept a session that went idle without writing.
            slice_id = str(context.get("slice") or "").strip()
            sha = str(
                context.get("sha") or context.get("pinned_sha") or ""
            ).strip()
            if not slice_id or not sha:
                return True  # legacy callers without slice/sha context
            return _slice_section_present(text, slice_id, sha)
        # Integration verdict: appended open-loop slice sections carry
        # their own field lines and must not vote on this attempt.
        scoped = _integration_verdict_text(text)
        if not _verdict_line_ready(scoped):
            return False
        if not _verdict_mentions_iteration(scoped, iteration):
            return False
        pinned = None
        attempt = None
        if context:
            pinned = context.get("pinned_sha") or context.get("expected_sha")
            attempt = context.get("evaluator_attempt")
        if attempt and not _verdict_records_attempt(scoped, str(attempt)):
            return False
        if pinned:
            return _verdict_records_sha(scoped, str(pinned))
        return True
    return True


def _session_client(base_url: str | None = None) -> Any:
    """Build a client using the documented loopback default."""
    return broker_http.BrokerClient(
        base_url or broker_http.DEFAULT_BASE_URL,
    )


def _print_json(payload: Any) -> None:
    """Keep all session subcommands machine-readable."""
    print(json.dumps(payload, indent=2, sort_keys=True))


def command_session_create(args: argparse.Namespace) -> int:
    """Create one broker session and print the server response."""
    client = _session_client(args.base_url)
    try:
        result = client.create_session(
            args.agent_id,
            args.model,
            args.message,
            getattr(args, "title", None),
            runner_id=getattr(args, "runner_id", None),
            host_id=getattr(args, "host_id", None),
            workspace=getattr(args, "workspace", None),
        )
    except broker_http.BrokerHttpError as exc:
        raise TrioctlError(str(exc)) from exc
    _print_json(result)
    return 0


def _session_status(snapshot: Any) -> str:
    """Read a normalized status from a broker session snapshot."""
    if not isinstance(snapshot, dict):
        return ""
    status = snapshot.get("status")
    return status.lower() if isinstance(status, str) else ""


def command_session_wait(args: argparse.Namespace) -> int:
    """Poll a broker session until the requested turn has finished."""
    client = _session_client(getattr(args, "base_url", None))
    try:
        snapshot = _wait_for_session(
            client,
            args.session_id,
            timeout=args.timeout,
            interval=args.interval,
        )
    except broker_http.BrokerHttpError as exc:
        raise TrioctlError(str(exc)) from exc
    _print_json(snapshot)
    return 1 if _session_status(snapshot) in SESSION_FAILURE_STATUSES else 0


def command_session_read(args: argparse.Namespace) -> int:
    """Read one session's committed items and print the response."""
    if args.limit < 0:
        raise TrioctlError("--limit must be non-negative")
    if args.order not in {"asc", "desc"}:
        raise TrioctlError("--order must be asc or desc")
    client = _session_client(getattr(args, "base_url", None))
    try:
        result = client.get_items(
            args.session_id,
            limit=args.limit,
            order=args.order,
        )
    except broker_http.BrokerHttpError as exc:
        raise TrioctlError(str(exc)) from exc
    _print_json(result)
    return 0


# Headless `trioctl omnigent loop` iterations each create a titled broker
# session (see ``OmnigentRunner._title``) that otherwise lives forever in
# the Omnigent UI history. Mailbox files record the outcome but not the
# role's reasoning, so pruning archives the full transcript before it
# deletes the broker session.
#
# The broker rejects GET .../items?limit=<n> above 1000 with HTTP 422, so
# a transcript longer than that must be paged: SESSION_ARCHIVE_PAGE_LIMIT
# per request, advancing an `after` item-id cursor until a page comes back
# short. The items route has no `offset` -- only cursor pagination.
SESSION_ARCHIVE_PAGE_LIMIT = 1000

# GET /v1/sessions defaults to the newest 20 sessions and caps `limit` at
# 1000 (also cursor-paginated, no `offset`), so the prune must page through
# SESSION_LIST_PAGE_LIMIT-sized windows to see every session it might need
# to match, not just the newest handful.
SESSION_LIST_PAGE_LIMIT = 1000

# A `trioctl omnigent loop` process exports this before running the loop,
# pointing at `<mailbox>/.sessions/run-<pid>.ids` -- a run-scoped, one-id-
# per-line record of every broker session this run created. `OmnigentRunner`
# appends to it directly (belt-and-suspenders alongside its in-memory
# `created_session_ids`); a headless `trioctl omnigent run <role>` worker
# spawned in a separate OS process during the run cannot share that memory
# and would append through the same env var if its dispatch path ever opens
# a broker session of its own. Reading it back after the loop exits, unioned
# with the in-memory ids, is what lets the default post-loop cleanup delete
# exactly this run's sessions and nothing from an earlier run.
SESSION_IDS_ENV_VAR = "TRIO_MAILBOX_SESSION_IDS"


def _append_session_id_to_file(path: Path, session_id: str) -> None:
    """Append one session id to a run's ids file, creating its directory."""
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as handle:
        handle.write(f"{session_id}\n")


def _record_created_session_id(session_id: str) -> None:
    """Append `session_id` to this run's ids file, if one is tracked.

    A no-op when `SESSION_IDS_ENV_VAR` is unset -- e.g. a bare `sessions
    create`/`run` invocation made outside a `loop` run.
    """
    path_value = os.environ.get(SESSION_IDS_ENV_VAR)
    if not path_value:
        return
    _append_session_id_to_file(Path(path_value), session_id)


def _read_session_ids_file(path: Path) -> list[str]:
    """Read one run's recorded session ids, ignoring a missing file."""
    try:
        text = path.read_text(encoding="utf-8")
    except OSError:
        return []
    return [line.strip() for line in text.splitlines() if line.strip()]


# An uncertain first-prompt dispatch (broker_http.PromptDeliveryUncertain),
# or a delivered prompt whose role did not finish within the run (timeout,
# broker loss), is recorded as `<mailbox>/.sessions/held-<session id>.json`
# before the run exits. Cleanup never removes it; while one exists no role
# is dispatched for the mailbox (`loop` exits HELD_DISPATCH_EXIT). A person
# resolves it.
HELD_DISPATCH_EXIT = 7
HELD_REASONS = {
    "first_prompt_uncertain": "first-prompt delivery uncertain",
    "role_completion_uncertain": "prompt delivered, role completion uncertain",
    "abandoned_on_exit": "slice-eval still running when the loop exited",
    "mirror_crosswired": (
        "first prompt uncertain: the session's only saved user row is a "
        "sibling dispatch's prompt (cross-wired chat binding)"
    ),
}


def _optional_str(obj: Any, key: str) -> str | None:
    value = obj.get(key) if isinstance(obj, dict) else None
    return value.strip() if isinstance(value, str) and value.strip() else None


def _posted_copies(client: Any, session_id: str, extra: int) -> dict[str, Any]:
    """Copies of the first prompt that may be queued, as the client counted.

    ``posted_copies`` is None when the client does not count (a test
    double): the hold then lacks provenance and stays for a person.
    """
    posts = getattr(client, "prompt_posts", None)
    seqs = getattr(client, "prompt_inject_seqs", None)
    counted = posts.get(session_id) if isinstance(posts, dict) else None
    return {
        "posted_copies": (counted + extra) if isinstance(counted, int) else None,
        "inject_seqs": list(seqs.get(session_id, []))
        if isinstance(seqs, dict)
        else [],
    }


def _create_sends_labels(client: Any) -> bool:
    """True when `_create` can forward the opt-in label to this client."""
    if not COMPLETION_RECEIPT_LABELS:
        return False
    method = getattr(client, "create_session", None) or getattr(
        client, "create", None
    )
    try:
        params = inspect.signature(method).parameters
    except (TypeError, ValueError):
        return False
    return "labels" in params or any(
        p.kind == inspect.Parameter.VAR_KEYWORD for p in params.values()
    )


def _sent_prompt_shas(prov: dict[str, Any]) -> list[str] | None:
    """Contract R0: the sha256 of every message sent, in order.

    Trio only ever sends this dispatch's prompt (create, corrective and
    restart-blip copies are the same text), so it is one hash per copy.
    """
    copies = prov.get("posted_copies")
    sha = prov.get("prompt_sha256")
    if not isinstance(copies, int) or not sha:
        return None
    return [sha] * copies


def _git_read(repo: Path, *args: str) -> str | None:
    try:
        result = subprocess.run(
            ["git", "-C", str(repo), "--no-optional-locks", *args],
            capture_output=True, text=True,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    return result.stdout.strip() if result.returncode == 0 else None


def _dispatch_provenance(
    mailbox: Path,
    repo: Path,
    role: str,
    iteration: int,
    prompt: str,
    before_text: str,
    context: dict[str, Any] | None,
    *,
    agent_id: str,
    model: str,
    title: str,
    nonce: str | None,
) -> dict[str, Any]:
    """Facts known before create: role, phase, prompt hash, baseline."""
    state = {}
    for line in _mailbox_text(mailbox / "STATE.md").splitlines():
        match = re.match(r"^\s*([A-Za-z_]+)\s*:(.*)$", line)
        if match:
            state.setdefault(match.group(1).lower(), match.group(2).strip())
    context = context or {}
    artifact = "LOG.md" if role in ("lead", "repair") else "VERDICT.md"
    return {
        "role": role,
        "iteration": iteration,
        "mode": "open-loop" if context.get("mode") == "open-loop"
        else "lockstep",
        "kind": context.get("kind"),
        "slice": context.get("slice"),
        "attempt": context.get("evaluator_attempt"),
        "pinned_sha": context.get("pinned_sha") or context.get("expected_sha"),
        "agent_id": agent_id,
        "model": model,
        "title": title,
        "prior_status": state.get("status"),
        "prior_phase": state.get("phase"),
        "prompt_sha256": reconcile.sha256_text(prompt) if reconcile else None,
        "prompt_bytes": len(prompt.encode("utf-8")),
        "prompt_nonce": nonce,
        "product_head": _git_read(repo, "rev-parse", "HEAD"),
        "artifact_baseline": {
            "path": artifact,
            "sha256": reconcile.sha256_text(before_text) if reconcile else None,
            "size": len(before_text.encode("utf-8")),
            "mtime": _mailbox_mtime(mailbox / artifact),
        },
        "terminal_epoch": None,
        "turn_seq_at_dispatch": 0,
        "dispatched_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    }


def _held_record_path(mailbox: Path, session_id: str) -> Path:
    slug = re.sub(r"[^A-Za-z0-9_-]+", "-", session_id).strip("-") or "session"
    return mailbox / ".sessions" / f"held-{slug}.json"


def _write_held_record(mailbox: Path, record: dict[str, Any]) -> Path:
    """Durably write one held-dispatch record (temp file, fsync, rename)."""
    path = _held_record_path(mailbox, str(record["session_id"]))
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    with tmp.open("w", encoding="utf-8") as handle:
        json.dump(record, handle, indent=2, sort_keys=True)
        handle.write("\n")
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(tmp, path)
    try:
        fd = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(fd)
        finally:
            os.close(fd)
    except OSError:
        pass
    return path


def _mark_mailbox_held(mailbox: Path, record: dict[str, Any], path: Path) -> None:
    """Append a LOG.md line and set STATE.md to needs_human (not running).

    Mirrors the loop core's `_append_log`/`_update_state`: other state
    lines are kept. Lockstep `run_loop` returns 5 on needs_human without
    dispatching; the held record also blocks every role dispatch.
    """
    log = mailbox / "LOG.md"
    text = (
        log.read_text(encoding="utf-8", errors="replace")
        if log.is_file()
        else "# Trio loop log\n"
    )
    if text and not text.endswith("\n"):
        text += "\n"
    reason = HELD_REASONS.get(
        record.get("hold"), HELD_REASONS["first_prompt_uncertain"]
    )
    text += (
        f"- iter {record.get('iteration', '?')} | loop | held "
        f"{record.get('role', '?')} session {record['session_id']}: "
        f"{reason}; see {path.name}\n"
    )
    log.write_text(text, encoding="utf-8")
    state = mailbox / "STATE.md"
    lines = (
        state.read_text(encoding="utf-8", errors="replace").splitlines()
        if state.is_file()
        else []
    )
    updates = {"status": "needs_human", "phase": "needs_human"}
    result = []
    for line in lines:
        match = re.match(r"^\s*([A-Za-z_]+)\s*:", line)
        key = match.group(1).lower() if match else None
        if key in updates:
            line = f"{key}: {updates.pop(key)}"
        result.append(line)
    result.extend(f"{key}: {value}" for key, value in updates.items())
    state.write_text("\n".join(result) + "\n", encoding="utf-8")


def _held_records(mailbox: Path) -> list[tuple[Path, dict[str, Any]]]:
    """Every held-dispatch record; an unreadable one still counts."""
    held = []
    for path in sorted((mailbox / ".sessions").glob("held-*.json")):
        try:
            record = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            record = {}
        held.append((path, record if isinstance(record, dict) else {}))
    return held


def _held_dispatch_message(mailbox: Path) -> str | None:
    """Actionable refusal text while a held record exists, else None."""
    held = _held_records(mailbox)
    if not held:
        return None
    lines = [
        f"{mailbox.name}: a role prompt was dispatched but its delivery or "
        "completion is uncertain; it may still be running. Not dispatching "
        "another role."
    ]
    for path, record in held:
        detail = ", ".join(
            f"{key} {record[key]}"
            for key in ("role", "iteration", "attempt", "pinned_sha")
            if record.get(key) not in (None, "")
        )
        lines.append(
            f"  session {record.get('session_id', '?')}"
            + (f" ({detail})" if detail else "")
            + f": {path}"
        )
        if record.get("hold") == "abandoned_on_exit":
            lines.append(
                f"    {HELD_REASONS['abandoned_on_exit']} (slice-eval "
                f"{record.get('slice', '?')} @{record.get('sha', '?')})"
            )
    abandoned = [r for _p, r in held if r.get("hold") == "abandoned_on_exit"]
    if len(abandoned) == len(held):
        # The loop core's abandoned_on_exit hold never touches STATE.md.
        state_note = (
            "check STATE.md status/phase (an abandoned_on_exit hold leaves it "
            "as the loop last wrote it) and set it for the step to run next"
        )
    elif abandoned:
        state_note = (
            "set STATE.md status/phase for the step to run next (a "
            "delivery/completion hold set it to needs_human; an "
            "abandoned_on_exit hold does not change it)"
        )
    else:
        state_note = (
            "set STATE.md status/phase for the step to run next (it was set "
            "to needs_human)"
        )
    lines.append(
        "  resolve: `trioctl omnigent session read <session>` and check the "
        "mailbox and git state; once that session has finished or is gone "
        "and its output is reconciled by hand, delete the held-*.json record, "
        f"{state_note}, and re-run. `trioctl omnigent sessions prune` can "
        "then remove the session."
    )
    return "\n".join(lines)


def _sanitise_archive_slug(value: str) -> str:
    """Collapse a title or timestamp into a filesystem-safe slug."""
    slug = re.sub(r"[^A-Za-z0-9]+", "-", value).strip("-")
    return slug or "session"


def _session_archive_filename(row: dict[str, Any]) -> str:
    """Name an archive file from the session's listing row.

    Format: ``<created_at>-<sanitised title>-<id8>.jsonl``.
    """
    session_id = str(row.get("id") or row.get("session_id") or "unknown")
    created_at = row.get("created_at") or row.get("createdAt") or "unknown"
    title = row.get("title") or "untitled"
    return (
        f"{_sanitise_archive_slug(str(created_at))}-"
        f"{_sanitise_archive_slug(str(title))}-{session_id[:8]}.jsonl"
    )


def _item_cursor_id(item: Any) -> str | None:
    """Read an item row's id for cursor paging, or ``None`` if unusable."""
    if isinstance(item, dict):
        value = item.get("id")
        if isinstance(value, str) and value:
            return value
    return None


def _fetch_session_items_paged(
    client: Any, session_id: str
) -> tuple[list[Any], Any]:
    """Page a session's full item history at SESSION_ARCHIVE_PAGE_LIMIT per
    request (the broker rejects a larger ``limit`` with HTTP 422),
    advancing an ``after`` item-id cursor to the previous page's last item
    until a page returns fewer items than the page limit (or none). The
    items route only supports cursor pagination -- there is no ``offset``.

    Returns ``(items, error)``: whatever items were read successfully,
    plus the ``BrokerHttpError`` that stopped the read early, or ``None``
    on a clean full read. A mid-transcript failure still yields whatever
    was read before it, instead of losing everything. A cursor that fails
    to advance between two pages (an unusable or repeated last-item id)
    also stops the read with an error, rather than looping forever on the
    same page.
    """
    items: list[Any] = []
    after: str | None = None
    while True:
        try:
            payload = client.get_items(
                session_id,
                limit=SESSION_ARCHIVE_PAGE_LIMIT,
                order="asc",
                after=after,
            )
        except broker_http.BrokerHttpError as exc:
            return items, exc
        page = _session_items(payload)
        if not page:
            return items, None
        items.extend(page)
        if len(page) < SESSION_ARCHIVE_PAGE_LIMIT:
            return items, None
        next_after = _item_cursor_id(page[-1])
        if not next_after or next_after == after:
            return items, broker_http.BrokerHttpError(
                f"GET .../{session_id}/items cursor did not advance past "
                f"{after!r}; aborting to avoid an infinite loop"
            )
        after = next_after


def _fetch_all_broker_sessions(
    client: Any, *, kind: str | None = None
) -> list[dict[str, Any]]:
    """Page ``client.list_sessions()`` at SESSION_LIST_PAGE_LIMIT per
    request until a page returns fewer rows than the limit (or none), so
    the prune can see every session on the broker instead of just the
    server's default newest-20 window. Advances an ``after`` session-id
    cursor to the previous page's last row; a cursor that fails to
    advance between two pages raises instead of looping forever.

    ``kind`` is forwarded to ``list_sessions`` as-is; omitted (``None``)
    it leaves the server on its own default, which excludes the
    ``sub_agent``-kind sessions the Omnigent UI creates via
    ``sys_session_create``.
    """
    list_sessions = getattr(client, "list_sessions", None)
    if list_sessions is None:
        raise TrioctlError("broker client has no session-list method")
    rows: list[dict[str, Any]] = []
    after: str | None = None
    while True:
        list_kwargs: dict[str, Any] = {"limit": SESSION_LIST_PAGE_LIMIT, "after": after}
        if kind is not None:
            list_kwargs["kind"] = kind
        try:
            payload = list_sessions(**list_kwargs)
        except broker_http.BrokerHttpError as exc:
            raise TrioctlError(str(exc)) from exc
        page = [row for row in _session_items(payload) if isinstance(row, dict)]
        if not page:
            return rows
        rows.extend(page)
        if len(page) < SESSION_LIST_PAGE_LIMIT:
            return rows
        last_row_id = page[-1].get("id") or page[-1].get("session_id")
        if not isinstance(last_row_id, str) or not last_row_id or last_row_id == after:
            raise TrioctlError(
                "GET /v1/sessions cursor did not advance past "
                f"{after!r}; aborting to avoid an infinite loop"
            )
        after = last_row_id


def _session_title_matches_mailbox(title: str, mailbox: Path) -> bool:
    """True iff `title` is a trioctl loop session title scoped to `mailbox`.

    Loop session titles use the locked scheme
    ``trioctl <mailbox.name> <role>:iteration <N>`` (plus an optional
    open-loop suffix like `` lead-pass`` / `` integration-eval`` /
    `` slice-eval:<id>``), so a title matches `mailbox` iff it starts with
    the ``trioctl <mailbox.name> `` prefix. Registration-anchor titles --
    e.g. ``trio-omnigent-lead``, ``trio-omnigent-evaluator``,
    ``lead:omnigent/trio-omnigent-roles/lead``, config-path idle sessions,
    and untitled/empty rows -- never carry that prefix, so prune never
    deletes them; sessions for another mailbox carry their own
    ``trioctl <other-mailbox> `` prefix and are likewise left alone.
    """
    return title.startswith(f"trioctl {mailbox.name} ")


def _prune_broker_sessions(
    client: Any,
    mailbox: Path,
    *,
    all_scope: bool = False,
    dry_run: bool = False,
    keep_failed: bool = False,
    session_ids: Any = None,
    include_sub_agents: bool = False,
    keep_unarchived: bool = False,
    deleted_ids: list[str] | None = None,
) -> dict[str, int]:
    """Archive-then-delete broker sessions, id-scoped or title-scoped.

    Two mutually exclusive selection modes:

    - ``session_ids`` given (id-scoped): only rows whose id is in that
      iterable are touched -- the mode the default post-loop cleanup uses,
      so a session from an earlier run (even one matching this mailbox's
      title prefix) is never touched.
    - ``session_ids`` omitted (title-scoped, the manual/bulk form): only
      sessions whose title starts with ``trioctl <mailbox.name> `` (or,
      with ``all_scope``, any ``trioctl `` title) are touched -- other
      projects share the same broker.

    Title-scoped prune still skips ``running`` so a bulk sweep cannot
    kill a live session. Id-scoped post-loop prune does **not**: the
    loop has already finished, and cursor-native often stays ``running``
    after wait returns (0.14 smoke left tmux panes until DELETE).
    ``keep_failed``
    additionally skips ``failed``/``error`` sessions, and every archived
    transcript is written under ``<mailbox>/.sessions/`` *before* its
    broker session is deleted.

    ``include_sub_agents`` widens the *listing* only: it passes
    ``kind="any"`` to the broker so ``sub_agent``-kind sessions -- e.g.
    ones the Omnigent UI's trio-omnigent skill creates via
    ``sys_session_create``, invisible under the server's ``kind=default``
    listing -- are among the rows considered. Title matching above is
    unchanged either way; a session is still only touched if its title
    actually matches.

    ``keep_unarchived`` only affects sessions whose item read fails even
    after one retry: by default such a session is still deleted with a
    partial archive and a stderr warning (delete is the only path that
    kills the broker's tmux terminal; keeping it leaks 200-600 MB of
    RAM per role). With ``keep_unarchived`` the old keep-and-skip
    behavior is restored for callers that would rather leak than lose
    an incomplete transcript.

    ``deleted_ids``, when given, receives each session id whose DELETE
    succeeded.
    """
    rows = _fetch_all_broker_sessions(
        client, kind="any" if include_sub_agents else None
    )
    if session_ids is not None:
        wanted_ids = {sid for sid in session_ids if isinstance(sid, str) and sid}

        def _matches(row: dict[str, Any]) -> bool:
            row_id = row.get("id") or row.get("session_id")
            return isinstance(row_id, str) and row_id in wanted_ids

    else:
        all_prefix = "trioctl "

        def _matches(row: dict[str, Any]) -> bool:
            # Loop session titles use the locked scheme
            # ``trioctl <mailbox.name> <role>:iteration <N>`` (plus an
            # optional open-loop suffix), so a mailbox-scoped prune matches
            # iff the title starts with ``trioctl <mailbox.name> ``. Skill /
            # worker titles use ``<role>:iteration <N>`` right after that
            # prefix. Registration-anchor titles -- e.g.
            # ``trio-omnigent-lead``, ``trio-omnigent-evaluator``,
            # ``lead:omnigent/trio-omnigent-roles/lead``, config-path idle
            # sessions, and untitled/empty rows -- never carry that prefix,
            # so prune never deletes them. With ``all_scope`` any
            # ``trioctl `` title matches regardless of mailbox.
            title = row.get("title")
            if not isinstance(title, str):
                return False
            if all_scope:
                return title.startswith(all_prefix)
            return _session_title_matches_mailbox(title, mailbox)

    counts = {
        "archived": 0,
        "deleted": 0,
        "skipped_running": 0,
        "skipped_failed": 0,
        "failed": 0,
    }
    sessions_dir = mailbox / ".sessions"
    for row in rows:
        if not _matches(row):
            continue
        title = row.get("title") or "untitled"
        session_id = row.get("id") or row.get("session_id")
        if not isinstance(session_id, str) or not session_id:
            continue
        status = _session_status(row)
        # Bulk title prune: never interrupt a live session.
        # Post-loop id list: delete anyway so the tmux pane dies.
        if status == "running" and session_ids is None:
            counts["skipped_running"] += 1
            print(f"trioctl: skip (running): {session_id} {title}")
            continue
        if keep_failed and status in SESSION_FAILURE_STATUSES:
            counts["skipped_failed"] += 1
            print(f"trioctl: skip (failed, --keep-failed): {session_id} {title}")
            continue
        if dry_run:
            print(f"trioctl: dry-run would archive and delete: {session_id} {title}")
            continue
        items, read_error = _fetch_session_items_paged(client, session_id)
        if read_error is not None:
            # Retry the item read once: a transient broker hiccup should
            # not strand a terminal. If the retry still fails we keep
            # the best items read so far and apply the partial-archive
            # policy below.
            items, read_error = _fetch_session_items_paged(
                client, session_id
            )
        sessions_dir.mkdir(parents=True, exist_ok=True)
        archive_path = sessions_dir / _session_archive_filename(row)
        with archive_path.open("w", encoding="utf-8") as handle:
            handle.write(json.dumps(row, sort_keys=True) + "\n")
            for item in items:
                handle.write(json.dumps(item, sort_keys=True) + "\n")
        if read_error is not None:
            # The transcript could not be fully read even after one
            # retry. Delete is the only path that kills the broker's
            # tmux terminal; keeping an unarchived session leaks RAM
            # (200-600 MB per role terminal). Default: warn on stderr
            # and delete anyway with a partial archive (counts as both
            # `failed` and `deleted`). --keep-unarchived opts back into
            # the old keep-and-skip behavior for callers that would
            # rather leak than lose an incomplete transcript.
            counts["failed"] += 1
            if keep_unarchived:
                print(
                    f"trioctl: failed to fully read items for "
                    f"{session_id} {title}: {read_error} "
                    f"({len(items)} item(s) saved to {archive_path}; "
                    f"session kept, not deleted)",
                    file=sys.stderr,
                )
                continue
            print(
                f"trioctl: failed to fully read items for {session_id} "
                f"{title}: {read_error} ({len(items)} item(s) saved to "
                f"{archive_path}; deleting anyway -- transcript was "
                f"not fully archived)",
                file=sys.stderr,
            )
        else:
            counts["archived"] += 1
        delete_session = getattr(client, "delete_session", None)
        if delete_session is None:
            raise TrioctlError("broker client has no session-delete method")
        # DELETE alone does not stop a host-launched session's dedicated
        # runner (observed: runners held their workspaces ~1h until their
        # idle reaper). Broker-archiving first is the supported, session-
        # scoped path that makes the server send the host `stop_runner`.
        _stop_session_runner(client, session_id)
        try:
            delete_session(session_id)
        except broker_http.BrokerHttpError as exc:
            raise TrioctlError(str(exc)) from exc
        counts["deleted"] += 1
        if deleted_ids is not None:
            deleted_ids.append(session_id)
        if read_error is None:
            print(
                f"trioctl: archived and deleted {session_id} -> "
                f"{archive_path}"
            )
        else:
            print(
                f"trioctl: deleted with partial archive {session_id} "
                f"-> {archive_path}"
            )
    return counts


RUNNER_STOP_WAIT_SECONDS = 20.0


def _stop_session_runner(client: Any, session_id: str) -> bool | None:
    """Archive one session so its host runner is stopped; best effort.

    Returns True once the broker reports ``runner_online`` false, False
    when it stays online past the bounded wait, None when the client or
    session cannot say (fakes, older brokers). Never raises: a runner
    left to its idle reaper is the pre-existing behaviour.
    """
    archive = getattr(client, "archive_session", None)
    get = getattr(client, "get_session", None)
    if archive is None:
        return None
    try:
        archive(session_id)
    except Exception:  # noqa: BLE001
        return None
    if get is None:
        return None
    deadline = time.monotonic() + RUNNER_STOP_WAIT_SECONDS
    while True:
        try:
            snap = get(session_id)
        except Exception:  # noqa: BLE001
            return None
        online = snap.get("runner_online") if isinstance(snap, dict) else None
        if online is None:
            return None
        if online is False:
            return True
        if time.monotonic() >= deadline:
            print(
                f"trioctl: runner for {session_id} still online after archive; "
                "it will stop on its idle timeout",
                file=sys.stderr,
            )
            return False
        time.sleep(0.5)


def command_sessions_prune(args: argparse.Namespace) -> int:
    """Manual/bulk form: archive then delete broker sessions by title prefix.

    Matches every session whose title starts with ``trioctl <mailbox.name>
    `` (or, with ``--all``, any ``trioctl `` title) regardless of which run
    created it -- unlike `loop`'s default post-loop cleanup, which is
    scoped to only the sessions that run itself created. Use this for a
    one-off sweep, or to clean up sessions left behind by a run that never
    reached its own cleanup (e.g. `--keep-sessions`, or a crash).

    ``--include-sub-agents`` additionally lists ``kind=sub_agent`` broker
    sessions -- e.g. ones the Omnigent UI's trio-omnigent skill creates via
    ``sys_session_create`` -- which the default listing hides. Matching
    still requires the same ``trioctl <mailbox.name> `` title prefix, so
    the flag only helps when a sub-agent session actually carries that
    title.
    """
    mailbox = Path(args.mailbox).expanduser().resolve()
    client = _session_client(getattr(args, "base_url", None))
    counts = _prune_broker_sessions(
        client,
        mailbox,
        all_scope=args.all,
        dry_run=args.dry_run,
        keep_failed=args.keep_failed,
        include_sub_agents=args.include_sub_agents,
        keep_unarchived=args.keep_unarchived,
    )
    print(
        f"trioctl: archived {counts['archived']}, deleted {counts['deleted']}, "
        f"skipped running {counts['skipped_running']}, "
        f"failed {counts['failed']}"
    )
    return 0


def _run_post_loop_session_prune(
    mailbox: Path,
    base_url: str | None,
    session_ids: Any,
    *,
    keep_unarchived: bool = False,
) -> list[str]:
    """Best-effort cleanup after a headless `loop` run exits (default-on).

    Runs after the loop returns regardless of its exit code, unless the
    run passed `--keep-sessions`. Id-scoped to exactly `session_ids` --
    the union of the run's `OmnigentRunner.created_session_ids` and its
    `.sessions/run-<pid>.ids` file -- never by title prefix, so a session
    left behind by an earlier run (even one for this same mailbox) is
    never touched. Always a real archive-then-delete pass (never
    `--dry-run`, no `--keep-failed`). A prune failure is reported but
    never overrides the loop's own exit code.

    ``keep_unarchived`` defaults off so the loop always deletes a
    session whose transcript could not be fully archived even after one
    retry -- terminals only die on broker DELETE, never on process
    exit, so keeping them leaks 200-600 MB of RAM per role. The matching
    `loop --keep-unarchived` flag opts back into keep-and-skip.

    Returns the ids actually deleted (also on a partial failure), so the
    worktree cleanup can wait for exactly those sessions' runners to exit.
    """
    ids = sorted({sid for sid in session_ids if isinstance(sid, str) and sid})
    deleted: list[str] = []
    if not ids:
        return deleted
    try:
        client = _session_client(base_url)
        counts = _prune_broker_sessions(
            client, mailbox, session_ids=ids,
            keep_unarchived=keep_unarchived,
            deleted_ids=deleted,
        )
    except TrioctlError as exc:
        print(f"trioctl: session prune failed: {exc}", file=sys.stderr)
        return deleted
    print(
        "trioctl: session prune archived "
        f"{counts['archived']}, deleted {counts['deleted']}, "
        f"skipped running {counts['skipped_running']}, "
        f"failed {counts['failed']}"
    )
    return deleted


def _open_loop_queue_errors_note(errors: list[str]) -> str:
    """The QUEUE.md-parse-errors note of a lead-pass OPEN-LOOP CONTEXT
    block (r11g Q1); byte-identical to portable/driver.sh build_prompt."""
    return (
        "QUEUE.md PARSE ERRORS: the integration gate is held until the "
        "`faults:` block parses cleanly. Repair these entries in place "
        "(keep every fault, fix its shape):\n"
        + "\n".join(f"- {e}" for e in errors)
    )


