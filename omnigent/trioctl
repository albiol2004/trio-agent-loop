    return Path.home() / ".cursor" / "cli-config.json"


def check_cursor_approval_mode() -> dict[str, Any]:
    """Doctor check: Cursor CLI must run with approvalMode="unrestricted".

    --require-unrestricted: when a Lead/Evaluator --yolo session runs on
    top of a Cursor CLI still set to "allowlist", cursor-agent surfaces
    interactive approval prompts. Omnigent's _yolo_auto_accept workaround
    retries those for 3 attempts and then gives up, surfacing a manual
    ApprovalCard and stalling the loop.
    """
    path = cursor_cli_config_path()
    fix_hint = (
        "run `trioctl omnigent fix-approval-mode` (or set approvalMode to "
        '"unrestricted" and sandbox.mode to "disabled" by hand) in '
        f"{path}"
    )
    if not path.exists():
        return {
            "check": "cursor:approval-mode",
            "ok": True,
            "status": "WARN",
            "detail": (
                f"{path} not found; cursor-agent will use its built-in "
                "default approval mode, which may not be unrestricted. "
                f"--require-unrestricted: {fix_hint}"
            ),
        }
    try:
        data = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        return {
            "check": "cursor:approval-mode",
            "ok": False,
            "status": "FAIL",
            "detail": f"cannot read/parse {path}: {exc}. {fix_hint}",
        }
    mode = data.get("approvalMode") if isinstance(data, dict) else None
    if mode == "unrestricted":
        return {
            "check": "cursor:approval-mode",
            "ok": True,
            "status": "PASS",
            "detail": f'{path}: approvalMode="unrestricted"',
        }
    return {
        "check": "cursor:approval-mode",
        "ok": False,
        "status": "FAIL",
        "detail": (
            f"{path}: approvalMode={mode!r} (need \"unrestricted\"). "
            "--require-unrestricted: Lead/Evaluator --yolo sessions "
            "otherwise fall back to Omnigent's 3-attempt auto-accept and "
            f"surface manual approval cards. Fix: {fix_hint}"
        ),
    }


def command_fix_approval_mode(args: argparse.Namespace) -> int:
    path = cursor_cli_config_path()
    if not path.exists():
        raise TrioctlError(
            f"{path} does not exist; run cursor-agent once to create it, "
            'or create it manually with {"approvalMode": "unrestricted"}'
        )
    raw = path.read_text()
    try:
        data = json.loads(raw)
    except json.JSONDecodeError as exc:
        raise TrioctlError(f"{path} is not valid JSON, refusing to edit: {exc}") from exc
    before = json.dumps(data, indent=2, sort_keys=True)
    timestamp = time.strftime("%Y%m%dT%H%M%S")
    backup = path.with_name(f"{path.name}.bak-trio-{timestamp}")
    shutil.copyfile(path, backup)
    data["approvalMode"] = "unrestricted"
    sandbox = data.get("sandbox")
    if not isinstance(sandbox, dict):
        sandbox = {}
    sandbox["mode"] = "disabled"
    data["sandbox"] = sandbox
    after = json.dumps(data, indent=2, sort_keys=True)
    path.write_text(after + "\n")
    print(f"Backed up: {backup}")
    print("Before:")
    print(before)
    print("After:")
    print(after)
    return 0


def command_configure(args: argparse.Namespace) -> int:
    target = config_path(args.config)
    if target.exists() and not args.force:
        print(f"Preserving existing config: {target}")
        return 0
    source = DEFAULT_CONFIG
    if not source.is_file():
        raise TrioctlError(f"default config is missing: {source}")
    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(source, target)
    print(f"Wrote config: {target}")
    return 0


def command_models(args: argparse.Namespace) -> int:
    catalogs = {}
    if args.provider in {"codex", "all"}:
        catalogs["codex"] = codex_models(args.timeout)
    if args.provider in {"cursor", "all"}:
        catalogs["cursor"] = cursor_models(args.timeout)
    if args.json:
        print(json.dumps({"providers": catalogs}, indent=2, sort_keys=True))
        return 0
    for provider, models in catalogs.items():
        print(f"{provider}:")
        for model in models:
            name = model.get("model") or model.get("id") or "?"
            if provider == "codex":
                detail = ", ".join(sorted(_efforts(model))) or "unspecified"
            else:
                detail = model.get("displayName") or "available"
            default = " (default)" if model.get("isDefault") else ""
            print(f"  {name}{default}: {detail}")
    return 0


def command_resolve(args: argparse.Namespace) -> int:
    config = load_config(config_path(args.config))
    result = resolve_role(args.role, config, allow_fallback=args.allow_fallback)
    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        effort = result.get("reasoning_effort") or result.get("model_effort")
        print(f"{result['role']}: {result['model']} / {effort} ({result['source']})")
    return 0


def _worker_event_ctx(
    args: argparse.Namespace | None = None,
) -> dict[str, Any]:
    """Build opt-in telemetry context from CLI, else env. Default off."""
    def _pick(attr: str, env_name: str) -> str | None:
        if args is not None:
            value = getattr(args, attr, None)
            if value not in (None, ""):
                return str(value)
        env = os.environ.get(env_name, "").strip()
        return env or None

    if worker_events is None:
        return {}
    mailbox = _pick("worker_events_mailbox", WORKER_MAILBOX_ENV)
    raw_file = _pick("worker_events_file", WORKER_EVENTS_FILE_ENV)
    events_path = worker_events.resolve_events_path(raw_file, mailbox)
    if events_path is None:
        return {}
    return {
        "events_path": events_path,
        "run_id": _pick("worker_run_id", WORKER_RUN_ID_ENV),
        "iteration": _pick("worker_iteration", WORKER_ITERATION_ENV),
        "slice_id": _pick("worker_slice", WORKER_SLICE_ENV),
        "invocation_id": worker_events.new_invocation_id(),
    }


def _emit_worker_event(
    ctx: dict[str, Any] | None,
    kind: str,
    role: str,
    **fields: Any,
) -> None:
    """Write one lifecycle event; swallow telemetry errors."""
    if not ctx or worker_events is None:
        return
    path = ctx.get("events_path")
    invocation_id = ctx.get("invocation_id")
    if path is None or not invocation_id:
        return
    rec = worker_events.base_record(
        invocation_id=str(invocation_id),
        kind=kind,
        role=role,
        run_id=ctx.get("run_id"),
        iteration=ctx.get("iteration"),
        slice_id=ctx.get("slice_id"),
        **fields,
    )
    worker_events.emit(path, rec)


def _kill_worker(proc: subprocess.Popen[str], isolated: bool) -> None:
    """Kill the worker; an isolated one takes its whole process group."""
    if isolated:
        try:
            os.killpg(proc.pid, signal.SIGKILL)
            return
        except OSError:
            pass
    proc.kill()


WORKER_GROUP_DRAIN_SECONDS = 10.0


def _drain_worker_group(pgid: int) -> None:
    """SIGTERM what is left of an isolated worker's group, then SIGKILL.

    Live cursor-agent leaves helper processes that take a moment to exit
    after the wrapper returns; integration must not see them as an
    active session (it retains the worktree) nor leave them running.
    """
    def alive() -> bool:
        if worker_worktrees is not None:
            return worker_worktrees.group_alive(pgid)
        try:
            os.killpg(pgid, 0)
            return True
        except OSError:
            return False

    for sig, wait in (
        (signal.SIGTERM, WORKER_GROUP_DRAIN_SECONDS),
        (signal.SIGKILL, 2.0),
    ):
        try:
            os.killpg(pgid, sig)
        except OSError:
            return
        deadline = time.monotonic() + wait
        while time.monotonic() < deadline:
            if not alive():
                return
            time.sleep(0.05)


def run_cursor_worker(
    role: str,
    config: dict[str, Any],
    *,
    prompt: str,
    workspace: Path,
    models: list[dict[str, Any]] | None = None,
    timeout: float | None = None,
    events: dict[str, Any] | None = None,
    isolated: bool = False,
    on_spawn: Any = None,
    wrap: Any = None,
) -> str:
    """Run one ephemeral Cursor worker with the live profile-resolved model.

    Optional ``events`` is opt-in subprocess telemetry. Missing/empty
    preserves historical behavior and writes no files. Telemetry must
    not change exit codes, exceptions, or process cleanup.

    ``isolated`` binds the process itself to *workspace* (cwd as well as
    ``--workspace``, since cursor-agent derives its project ``.cursor``
    config root from the physical cwd) and starts it as its own process
    group so every descendant is tracked and killed with it. ``on_spawn``
    receives the Popen right after launch (ledger bookkeeping).
    """
    if role not in CURSOR_WORKER_ROLES:
        raise TrioctlError(
            f"Cursor worker role must be one of: {', '.join(CURSOR_WORKER_ROLES)}"
        )
    if not prompt.strip():
        raise TrioctlError("Cursor worker prompt is empty")
    resolved = resolve_role(role, config, models=models)
    if resolved["provider"] != "cursor":
        raise TrioctlError(f"roles.{role}: provider must be cursor for worker dispatch")
    cursor = shutil.which("cursor-agent")
    if not cursor:
        raise TrioctlError("cursor-agent is not on PATH")
    command = [
        cursor,
        "-p",
        "--output-format",
        "text",
        "--model",
        resolved["model"],
        "--force",
        "--trust",
        "--approve-mcps",
        "--workspace",
        str(workspace.resolve()),
    ]
    if role == "scout":
        command.extend(["--mode", "ask"])
    full_prompt = f"{CURSOR_ROLE_PROMPTS[role]}\n\nTASK FROM LEAD:\n{prompt.strip()}\n"
    if wrap is not None:
        command = wrap(command)
    started = time.monotonic_ns()
    proc: subprocess.Popen[str] | None = None
    try:
        try:
            proc = subprocess.Popen(
                command,
                stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                **(
                    {"cwd": str(workspace.resolve()), "start_new_session": True}
                    if isolated
                    else {}
                ),
            )
        except OSError as exc:
            _emit_worker_event(events, "spawn_failed", role, pid=None)
            raise TrioctlError(f"Cursor {role} failed to run: {exc}") from exc
        _emit_worker_event(events, "spawned", role, pid=proc.pid)
        if on_spawn is not None:
            on_spawn(proc)
        try:
            stdout, stderr = proc.communicate(
                input=full_prompt, timeout=timeout
            )
        except subprocess.TimeoutExpired as exc:
            _kill_worker(proc, isolated)
            try:
                proc.communicate()
            except OSError:
                pass
            duration = time.monotonic_ns() - started
            _emit_worker_event(
                events,
                "timeout",
                role,
                pid=proc.pid,
                duration_ns=duration,
            )
            raise TrioctlError(
                f"Cursor {role} failed to run: {exc}"
            ) from exc
        except KeyboardInterrupt:
            _kill_worker(proc, isolated)
            try:
                proc.communicate()
            except OSError:
                pass
            duration = time.monotonic_ns() - started
            _emit_worker_event(
                events,
                "interrupted",
                role,
                pid=proc.pid,
                duration_ns=duration,
            )
            raise
        except Exception:
            duration = time.monotonic_ns() - started
            _emit_worker_event(
                events,
                "unknown",
                role,
                pid=proc.pid,
                duration_ns=duration,
            )
            raise
        duration = time.monotonic_ns() - started
        code = proc.returncode
        kind = "nonzero_exit" if code else "exited"
        _emit_worker_event(
            events,
            kind,
            role,
            pid=proc.pid,
            returncode=code,
            duration_ns=duration,
        )
        if code:
            detail = (stderr or "").strip() or (stdout or "").strip()
            raise TrioctlError(
                f"Cursor {role} exited {code}: {detail or 'no output'}"
            )
        output = (stdout or "").strip()
        if not output:
            raise TrioctlError(f"Cursor {role} completed without output")
        return output
    finally:
        if proc is not None and proc.poll() is None:
            _kill_worker(proc, isolated)
            try:
                proc.wait(timeout=1)
            except (OSError, subprocess.TimeoutExpired):
                pass
        if isolated and proc is not None:
            # Ephemeral worker: descendants left behind in its group would
            # keep using the worktree after the wrapper exits.
            _drain_worker_group(proc.pid)


def _driver_config_path(mailbox_arg: Any) -> Path | None:
    """The loop driver's pinned profile from ``<mailbox>/.driver.json``.

    None when the file, its ``config_path`` key, or the named file is
    missing (the last one warns: the driver's profile is gone).
    """
    mailbox = Path(str(mailbox_arg)).expanduser()
    if not mailbox.is_absolute():
        mailbox = Path.cwd() / mailbox
    try:
        data = json.loads((mailbox / ".driver.json").read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    value = data.get("config_path") if isinstance(data, dict) else None
    if not isinstance(value, str) or not value.strip():
        return None
    path = Path(value).expanduser()
    if not path.is_file():
        print(
            f"trioctl: driver config {path} from {mailbox / '.driver.json'} "
            f"is missing; using {config_path(None)}",
            file=sys.stderr,
        )
        return None
    return path


def _run_config_path(args: argparse.Namespace) -> Path:
    """Profile for a worker run: --config, else the driver's, else env/default."""
    if getattr(args, "config", None):
        return config_path(args.config)
    default = config_path(None)
    mailbox_arg = getattr(args, "worker_events_mailbox", None)
    if not mailbox_arg:
        return default
    pinned = _driver_config_path(mailbox_arg)
    if pinned is None:
        return default
    try:
        same = pinned.resolve() == default.expanduser().resolve()
    except OSError:
        same = False
    if not same:
        print(f"trioctl: using driver config {pinned}", file=sys.stderr)
    return pinned


def command_run(args: argparse.Namespace) -> int:
    """Run one headless Cursor worker (a separate OS process from `loop`).

    `run_cursor_worker` drives `cursor-agent` directly and never opens an
    Omnigent broker session, so today there is no id to append to a
    `loop` run's `SESSION_IDS_ENV_VAR` ids file -- that file only ever
    gains entries through `_record_created_session_id`, which this
    process-boundary hook exists to route a headless worker's session id
    through if a future dispatch path ever opens a broker-tracked one.
    """
    config = load_config(_run_config_path(args))
    if args.prompt_file == "-":
        prompt = sys.stdin.read()
    else:
        try:
            prompt = Path(args.prompt_file).read_text()
        except OSError as exc:
            raise TrioctlError(
                f"cannot read prompt file {args.prompt_file}: {exc}"
            ) from exc
    if getattr(args, "isolate", False):
        return _command_run_isolated(args, config, prompt)
    output = run_cursor_worker(
        args.role,
        config,
        prompt=prompt,
        workspace=Path(args.workspace),
        timeout=args.timeout,
        events=_worker_event_ctx(args) or None,
    )
    print(output)
    return 0


