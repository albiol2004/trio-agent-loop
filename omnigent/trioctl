    )
    sessions_prune.add_argument(
        "--include-sub-agents",
        action="store_true",
        help=(
            "also list kind=sub_agent broker sessions (e.g. ones the "
            "Omnigent UI's trio-omnigent skill creates), so they're "
            "considered against the same trioctl title-prefix match"
