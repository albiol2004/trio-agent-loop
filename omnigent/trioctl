def main() -> int:
    args = parser().parse_args()
    try:
        return args.func(args)
    except TrioctlError as exc:
        print(f"trioctl: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
