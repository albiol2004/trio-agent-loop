def _multi_repo_listing(
    repos: dict[str, dict[str, Any]], home: Path | None, pins: dict[str, str] | None = None
) -> str:
    """One `  - <name>: <path> (base <b>)[ @<sha>]` line per repo, home first."""
    rows: list[str] = []
    for name, path, base in [
        ("home", home, None),
        *[(n, d["path"], d.get("base")) for n, d in repos.items()],
    ]:
        line = f"  - `{name}`: `{path}`"
        if base:
            line += f" (base `{base}`)"
        if pins is not None:
            line += f" @`{pins.get(name) or '?'}`"
        rows.append(line + "\n")
    return "".join(rows)


def _omnigent_prompt_dirs(repo: Path) -> list[Path]:
    """Ordered directories to search for checked-in Omnigent role prompts.

    An installed `trioctl` (see install.sh's `--omnigent` mode) has no
    `omnigent/entrypoints/trio-omnigent/prompts` of its own next to the
    target project or next to the installed script itself, so the search
    falls through to `$TRIO_OMNIGENT_PROMPTS` when set, then the skill
    directories install.sh writes the same prompts into for Claude Code
    and Codex.
    """
    tail = Path("omnigent", "entrypoints", "trio-omnigent", "prompts")
    dirs = [repo / tail, Path(__file__).resolve().parent.parent / tail]
    env_dir = os.environ.get("TRIO_OMNIGENT_PROMPTS")
    if env_dir:
        dirs.append(Path(env_dir).expanduser())
    home = Path.home()
    dirs.append(home / ".claude" / "skills" / "trio-omnigent" / "prompts")
    dirs.append(home / ".agents" / "skills" / "trio-omnigent" / "prompts")
    return dirs


