class TrioctlError(RuntimeError):
    """A user-actionable configuration or discovery failure."""


def _load_broker_http() -> Any:
    """Load the sibling client without importing this directory as a package."""
    path = Path(__file__).with_name("broker_http.py")
    loader = importlib.machinery.SourceFileLoader(
        "trioctl_broker_http",
        str(path),
    )
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise ImportError(f"cannot load broker client: {path}")
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


# The repository directory is named ``omnigent``.  A non-package loader keeps
# running from the repository root from accidentally resolving that directory.
broker_http = _load_broker_http()


def config_path(value: str | None = None) -> Path:
    if value:
        return Path(value).expanduser()
    override = os.environ.get("TRIOCTL_CONFIG")
    if override:
        return Path(override).expanduser()
    base = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    return base / "trio-agent-loop" / "omnigent.toml"


def load_config(path: Path) -> dict[str, Any]:
    try:
        data = tomllib.loads(path.read_text())
    except FileNotFoundError as exc:
        raise TrioctlError(
            f"config not found: {path}; run 'trioctl omnigent configure'"
        ) from exc
    except (OSError, tomllib.TOMLDecodeError) as exc:
        raise TrioctlError(f"cannot read config {path}: {exc}") from exc
    if data.get("version") != 1:
        raise TrioctlError(f"{path}: version must be 1")
    roles = data.get("roles")
    if not isinstance(roles, dict):
        raise TrioctlError(f"{path}: missing [roles.*] tables")
    missing = [role for role in ROLES if not isinstance(roles.get(role), dict)]
    if missing:
        raise TrioctlError(f"{path}: missing roles: {', '.join(missing)}")
    return data


def _send(proc: subprocess.Popen[str], payload: dict[str, Any]) -> None:
    if proc.stdin is None:
        raise TrioctlError("Codex app-server stdin is unavailable")
    proc.stdin.write(json.dumps(payload, separators=(",", ":")) + "\n")
    proc.stdin.flush()


def _wait_response(
    proc: subprocess.Popen[str],
    selector: selectors.BaseSelector,
    request_id: int,
    deadline: float,
) -> dict[str, Any]:
    while time.monotonic() < deadline:
        events = selector.select(max(0.0, min(0.5, deadline - time.monotonic())))
        if not events:
            if proc.poll() is not None:
                break
            continue
        if proc.stdout is None:
            break
        line = proc.stdout.readline()
        if not line:
            break
        try:
            message = json.loads(line)
        except json.JSONDecodeError:
            continue
        if message.get("id") == request_id:
            if "error" in message:
                raise TrioctlError(f"Codex app-server error: {message['error']}")
            return message
    raise TrioctlError(f"Codex app-server timed out waiting for response {request_id}")


def codex_models(timeout: float = 15.0) -> list[dict[str, Any]]:
    codex = shutil.which("codex")
    if not codex:
        raise TrioctlError("codex is not on PATH")
    try:
        proc = subprocess.Popen(
            [codex, "app-server", "--stdio"],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            bufsize=1,
        )
    except OSError as exc:
        raise TrioctlError(f"could not start Codex app-server: {exc}") from exc

    selector = selectors.DefaultSelector()
    assert proc.stdout is not None
    selector.register(proc.stdout, selectors.EVENT_READ)
    deadline = time.monotonic() + timeout
    try:
        _send(
            proc,
            {
                "id": 1,
                "method": "initialize",
                "params": {
                    "clientInfo": {"name": "trioctl", "version": VERSION},
                    "capabilities": {"experimentalApi": True},
                },
            },
        )
        _wait_response(proc, selector, 1, deadline)
        _send(proc, {"method": "initialized"})

        models: list[dict[str, Any]] = []
        cursor: str | None = None
        request_id = 2
        while True:
            params: dict[str, Any] = {"includeHidden": False}
            if cursor:
                params["cursor"] = cursor
            _send(
                proc,
                {"id": request_id, "method": "model/list", "params": params},
            )
            envelope = _wait_response(proc, selector, request_id, deadline)
            result = envelope.get("result")
            if not isinstance(result, dict) or not isinstance(result.get("data"), list):
                raise TrioctlError("Codex model/list returned an invalid response")
            for item in result["data"]:
                if isinstance(item, dict):
                    models.append(item)
            cursor = result.get("nextCursor")
            if cursor is None:
                return models
            if not isinstance(cursor, str) or not cursor:
                raise TrioctlError("Codex model/list returned an invalid cursor")
            request_id += 1
    finally:
        selector.close()
        if proc.poll() is None:
            proc.terminate()
        try:
            proc.communicate(timeout=3)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.communicate()


def cursor_models(timeout: float = 15.0) -> list[dict[str, Any]]:
    """Return the authenticated Cursor CLI's live account model catalog."""
    cursor = shutil.which("cursor-agent")
    if not cursor:
        raise TrioctlError("cursor-agent is not on PATH")
    try:
        result = subprocess.run(
            [cursor, "models"],
            capture_output=True,
            text=True,
            timeout=timeout,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise TrioctlError(f"could not query Cursor models: {exc}") from exc
    if result.returncode:
        detail = result.stderr.strip() or result.stdout.strip()
        raise TrioctlError(
            f"Cursor model listing failed: {detail or result.returncode}"
        )

    models: list[dict[str, Any]] = []
    for line in result.stdout.splitlines():
        match = re.match(r"^(\S+)\s+-\s+(.+?)\s*$", line)
        if match:
            model_id, display_name = match.groups()
            models.append(
                {"id": model_id, "model": model_id, "displayName": display_name}
            )
    if not models:
        raise TrioctlError("Cursor model listing returned no parseable models")
    return models


def _efforts(model: dict[str, Any]) -> set[str]:
    values = model.get("supportedReasoningEfforts", [])
    if not isinstance(values, list):
        return set()
    return {
        item["reasoningEffort"]
        for item in values
        if isinstance(item, dict) and isinstance(item.get("reasoningEffort"), str)
    }


def _model_rank(model: dict[str, Any]) -> tuple[int, ...]:
    value = str(model.get("model") or model.get("id") or "")
    match = re.search(r"gpt-(\d+)(?:\.(\d+))?(?:\.(\d+))?", value, re.I)
    numbers = tuple(int(part or 0) for part in match.groups()) if match else (0, 0, 0)
    return (*numbers, int(bool(model.get("isDefault"))))


def _family_matches(model: dict[str, Any], family: str) -> bool:
    needle = re.sub(r"[^a-z0-9]+", "-", family.lower()).strip("-")
    values = (
        re.sub(r"[^a-z0-9]+", "-", str(model.get(key) or "").lower()).strip("-")
        for key in ("id", "model", "displayName")
    )
    return any(needle in value for value in values)


def resolve_role(
    role: str,
    config: dict[str, Any],
    *,
    models: list[dict[str, Any]] | None = None,
    allow_fallback: bool = False,
) -> dict[str, Any]:
    if role not in ROLES:
        raise TrioctlError(f"unknown role: {role}")
    spec = config["roles"][role]
    provider = spec.get("provider")
    effort = spec.get("effort")
    if provider not in {"claude", "codex", "cursor"} or not isinstance(effort, str):
        raise TrioctlError(f"roles.{role}: provider/effort is invalid")

    if provider == "claude":
        model = spec.get("model")
        if not isinstance(model, str) or not model:
            raise TrioctlError(f"roles.{role}: Claude roles require model")
        return {
            "role": role,
            "provider": provider,
            "model": model,
            "reasoning_effort": effort,
            "source": "configured-alias",
        }

    try:
        catalog = (
            models
            if models is not None
            else (cursor_models() if provider == "cursor" else codex_models())
        )
        exact = spec.get("model")
        family = spec.get("model_family")
        if isinstance(exact, str) and exact:
            matches = [
                item for item in catalog if exact in {item.get("id"), item.get("model")}
            ]
        elif isinstance(family, str) and family:
            matches = [item for item in catalog if _family_matches(item, family)]
        else:
            raise TrioctlError(
                f"roles.{role}: {provider} roles require model or model_family"
            )
        if provider == "cursor":
            fast = spec.get("fast", False)
            matches = [
                item
                for item in matches
                if str(item.get("model") or item.get("id") or "").endswith(
                    f"-{effort}" + ("-fast" if fast else "")
                )
            ]
        if not matches:
            wanted = exact or f"family {family!r}"
            raise TrioctlError(
                f"roles.{role}: no available {provider} model matches {wanted} "
                f"at effort {effort!r}"
            )
        selected = max(matches, key=_model_rank)
        supported = _efforts(selected) if provider == "codex" else set()
        if provider == "codex" and supported and effort not in supported:
            name = selected.get("model") or selected.get("id")
            raise TrioctlError(
                f"roles.{role}: {name} does not support effort {effort!r}; "
                f"available: {', '.join(sorted(supported))}"
            )
        model = selected.get("model") or selected.get("id")
        if not isinstance(model, str) or not model:
            raise TrioctlError("selected Codex model has no usable identifier")
        return {
            "role": role,
            "provider": provider,
            "model": model,
            "reasoning_effort": effort if provider == "codex" else None,
            "model_effort": effort if provider == "cursor" else None,
            "source": f"{provider}-model-list",
        }
    except TrioctlError:
        fallback = spec.get("fallback_model")
        if not allow_fallback or not isinstance(fallback, str) or not fallback:
            raise
        return {
            "role": role,
            "provider": provider,
            "model": fallback,
            "reasoning_effort": effort if provider == "codex" else None,
            "model_effort": effort if provider == "cursor" else None,
            "source": "explicit-fallback",
        }


def omnigent_contract() -> str:
    """Verify the installed Omnigent package exposes Trio's required seams."""
    executable = shutil.which("omnigent")
    if not executable:
        raise TrioctlError("omnigent is not on PATH")
    try:
        first_line = Path(executable).read_text().splitlines()[0]
    except (OSError, IndexError) as exc:
        raise TrioctlError(f"cannot inspect {executable}: {exc}") from exc
    if not first_line.startswith("#!"):
        raise TrioctlError(f"{executable} has no Python shebang")
    interpreter = first_line[2:]
    probe = """
from omnigent.tools.builtins.spawn import SysSessionCreateTool
from omnigent.server.routes.sessions import _resolve_agent_spec

create_props = SysSessionCreateTool().get_schema()["function"]["parameters"]["properties"]
assert "reasoning_effort" in create_props
assert callable(_resolve_agent_spec)
"""
    try:
        result = subprocess.run(
            [interpreter, "-c", probe],
            capture_output=True,
            text=True,
            timeout=15,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise TrioctlError(f"Omnigent contract probe failed: {exc}") from exc
    if result.returncode:
        detail = result.stderr.strip().splitlines()
        suffix = detail[-1] if detail else f"exit {result.returncode}"
        raise TrioctlError(f"required session/launch support is missing: {suffix}")
    return "session-create effort and registered native launch propagation available"


def cursor_cli_config_path() -> Path:
    """Location of the Cursor CLI's user config (respects $HOME)."""
    return Path.home() / ".cursor" / "cli-config.json"


def check_cursor_approval_mode() -> dict[str, Any]:
    """Doctor check: Cursor CLI must run with approvalMode="unrestricted".

    --require-unrestricted: when a Lead/Evaluator --yolo session runs on
    top of a Cursor CLI still set to "allowlist", cursor-agent surfaces
    interactive approval prompts. Omnigent's _yolo_auto_accept workaround
    retries those for 3 attempts and then gives up, surfacing a manual
    ApprovalCard and stalling the loop.
    """
    path = cursor_cli_config_path()
    fix_hint = (
        "run `trioctl omnigent fix-approval-mode` (or set approvalMode to "
        '"unrestricted" and sandbox.mode to "disabled" by hand) in '
        f"{path}"
    )
    if not path.exists():
        return {
            "check": "cursor:approval-mode",
            "ok": True,
            "status": "WARN",
            "detail": (
                f"{path} not found; cursor-agent will use its built-in "
                "default approval mode, which may not be unrestricted. "
                f"--require-unrestricted: {fix_hint}"
            ),
        }
    try:
        data = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        return {
            "check": "cursor:approval-mode",
            "ok": False,
            "status": "FAIL",
            "detail": f"cannot read/parse {path}: {exc}. {fix_hint}",
        }
    mode = data.get("approvalMode") if isinstance(data, dict) else None
    if mode == "unrestricted":
        return {
            "check": "cursor:approval-mode",
            "ok": True,
            "status": "PASS",
            "detail": f'{path}: approvalMode="unrestricted"',
        }
    return {
        "check": "cursor:approval-mode",
        "ok": False,
        "status": "FAIL",
        "detail": (
            f"{path}: approvalMode={mode!r} (need \"unrestricted\"). "
            "--require-unrestricted: Lead/Evaluator --yolo sessions "
            "otherwise fall back to Omnigent's 3-attempt auto-accept and "
            f"surface manual approval cards. Fix: {fix_hint}"
        ),
    }


def command_fix_approval_mode(args: argparse.Namespace) -> int:
    path = cursor_cli_config_path()
    if not path.exists():
        raise TrioctlError(
            f"{path} does not exist; run cursor-agent once to create it, "
            'or create it manually with {"approvalMode": "unrestricted"}'
        )
    raw = path.read_text()
    try:
        data = json.loads(raw)
    except json.JSONDecodeError as exc:
        raise TrioctlError(f"{path} is not valid JSON, refusing to edit: {exc}") from exc
    before = json.dumps(data, indent=2, sort_keys=True)
    timestamp = time.strftime("%Y%m%dT%H%M%S")
    backup = path.with_name(f"{path.name}.bak-trio-{timestamp}")
    shutil.copyfile(path, backup)
    data["approvalMode"] = "unrestricted"
    sandbox = data.get("sandbox")
    if not isinstance(sandbox, dict):
        sandbox = {}
    sandbox["mode"] = "disabled"
    data["sandbox"] = sandbox
    after = json.dumps(data, indent=2, sort_keys=True)
    path.write_text(after + "\n")
    print(f"Backed up: {backup}")
    print("Before:")
    print(before)
    print("After:")
    print(after)
    return 0


def command_configure(args: argparse.Namespace) -> int:
    target = config_path(args.config)
    if target.exists() and not args.force:
        print(f"Preserving existing config: {target}")
        return 0
    source = DEFAULT_CONFIG
    if not source.is_file():
        raise TrioctlError(f"default config is missing: {source}")
    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(source, target)
    print(f"Wrote config: {target}")
    return 0


def command_models(args: argparse.Namespace) -> int:
    catalogs = {}
    if args.provider in {"codex", "all"}:
        catalogs["codex"] = codex_models(args.timeout)
    if args.provider in {"cursor", "all"}:
        catalogs["cursor"] = cursor_models(args.timeout)
    if args.json:
        print(json.dumps({"providers": catalogs}, indent=2, sort_keys=True))
        return 0
    for provider, models in catalogs.items():
        print(f"{provider}:")
        for model in models:
            name = model.get("model") or model.get("id") or "?"
            if provider == "codex":
                detail = ", ".join(sorted(_efforts(model))) or "unspecified"
            else:
                detail = model.get("displayName") or "available"
            default = " (default)" if model.get("isDefault") else ""
            print(f"  {name}{default}: {detail}")
    return 0


def command_resolve(args: argparse.Namespace) -> int:
    config = load_config(config_path(args.config))
    result = resolve_role(args.role, config, allow_fallback=args.allow_fallback)
    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        effort = result.get("reasoning_effort") or result.get("model_effort")
        print(f"{result['role']}: {result['model']} / {effort} ({result['source']})")
    return 0


def run_cursor_worker(
    role: str,
    config: dict[str, Any],
    *,
    prompt: str,
    workspace: Path,
    models: list[dict[str, Any]] | None = None,
    timeout: float | None = None,
) -> str:
    """Run one ephemeral Cursor worker with the live profile-resolved model."""
    if role not in CURSOR_WORKER_ROLES:
        raise TrioctlError(
            f"Cursor worker role must be one of: {', '.join(CURSOR_WORKER_ROLES)}"
        )
    if not prompt.strip():
        raise TrioctlError("Cursor worker prompt is empty")
    resolved = resolve_role(role, config, models=models)
    if resolved["provider"] != "cursor":
        raise TrioctlError(f"roles.{role}: provider must be cursor for worker dispatch")
    cursor = shutil.which("cursor-agent")
    if not cursor:
        raise TrioctlError("cursor-agent is not on PATH")
    command = [
        cursor,
        "-p",
        "--output-format",
        "text",
        "--model",
        resolved["model"],
        "--force",
        "--trust",
        "--approve-mcps",
        "--workspace",
        str(workspace.resolve()),
    ]
    if role == "scout":
        command.extend(["--mode", "ask"])
    full_prompt = f"{CURSOR_ROLE_PROMPTS[role]}\n\nTASK FROM LEAD:\n{prompt.strip()}\n"
    try:
        result = subprocess.run(
            command,
            input=full_prompt,
            capture_output=True,
            text=True,
            timeout=timeout,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise TrioctlError(f"Cursor {role} failed to run: {exc}") from exc
    if result.returncode:
        detail = result.stderr.strip() or result.stdout.strip()
        raise TrioctlError(
            f"Cursor {role} exited {result.returncode}: {detail or 'no output'}"
        )
    output = result.stdout.strip()
    if not output:
        raise TrioctlError(f"Cursor {role} completed without output")
    return output


def command_run(args: argparse.Namespace) -> int:
    config = load_config(config_path(args.config))
    if args.prompt_file == "-":
        prompt = sys.stdin.read()
    else:
        try:
            prompt = Path(args.prompt_file).read_text()
        except OSError as exc:
            raise TrioctlError(
                f"cannot read prompt file {args.prompt_file}: {exc}"
            ) from exc
    output = run_cursor_worker(
        args.role,
        config,
        prompt=prompt,
        workspace=Path(args.workspace),
        timeout=args.timeout,
    )
    print(output)
    return 0


SESSION_TERMINAL_STATUSES = {"completed", "failed", "error"}


def _session_client(base_url: str | None = None) -> Any:
    """Build a client using the documented loopback default."""
    return broker_http.BrokerClient(
        base_url or broker_http.DEFAULT_BASE_URL,
    )


def _print_json(payload: Any) -> None:
    """Keep all session subcommands machine-readable."""
    print(json.dumps(payload, indent=2, sort_keys=True))


def command_session_create(args: argparse.Namespace) -> int:
    """Create one broker session and print the server response."""
    client = _session_client(args.base_url)
    try:
        result = client.create_session(
            args.agent_id,
            args.model,
            args.message,
            getattr(args, "title", None),
        )
    except broker_http.BrokerHttpError as exc:
        raise TrioctlError(str(exc)) from exc
    _print_json(result)
    return 0


def _session_status(snapshot: Any) -> str:
    """Read a normalized status from a broker session snapshot."""
    if not isinstance(snapshot, dict):
        return ""
    status = snapshot.get("status")
    return status.lower() if isinstance(status, str) else ""


def command_session_wait(args: argparse.Namespace) -> int:
    """Poll a broker session until it reaches a terminal status."""
    if args.timeout < 0:
        raise TrioctlError("--timeout must be non-negative")
    if args.interval < 0:
        raise TrioctlError("--interval must be non-negative")

    client = _session_client(getattr(args, "base_url", None))
    deadline = time.monotonic() + args.timeout
    while True:
        try:
            snapshot = client.get_session(args.session_id)
        except broker_http.BrokerHttpError as exc:
            raise TrioctlError(str(exc)) from exc
        if _session_status(snapshot) in SESSION_TERMINAL_STATUSES:
            _print_json(snapshot)
            return 0
        if time.monotonic() >= deadline:
            raise TrioctlError(
                f"session {args.session_id} timed out after "
                f"{args.timeout:g} seconds"
            )
        remaining = deadline - time.monotonic()
        time.sleep(min(args.interval, remaining))


def command_session_read(args: argparse.Namespace) -> int:
    """Read one session's committed items and print the response."""
    if args.limit < 0:
        raise TrioctlError("--limit must be non-negative")
    if args.order not in {"asc", "desc"}:
        raise TrioctlError("--order must be asc or desc")
    client = _session_client(getattr(args, "base_url", None))
    try:
        result = client.get_items(
            args.session_id,
            limit=args.limit,
            order=args.order,
        )
    except broker_http.BrokerHttpError as exc:
        raise TrioctlError(str(exc)) from exc
    _print_json(result)
    return 0


class OmnigentRunner:
    """Run Trio judgment roles through fresh broker sessions."""

    session_ids: dict[str, str]

    def __init__(
        self,
        repo: Path | None = None,
        *,
        broker_client: Any | None = None,
        client: Any | None = None,
        config: dict[str, Any] | None = None,
        models: dict[str, list[dict[str, Any]]] | None = None,
        base_url: str | None = None,
        timeout: float = 300.0,
        interval: float = 1.0,
    ) -> None:
        if broker_client is not None and client is not None:
            raise ValueError("provide only one broker client")
        self.repo = Path(repo or Path.cwd()).resolve()
        self._config = config
        self._models = models or {}
        self._broker_client = (
            broker_client if broker_client is not None else client
        )
        self._base_url = base_url or broker_http.DEFAULT_BASE_URL
        self._timeout = timeout
        self._interval = interval
        self.session_ids: dict[str, str] = {}

    def _load_config(self) -> dict[str, Any]:
        """Load the user profile only when the first role is dispatched."""
        if self._config is None:
            self._config = load_config(config_path())
        return self._config

    def _agent_id(self, role: str) -> str:
        """Resolve only the exact persisted Lead/Evaluator registry key."""
        path = omnigent_registry_path()
        try:
            entries = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as exc:
            raise TrioctlError(
                f"cannot read Omnigent role registry {path}: {exc}"
            ) from exc
        key = f"trio-omnigent-{role}"
        entry = entries.get(key) if isinstance(entries, dict) else None
        agent_id = entry.get("agent_id") if isinstance(entry, dict) else None
        if not isinstance(agent_id, str) or not agent_id.strip():
            raise TrioctlError(
                f"{path}: {key} is missing a non-empty agent_id"
            )
        return agent_id.strip()

    def _resolve_model(self, role: str) -> str:
        """Resolve a role through trioctl's strict, no-fallback resolver."""
        config = self._load_config()
        spec = config["roles"][role]
        provider = spec.get("provider")
        if provider in self._models:
            resolved = resolve_role(
                role,
                config,
                models=self._models[provider],
            )
        else:
            resolved = resolve_role(role, config)
        model = resolved.get("model")
        if not isinstance(model, str) or not model:
            raise TrioctlError(f"roles.{role}: resolver returned no model")
        return model

    def _prompt_path(self, role: str) -> Path:
        """Find the checked-in prompt, including from an installed trioctl."""
        relative = Path(
            "omnigent",
            "entrypoints",
            "trio-omnigent",
            "prompts",
            f"{role}.md",
        )
        source_root = Path(__file__).resolve().parent.parent
        candidates = (self.repo / relative, source_root / relative)
        for path in candidates:
            if path.is_file():
                return path
        raise TrioctlError(f"missing Omnigent prompt: {relative}")

    def _prompt(self, role: str, iteration: int, mailbox: Path) -> str:
        """Fill a role prompt without interpreting braces in its prose."""
        prompt_role = "lead" if role == "repair" else role
        template = self._prompt_path(prompt_role).read_text(encoding="utf-8")
        values = {
            "{mailbox}": str(mailbox.resolve()),
            "{iteration}": str(iteration),
            "{repo}": str(self.repo),
        }
        for placeholder, value in values.items():
            template = template.replace(placeholder, value)
        if role != "repair":
            return template.rstrip() + "\n"

        verdict_path = mailbox / "VERDICT.md"
        try:
            verdict = verdict_path.read_text(
                encoding="utf-8", errors="replace"
            ).strip()
        except OSError as exc:
            raise TrioctlError(
                f"cannot read repair verdict {verdict_path}: {exc}"
            ) from exc
        scope_note = next(
            (line for line in verdict.splitlines() if line.strip()),
            "VERDICT.md has no scope line",
        )
        return (
            template.rstrip()
            + "\n\n## Scoped repair\n"
            + f"Read `{verdict_path}` and fix only its listed scope.\n"
            + f"Scope note: {scope_note}\n"
            + f"Append `- iter {iteration} | repair | <one-line summary>` "
            "to LOG.md for this repair.\n"
        )

    def _client(self) -> Any:
        """Reuse an injected fake or build the real HTTP client once."""
        if self._broker_client is None:
            self._broker_client = _session_client(self._base_url)
        return self._broker_client

    @staticmethod
    def _create(
        client: Any,
        agent_id: str,
        model: str,
        prompt: str,
        title: str,
    ) -> Any:
        """Call the checked-in client seam or a small test double."""
        method = getattr(client, "create_session", None) or getattr(
            client, "create", None
        )
        if method is None:
            raise TrioctlError("broker client has no session-create method")
        return method(agent_id, model, prompt, title)

    def _wait(self, client: Any, session_id: str) -> Any:
        """Wait through a fake seam or poll the real broker session."""
        method = getattr(client, "wait_session", None) or getattr(
            client, "wait", None
        )
        if method is not None:
            try:
                return method(
                    session_id,
                    timeout=self._timeout,
                    interval=self._interval,
                )
            except TypeError:
                return method(session_id)

        deadline = time.monotonic() + self._timeout
        while True:
            get_session = getattr(client, "get_session", None)
            if get_session is None:
                raise TrioctlError("broker client has no session-wait method")
            snapshot = get_session(session_id)
            if _session_status(snapshot) in SESSION_TERMINAL_STATUSES:
                return snapshot
            if time.monotonic() >= deadline:
                raise TrioctlError(
                    f"session {session_id} timed out after "
                    f"{self._timeout:g} seconds"
                )
            time.sleep(self._interval)

    @staticmethod
    def _read(client: Any, session_id: str) -> Any:
        """Read committed session items before returning to the loop driver."""
        method = (
            getattr(client, "get_items", None)
            or getattr(client, "read_session", None)
            or getattr(client, "read", None)
        )
        if method is None:
            raise TrioctlError("broker client has no session-read method")
        return method(session_id)

    @staticmethod
    def _session_id(created: Any) -> str | None:
        if isinstance(created, dict):
            value = created.get("id") or created.get("session_id")
            return value if isinstance(value, str) and value else None
        return created if isinstance(created, str) and created else None

    def run(self, role: str, iteration: int, mailbox: Path) -> int:
        """Create, await, and read one Lead, Evaluator, or repair session."""
        if role not in {"lead", "evaluator", "repair"}:
            raise TrioctlError(f"unknown Omnigent loop role: {role}")
        mailbox = Path(mailbox).resolve()
        registered_role = "lead" if role == "repair" else role
        agent_id = self._agent_id(registered_role)
        model = self._resolve_model(registered_role)
        prompt = self._prompt(role, iteration, mailbox)
        title = f"trioctl {mailbox.name} iteration {iteration} {role}"
        client = self._client()
        try:
            created = self._create(
                client,
                agent_id,
                model,
                prompt,
                title,
            )
            session_id = self._session_id(created)
            if session_id is None:
                raise TrioctlError("session create response has no session id")
            self.session_ids[role] = session_id
            snapshot = self._wait(client, session_id)
            self._read(client, session_id)
        except broker_http.BrokerHttpError as exc:
            raise TrioctlError(str(exc)) from exc
        if _session_status(snapshot) in {"failed", "error"}:
            return 1
        return 0


def _load_trio_loop(repo: Path) -> Any:
    """Load loop-core by path so the ``omnigent`` directory is not a package."""
    path = repo / "metrics" / "trio_loop.py"
    if not path.is_file():
        raise TrioctlError(f"loop core is missing: {path}")
    loader = importlib.machinery.SourceFileLoader("trio_loop", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None or spec.loader is None:
        raise TrioctlError(f"cannot load loop core from {path}")
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    if not callable(getattr(module, "run_loop", None)):
        raise TrioctlError(f"{path} does not expose run_loop")
    return module


def command_loop(args: argparse.Namespace) -> int:
    """Run loop-core with the Omnigent role runner."""
    repo = Path.cwd().resolve()
    mailbox = Path(args.mailbox).expanduser()
    if not mailbox.is_absolute():
        mailbox = repo / mailbox
    mailbox = mailbox.resolve()
    mailbox.mkdir(parents=True, exist_ok=True)
    loop_core = _load_trio_loop(repo)
    runner = OmnigentRunner(
        repo=repo,
        base_url=getattr(args, "base_url", None),
    )
    return loop_core.run_loop(
        mailbox,
        args.max_iterations,
        runner,
        repo=repo,
    )


def omnigent_registry_path() -> Path:
    """Return the existing user-owned role registry path."""
    return (
        Path(os.environ.get("OMNIGENT_HOME", str(Path.home() / ".omnigent")))
        / "agents"
        / "trio-omnigent-roles"
        / "registry.json"
    )


def _scout_agent_id(entries: object) -> str | None:
    """Read a scout registration from either supported registry key."""
    if not isinstance(entries, dict):
        return None
    for key in ("trio-omnigent-scout", "scout"):
        entry = entries.get(key)
        if isinstance(entry, str) and entry.strip():
            return entry.strip()
        if isinstance(entry, dict):
            for field in ("agent_id", "agentId", "id"):
                value = entry.get(field)
                if isinstance(value, str) and value.strip():
                    return value.strip()
    return None


def check_live_session(
    config: dict[str, Any] | None,
    catalogs: dict[str, list[dict[str, Any]]],
    base_url: str,
) -> dict[str, Any]:
    """Probe session creation, snapshot, and item retrieval on demand."""
    path = omnigent_registry_path()
    if config is None:
        return {
            "check": "omnigent:session-api",
            "ok": False,
            "detail": "cannot resolve scout model because config is invalid",
        }
    try:
        entries = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        return {
            "check": "omnigent:session-api",
            "ok": False,
            "detail": f"scout agent registry unavailable at {path}: {exc}",
        }
    agent_id = _scout_agent_id(entries)
    if not agent_id:
        return {
            "check": "omnigent:session-api",
            "ok": False,
            "detail": (
                f"no scout agent_id in {path}; register a scout agent "
                "before using --live-session"
            ),
        }

    try:
        provider = config["roles"]["scout"].get("provider")
        resolved = resolve_role(
            "scout",
            config,
            models=catalogs.get(provider, []),
        )
        client = _session_client(base_url)
        created = client.create_session(
            agent_id,
            resolved["model"],
            "Reply with the single word pong and stop.",
            "trioctl doctor",
        )
        if not isinstance(created, dict):
            raise TrioctlError("session create returned a non-object response")
        session_id = created.get("id") or created.get("session_id")
        if not isinstance(session_id, str) or not session_id:
            raise TrioctlError("session create response has no session id")
        snapshot = client.get_session(session_id)
        items = client.get_items(session_id)
        if isinstance(items, dict) and isinstance(items.get("items"), list):
            item_count = len(items["items"])
        elif isinstance(items, list):
            item_count = len(items)
        else:
            item_count = "received"
        status = _session_status(snapshot) or "unknown"
        return {
            "check": "omnigent:session-api",
            "ok": True,
            "detail": (
                f"{session_id}: status={status}, items={item_count}, "
                f"model={resolved['model']}"
            ),
        }
    except (TrioctlError, broker_http.BrokerHttpError) as exc:
        return {
            "check": "omnigent:session-api",
            "ok": False,
            "detail": str(exc),
        }


def command_doctor(args: argparse.Namespace) -> int:
    path = config_path(args.config)
    checks: list[dict[str, Any]] = []
    try:
        config = load_config(path)
    except TrioctlError as exc:
        config = None
        checks.append({"check": "config", "ok": False, "detail": str(exc)})
    else:
        checks.append({"check": "config", "ok": True, "detail": str(path)})

    providers = {
        spec.get("provider")
        for spec in (config or {}).get("roles", {}).values()
        if isinstance(spec, dict)
    }
    required_commands = {"omnigent"}
    required_commands.update(
        {"claude" if provider == "claude" else provider for provider in providers}
    )
    if "cursor" in required_commands:
        required_commands.remove("cursor")
        required_commands.add("cursor-agent")
    for command in sorted(required_commands):
        found = shutil.which(command)
        checks.append(
            {
                "check": f"command:{command}",
                "ok": found is not None,
                "detail": found or "not on PATH",
            }
        )
    try:
        detail = omnigent_contract()
        checks.append(
            {"check": "omnigent:session-contract", "ok": True, "detail": detail}
        )
    except TrioctlError as exc:
        checks.append(
            {
                "check": "omnigent:session-contract",
                "ok": False,
                "detail": str(exc),
            }
        )

    checks.append(check_cursor_approval_mode())

    catalogs: dict[str, list[dict[str, Any]]] = {}
    for provider, loader in (("codex", codex_models), ("cursor", cursor_models)):
        if provider not in providers:
            continue
        try:
            catalogs[provider] = loader(args.timeout)
            checks.append(
                {
                    "check": f"{provider}:model/list",
                    "ok": True,
                    "detail": f"{len(catalogs[provider])} available models",
                }
            )
        except TrioctlError as exc:
            checks.append(
                {"check": f"{provider}:model/list", "ok": False, "detail": str(exc)}
            )

    if config is not None:
        for role in ROLES:
            try:
                resolved = resolve_role(
                    role,
                    config,
                    models=catalogs.get(config["roles"][role].get("provider"), []),
                )
                effort = resolved.get("reasoning_effort") or resolved.get(
                    "model_effort"
                )
                checks.append(
                    {
                        "check": f"role:{role}",
                        "ok": True,
                        "detail": (
                            f"{resolved['model']} / {effort} ({resolved['source']})"
                        ),
                    }
                )
            except TrioctlError as exc:
                checks.append(
                    {"check": f"role:{role}", "ok": False, "detail": str(exc)}
                )

    registry = omnigent_registry_path()
    try:
        entries = json.loads(registry.read_text())
        if entries.get("_profile") != REGISTRY_PROFILE:
            raise TrioctlError(
                "registered role profile is stale; back up registry.json and "
                "re-register Lead/Evaluator from the current role configs"
            )
        # Only the two orchestration roles are durable Omnigent agents. Cursor
        # workers are ephemeral headless CLI runs, avoiding cursor-native's
        # one-chat-per-workspace transcript ownership collision.
        expected = {"trio-omnigent-lead", "trio-omnigent-evaluator"}
        missing = sorted(expected - set(entries))
        if missing:
            raise TrioctlError(f"missing: {', '.join(missing)}")
        obsolete = sorted(
            {"trio-omnigent-builder", "trio-omnigent-scout"} & set(entries)
        )
        if obsolete:
            raise TrioctlError(
                "obsolete persistent Cursor roles: "
                f"{', '.join(obsolete)}; remove them and restart Omnigent once"
            )
        checks.append({"check": "registry", "ok": True, "detail": str(registry)})
    except (OSError, json.JSONDecodeError, TypeError, TrioctlError) as exc:
        checks.append({"check": "registry", "ok": False, "detail": str(exc)})

    if getattr(args, "live_session", False):
        checks.append(
            check_live_session(
                config,
                catalogs,
                getattr(args, "base_url", broker_http.DEFAULT_BASE_URL),
            )
        )

    if args.json:
        print(
            json.dumps(
                {"ok": all(item["ok"] for item in checks), "checks": checks}, indent=2
            )
        )
    else:
        for item in checks:
            status = item.get("status") or ("PASS" if item["ok"] else "FAIL")
            print(f"{status} {item['check']}: {item['detail']}")
    return 0 if all(item["ok"] for item in checks) else 1


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(prog="trioctl")
    root.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    products = root.add_subparsers(dest="product", required=True)
    omni = products.add_parser("omnigent", help="manage the Omnigent Trio profile")
    commands = omni.add_subparsers(dest="command", required=True)

    configure = commands.add_parser(
        "configure", help="install the default user profile"
    )
    configure.add_argument("--config")
    configure.add_argument("--force", action="store_true")
    configure.set_defaults(func=command_configure)

    models = commands.add_parser(
        "models", help="query provider CLI live model catalogs"
    )
    models.add_argument(
        "--provider", choices=("all", "codex", "cursor"), default="cursor"
    )
    models.add_argument("--json", action="store_true")
    models.add_argument("--timeout", type=float, default=15.0)
    models.set_defaults(func=command_models)

    resolve = commands.add_parser("resolve", help="resolve one role's runtime model")
    resolve.add_argument("role", choices=ROLES)
    resolve.add_argument("--config")
    resolve.add_argument("--json", action="store_true")
    resolve.add_argument("--allow-fallback", action="store_true")
    resolve.set_defaults(func=command_resolve)

    run = commands.add_parser(
        "run", help="run one profile-resolved headless Cursor worker"
    )
    run.add_argument("role", choices=CURSOR_WORKER_ROLES)
    run.add_argument("--config")
    run.add_argument(
        "--prompt-file",
        default="-",
        help="task prompt file, or - to read stdin (default)",
    )
    run.add_argument("--workspace", default=".")
    run.add_argument("--timeout", type=float)
    run.set_defaults(func=command_run)

    loop = commands.add_parser(
        "loop",
        help="run loop-core with Omnigent Lead and Evaluator sessions",
    )
    loop.add_argument("--mailbox", type=Path, default=Path("loop"))
    loop.add_argument("--max-iterations", type=int, default=10)
    loop.add_argument(
        "--base-url",
        default=broker_http.DEFAULT_BASE_URL,
    )
    loop.set_defaults(func=command_loop)

    session = commands.add_parser(
        "session",
        help="create, wait for, or read one broker session",
    )
    session_commands = session.add_subparsers(
        dest="session_command",
        required=True,
    )

    session_create = session_commands.add_parser(
        "create",
        help="create one broker session",
    )
    session_create.add_argument("--agent-id", required=True)
    session_create.add_argument("--model", required=True)
    session_create.add_argument("--message", required=True)
    session_create.add_argument("--title")
    session_create.add_argument(
        "--base-url",
        default=broker_http.DEFAULT_BASE_URL,
    )
    session_create.set_defaults(func=command_session_create)

    session_wait = session_commands.add_parser(
        "wait",
        help="wait for a broker session to finish",
    )
    session_wait.add_argument("session_id")
    session_wait.add_argument("--timeout", type=float, default=300.0)
    session_wait.add_argument("--interval", type=float, default=1.0)
    session_wait.add_argument(
        "--base-url",
        default=broker_http.DEFAULT_BASE_URL,
    )
    session_wait.set_defaults(func=command_session_wait)

    session_read = session_commands.add_parser(
        "read",
        help="read a broker session's committed items",
    )
    session_read.add_argument("session_id")
    session_read.add_argument("--limit", type=int, default=100)
    session_read.add_argument("--order", choices=("asc", "desc"), default="asc")
    session_read.add_argument(
        "--base-url",
        default=broker_http.DEFAULT_BASE_URL,
    )
    session_read.set_defaults(func=command_session_read)

    doctor = commands.add_parser(
        "doctor", help="validate commands, models, and registry"
    )
    doctor.add_argument("--config")
    doctor.add_argument("--json", action="store_true")
    doctor.add_argument("--timeout", type=float, default=15.0)
    doctor.add_argument("--live-session", action="store_true")
    doctor.add_argument(
        "--base-url",
        default=broker_http.DEFAULT_BASE_URL,
    )
    doctor.set_defaults(func=command_doctor)

    fix_approval_mode = commands.add_parser(
        "fix-approval-mode",
        help='set the Cursor CLI to approvalMode="unrestricted"',
    )
    fix_approval_mode.set_defaults(func=command_fix_approval_mode)
    return root


def main() -> int:
    args = parser().parse_args()
    try:
        return args.func(args)
    except TrioctlError as exc:
        print(f"trioctl: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
