IDLE_DWELL_SLICE_EVAL_ENV = "TRIO_OMNIGENT_IDLE_DWELL_SLICE_EVAL"
DEFAULT_IDLE_DWELL = 30.0


def _idle_dwell(kind: str | None = None) -> float:
    """Seconds a live session must stay idle before its turn counts as done.

    ``TRIO_OMNIGENT_IDLE_DWELL`` (default 30 s) applies to every role. For
    open-loop slice-evals only, ``TRIO_OMNIGENT_IDLE_DWELL_SLICE_EVAL``
    overrides it (unset: the same value), so a qualification run can try a
    shorter slice-eval dwell without touching Lead / repair /
    integration-eval behavior. Invalid, non-finite or negative values are
    ignored (fall back one level). Read `_wait_for_session` before
    lowering either.
    """
    base = broker_http._env_float(IDLE_DWELL_ENV, DEFAULT_IDLE_DWELL)
    if base < 0:
        base = DEFAULT_IDLE_DWELL
    if kind == "slice-eval":
        override = broker_http._env_float(IDLE_DWELL_SLICE_EVAL_ENV, -1.0)
        if override >= 0:
            return override
    return base


