    loop.add_argument(
        "--completion-receipts",
        action="store_true",
        help=(
            "opt-in (default off; only once the Omnigent server and runner "
            "implement the completion-receipt contract): create role "
            "sessions with the receipt opt-in label, add a per-dispatch "
            "prompt nonce and save dispatch provenance under "
            "<mailbox>/.sessions, so a later hold can be reconciled"
