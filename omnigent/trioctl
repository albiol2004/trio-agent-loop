ROOT_TURN_LOCK_DIR_ENV = "TRIO_ROOT_TURN_LOCK_DIR"
ROOT_TURN_POLL_ENV = "TRIO_ROOT_TURN_POLL_S"
ROOT_TURN_PROGRESS_ENV = "TRIO_ROOT_TURN_PROGRESS_S"
DEFAULT_ROOT_TURN_PROGRESS = 60.0
ROOT_STRANGER_WAIT_ENV = "TRIO_ROOT_STRANGER_WAIT_S"
DEFAULT_ROOT_STRANGER_WAIT = 300.0
