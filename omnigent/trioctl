    return value if value >= 0 else default


def _root_turn_lock_dir() -> Path:
    """Per-user dir (sibling of `cwd-locks/`): one lock file per aggregate root."""
    env = os.environ.get(ROOT_TURN_LOCK_DIR_ENV, "").strip()
    if env:
        return Path(env).expanduser()
    state = os.environ.get("XDG_STATE_HOME", "").strip()
    base = Path(state) if state else Path.home() / ".local" / "state"
    return base / "trio-agent-loop" / "root-turn"


def _root_turn_path(root: str | Path) -> Path:
    key = hashlib.sha256(os.path.realpath(str(root)).encode("utf-8")).hexdigest()[:24]
    return _root_turn_lock_dir() / f"{key}.lock"


def _read_root_turn_holder(path: Path) -> dict[str, Any] | None:
    """The holder record of a root-turn lock file (line 2, JSON), or None."""
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
        record = json.loads(lines[1]) if len(lines) > 1 else None
    except (OSError, ValueError):
        return None
    return record if isinstance(record, dict) else None


def _describe_root_holder(holder: dict[str, Any] | None) -> str:
    if not holder:
        return "an unknown holder"
    who = holder.get("mailbox") or "one-shot"
    since = holder.get("since")
    when = (
        time.strftime("%H:%M:%S", time.localtime(float(since)))
        if isinstance(since, (int, float)) else "?"
    )
    return f"{who} {holder.get('role') or '?'} (pid {holder.get('pid')}, since {when})"


class _RootTurnLock:
    """One acquisition of the per-root turn lock (see ROOT_TURN_WAIT_ENV).

    Same flock pattern as :class:`_SameCwdGate`: line 1 ``"<pid> <root>"``
    (so :func:`_prune_same_cwd_locks` prunes files of vanished roots), line
    2 the JSON holder record, rewritten under the lock; the locked inode is
    re-checked after every acquisition.
    """

    def __init__(self, root: str | Path, *, who: dict[str, Any]) -> None:
        self.root = os.path.realpath(str(root))
        self.who = dict(who)
        self.path = _root_turn_path(self.root)
        self._fh: Any = None
        self.contended = False

    def holder(self) -> dict[str, Any] | None:
        return _read_root_turn_holder(self.path)

    def held_by_other(self) -> bool:
        """Whether some description (another holder) holds the flock now."""
        import fcntl

        try:
            with open(self.path, "a+", encoding="utf-8") as fh:
                try:
                    fcntl.flock(fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                except BlockingIOError:
                    return True
                return False
        except OSError:
            return False

    def acquire(self, max_wait: float, *, label: str = "") -> float:
        """Take the lock (bounded); returns the seconds waited.

        Raises :class:`RootBusyError` naming the holder after *max_wait*.
        Prints one line when it starts waiting and one per progress period.
        """
        import fcntl

        self.path.parent.mkdir(parents=True, exist_ok=True)
        poll = _env_seconds(ROOT_TURN_POLL_ENV, 0.5) or 0.5
        every = _env_seconds(ROOT_TURN_PROGRESS_ENV, DEFAULT_ROOT_TURN_PROGRESS) or 60.0
        start = time.monotonic()
        next_note = start
        fh = open(self.path, "a+", encoding="utf-8")
        while True:
            try:
                fcntl.flock(fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                if _same_lock_inode(fh, self.path):
                    break
                fh.close()  # pruned while we queued: re-open the path
                fh = open(self.path, "a+", encoding="utf-8")
                continue
            except BlockingIOError:
                self.contended = True
            except OSError:
                fh.close()
                raise
            waited = time.monotonic() - start
            if waited >= max_wait:
                fh.close()
                raise RootBusyError(
                    f"root turn at {self.root} is still held by "
                    f"{_describe_root_holder(self.holder())} after {waited:.0f}s "
                    f"(bound {max_wait:.0f}s, {ROOT_TURN_WAIT_ENV}/"
                    f"{ROOT_TURN_ONESHOT_WAIT_ENV}); {label or 'dispatch'} not started"
                )
            if time.monotonic() >= next_note:
                print(
                    f"trioctl: root turn at {self.root} held by "
                    f"{_describe_root_holder(self.holder())} "
                    f"(waited {waited:.0f}s/<={max_wait:.0f}s)"
                    + (f"; {label} waits" if label else ""),
                    file=sys.stderr,
                )
                next_note = time.monotonic() + every
            time.sleep(poll)
        waited = time.monotonic() - start
        record = {
            "pid": os.getpid(),
            "pid_start": (
                worker_worktrees.process_identity(os.getpid()).get("start")
                if worker_worktrees is not None else None
            ),
            "since": time.time(),
            "argv0": Path(sys.argv[0]).name if sys.argv and sys.argv[0] else "",
            "root": self.root,
            **self.who,
        }
        try:
            fh.seek(0)
            fh.truncate()
            fh.write(f"{os.getpid()} {self.root}\n{json.dumps(record, sort_keys=True)}\n")
            fh.flush()
        except OSError:
            pass
        self._fh = fh
        return waited

    def release(self) -> None:
        fh, self._fh = self._fh, None
        if fh is not None:
            try:
                fh.close()  # closing the description drops the flock
            except OSError:
                pass

    @property
    def held(self) -> bool:
        return self._fh is not None


#: Process-wide root turns: {lock path: {lock, count, mutex}}. A trioctl
#: process holds each root's flock at most once; its dispatches (the Lead,
#: its degraded slice-eval, the next Lead after a sticky evaluator) share it.
_ROOT_TURNS: dict[str, dict[str, Any]] = {}
_ROOT_TURNS_GUARD = threading.Lock()


def _root_turn_slot(key: str) -> dict[str, Any]:
    with _ROOT_TURNS_GUARD:
        return _ROOT_TURNS.setdefault(
            key, {"lock": None, "count": 0, "mutex": threading.Lock()}
        )


#: Unified live-loop registry schema (r16-rc: r15.x `loops/<slug>-<pid>.json`
#: and r16a `loops/<slug>.json` merged into one record, one writer).
LOOP_REGISTRY_SCHEMA = 1
_REGISTRY_SLUG_RE = re.compile(r"[^A-Za-z0-9_-]+")


def _registry_slug(mailbox_rel: str) -> str:
    """Same as `root_free.loop_slug` / `trio-metrics.py:loop_slug` (byte-identical)."""
    text = str(mailbox_rel).strip().strip("/").replace("/", "--")
    return (_REGISTRY_SLUG_RE.sub("-", text).strip("-") or "loop")[:120]


def _repo_identity(path: Path | str) -> str:
    """The repository *path* belongs to, as its main checkout's realpath.

    Every worktree of one repository (the root, a Lead worktree, a declared
    aggregate) maps to the same key, so `writes:` overlap is compared per
    repository whatever mode (root-bound, lockstep, root-free) a loop runs in.
    """
    real = os.path.realpath(str(path))
    try:
        proc = subprocess.run(
            ["git", "-C", real, "rev-parse", "--path-format=absolute", "--git-common-dir"],
            capture_output=True, text=True, timeout=30,
        )
    except (OSError, subprocess.SubprocessError):
        return real
    common = proc.stdout.strip()
    if proc.returncode != 0 or not common:
        return real
    common = os.path.realpath(common)
    return os.path.dirname(common) if os.path.basename(common) == ".git" else common


def aggregate_for(mailbox: Path, repo_name: str | None, home: Path) -> Path:
    """The aggregate checkout of *repo_name* for *mailbox*.

    A live root-free loop's registry record names its aggregates (the Lead
    worktree for home, a `trio/<slug>` worktree per declared repo); every
    other loop works in the home root and the declared clones' own paths.
    """
    name = repo_name if repo_name and repo_name != "." else "home"
    entry = _registry_entry_of(mailbox, home)
    aggregates = (entry or {}).get("aggregates") or {}
    if isinstance(aggregates, dict) and aggregates.get(name):
        return Path(str(aggregates[name]))
    if name == "home":
        return Path(home)
    declared = _declared_repos(mailbox).get(name)
    return Path(declared["path"]) if declared else Path(home)


def _loop_registry_dir(root: Path) -> Path | None:
    """``<git common dir>/trio-worktrees/loops`` of *root*, or None (no git)."""
    if worker_worktrees is None:
        return None
    try:
        return worker_worktrees.ledger_dir(Path(root)) / LOOP_REGISTRY_DIR
    except Exception:  # noqa: BLE001 - not a git checkout: no registry
        return None


def _loop_writes(mailbox: Path, root: Path) -> dict[str, list[str]]:
    """``{repository identity: [writes...]}`` of *mailbox*'s PLAN.md slices."""
    out: dict[str, list[str]] = {}
    try:
        names = ["home", *_declared_repos(mailbox)]
        for name in names:
            writes = _repo_declared_writes(mailbox, name)
            if writes:
                key = _repo_identity(aggregate_for(mailbox, name, root))
                out.setdefault(key, []).extend(writes)
    except Exception:  # noqa: BLE001 - an unparseable PLAN declares nothing
        if worker_worktrees is not None:
            writes = worker_worktrees.declared_product_paths(mailbox)
            if writes:
                out[_repo_identity(root)] = writes
    return out


def _registry_records(root: Path) -> list[dict[str, Any]]:
    """Every readable record in *root*'s registry (live or not), with `_path`."""
    directory = _loop_registry_dir(root)
    if directory is None or not directory.is_dir():
        return []
    out: list[dict[str, Any]] = []
    for path in sorted(directory.glob("*.json")):
        try:
            entry = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        if isinstance(entry, dict):
            entry["_path"] = str(path)
            out.append(entry)
    return out


def _registry_alive(entry: dict[str, Any]) -> bool:
    return bool(worker_worktrees is not None and worker_worktrees.identity_alive(
        {"pid": entry.get("pid"), "start": entry.get("pid_start")}
    ))


def _live_loops(
    root: Path,
    *,
    exclude_mailbox: Path | None = None,
    any_root: bool = False,
    root_bound_only: bool = False,
) -> list[dict[str, Any]]:
    """Registered live `omnigent loop` drivers of *root*'s repository.

    By default only loops whose aggregate root is *root* itself (the
    root-turn users); ``any_root`` returns every live loop of the
    repository (root-free Lead worktrees included); ``root_bound_only``
    drops root-free loops (they never take the root turn).
    """
    here = os.path.realpath(str(root))
    skip = os.path.realpath(str(exclude_mailbox)) if exclude_mailbox else None
    live: list[dict[str, Any]] = []
    for entry in _registry_records(root):
        if not any_root and entry.get("root") != here:
            continue
        if root_bound_only and entry.get("mode") == "root-free":
            continue
        if not _registry_alive(entry):
            continue
        if skip and skip in {
            os.path.realpath(str(entry.get(key)))
            for key in ("mailbox", "live_mailbox") if entry.get(key)
        }:
            continue
        live.append(entry)
    return live


def _registry_entry_of(mailbox: Path, home: Path | None = None) -> dict[str, Any] | None:
    """The live registry record whose root or live mailbox is *mailbox*."""
    if worker_worktrees is None:
        return None
    target = os.path.realpath(str(mailbox))
    try:
        base = Path(home) if home is not None else Path(mailbox)
        records = _live_loops(base if base.exists() else Path(mailbox), any_root=True)
    except Exception:  # noqa: BLE001 - no registry: no record
        return None
    for entry in records:
        if target in {
            os.path.realpath(str(entry.get(key)))
            for key in ("mailbox", "live_mailbox") if entry.get(key)
        }:
            return entry
    return None


def _live_driver_of(home: Path, mailbox_rel: str) -> dict[str, Any] | None:
    """The live driver record of the loop *mailbox_rel* in *home*'s repository."""
    for entry in _live_loops(home, any_root=True):
        if entry.get("mailbox_rel") == mailbox_rel or entry.get("slug") == _registry_slug(
            mailbox_rel
        ):
            return entry
    return None


def _writes_overlaps(mine: dict[str, list[str]], theirs: dict[str, list[str]]) -> list[str]:
    """``"<a> overlaps <b>"`` for every pair covering each other (per repo)."""
    covered = worker_worktrees._covered
    pairs: list[str] = []
    for repo_key, paths in mine.items():
        other = theirs.get(repo_key) or []
        for a in paths:
            for b in other:
                if covered(a, [b]) or covered(b, [a]):
                    item = f"{a} overlaps {b}" if a != b else a
                    if len(mine) > 1:
                        item += f" (repo {repo_key})"
                    if item not in pairs:
                        pairs.append(item)
    return pairs


def _writes_overlap_problems(root: Path, mailbox: Path) -> list[str]:
    """One line per live loop of *root*'s repository whose `writes:` overlap
    *mailbox*'s -- root-bound, lockstep and root-free loops alike."""
    mine = _loop_writes(mailbox, root)
    if not mine:
        return []
    problems: list[str] = []
    for entry in _live_loops(root, exclude_mailbox=mailbox, any_root=True):
        other_box = Path(str(entry.get("live_mailbox") or entry.get("mailbox")))
        shown = Path(str(entry.get("mailbox") or other_box))
        theirs = _loop_writes(other_box, root) if other_box.is_dir() else (
            entry.get("writes_by_repo") or {}
        )
        pairs = _writes_overlaps(mine, theirs)
        if pairs:
            problems.append(
                f"writes overlap with live loop {shown} (pid {entry.get('pid')}) "
                f"in {root}: {', '.join(pairs)}"
            )
    return problems


def _allow_overlapping_loops(args: Any = None) -> bool:
    if getattr(args, "allow_overlapping_writes", False):
        return True
    return os.environ.get(ALLOW_OVERLAPPING_LOOPS_ENV, "").strip() in ("1", "true", "yes")


class _LoopRegistration:
    """This driver's live-loop registry record -- the ONE writer.

    ``<git common dir>/trio-worktrees/loops/<slug>.json`` (slug of the root
    mailbox path, as the r16 Lead worktree record), written while a
    `trioctl omnigent loop` driver runs, in every mode. Keys (schema 1):
    ``schema``, ``slug``, ``mode`` (``root-bound`` | ``lockstep`` |
    ``root-free``), ``root`` (the repository root this loop belongs to),
    ``mailbox`` (the root mailbox), ``mailbox_rel``, ``live_mailbox`` (where
    the driver reads/writes it: the root mailbox, or the Lead worktree's copy),
    ``lead_worktree``/``branch``/``target_ref`` (root-free; else null),
    ``aggregates`` (``{repo name: aggregate checkout}``), ``pid``,
    ``pid_start``, ``started_at``, ``writes_by_repo`` (``{repository
    identity: [writes]}``, see `_repo_identity`).
    """

    def __init__(
        self,
        root: Path,
        mailbox: Path,
        *,
        root_free_info: dict[str, Any] | None = None,
        live_mailbox: Path | None = None,
        mode: str | None = None,
    ) -> None:
        self.root = Path(os.path.realpath(str(root)))
        self.mailbox = Path(mailbox)
        self.live_mailbox = Path(live_mailbox) if live_mailbox is not None else self.mailbox
        self.info = dict(root_free_info or {})
        self.mode = mode or ("root-free" if root_free_info else "root-bound")
        self.path: Path | None = None

    def rel(self) -> str:
        try:
            return Path(os.path.realpath(str(self.mailbox))).relative_to(self.root).as_posix()
        except ValueError:
            return self.mailbox.name

    def file(self) -> Path | None:
        directory = _loop_registry_dir(self.root)
        if directory is None:
            return None
        return directory / f"{_registry_slug(self.rel())}.json"

    def entry(self) -> dict[str, Any]:
        rel = self.rel()
        ident = worker_worktrees.process_identity(os.getpid())
        aggregates: dict[str, str] = {}
        if self.mode == "root-free":
            aggregates["home"] = str(self.info.get("lead") or "")
            for name, info in (self.info.get("repo_aggregates") or {}).items():
                aggregates[name] = str(info)
        else:
            aggregates["home"] = str(self.root)
            for name, declared in _declared_repos(self.live_mailbox).items():
                aggregates[name] = str(declared["path"])
        return {
            "schema": LOOP_REGISTRY_SCHEMA,
            "slug": _registry_slug(rel),
            "mode": self.mode,
            "root": str(self.root),
            "mailbox": str(self.mailbox),
            "mailbox_rel": rel,
            "live_mailbox": str(self.live_mailbox),
            "lead_worktree": self.info.get("lead"),
            "branch": self.info.get("branch"),
            "target_ref": self.info.get("target"),
            "aggregates": aggregates,
            "pid": ident["pid"],
            "pid_start": ident["start"],
            "started_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
            "writes_by_repo": _loop_writes(self.live_mailbox, self.root),
        }

    def register(self) -> None:
        path = self.file()
        if path is None:
            return
        try:
            path.parent.mkdir(parents=True, exist_ok=True)
            tmp = path.parent / f".{path.name}.tmp-{os.getpid()}"
            tmp.write_text(json.dumps(self.entry(), indent=2, sort_keys=True) + "\n",
                           encoding="utf-8")
            os.replace(tmp, path)
            self.path = path
        except OSError as exc:
            print(f"trioctl: could not register live loop: {exc}", file=sys.stderr)

    def unregister(self) -> None:
        """Remove the record -- only while this process still owns it."""
        path, self.path = self.path, None
        if path is None:
            return
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            data = {}
        if isinstance(data, dict) and data.get("pid") not in (None, os.getpid()):
            return
        try:
            path.unlink()
        except OSError:
            pass


@contextlib.contextmanager
def _loop_registry_guard(root: Path) -> Iterator[None]:
    """Serialise overlap check + registration across starting drivers."""
    import fcntl

    directory = _loop_registry_dir(root)
    if directory is None:
        yield
        return
    try:
        directory.mkdir(parents=True, exist_ok=True)
        fh = open(directory / ".registry.lock", "a+", encoding="utf-8")
    except OSError:
        yield
        return
    try:
        fcntl.flock(fh.fileno(), fcntl.LOCK_EX)
        yield
    finally:
        fh.close()


def _set_state_reason(state_path: Path, reason: str | None) -> None:
    """Set (or with None drop) STATE.md's `reason:` line; other lines untouched."""
    try:
        lines = state_path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return
    pattern = re.compile(r"^\s*(?:-\s+)?reason\s*:", re.IGNORECASE)
    kept = [line for line in lines if not pattern.match(line)]
    if reason is not None:
        kept.append(f"reason: {reason}")
    if kept != lines:
        state_path.write_text("\n".join(kept) + ("\n" if kept else ""), encoding="utf-8")


#: STATE.md `reason:` values this driver writes (cleared again on resume).
DRIVER_STOP_REASONS = ("root-occupied", "writes-overlap", "driver-exception")


def _one_shot_root_turn(args: Any, workspace: Path) -> "_RootTurnLock | None":
    """A non-isolated one-shot's root turn (None = no lock needed / joined).

    Taken only when *workspace*'s Cursor project root is the aggregate root
    of a live registered loop. A one-shot started from inside a root
    session (a cursor-agent at that root is its ancestor: the turn holder's
    own scouts/builders), or naming the holder's mailbox, shares that turn.
    """
    if worker_worktrees is None:
        return None
    root = worker_worktrees.cursor_project_root(workspace)
    if not (root / ".git").exists():
        return None
    root = Path(os.path.realpath(str(root)))
    if not _live_loops(root, root_bound_only=True):
        # No root-bound/lockstep loop at this root (root-free loops never
        # take the root turn): nothing to serialise with.
        return None
    parent = worker_worktrees.cursor_agent_ancestor(root)
    if parent:
        print(
            f"trioctl: one-shot inside root session (cursor-agent pid {parent}) "
            f"at {root}: shares its root turn",
            file=sys.stderr,
        )
        return None
    mailbox_arg = getattr(args, "worker_events_mailbox", None)
    mailbox = str(Path(str(mailbox_arg)).expanduser().resolve()) if mailbox_arg else None
    lock = _RootTurnLock(root, who={"mailbox": None, "role": args.role, "kind": "one-shot",
                                    "worker_mailbox": mailbox})
    holder = lock.holder() or {}
    if mailbox and holder.get("mailbox") == mailbox and lock.held_by_other():
        print(f"trioctl: one-shot for {mailbox}: shares its loop's root turn", file=sys.stderr)
        return None
    lock.acquire(
        _env_seconds(ROOT_TURN_ONESHOT_WAIT_ENV, DEFAULT_ROOT_TURN_ONESHOT_WAIT),
        label=f"one-shot {args.role}",
    )
    return lock


# Prompts of this process's dispatches, per mailbox, so a first-prompt hold
# can tell a cross-wired mirror (the only saved user row is a SIBLING
# dispatch's prompt) from a generic uncertain delivery.
_DISPATCH_PROMPTS_LOCK = threading.Lock()
_DISPATCH_PROMPTS: dict[str, dict[str, Any]] = {}


def _register_dispatch_prompt(token: str, mailbox: Path, prompt: str, meta: dict[str, Any]) -> None:
    now = time.monotonic()
    with _DISPATCH_PROMPTS_LOCK:
        for key in [k for k, v in _DISPATCH_PROMPTS.items()
                    if v.get("ended") is not None and now - v["ended"] > 3600]:
            _DISPATCH_PROMPTS.pop(key, None)
        _DISPATCH_PROMPTS[token] = {
            "mailbox": str(mailbox), "prompt": prompt, "session_id": None,
            "started": now, "ended": None, "meta": dict(meta or {}),
        }


def _dispatch_prompt_update(token: str | None, **fields: Any) -> None:
    if not token:
        return
    with _DISPATCH_PROMPTS_LOCK:
        entry = _DISPATCH_PROMPTS.get(token)
        if entry is not None:
            entry.update(fields)


def _crosswired_sibling(
    token: str | None, mailbox: Path, rows: list[str]
) -> dict[str, Any] | None:
    """The overlapping sibling dispatch whose prompt is every saved user row."""
    if not token or not rows:
        return None
    with _DISPATCH_PROMPTS_LOCK:
        mine = _DISPATCH_PROMPTS.get(token)
        if mine is None:
            return None
        siblings = [
            dict(v) for k, v in _DISPATCH_PROMPTS.items()
            if k != token and v["mailbox"] == str(mailbox)
            and (v["ended"] is None or v["ended"] >= mine["started"])
        ]
    for sibling in siblings:
        want = broker_http._prompt_text(sibling["prompt"])
        if want and all(broker_http._row_matches_prompt(r, want) for r in rows):
            return sibling
    return None


class OmnigentRunner:
    """Run Trio judgment roles through fresh broker sessions."""

    session_ids: dict[str, str]
    created_session_ids: list[str]

    def __init__(
        self,
        repo: Path | None = None,
        *,
        broker_client: Any | None = None,
        client: Any | None = None,
        config: dict[str, Any] | None = None,
        models: dict[str, list[dict[str, Any]]] | None = None,
        base_url: str | None = None,
        timeout: float = DEFAULT_LOOP_WAIT_TIMEOUT,
        interval: float = 1.0,
        runner_id: str | None = None,
        host_id: str | None = None,
        workspace: str | None = None,
        observe: dict[str, Any] | None = None,
        completion_receipts: bool = False,
        isolate_workers: dict[str, Any] | None = None,
        end_root_sessions: bool = True,
        restore_root_config: bool = False,
        root_free: dict[str, Any] | None = None,
    ) -> None:
        if broker_client is not None and client is not None:
            raise ValueError("provide only one broker client")
        self.repo = Path(repo or Path.cwd()).resolve()
        self._config = config
        self._models = models or {}
        self._broker_client = (
            broker_client if broker_client is not None else client
        )
        self._base_url = base_url or broker_http.DEFAULT_BASE_URL
        self._timeout = timeout
        self._interval = interval
        self._runner_id = runner_id
        # Dedicated host launch (default). runner_id remains an override
        # that binds an already-online runner instead of spawning one.
        self._host_id = host_id
        self._workspace = workspace or str(self.repo)
        # Opt-in `--observe-workers` run: {run_id, workers, phases,
        # trioctl}. None keeps prompts and mailbox writes unchanged.
        self._observe = observe
        # Worker isolation (default ON since r11; `--no-isolate-workers`
        # disables it): {trioctl, worktree_root}. Builders
        # get their own worktree via `run --isolate`; open-loop slice-evals
        # are bound to a detached worktree at their pinned sha.
        self._isolate = isolate_workers
        # Isolated runs end a finished root-bound evaluator's own session
        # and then undo this run's own Omnigent merges into the root's
        # project Cursor config, so the graded tree is the product alone
        # (False with --keep-sessions: the config stays, acceptance waits).
        self._end_root_sessions = end_root_sessions
        # Non-isolated loop runs (`--no-isolate-workers`, lockstep default):
        # every session's workspace is the root, so Omnigent's generated
        # `.cursor/{mcp,hooks}.json` lands there too. When set, the same
        # baseline/restore as isolated mode applies to it, without ever
        # waiting for the root before a launch (sessions may overlap).
        self._restore_root_nonisolated = bool(restore_root_config) and not isolate_workers
        # Root-bound (aggregate workspace) sessions this runner created, in
        # order; used to prove the previous one no longer owns the root's
        # project Cursor config before the root is reused.
        #
        # Ownership is recorded per dispatch (never by slicing the shared
        # created_session_ids list: open-loop runs the Lead thread and the
        # evaluator on ONE runner concurrently). Only a FINISHED root-bound
        # dispatch's own session is ever ended for root reuse; sessions of
        # in-flight dispatches (any role) are never touched.
        self._own_lock = threading.Lock()
        self._root_finished: list[dict[str, Any]] = []
        self._inflight: set[str] = set()
        # {session_id: {role, kind, slice, sha}} for in-flight dispatches.
        self._inflight_meta: dict[str, dict[str, Any]] = {}
        # Degraded (root-bound) slice-evals of THIS run still in flight:
        # {token: {slice, sha, started}}. Their cursor-agent runs at the
        # root; `_release_root` treats them as known occupants and waits
        # for them (bounded by the role timeout) instead of refusing.
        self._degraded_root_evals: dict[str, dict[str, Any]] = {}
        # Integration-fence tokens this runner holds: acquired per evaluator
        # dispatch; only tokens of FINISHED evaluator dispatches are released
        # at the next Lead/repair dispatch; all are released at loop end.
        self._fence_tokens: dict[str, bool] = {}
        # r15: fence token -> the repository whose ledger holds it (tokens
        # absent here are the home repo's).
        self._fence_repos: dict[str, Path] = {}
        # r15.x root-turn share: {key, count (this runner's holders), sticky
        # (finished root-bound evaluators still holding it with their
        # fence)}; see `_enter_root_turn` / `_root_turn_slot`.
        self._root_turn: dict[str, Any] = {"key": None, "count": 0, "sticky": 0}
        # Set when a dispatch stops the loop for a human (root-occupied,
        # writes-overlap): `_command_loop` maps it to STATE + exit code.
        self.driver_stop: dict[str, Any] | None = None
        # {root, allow}: set by `_command_loop` (live-loop registry checks).
        self.loop_registry: dict[str, Any] | None = None
        # The loop core driving this runner (set by `loop`); None = unknown.
        self.loop_core: Any = None
        # r16 root-free open-loop: {home, lead, branch, target, target_base}.
        # Every session runs in the Lead worktree (``repo``/``workspace``)
        # or a task-owned worktree; none of the root machinery below
        # (release/snapshot/restore/record) applies, and no eval ever falls
        # back to the aggregate root.
        self._root_free = root_free
        # Opt-in (default off): opt-in label, prompt nonce and dispatch
        # provenance for `omnigent reconcile`. Needs a server + runner
        # that implement the completion-receipt contract.
        self._completion_receipts = bool(
            completion_receipts and COMPLETION_RECEIPT_LABELS
        )
        # Last-dispatched session per role. Back-compat only (`.driver.json`,
        # prune, tests): with concurrent open-loop slice-evals several
        # evaluator dispatches are in flight at once, so nothing on the
        # in-flight dispatch path reads it -- each dispatch carries its own
        # session id (`dispatch["session_id"]`). Written under _own_lock.
        self.session_ids: dict[str, str] = {}
        self.created_session_ids: list[str] = []
        # First-prompt delivery uncertain: kept out of post-loop prune.
        self.held_session_ids: list[str] = []
        # Per-dispatch provenance for the held record (never inferred),
        # keyed by session id once the create returned one. Guarded by
        # _own_lock; popped when the dispatch ends.
        self._delivery: dict[str, dict[str, Any]] = {}
        # Last dispatch's nonce (back-compat); each dispatch uses its own.
        self._dispatch_nonce: str | None = None
        # Lazy client/config initialisation may race between the Lead
        # thread and slice-eval worker threads.
        self._init_lock = threading.Lock()
        # The profile this driver resolves roles from, pinned at start and
        # recorded in `.driver.json` (loop core `_driver_meta`) so workers
        # the Lead dispatches with `--mailbox` use the same profile even
        # when the Lead's shell carries a different TRIOCTL_CONFIG.
        self._config_path = config_path().expanduser().resolve()
        self.driver_meta: dict[str, Any] = (
            {"config_path": str(self._config_path)} if config is None else {}
        )
        if os.environ.get(KILL_CHECK_ENV, "").strip().lower() in ("0", "false", "off", "no"):
            # r18a: isolated builders of this loop read it back from
            # `.driver.json` (the Lead's shell may not carry the env var).
            self.driver_meta["kill_check"] = False

    def _load_config(self) -> dict[str, Any]:
        """Load the user profile only when the first role is dispatched."""
        if self._config is None:
            with self._lazy_lock():
                if self._config is None:
                    path = getattr(self, "_config_path", None) or config_path()
                    self._config = load_config(path)
        return self._config

    def _lazy_lock(self) -> Any:
        """The lazy-init lock (a no-op context for __new__-built test runners)."""
        lock = self.__dict__.get("_init_lock")
        return lock if lock is not None else contextlib.nullcontext()

    def _dict_lock(self) -> Any:
        """_own_lock (a no-op context for __new__-built test runners)."""
        lock = self.__dict__.get("_own_lock")
        return lock if lock is not None else contextlib.nullcontext()

    def inflight_sessions(self) -> dict[str, dict[str, Any]]:
        """Snapshot of in-flight dispatches that already have a session id.

        ``{session_id: {"role", "kind", "slice", "sha"}}``, taken under
        _own_lock; the open-loop driver writes it to `.driver.json`.
        """
        with self._dict_lock():
            meta = dict(self.__dict__.get("_inflight_meta") or {})
            inflight = set(self.__dict__.get("_inflight") or set())
        return {sid: dict(meta.get(sid) or {}) for sid in inflight}

    def _agent_id(self, role: str) -> str:
        """Resolve only the exact persisted Lead/Evaluator registry key."""
        path = omnigent_registry_path()
        try:
            entries = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as exc:
            raise TrioctlError(
                f"cannot read Omnigent role registry {path}: {exc}"
            ) from exc
        key = f"trio-omnigent-{role}"
        entry = entries.get(key) if isinstance(entries, dict) else None
        agent_id = entry.get("agent_id") if isinstance(entry, dict) else None
        if not isinstance(agent_id, str) or not agent_id.strip():
            raise TrioctlError(
                f"{path}: {key} is missing a non-empty agent_id"
            )
        return agent_id.strip()

    def _resolve_model(self, role: str) -> str:
        """Resolve a role through trioctl's strict, no-fallback resolver."""
        config = self._load_config()
        spec = config["roles"][role]
        provider = spec.get("provider")
        if provider in self._models:
            resolved = resolve_role(
                role,
                config,
                models=self._models[provider],
            )
        else:
            resolved = resolve_role(role, config)
        model = resolved.get("model")
        if not isinstance(model, str) or not model:
            raise TrioctlError(f"roles.{role}: resolver returned no model")
        return model

    def _prompt_path(self, role: str) -> Path:
        """Find the checked-in prompt, including from an installed trioctl.

        An installed ``trioctl`` (``~/.local/bin/trioctl``) has no source
        tree of its own, so the first two candidates below never resolve
        for it; install.sh instead writes the same prompts into the
        Claude Code and Codex skill directories, which the last two
        candidates fall back to.
        """
        filename = f"{role}.md"
        candidates = [directory / filename for directory in _omnigent_prompt_dirs(self.repo)]
        for path in candidates:
            if path.is_file():
                return path
        tried = ", ".join(str(path) for path in candidates)
        raise TrioctlError(f"missing Omnigent prompt: {filename} (tried: {tried})")

    @staticmethod
    def _open_loop_context_block(
        context: dict[str, Any],
        repos: dict[str, dict[str, Any]] | None = None,
        home: Path | None = None,
        mailbox: Path | None = None,
    ) -> str:
        """Build the OPEN-LOOP CONTEXT block prepended to open-loop prompts.

        Line 1 matches portable/driver.sh's build_prompt byte-for-byte:
        `kind=<kind>[ slice=<slice>][ sha=<sha>]`. Omnigent roles otherwise
        never see the canonical Open-loop procedure (their config.yaml is
        hand-maintained and only gets the one-paragraph description), so a
        kind-specific rendering of it is appended before the blank line
        that separates the block from the role's normal prompt.

        *repos* (r15): the mailbox's declared PLAN.md `repos:`; when given,
        the kind's multi-repo note is appended to its procedure. Without
        it (single-repo) the block is byte-identical to earlier releases.
        """
        kind = context.get("kind") or ""
        line = f"OPEN-LOOP CONTEXT: kind={kind}"
        slice_id = context.get("slice")
        if slice_id:
            line += f" slice={slice_id}"
        sha = context.get("sha")
        if sha:
            line += f" sha={sha}"
        if kind == "lead-pass":
            procedure = _OPEN_LOOP_LEAD_PASS_PROCEDURE
        elif kind == "slice-eval":
            procedure = _OPEN_LOOP_SLICE_EVAL_PROCEDURE.format(
                slice=slice_id or "<slice>", sha=sha or "<sha>"
            )
        elif kind == "integration-eval":
            procedure = _OPEN_LOOP_INTEGRATION_EVAL_PROCEDURE.format(
                sha=context.get("pinned_sha") or sha or "HEAD",
                attempt=context.get("evaluator_attempt") or "<none>",
                iteration=context.get("iteration") or "N",
            )
        else:
            procedure = ""
        if repos and procedure:
            procedure += OmnigentRunner._multi_repo_note(
                kind, context, repos, home, mailbox
            )
        if kind == "slice-eval" and context.get("quality_note"):
            # r18a: the builder run's base-revert outcome and authorship.
            procedure += str(context["quality_note"])
        queue_errors = [str(e) for e in context.get("queue_errors") or []]
        if queue_errors:
            # r11g Q1: the driver holds the integration gate while the
            # QUEUE.md `faults:` block has parse errors; the Lead never
            # reads LOG.md, so the error text rides on this block.
            line += "\n" + _open_loop_queue_errors_note(queue_errors)
        if not procedure:
            return line + "\n\n"
        return line + "\n" + procedure + "\n"

    @staticmethod
    def _multi_repo_note(
        kind: str,
        context: dict[str, Any],
        repos: dict[str, dict[str, Any]],
        home: Path | None,
        mailbox: Path | None,
    ) -> str:
        """The r15 multi-repo addendum of one OPEN-LOOP CONTEXT procedure."""
        if kind == "lead-pass":
            return _OPEN_LOOP_MULTI_REPO_LEAD_NOTE.format(
                repos="Repos:\n" + _multi_repo_listing(repos, home)
            )
        if kind == "slice-eval":
            name = str(context.get("repo") or "").strip()
            if name not in repos:
                return ""
            return _OPEN_LOOP_MULTI_REPO_SLICE_EVAL_NOTE.format(
                slice=context.get("slice") or "<slice>",
                sha=context.get("sha") or "<sha>",
                name=name,
                path=repos[name]["path"],
            )
        if kind == "integration-eval":
            pins = dict(context.get("pins") or {})
            pins.setdefault("home", str(context.get("pinned_sha") or context.get("sha") or ""))
            order = ["home", *repos]
            return _OPEN_LOOP_MULTI_REPO_INTEGRATION_NOTE.format(
                pins=_multi_repo_listing(repos, home, pins),
                evaluated=", ".join(f"{n}@{pins.get(n) or '<sha>'}" for n in order),
                iteration=context.get("iteration") or "N",
                mailbox_name=mailbox.name if mailbox is not None else "<mailbox>",
            )
        return ""

    def _prompt(
        self,
        role: str,
        iteration: int,
        mailbox: Path,
        context: dict[str, Any] | None = None,
    ) -> str:
        """Fill a role prompt without interpreting braces in its prose."""
        prompt_role = "lead" if role == "repair" else role
        template = self._prompt_path(prompt_role).read_text(encoding="utf-8")
        values = {
            "{mailbox}": str(mailbox.resolve()),
            "{iteration}": str(iteration),
            "{repo}": str(self.repo),
        }
        for placeholder, value in values.items():
            template = template.replace(placeholder, value)
        if role != "repair":
            result = template.rstrip() + "\n"
        else:
            verdict_path = mailbox / "VERDICT.md"
            try:
                verdict = verdict_path.read_text(
                    encoding="utf-8", errors="replace"
                ).strip()
            except OSError as exc:
                raise TrioctlError(
                    f"cannot read repair verdict {verdict_path}: {exc}"
                ) from exc
            scope_note = next(
                (line for line in verdict.splitlines() if line.strip()),
                "VERDICT.md has no scope line",
            )
            result = (
                template.rstrip()
                + "\n\n## Scoped repair\n"
                + f"Read `{verdict_path}` and fix only its listed scope.\n"
                + f"Scope note: {scope_note}\n"
                + f"Append `- iter {iteration} | repair | <one-line summary>` "
                "to LOG.md for this repair.\n"
            )
        if self._observe and role in ("lead", "repair"):
            result += self._observe_block(iteration, mailbox)
        if self._isolate and role in ("lead", "repair"):
            result += self._isolate_block(iteration, mailbox)
        if context and context.get("mode") == "open-loop":
            repos = _declared_repos(mailbox)
            if repos:
                block = self._open_loop_context_block(
                    context, repos, self.repo, mailbox
                )
            else:
                block = self._open_loop_context_block(context)
            if self.__dict__.get("_root_free") is not None:
                # r16: rendered only for root-free runs (every other prompt
                # stays byte-identical).
                block = block.rstrip("\n") + "\n" + self._root_free_note(
                    context, mailbox, repos
                ) + "\n"
                # eval-r16rc N9: a root-free aggregate is on the loop branch.
                block = block.replace(
                    "on its checked-out base branch, make ONE",
                    "in its aggregate (on the loop branch), make ONE",
                )
            result = block + result
        elif context and (
            context.get("evaluator_attempt") or context.get("pinned_sha")
        ):
            # Default lockstep: pass the persisted pin and unique attempt
            # through the actual Omnigent prompt so artifact wait can
            # match this dispatch, not leftover same-iteration text.
            attempt = str(context.get("evaluator_attempt") or "")
            sha = str(
                context.get("pinned_sha") or context.get("expected_sha") or ""
            )
            pins = context.get("pins") or {}
            extra = (
                " pins=" + ",".join(f"{n}@{v}" for n, v in pins.items())
                if pins else ""
            )
            note = ""
            repos = _declared_repos(mailbox) if pins else {}
            if repos:
                # eval-r15 N2: the lockstep Evaluator's multi-repo procedure.
                note = self._lockstep_multi_repo_note(
                    "evaluator", iteration, mailbox, repos, context
                )
            result = (
                f"LOCKSTEP CONTEXT: attempt={attempt} sha={sha}{extra}\n"
                + note + "\n" + result
            )
        elif role in ("lead", "repair") and not (context or {}).get("mode"):
            repos = _declared_repos(mailbox)
            if repos:
                # eval-r15 N2: the lockstep Lead's multi-repo procedure.
                result = self._lockstep_multi_repo_note(
                    role, iteration, mailbox, repos, context
                ) + "\n" + result
        return result

    def _lockstep_multi_repo_note(
        self,
        role: str,
        iteration: int,
        mailbox: Path,
        repos: dict[str, dict[str, Any]],
        context: dict[str, Any] | None,
    ) -> str:
        """The r15 MULTI-REPO procedure of a LOCKSTEP prompt (eval-r15 N2)."""
        if role in ("lead", "repair"):
            return _LOCKSTEP_MULTI_REPO_LEAD_NOTE.format(
                repos="Repos:\n" + _multi_repo_listing(repos, self.repo)
            )
        context = context or {}
        pins = dict(context.get("pins") or {})
        pins.setdefault("home", str(context.get("pinned_sha") or ""))
        order = ["home", *repos]
        return _LOCKSTEP_MULTI_REPO_EVALUATOR_NOTE.format(
            pins=_multi_repo_listing(repos, self.repo, pins),
            evaluated=", ".join(f"{n}@{pins.get(n) or '<sha>'}" for n in order),
            iteration=iteration,
            mailbox_name=mailbox.name,
        )

    def _root_free_note(
        self,
        context: dict[str, Any],
        mailbox: Path,
        repos: dict[str, dict[str, Any]] | None,
    ) -> str:
        """The ROOT-FREE addendum of a root-free OPEN-LOOP CONTEXT (r16)."""
        rf = self._root_free or {}
        values = {
            "lead": rf.get("lead") or str(self.repo),
            "branch": rf.get("branch") or "trio/<mailbox>",
            "target": rf.get("target") or "<target>",
            "base": str(rf.get("target_base") or "")[:12] or "<sha>",
            "home": rf.get("home") or "<root>",
            "mailbox": str(mailbox),
            "iteration": context.get("iteration") or "N",
        }
        kind = context.get("kind")
        if kind == "lead-pass":
            text = _ROOT_FREE_LEAD_NOTE.format(**values)
            if repos:
                text += "".join(
                    f"  - `{name}`: aggregate `{d['path']}` on `{values['branch']}`"
                    + (f" (lands onto `{d['target']}`)" if d.get("target") else "")
                    + "\n"
                    for name, d in _root_free_repo_rows(rf, repos).items()
                )
            return text
        if kind == "slice-eval":
            return _ROOT_FREE_SLICE_EVAL_NOTE.format(**values)
        if kind == "integration-eval":
            text = _ROOT_FREE_INTEGRATION_NOTE.format(**values)
            if repos:
                text += _ROOT_FREE_INTEGRATION_REPOS_NOTE.format(**values)
            return text
        return _ROOT_FREE_SLICE_EVAL_NOTE.format(**values)

    def _observe_block(self, iteration: int, mailbox: Path) -> str:
        """Explicit worker-dispatch CLI for an observed Lead/repair pass.

        The broker-hosted Lead does not inherit this process's env, and a
        bare `trioctl` on its PATH may be an older release without the
        worker-events flags, so every field is spelled out here.
        """
        obs = self._observe or {}
        q = shlex.quote
        command = (
            f"{q(sys.executable)} {q(str(obs['trioctl']))} omnigent run "
            "<builder|scout|docs> \\\n"
            f"    --worker-events-file {q(str(obs['workers']))} \\\n"
            f"    --mailbox {q(str(Path(mailbox).resolve()))} \\\n"
            f"    --worker-run-id {q(str(obs['run_id']))} \\\n"
            f"    --worker-iteration {iteration} \\\n"
            "    --worker-slice <slice-id> \\\n"
            f"    --workspace {q(str(self.repo))} --prompt-file <task-file>"
        )
        return (
            "\n## Worker observability (opt-in for this loop run)\n"
            "This loop was launched with `--observe-workers`. Your shell "
            "does not inherit the loop's environment, so dispatch every "
            "worker for this pass with exactly this command (not a bare "
            "`trioctl` from PATH), replacing only `<builder|scout|docs>`, "
            "`<slice-id>` (the PLAN.md slice id), and `<task-file>`:\n\n"
            f"```\n{command}\n```\n\n"
            "Worker event logging is best-effort; never fail, retry, or "
            "delay a slice because of it. This does not change how you "
            "plan: run slices concurrently only when they are ready and "
            "disjoint, and serially otherwise. In `REPORT.md` add a "
            "`## Wave decisions` section listing (1) the slices that were "
            "ready this pass, (2) the wave(s) you dispatched, i.e. which "
            "slices ran concurrently, and (3) for each ready slice you ran "
            "serially, the reason. Mark it agent-reported; it is not "
            "measured causality.\n"
        )

    def _isolate_block(self, iteration: int, mailbox: Path) -> str:
        """Explicit isolated-builder dispatch CLI for this loop run."""
        iso = self._isolate or {}
        q = shlex.quote
        root = iso.get("worktree_root")
        command = (
            f"{q(sys.executable)} {q(str(iso['trioctl']))} omnigent run builder "
            "--isolate \\\n"
            f"    --mailbox {q(str(Path(mailbox).resolve()))} \\\n"
            "    --worker-slice <slice-id> --summary '<one-line summary>' \\\n"
            + (f"    --worktree-root {q(str(root))} \\\n" if root else "")
            + f"    --workspace {q(str(self.repo))} --prompt-file <task-file>"
        )
        return (
            "\n## Isolated builders (on for this loop run)\n"
            "Dispatch every builder with exactly this command, replacing only "
            "`<slice-id>`, `<one-line summary>` and `<task-file>`:\n\n"
            f"```\n{command}\n```\n\n"
            "Each builder runs in its own task-owned git worktree. On exit 0 "
            "trioctl has already committed its work as `slice(<id>): "
            "<summary>` and merged it into this checkout -- do not re-commit "
            "those files. Before dispatching a builder, commit ONLY product "
            "edits you or your builders made under a slice's declared "
            "`writes:` (the worker would not see them otherwise). If the "
            "dispatch is refused for any other file (\"commit or stash YOUR "
            "change to <file>\", or product-path changes you did not make), "
            "do NOT commit, stash or delete it: stop the pass, append "
            "`- iter N | lead | blocked: uncommitted foreign changes: "
            "<files>` to LOG.md and set `status: needs_human` in STATE.md. "
            "Untracked files outside product paths and other mailboxes are "
            "only listed (`trioctl: ignored ...`), never a reason to commit. "
            "Exit 3 means the worktree was retained: read the JSON "
            "line it prints. For `worker_failed`, `interrupted` or "
            "`unverified_output`, do NOT integrate that output -- dispatch a "
            "fresh builder for the slice once, then take over (see step 3 "
            "of the OPEN-LOOP CONTEXT procedure in open-loop; in lockstep, "
            "implement the slice yourself or stop for a human). For "
            "`merge_conflict`, `aggregate_dirty`, `merge_failed`, "
            "`aggregate_moved`, `integration_fenced` or `active_session`, "
            "remove the cause, then run `omnigent worktrees integrate <id>` "
            "once (`merge_failed` right after an open-loop revert: once the "
            "revert commit exists). Never delete "
            "retained worktrees. Concurrency rules for waves are "
            "unchanged: only ready slices with disjoint `writes:` and no "
            "`reads:` of another wave member run together; a slice that reads "
            "another's output is dispatched after that slice is merged.\n"
        )

    def _slice_eval_worktree(
        self, role: str, mailbox: Path, context: dict[str, Any] | None
    ) -> dict[str, Any] | None:
        """A detached worktree at the slice-eval pin, or None."""
        if not self._isolate or role != "evaluator" or worker_worktrees is None:
            return None
        if not context or context.get("kind") != "slice-eval" or not context.get("sha"):
            return None
        root = self._isolate.get("worktree_root")
        repo = self.repo
        kwargs: dict[str, Any] = {}
        name, declared = self._eval_repo(mailbox, context)
        if declared is not None:
            # r15: the pinned sha lives in the slice's declared repo; bind
            # the detached worktree there (its own ledger and root).
            repo = declared["path"]
            root = str(_repo_worktree_root(repo, name, root))
            kwargs = {"repo_name": name}
        try:
            record = worker_worktrees.create(
                repo,
                slice_id=f"eval-{context.get('slice') or 'slice'}",
                mailbox=mailbox,
                root=Path(root) if root else None,
                role="evaluator",
                detach_at=str(context["sha"]),
                **kwargs,
            )
        except (worker_worktrees.WorktreeError, OSError, subprocess.SubprocessError) as exc:
            raise TrioctlError(f"cannot bind slice-eval worktree: {exc}") from exc
        try:
            # Live owner for the whole dispatch: this process (session id
            # is appended once created).
            worker_worktrees.mark_running(_ledger_repo(record, self.repo), record, None)
        except Exception as exc:
            # Created but not bound: the degraded eval never uses it, so
            # retire it now (recorded, never an orphan) before degrading.
            self._discard_eval_worktree(record, exc)
            raise TrioctlError(
                f"cannot bind slice-eval worktree: {type(exc).__name__}: {exc}"
            ) from exc
        return record

    @staticmethod
    def _eval_repo(
        mailbox: Path, context: dict[str, Any] | None
    ) -> tuple[str, dict[str, Any] | None]:
        """(repo name, declared repo or None) a slice-eval grades in (r15).

        PLAN.md is authoritative (eval-r15 N1): the slice's PLAN.md `repo:`
        (omitted = home, as in trio-check's check_queue) names the repo.
        The loop core's context ``repo`` (set only for a declared repo; its
        retire parse already holds an entry that disagrees with PLAN.md) is
        a cross-check: a disagreement raises, so the bind degrades loudly
        instead of grading another repo's tree.
        """
        context = context or {}
        repos = _declared_repos(mailbox)
        if not repos:
            return "home", None
        name, declared = _slice_repo(mailbox, context.get("slice"))
        claimed = str(context.get("repo") or "").strip()
        if claimed and claimed != name:
            raise TrioctlError(
                f"slice-eval context names repo {claimed!r} but PLAN.md puts "
                f"slice {context.get('slice')!r} in repo {name!r}"
            )
        return name, declared

    def _discard_eval_worktree(self, record: dict[str, Any], exc: BaseException) -> None:
        """Remove (or record as retained) a created-but-unbound eval worktree."""
        worker_id = record.get("id")
        try:
            result = worker_worktrees.discard_eval(
                _ledger_repo(record, self.repo), str(worker_id), f"{type(exc).__name__}: {exc}"
            )
            state = result.get("state")
            detail = (
                "" if state == "removed"
                else f" ({result.get('retained_reason')}: {result.get('retained_detail')})"
            )
            print(
                f"trioctl: unbound slice-eval worktree {worker_id}: {state}{detail}",
                file=sys.stderr,
            )
        except Exception as cleanup_exc:  # noqa: BLE001 - the eval still degrades
            print(
                f"trioctl: could not discard unbound slice-eval worktree {worker_id} "
                f"({record.get('path')}): {type(cleanup_exc).__name__}: {cleanup_exc}",
                file=sys.stderr,
            )

    def _bind_slice_eval(
        self,
        role: str,
        iteration: int,
        mailbox: Path,
        context: dict[str, Any] | None,
        dispatch: dict[str, Any],
    ) -> tuple[dict[str, Any] | None, str | None]:
        """(slice-eval worktree or None, degraded reason or None). Never raises.

        A failed bind never kills the driver: it is logged once, recorded
        as ``eval_isolation: degraded (<reason>)`` in this dispatch's
        session bookkeeping (``inflight_sessions`` -> `.driver.json`) and
        in LOG.md, and the slice-eval runs on the root-bound non-isolated
        path (the evaluator grades in its own ``git worktree add`` at the
        pin, as with ``--no-isolate-workers``).

        Root-free runs (r16) never degrade: see `_bind_root_free_eval`.
        """
        if self.__dict__.get("_root_free") is not None:
            return self._bind_root_free_eval(role, iteration, mailbox, context, dispatch)
        try:
            return self._slice_eval_worktree(role, mailbox, context), None
        except Exception as exc:  # noqa: BLE001 - any bind failure degrades
            error_class = type(exc).__name__
            reason = str(exc) if isinstance(exc, TrioctlError) else f"{error_class}: {exc}"
        slice_id = (context or {}).get("slice") or "?"
        sha = str((context or {}).get("sha") or "")[:12]
        note = f"eval_isolation: degraded ({reason})"
        print(
            f"trioctl: slice-eval {slice_id}@{sha}: {note} [{error_class}]; "
            "grading on the root-bound (non-isolated) path",
            file=sys.stderr,
        )
        dispatch["meta"]["eval_isolation"] = f"degraded ({reason})"
        with self._own_lock:
            self.__dict__.setdefault("eval_isolation_degraded", []).append(
                {"slice": slice_id, "sha": (context or {}).get("sha"), "reason": reason}
            )
        line = (
            f"- iter {iteration} | loop | slice-eval {slice_id} @{sha} "
            f"{note.replace(chr(10), ' ')}\n"
        )
        try:
            log = mailbox / "LOG.md"
            prefix = ""
            if log.is_file():
                with open(log, "rb") as fh:
                    fh.seek(0, os.SEEK_END)
                    if fh.tell():
                        fh.seek(-1, os.SEEK_END)
                        prefix = "" if fh.read(1) == b"\n" else "\n"
            with open(log, "a", encoding="utf-8") as fh:
                fh.write(prefix + line)
        except OSError as exc:
            print(f"trioctl: could not log degraded eval isolation: {exc}", file=sys.stderr)
        return None, reason

    # ------------------------------------------------ r15.x root-turn lock

    ROOT_STRANGER_WAIT = DEFAULT_ROOT_STRANGER_WAIT

    def _turn_state(self) -> dict[str, Any]:
        """This runner's share of the root turn (lazy for __new__-built runners):
        {key (lock path), count (its holders), sticky (finished evaluators)}."""
        state = self.__dict__.get("_root_turn")
        if state is None:
            state = self.__dict__.setdefault(
                "_root_turn", {"key": None, "count": 0, "sticky": 0},
            )
        return state

    def _root_turn_root(self) -> Path:
        """The Cursor project root a root-bound dispatch of this runner loads."""
        workspace = Path(self.__dict__.get("_workspace") or self.repo).resolve()
        if worker_worktrees is None:
            return workspace
        return worker_worktrees.cursor_project_root(workspace)

    def _enter_root_turn(
        self, role: str, mailbox: Path, iteration: int, kind: str | None
    ) -> bool:
        """Hold the root turn for this dispatch (re-entrant within the process).

        A dispatch joins a turn this process already holds (its Lead's
        degraded slice-eval, the next Lead after a sticky evaluator turn);
        otherwise it waits for the per-root flock, bounded by
        TRIO_ROOT_TURN_WAIT_S (RootBusyError after that). True when it had
        to wait for another holder.
        """
        root = self._root_turn_root()
        key = str(_root_turn_path(root))
        mine = self._turn_state()
        slot = _root_turn_slot(key)
        with slot["mutex"]:
            if slot["count"] > 0:
                slot["count"] += 1
                mine["key"] = key
                mine["count"] += 1
                return False
            lock = _RootTurnLock(
                root, who={"mailbox": str(mailbox), "role": role, "kind": kind or role},
            )
            label = f"{mailbox.name} {kind or role} (iteration {iteration})"
            waited = lock.acquire(
                _env_seconds(ROOT_TURN_WAIT_ENV, DEFAULT_ROOT_TURN_WAIT), label=label,
            )
            slot["lock"] = lock
            slot["count"] = 1
            mine["key"] = key
            mine["count"] += 1
        if not lock.contended:
            return False
        with self._dict_lock():
            current = self.__dict__.get("driver_meta")
            current = dict(current) if isinstance(current, dict) else {}
            current["root_turn_wait_s"] = round(
                float(current.get("root_turn_wait_s") or 0.0) + waited, 3
            )
            self.driver_meta = current  # rebind: the core may be serialising it
        threshold = _env_seconds(ROOT_TURN_PROGRESS_ENV, DEFAULT_ROOT_TURN_PROGRESS)
        if waited > threshold:
            _append_mailbox_log(
                mailbox,
                f"- iter {iteration} | loop | root turn: {kind or role} waited "
                f"{waited:.0f}s for another Trio actor at {lock.root}",
            )
        return True

    def _repin_after_turn_wait(
        self, iteration: int, mailbox: Path, context: dict[str, Any] | None
    ) -> bool:
        """Re-bind a root-bound evaluation's pin after waiting for the root turn.

        The loop core pins HEAD before it dispatches; while this dispatch
        waited, another loop's turn may have committed. The core's own
        binding helper decides (it keeps the pin/attempt while the product
        is intact since the pin, else pins HEAD with a fresh attempt); the
        shared *context* dict is updated in place. True when it changed.
        """
        core = self.__dict__.get("loop_core")
        if not context or core is None or not context.get("pinned_sha"):
            return False
        state_path = mailbox / "STATE.md"
        before = (context.get("pinned_sha"), context.get("evaluator_attempt"))
        try:
            if context.get("kind") == "integration-eval":
                helper = getattr(core, "_open_loop_integration_context", None)
                if not callable(helper):
                    return False
                fresh = helper(mailbox, self.repo, iteration, state_path)
            elif context.get("mode") != "open-loop":
                helper = getattr(core, "_lockstep_eval_context", None)
                intact = getattr(core, "_evaluated_product_intact", None)
                if not callable(helper) or not callable(intact):
                    return False
                if intact(self.repo, mailbox, str(context["pinned_sha"])):
                    return False
                core._update_state(
                    state_path, {"evaluated_sha": "", "evaluator_attempt": ""}
                )
                fresh = helper(mailbox, self.repo, iteration,
                               core._read_state(state_path), state_path)
            else:
                return False
        except Exception as exc:  # noqa: BLE001 - keep the core's pin
            print(f"trioctl: could not re-pin after the root-turn wait: {exc}",
                  file=sys.stderr)
            return False
        context.update(fresh)
        after = (context.get("pinned_sha"), context.get("evaluator_attempt"))
        if after != before:
            print(
                f"trioctl: root turn wait moved the product; evaluation re-pinned "
                f"{str(before[0])[:12]} -> {str(after[0])[:12]}",
                file=sys.stderr,
            )
        return after != before

    def _exit_root_turn(self, count: int = 1) -> None:
        mine = self._turn_state()
        if not mine["key"]:
            return
        slot = _root_turn_slot(mine["key"])
        with slot["mutex"]:
            count = min(count, mine["count"])
            mine["count"] -= count
            slot["count"] = max(0, slot["count"] - count)
            if slot["count"] == 0 and slot["lock"] is not None:
                slot["lock"].release()
                slot["lock"] = None

    def _keep_root_turn_sticky(self) -> None:
        """A root-bound evaluator's turn outlives its dispatch (fence-tied)."""
        self._turn_state()["sticky"] += 1

    def _release_sticky_root_turns(self) -> None:
        """At the next Lead/repair dispatch: drop finished evaluators' turns."""
        mine = self._turn_state()
        sticky, mine["sticky"] = mine["sticky"], 0
        if sticky:
            self._exit_root_turn(sticky)

    def release_root_turns(self) -> None:
        """Loop end (after prune/restore): no dispatch of this runner is at the root."""
        mine = self._turn_state()
        mine["sticky"] = 0
        self._exit_root_turn(mine["count"])

    def _check_writes_overlap(self, mailbox: Path, iteration: int) -> None:
        """Lead-pass start: a live loop's `writes:` overlap this loop's.

        Root-bound and lockstep loops share the one aggregate at the root:
        refuse (needs_human, exit 5). A root-free loop has its own
        aggregate and the land merges and re-verifies a moved target, so a
        mid-run overlap (often introduced by the OTHER loop's Lead) only
        warns -- LOG line naming the other loop and paths, `.driver.json`
        `writes_overlap` -- and never stops this loop (eval-r16rc N4). The
        start-time refusal (exit 2) is unchanged in every mode.
        """
        registry = self.__dict__.get("loop_registry")
        if not registry:
            return
        problems = _writes_overlap_problems(Path(registry["root"]), mailbox)
        if not problems:
            meta = self.__dict__.get("driver_meta")
            if isinstance(meta, dict) and "writes_overlap" in meta:
                with self._dict_lock():
                    self.driver_meta = {k: v for k, v in meta.items() if k != "writes_overlap"}
            return
        if self.__dict__.get("_root_free") is not None and not registry.get("allow"):
            logged = registry.setdefault("logged", set())
            fresh = [p for p in problems if p not in logged]
            for problem in fresh:
                logged.add(problem)
                _append_mailbox_log(
                    mailbox,
                    f"- iter {iteration} | loop | warning: {problem}; root-free: this "
                    "loop continues (its land merges and re-verifies the other "
                    "loop's changes; a real conflict ends in needs_land)",
                )
                print(f"trioctl: warning: {problem} (root-free: continuing)",
                      file=sys.stderr)
            with self._dict_lock():
                current = self.__dict__.get("driver_meta")
                current = dict(current) if isinstance(current, dict) else {}
                current["writes_overlap"] = list(problems)
                self.driver_meta = current  # rebind: the core may be serialising it
            return
        if registry.get("allow"):
            logged = registry.setdefault("logged", set())
            for problem in problems:
                if problem in logged:
                    continue
                logged.add(problem)
                _append_mailbox_log(
                    mailbox,
                    f"- iter {iteration} | loop | warning: {problem}; "
                    f"{ALLOW_OVERLAPPING_LOOPS_ENV}=1 proceeds (one shared aggregate: unsafe)",
                )
            return
        message = "; ".join(problems)
        error = WritesOverlapError(message)
        error.stop = {
            "status": "needs_human", "phase": "writes-overlap", "reason": "writes-overlap",
            "message": message, "exit": 5,
        }
        raise error

    ROOT_RELEASE_WAIT = 30.0

    def _wait_known_root_occupants(self) -> float:
        """Wait for this run's in-flight degraded root-bound slice-evals.

        Such an eval is a known occupant of the root, not a stranger: its
        cursor-agent legitimately runs there until the dispatch ends. The
        wait is bounded by each dispatch's own role timeout (plus
        ROOT_RELEASE_WAIT for its teardown); past that the caller's normal
        stranger check decides. Returns the seconds waited.
        """
        start = time.monotonic()
        announced: set[str] = set()
        while True:
            with self._dict_lock():
                known = dict(self.__dict__.get("_degraded_root_evals") or {})
            if not known:
                break
            timeout = float(self._timeout or 0.0)
            deadline = max(
                float(entry.get("started") or start) for entry in known.values()
            ) + timeout + self.ROOT_RELEASE_WAIT
            if time.monotonic() >= deadline:
                print(
                    "trioctl: degraded slice-eval(s) "
                    f"{sorted(str(e.get('slice') or '?') for e in known.values())} "
                    "outlived their role timeout; checking the root as usual",
                    file=sys.stderr,
                )
                break
            for token, entry in known.items():
                if token not in announced:
                    announced.add(token)
                    print(
                        "trioctl: root busy with degraded slice-eval "
                        f"{entry.get('slice') or '?'}; Lead pass waits",
                        file=sys.stderr,
                    )
            time.sleep(0.5 if self._interval else 0.02)
        waited = time.monotonic() - start
        if announced:
            with self._dict_lock():
                current = self.__dict__.get("driver_meta")
                current = dict(current) if isinstance(current, dict) else {}
                current["root_wait_s"] = round(
                    float(current.get("root_wait_s") or 0.0) + waited, 3
                )
                # Rebind, never mutate (the loop core may be serialising it).
                self.driver_meta = current
        return waited

    def _release_root(self, mailbox: Path, *, stranger_wait: float | None = None) -> None:
        """Before a root-bound dispatch: prove no earlier session owns the root.

        Cursor-native writes the aggregate root's project ``.cursor``
        config at launch, overwriting whatever an earlier root session
        (e.g. the idle Lead of the previous pass) still has loaded. A held
        earlier session is never touched: the dispatch is refused. Others
        are archived and deleted through the normal id-scoped prune, then
        no cursor-agent may remain with its cwd at the root.

        A degraded (root-bound) slice-eval of this run that is still in
        flight is a known occupant: it is waited for first (bounded by its
        role timeout), then its finished session is released like any
        other. Only unknown cursor-agents at the root refuse the dispatch.

        r15.x: every Trio actor at this root holds the root-turn lock, so a
        cursor-agent still found here (at the root or in a subdirectory
        that loads its slot) is not Trio's: the user's own session, an older
        Trio, or a leaked process. It is waited for up to
        TRIO_ROOT_STRANGER_WAIT_S (default 300 s, progress every 30 s), then
        :class:`RootOccupiedError` names it (pid, cwd, start, parents, cmd).
        """
        self._wait_known_root_occupants()
        with self._own_lock:
            # Claimed atomically: a concurrent release (the degraded eval's
            # own post-dispatch release) never prunes the same session.
            claimed = [
                entry for entry in self._root_finished
                if entry["session_id"] not in self._inflight
            ]
            previous = [entry["session_id"] for entry in claimed]
            self._root_finished = [
                e for e in self._root_finished if e["session_id"] not in previous
            ]
        try:
            self._end_previous_root_sessions(mailbox, previous)
        except BaseException:
            with self._own_lock:
                known = {e["session_id"] for e in self._root_finished}
                self._root_finished[:0] = [
                    e for e in claimed if e["session_id"] not in known
                ]
            raise
        if stranger_wait is None:
            stranger_wait = _env_seconds(ROOT_STRANGER_WAIT_ENV, float(self.ROOT_STRANGER_WAIT))
        start = time.monotonic()
        deadline = start + stranger_wait
        next_note = start + min(ROOT_STRANGER_PROGRESS, max(stranger_wait, 0.0))
        while True:
            live = worker_worktrees.cursor_processes_at(self.repo)
            if not live:
                return
            now = time.monotonic()
            if now >= deadline:
                raise self._root_occupied(mailbox, live, now - start)
            if now >= next_note and stranger_wait > self.ROOT_RELEASE_WAIT:
                print(
                    f"trioctl: cursor-agent process(es) {live[:10]} not owned by Trio "
                    f"at the aggregate root {self.repo}; waited {now - start:.0f}s/"
                    f"<={stranger_wait:.0f}s",
                    file=sys.stderr,
                )
                next_note = now + ROOT_STRANGER_PROGRESS
            time.sleep(0.5 if self._interval else 0.0)

    def _root_occupied(self, mailbox: Path, live: list[int], waited: float) -> RootOccupiedError:
        """The clean root-occupied abort (recorded for `_command_loop`)."""
        details = []
        for pid in live[:10]:
            try:
                details.append(worker_worktrees.process_detail(pid))
            except Exception:  # noqa: BLE001 - a vanished pid keeps its number
                details.append({"pid": pid})
        described = "; ".join(worker_worktrees.describe_process(d) for d in details)
        message = (
            f"cursor-agent process(es) {live[:10]} still run at the aggregate root "
            f"{self.repo} after {waited:.0f}s: root {self.repo} is in use by a process "
            f"Trio does not own: {described}; Trio would overwrite its "
            ".cursor/hooks.json and mcp.json. Close it or run this loop after it ends; "
            f"resume with: trioctl omnigent loop --mailbox {mailbox}"
        )
        error = RootOccupiedError(message, pids=list(live), details=details)
        error.stop = {
            "status": "needs_human", "phase": "root-occupied", "reason": "root-occupied",
            "message": message, "exit": ROOT_OCCUPIED_EXIT,
        }
        return error

    def _end_previous_root_sessions(self, mailbox: Path, previous: list[str]) -> None:
        """Prune the claimed finished root sessions (refuses held ones)."""
        if previous:
            held = set(self.held_session_ids) | {
                str(r.get("session_id")) for _p, r in _held_records(mailbox)
                if r.get("session_id")
            }
            if any(not r.get("session_id") for _p, r in _held_records(mailbox)):
                raise TrioctlError(
                    "unreadable held record: cannot prove the aggregate root "
                    "is free; not reusing it"
                )
            blocked = [sid for sid in previous if sid in held]
            if blocked:
                raise TrioctlError(
                    f"held session(s) {blocked} still own the aggregate root's "
                    "Cursor config; not reusing the root"
                )
            counts = _prune_broker_sessions(
                self._client(), mailbox, session_ids=previous, keep_unarchived=True,
            )
            print(
                f"trioctl: ended previous root session(s) {previous} before "
                f"reusing the aggregate root: {counts}",
                file=sys.stderr,
            )

    def _root_owned_ids(self, mailbox: Path) -> set[str]:
        """Root sessions this task provably launched and that no longer run.

        This run's created ids, ids recorded at THIS root under THIS
        mailbox, and ids an earlier trioctl run of this mailbox archived
        (full id and locked title prefix). A session recorded under another
        mailbox, or with no mailbox, is only evidence: another trioctl
        process may have it in flight (recorded before its cursor-agent
        starts), so it is never included, whatever else claims it. Held
        sessions (of this mailbox or of the mailbox a recorded session
        belongs to) and in-flight dispatches are never included either;
        restore_root_cursor adds nothing back.
        """
        owned = set(self.created_session_ids)
        held_elsewhere: set[str] = set()
        foreign: set[str] = set()
        recorded = worker_worktrees.root_owned_sessions(self.repo)
        here = mailbox.resolve()
        for sid, box in recorded.items():
            try:
                ours = bool(box) and Path(box).resolve() == here
            except (OSError, RuntimeError):
                ours = False
            if ours:
                owned.add(sid)
                continue
            foreign.add(sid)
            if box:
                held_elsewhere |= _held_session_ids(Path(box))
        prefix = f"trioctl {mailbox.name} "
        archive = mailbox / ".sessions"
        if archive.is_dir():
            for path in sorted(archive.glob("*.jsonl")):
                try:
                    with open(path, encoding="utf-8") as fh:
                        first = json.loads(fh.readline())
                except (OSError, ValueError):
                    continue
                if (
                    isinstance(first, dict)
                    and isinstance(first.get("id"), str)
                    and str(first.get("title") or "").startswith(prefix)
                ):
                    owned.add(first["id"])
        held = set(self.held_session_ids) | _held_session_ids(mailbox) | held_elsewhere
        with self._own_lock:
            inflight = set(self._inflight)
        return owned - held - inflight - foreign

    def _restore_root_config(self, mailbox: Path, *, final: bool = False) -> list[str]:
        """Undo this task's own Omnigent merges into the root ``.cursor`` config.

        Only while no cursor-agent runs at the root; anything not provably
        this task's own is left in place, so acceptance stays pending.
        """
        if _has_unreadable_hold(mailbox):
            problems = ["unreadable held record: root Cursor config left in place"]
        elif worker_worktrees.cursor_processes_at(self.repo):
            problems = ["a cursor-agent still runs at the root; its Cursor config was left in place"]
        else:
            try:
                problems = worker_worktrees.restore_root_cursor(
                    self.repo, self._root_owned_ids(mailbox), final=final,
                )
            except worker_worktrees.WorktreeError as exc:
                problems = [str(exc)]
        for problem in problems:
            print(f"trioctl: root Cursor config: {problem}", file=sys.stderr)
        return problems

    def _manages_root_config(self) -> bool:
        """Whether root-bound dispatches baseline/restore the root ``.cursor``."""
        if self.__dict__.get("_root_free") is not None:
            return False  # r16: no session ever runs at the root
        return worker_worktrees is not None and bool(
            self._isolate or self._restore_root_nonisolated
        )

    def _snapshot_root_config(self) -> None:
        """Non-isolated launch: record the root's pre-run config once, never wait."""
        try:
            worker_worktrees.snapshot_root_cursor(self.repo)
        except worker_worktrees.WorktreeError as exc:
            print(f"trioctl: root Cursor config baseline not taken: {exc}", file=sys.stderr)

    def _end_root_sessions_nonisolated(self, mailbox: Path) -> None:
        """Non-isolated: after a finished evaluator, end finished root sessions, restore.

        Only when no other dispatch of this runner is in flight (open-loop
        can run the Lead and an evaluator at the root together; their
        sessions are never touched and the config stays until loop end).
        Held sessions refuse the release; the config is then left in place
        and the loop core's acceptance check decides.
        """
        if not self._end_root_sessions:
            return
        with self._own_lock:
            # A degraded eval registered before its session id exists is
            # in flight too (never wait for it here: the Lead does).
            busy = bool(self._inflight) or bool(
                self.__dict__.get("_degraded_root_evals")
            )
        if busy:
            return
        try:
            self._release_root(mailbox, stranger_wait=self.ROOT_RELEASE_WAIT)
        except Exception as exc:  # noqa: BLE001 - config stays; acceptance decides
            print(f"trioctl: root Cursor config left in place: {exc}", file=sys.stderr)
            return
        self._restore_root_config(mailbox)

    def _prepare_root_config(self, mailbox: Path) -> None:
        """Before a root-bound launch (root already released): restore, then baseline."""
        self._restore_root_config(mailbox)
        try:
            worker_worktrees.snapshot_root_cursor(self.repo)
        except worker_worktrees.WorktreeError as exc:
            print(f"trioctl: root Cursor config baseline not taken: {exc}", file=sys.stderr)

    def _end_root_evaluator(self, mailbox: Path, session_id: str) -> None:
        """Back-compat name: :meth:`_end_root_session` for an evaluator."""
        self._end_root_session(mailbox, session_id, "evaluator")

    def _end_root_session(self, mailbox: Path, session_id: str, role: str) -> None:
        """End a finished root-bound session of *role*, then restore the root.

        Evaluator sessions were always ended here; since r15.x the Lead /
        repair session is too, at its turn end, instead of idling at the root
        until the next root dispatch (it would keep a cursor-agent there and
        block every other loop's root turn between passes). No session is
        ever reused. A held session is never touched. While a degraded
        slice-eval of this run still runs at the root, the session is ended
        but the root is not waited for / restored (the next release does it).
        """
        if not self._end_root_sessions:
            print(
                "trioctl: root Cursor config left in place (--keep-sessions keeps "
                f"{role} session {session_id}); acceptance stays pending",
                file=sys.stderr,
            )
            return
        if session_id in set(self.held_session_ids) | _held_session_ids(mailbox):
            return
        try:
            counts = _prune_broker_sessions(
                self._client(), mailbox, session_ids=[session_id], keep_unarchived=True,
            )
        except Exception as exc:  # noqa: BLE001 - config stays; acceptance fails closed
            print(f"trioctl: could not end {role} session {session_id}: {exc}",
                  file=sys.stderr)
            return
        if not isinstance(counts, dict) or int(counts.get("deleted") or 0) < 1:
            # Kept (archive failure, skipped, ...): it may still own the
            # root, so keep its bookkeeping; the next root dispatch retries
            # the release and the config stays until then.
            print(
                f"trioctl: finished root {role} session {session_id} was not deleted "
                f"({counts}); root Cursor config left in place, acceptance stays pending",
                file=sys.stderr,
            )
            return
        print(
            f"trioctl: ended finished root {role} session {session_id}: {counts}",
            file=sys.stderr,
        )
        with self._own_lock:
            self._root_finished = [
                e for e in self._root_finished if e["session_id"] != session_id
            ]
            degraded = bool(self.__dict__.get("_degraded_root_evals"))
        if degraded:
            return
        deadline = time.monotonic() + self.ROOT_RELEASE_WAIT
        while worker_worktrees.cursor_processes_at(self.repo):
            if time.monotonic() >= deadline:
                break
            time.sleep(0.5 if self._interval else 0.0)
        self._restore_root_config(mailbox)

    def restore_root_config_final(self, mailbox: Path) -> list[str]:
        """Loop end, after the post-loop prune: restore and drop the baseline."""
        if not self._manages_root_config():
            return []
        if not self._isolate:
            # Non-isolated: nothing ended the root sessions before the
            # post-loop prune; their runners exit asynchronously.
            deadline = time.monotonic() + self.ROOT_RELEASE_WAIT
            while worker_worktrees.cursor_processes_at(self.repo):
                if time.monotonic() >= deadline:
                    break
                time.sleep(0.5 if self._interval else 0.0)
        return self._restore_root_config(mailbox, final=True)

    def _observe_phase(
        self,
        kind: str,
        invocation_id: str,
        role: str,
        iteration: int,
        **fields: Any,
    ) -> None:
        """Best-effort Lead/Evaluator/repair phase record. Never raises."""
        if not self._observe or worker_events is None:
            return
        try:
            rec = worker_events.phase_record(
                invocation_id=invocation_id,
                kind=kind,
                role=role,
                run_id=str(self._observe["run_id"]),
                iteration=iteration,
                **fields,
            )
            worker_events.emit(self._observe["phases"], rec)
        except Exception:  # noqa: BLE001 - telemetry must not fail a pass
            print(worker_events.TELEMETRY_WARN, file=sys.stderr)

    def _observed_wave_report(self, mailbox: Path, since: float) -> str | None:
        """Copy this pass's REPORT.md wave section; stale reports are None."""
        path = mailbox / "REPORT.md"
        try:
            if path.stat().st_mtime < since:
                return None
            return worker_events.wave_section(
                path.read_text(encoding="utf-8", errors="replace")
            )
        except (OSError, AttributeError):
            return None

    def _client(self) -> Any:
        """Reuse an injected fake or build the real HTTP client once."""
        if self._broker_client is None:
            with self._lazy_lock():
                if self._broker_client is None:
                    self._broker_client = _session_client(self._base_url)
        return self._broker_client

    @staticmethod
    def _create(
        client: Any,
        agent_id: str,
        model: str,
        prompt: str,
        title: str,
        runner_id: str | None = None,
        host_id: str | None = None,
        workspace: str | None = None,
        prompt_timeout: float | None = None,
        labels: dict[str, str] | None = None,
        on_session_id: Any = None,
    ) -> Any:
        """Call the checked-in client seam or a small test double.

        Extra kwargs (`runner_id`, `host_id`, `workspace`,
        `prompt_timeout`) are forwarded
        only when the target method declares them (or accepts **kwargs).
        The fakes in test_omnigent_loop.py take the legacy 4-argument
        shape and must keep working unchanged.
        """
        method = getattr(client, "create_session", None) or getattr(
            client, "create", None
        )
        if method is None:
            raise TrioctlError("broker client has no session-create method")
        extra: dict[str, Any] = {}
        if runner_id:
            extra["runner_id"] = runner_id
        if host_id:
            extra["host_id"] = host_id
        if workspace:
            extra["workspace"] = workspace
        if prompt_timeout is not None:
            extra["prompt_timeout"] = prompt_timeout
        if labels:
            extra["labels"] = dict(labels)
        if on_session_id is not None:
            extra["on_session_id"] = on_session_id
        if extra:
            try:
                params = inspect.signature(method).parameters
            except (TypeError, ValueError):
                params = {}
            accepts_kwargs = any(
                p.kind == inspect.Parameter.VAR_KEYWORD
                for p in params.values()
            )
            forwarded = {
                key: value
                for key, value in extra.items()
                if key in params or accepts_kwargs
            }
            if forwarded:
                return method(
                    agent_id, model, prompt, title, **forwarded
                )
        return method(agent_id, model, prompt, title)

    def _wait(
        self,
        client: Any,
        session_id: str,
        timeout: float | None = None,
        **dispatch_kind: Any,
    ) -> Any:
        """Wait through a fake seam or poll the real broker session.

        ``kind="slice-eval"`` (passed only for open-loop slice-evals, so
        existing ``_wait`` doubles keep their signature) selects that kind's
        idle dwell; see `_idle_dwell`.
        """
        wait_timeout = self._timeout if timeout is None else timeout
        method = getattr(client, "wait_session", None) or getattr(
            client, "wait", None
        )
        if method is not None:
            try:
                return method(
                    session_id,
                    timeout=wait_timeout,
                    interval=self._interval,
                )
            except TypeError:
                return method(session_id)

        # Live Cursor turns have think/tool gaps that look idle. Hold
        # idle after running (or after an early assistant ack) so those
        # gaps are not terminal. Tests use interval=0 and skip the dwell.
        # TRIO_OMNIGENT_IDLE_DWELL overrides the live default (30s);
        # TRIO_OMNIGENT_IDLE_DWELL_SLICE_EVAL overrides it for slice-evals.
        return _wait_for_session(
            client,
            session_id,
            timeout=wait_timeout,
            interval=self._interval,
            stable_idle=(
                0.0
                if self._interval == 0
                else _idle_dwell(dispatch_kind.get("kind"))
            ),
        )

    @staticmethod
    def _read(client: Any, session_id: str) -> Any:
        """Read committed session items before returning to the loop driver."""
        method = (
            getattr(client, "get_items", None)
            or getattr(client, "read_session", None)
            or getattr(client, "read", None)
        )
        if method is None:
            raise TrioctlError("broker client has no session-read method")
        return method(session_id)

    @staticmethod
    def _session_id(created: Any) -> str | None:
        if isinstance(created, dict):
            value = created.get("id") or created.get("session_id")
            return value if isinstance(value, str) and value else None
        return created if isinstance(created, str) and created else None

    @staticmethod
    def _title(
        mailbox: Path,
        iteration: int,
        role: str,
        context: dict[str, Any] | None,
    ) -> str:
        """Base title, plus the open-loop kind (and slice, for slice-eval).

        Locked scheme: ``trioctl <mailbox.name> <role>:iteration <N>`` plus
        an optional open-loop suffix (`` lead-pass`` / `` integration-eval`` /
        `` slice-eval:<id>``). The ``trioctl <mailbox.name> `` prefix is what
        `sessions prune` matches (see ``_session_title_matches_mailbox``),
        and the ``:`` right after that prefix satisfies Omnigent's
        ``_parse_session_title`` -- a colon is required there, otherwise
        agent/title parse to None and ``sys_session_close`` rejects the
        session as ``session_not_a_sub_agent``.
        """
        # NOTE: the colon sits AFTER ``trioctl <mailbox.name> `` so the
        # prefix-scoped prune match (``title.startswith(...)``) and the
        # colon-aware ``_parse_session_title`` both keep working.
        title = f"trioctl {mailbox.name} {role}:iteration {iteration}"
        if context and context.get("mode") == "open-loop":
            kind = context.get("kind")
            slice_id = context.get("slice")
            if kind == "slice-eval" and slice_id:
                title += f" slice-eval:{slice_id}"
            elif kind:
                title += f" {kind}"
        return title

    def _create_wait_read(
        self,
        client: Any,
        agent_id: str,
        model: str,
        prompt: str,
        title: str,
        role: str,
        started: float | None = None,
        workspace: str | None = None,
        dispatch: dict[str, Any] | None = None,
    ) -> tuple[Any, Any]:
        """One create+wait+read cycle. Returns (session snapshot, items).

        *dispatch* (per-call, not shared) receives this call's own
        ``session_id`` the moment it exists.

        With ``started``, the prompt phase inside create counts against
        the role timeout: the wait only gets what is left of it.
        """
        token = (dispatch or {}).get("prompt_token")
        gate = _SameCwdGate(client, workspace or self._workspace)
        gate.acquire()
        if gate.contended:
            self._note_same_cwd_serialised(gate, role, dispatch)

        def on_session_id(new_id: str) -> None:
            _dispatch_prompt_update(token, session_id=new_id)
            gate.session_created(new_id)

        try:
            created = self._create(
                client,
                agent_id,
                model,
                prompt,
                title,
                runner_id=self._runner_id,
                host_id=self._host_id,
                workspace=workspace or self._workspace,
                prompt_timeout=self._timeout,
                labels=(
                    dict(COMPLETION_RECEIPT_LABELS)
                    if self._completion_receipts
                    else None
                ),
                on_session_id=on_session_id,
            )
        except broker_http.PromptDeliveryUncertain as exc:
            _dispatch_prompt_update(token, session_id=exc.session_id)
            gate.finish(exc.session_id, failed=True, keep=True)
            raise
        except BaseException:
            gate.finish(None, failed=True)
            raise
        session_id = self._session_id(created)
        _dispatch_prompt_update(token, session_id=session_id)
        gate.finish(session_id, failed=session_id is None)
        if session_id is None:
            raise TrioctlError("session create response has no session id")
        delivery = dispatch.get("delivery") if dispatch is not None else None
        if dispatch is not None:
            dispatch["session_id"] = session_id
            with self._own_lock:
                self._inflight.add(session_id)
                meta = self.__dict__.setdefault("_inflight_meta", {})
                meta[session_id] = dict(dispatch.get("meta") or {"role": role})
            if dispatch.get("root_mailbox") is not None:
                # Durable ownership evidence as soon as the id exists, so a
                # crash mid-dispatch still leaves a provable record.
                try:
                    worker_worktrees.record_root_session(
                        self.repo, session_id, dispatch["root_mailbox"]
                    )
                except Exception as exc:  # noqa: BLE001 - finally retries it
                    print(f"trioctl: could not record root session {session_id}: {exc}",
                          file=sys.stderr)
        with self._dict_lock():
            # Last dispatch of this role (back-compat); never read in flight.
            self.session_ids[role] = session_id
            self.created_session_ids.append(session_id)
            if delivery:
                self._delivery[session_id] = delivery
        _record_created_session_id(session_id)
        self._record_dispatch(role, client, session_id, created, delivery)
        remaining = (
            None
            if started is None
            else max(self._timeout - (time.monotonic() - started), 0.0)
        )
        snapshot = self._wait(
            client, session_id, timeout=remaining,
            **_slice_eval_kind((dispatch or {}).get("meta")),
        )
        items = self._read(client, session_id)
        return snapshot, items

    def _note_same_cwd_serialised(
        self, gate: "_SameCwdGate", role: str, dispatch: dict[str, Any] | None
    ) -> None:
        """Contended same-cwd lock: session meta + `.driver.json` evidence."""
        wait_s = round(gate.waited, 3)
        if dispatch is not None:
            meta = dispatch.setdefault("meta", {"role": role})
            meta["same_cwd_serialised"] = True
            meta["same_cwd_wait_s"] = wait_s
        entry = {
            "role": role,
            "kind": ((dispatch or {}).get("meta") or {}).get("kind"),
            "slice": ((dispatch or {}).get("meta") or {}).get("slice"),
            "workspace": gate.workspace,
            "same_cwd_serialised": True,
            "wait_s": wait_s,
            "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        }
        with self._dict_lock():
            current = self.__dict__.get("driver_meta")
            current = dict(current) if isinstance(current, dict) else {}
            events = list(current.get("same_cwd_serialised") or [])
            events.append(entry)
            current["same_cwd_serialised"] = events[-50:]
            # Rebind, never mutate: the loop core may be serialising the
            # old dict from another thread.
            self.driver_meta = current

    def _crosswire_hold(
        self, client: Any, session_id: str, mailbox: Path,
        dispatch: dict[str, Any],
    ) -> dict[str, Any] | None:
        """Held-record fields when a first-prompt hold is a cross-wired mirror."""
        try:
            rows = broker_http._user_row_texts(
                broker_http._session_item_rows(self._read(client, session_id))
            )
        except Exception:  # noqa: BLE001 - classification only; still held
            return None
        sibling = _crosswired_sibling(dispatch.get("prompt_token"), mailbox, rows)
        if sibling is None:
            return None
        meta = sibling.get("meta") or {}
        return {
            "crosswired_with": sibling.get("session_id"),
            "crosswired_role": meta.get("role"),
            "crosswired_kind": meta.get("kind"),
            "crosswired_slice": meta.get("slice"),
        }

    @staticmethod
    def _is_restart_blip(snapshot: Any, items: Any) -> bool:
        """A post-restart runner blip: unbound, and no items at all.

        `_wait_for_session` already refuses to treat a bound+running+idle,
        zero-item snapshot as terminal, but a session can still finish its
        wait (e.g. an immediate idle pong) and only *afterward* show an
        unbound runner with nothing read back -- the same restart blip
        observed in the real run, just caught one step later.
        """
        return not _runner_is_bound(snapshot) and not _session_items(items)

    def _new_dispatch_nonce(self) -> str | None:
        """A fresh nonce per opted-in dispatch; None on the default path."""
        return uuid.uuid4().hex if self._completion_receipts else None

    def _record_dispatch(
        self,
        role: str,
        client: Any,
        session_id: str,
        created: Any,
        delivery: dict[str, Any] | None = None,
    ) -> None:
        """Save dispatch provenance right after create, before the wait.

        *delivery* is this dispatch's own record (never looked up by role:
        several evaluator dispatches may be in flight at once).
        Identity comes only from the create response (null when absent);
        a failed write leaves the dispatch unreconcilable, never broken.
        """
        if not delivery or reconcile is None:
            return
        delivery.update(client=client, session_id=session_id, extra_sends=0)
        prov = dict(delivery["base"])
        prov.update(
            session_id=session_id,
            runner_id=_optional_str(created, "runner_id"),
            external_session_id=_optional_str(created, "external_session_id"),
            capabilities_at_dispatch={
                "completion_receipts": _create_sends_labels(client),
                "echoed": reconcile.capabilities(created)[
                    "completion_receipts"
                ],
            },
            delivered_at=time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        )
        prov.update(_posted_copies(client, session_id, 0))
        prov["sent_prompt_shas"] = _sent_prompt_shas(prov)
        delivery["provenance"] = prov
        try:
            delivery["provenance"] = reconcile.write_provenance(
                delivery["mailbox"], session_id, prov, delivery["prompt"],
                delivery["baseline_text"],
            )
        except OSError as exc:
            delivery["provenance"] = None
            print(
                f"trioctl: could not save dispatch provenance for "
                f"{session_id} ({exc}); a hold will need a person",
                file=sys.stderr,
            )

    def _final_provenance(
        self, role: str, session_id: str
    ) -> dict[str, Any] | None:
        """The saved provenance with the final copy count, or None.

        Looked up by this dispatch's own session id (per dispatch).
        """
        with self._dict_lock():
            delivery = self._delivery.get(session_id) or {}
        prov = delivery.get("provenance")
        if not prov or delivery.get("session_id") != session_id:
            return None
        prov = dict(prov)
        prov.update(_posted_copies(
            delivery.get("client"), session_id,
            int(delivery.get("extra_sends") or 0),
        ))
        prov["sent_prompt_shas"] = _sent_prompt_shas(prov)
        try:
            reconcile.durable_write_json(
                reconcile.provenance_paths(delivery["mailbox"], session_id)[
                    "provenance"
                ],
                prov,
            )
        except OSError:
            pass
        return prov

    def run(
        self,
        role: str,
        iteration: int,
        mailbox: Path,
        context: dict[str, Any] | None = None,
    ) -> int:
        """Create, await, and read one Lead, Evaluator, or repair session.

        The prompt is POSTed once and never re-sent. A restart blip
        (unbound runner, zero items back) after the wait does not prove
        the turn never ran, so the session is kept and held as
        ``role_completion_uncertain``; no second session is created.
        """
        if role not in {"lead", "evaluator", "repair"}:
            raise TrioctlError(f"unknown Omnigent loop role: {role}")
        mailbox = Path(mailbox).resolve()
        self._quality_before_dispatch(role, iteration, mailbox, context)
        try:
            code = self._run_observed(role, iteration, mailbox, context)
        except _EvalBindSkipped:
            # r16: a slice-eval whose worktree could not be bound was not
            # dispatched (logged); the loop core sees no verdict section and
            # retries it (status error after 3 attempts).
            return 0
        self._quality_after_dispatch(role, iteration, mailbox, context)
        return code

    def _quality_after_dispatch(
        self,
        role: str,
        iteration: int,
        mailbox: Path,
        context: dict[str, Any] | None,
    ) -> None:
        """r18a L1 telemetry: the slice section's evidence kinds, or the
        whole-goal verdict's `## Independent probe` line (logged, recorded
        under `quality` in `.driver.json`; never gates)."""
        if role != "evaluator":
            return
        try:
            text = _mailbox_text(mailbox / "VERDICT.md")
            ctx = context or {}
            if ctx.get("kind") == "slice-eval":
                slice_id = str(ctx.get("slice") or "")
                sha = str(ctx.get("sha") or ctx.get("pinned_sha") or "")
                parsed = slice_evidence(text, slice_id, sha)
                if parsed is None:
                    return
                key = f"{slice_id}@{sha[:12]}"
                self._record_quality(key, {"slice": slice_id, "sha": sha, **parsed})
                ev = parsed.get("evidence")
                summary = (
                    " ".join(f"{k}={v}" for k, v in ev.items()) if ev else "missing"
                )
                _append_mailbox_log(
                    mailbox,
                    f"- iter {iteration} | loop | slice {slice_id} @{sha[:12]} "
                    f"{parsed.get('verdict', '?')} evidence: {summary} "
                    f"attacks={parsed.get('attacks', 0)} (shadow)",
                )
                return
            pin = str(ctx.get("pinned_sha") or ctx.get("expected_sha") or ctx.get("sha") or "")
            probe = independent_probe(_integration_verdict_text(text))
            if probe is None:
                return
            kind = ctx.get("kind") or "lockstep"
            self._record_quality(
                f"{kind}@{pin[:12] or iteration}",
                {"kind": kind, "sha": pin, "iteration": iteration, "probe": probe},
            )
            if kind != "integration-eval":
                return  # lockstep: `.driver.json` only (LOG stays as before)
            _append_mailbox_log(
                mailbox,
                f"- iter {iteration} | loop | {kind} @{pin[:12]} probe: "
                f"{probe.get('status')}"
                + (f" -- {probe['reason']}" if probe.get("reason") else "")
                + " (shadow)",
            )
        except Exception as exc:  # noqa: BLE001 - shadow telemetry never raises
            print(f"trioctl: verdict quality telemetry skipped: {exc}", file=sys.stderr)

    # --- r18a shadow quality telemetry (never gates) -----------------------

    def _record_quality(self, key: str, values: dict[str, Any]) -> None:
        """Merge *values* into ``driver_meta['quality'][key]`` (`.driver.json`)."""
        with self._dict_lock():
            current = self.__dict__.get("driver_meta")
            current = dict(current) if isinstance(current, dict) else {}
            quality = dict(current.get("quality") or {})
            entry = dict(quality.get(key) or {})
            entry.update(values)
            quality[key] = entry
            current["quality"] = quality
            self.driver_meta = current  # rebind: the core may be serialising it

    def _slice_builder_record(
        self, mailbox: Path, context: dict[str, Any]
    ) -> tuple[bool, dict[str, Any] | None]:
        """(ledger readable, the builder run whose merge is this slice sha)."""
        if worker_worktrees is None:
            return False, None
        slice_id = str(context.get("slice") or "")
        sha = str(context.get("sha") or context.get("pinned_sha") or "").lower()
        if not slice_id or not sha:
            return False, None
        repo: Path = self.repo
        name = str(context.get("repo") or "").strip()
        if name and name != "home":
            declared = _declared_repos(mailbox) or {}
            if name in declared:
                repo = Path(declared[name]["path"])
        try:
            repo = worker_worktrees.repo_toplevel(repo)
            records = worker_worktrees.list_records(repo)
        except Exception:  # noqa: BLE001 - shadow telemetry never raises
            return False, None
        best = None
        for _wid, rec in records:
            if not isinstance(rec, dict) or rec.get("slice") != slice_id:
                continue
            merge = str(rec.get("merge_commit") or "").lower()
            if merge and (merge == sha or merge.startswith(sha) or sha.startswith(merge)):
                if best is None or _num(rec.get("created_at")) >= _num(best.get("created_at")):
                    best = rec
        return True, best

    def _quality_before_dispatch(
        self,
        role: str,
        iteration: int,
        mailbox: Path,
        context: dict[str, Any] | None,
    ) -> None:
        """Slice-eval: surface the builder run's kill check (or the Lead's
        authorship) in the OPEN-LOOP CONTEXT, log it once, record it."""
        if role != "evaluator" or not isinstance(context, dict):
            return
        if context.get("kind") != "slice-eval" or not self._isolate:
            return
        try:
            readable, rec = self._slice_builder_record(mailbox, context)
            if not readable:
                return
            slice_id = str(context.get("slice"))
            sha = str(context.get("sha") or context.get("pinned_sha"))
            if rec is None:
                facts: dict[str, Any] = {
                    "authored_by": "lead",
                    "kill_check": {"mode": "shadow", "outcome": "n/a",
                                   "reason": "no builder run merged this sha (Lead take-over or fix)"},
                }
            else:
                facts = {"authored_by": "builder", "worker": rec.get("id"),
                         "kill_check": rec.get("kill_check") or {
                             "mode": "shadow", "outcome": "n/a",
                             "reason": "not recorded (kill check off or pre-r18a trioctl)"}}
                if rec.get("verification_flags"):
                    facts["verification_flags"] = rec.get("verification_flags")
            kc = facts["kill_check"]
            lines = [
                "SLICE QUALITY (r18a shadow; informs your grading, gates nothing):",
                f"BASE-REVERT: {kc.get('outcome')}"
                + (f" -- {kc.get('reason')}" if kc.get("reason") else ""),
                f"AUTHORED-BY: {facts['authored_by']}",
            ]
            flags = facts.get("verification_flags") or []
            if flags:
                lines.append(
                    "PRE-GATE FLAGS (advisory AST lint; the following tests look "
                    "tautological -- grade them explicitly):"
                )
                lines.extend(f"- {f}" for f in flags[:20])
            context["quality_note"] = "\n".join(lines) + "\n"
            key = f"{slice_id}@{sha[:12]}"
            meta = self.__dict__.get("driver_meta")
            seen = isinstance(meta, dict) and key in (meta.get("quality") or {})
            self._record_quality(key, {"slice": slice_id, "sha": sha, **facts})
            if not seen:
                _append_mailbox_log(
                    mailbox,
                    f"- iter {iteration} | loop | retired slice {slice_id} @{sha[:12]} "
                    f"by {facts['authored_by']} | {kill_check_suffix(kc)} (shadow)",
                )
        except Exception as exc:  # noqa: BLE001 - shadow telemetry never raises
            print(f"trioctl: slice quality telemetry skipped: {exc}", file=sys.stderr)

    def _run_observed(
        self,
        role: str,
        iteration: int,
        mailbox: Path,
        context: dict[str, Any] | None,
    ) -> int:
        if not self._observe or worker_events is None:
            return self._run(role, iteration, mailbox, context)
        phase_id = worker_events.new_invocation_id()
        kind = None
        if context and context.get("mode") == "open-loop":
            kind = context.get("kind") or None
        self._observe_phase(
            "start", phase_id, role, iteration, open_loop_kind=kind
        )
        wall_start = time.time()
        outcome = "error"
        try:
            code = self._run(role, iteration, mailbox, context)
            outcome = "ok" if code == 0 else "failed"
            return code
        except KeyboardInterrupt:
            outcome = "interrupted"
            raise
        finally:
            extra: dict[str, Any] = {}
            if role in ("lead", "repair"):
                extra["wave_report"] = self._observed_wave_report(
                    mailbox, wall_start
                )
            self._observe_phase(
                "end",
                phase_id,
                role,
                iteration,
                outcome=outcome,
                open_loop_kind=kind,
                **extra,
            )

    def _run(
        self,
        role: str,
        iteration: int,
        mailbox: Path,
        context: dict[str, Any] | None,
    ) -> int:
        refusal = _held_dispatch_message(mailbox)
        if refusal:
            raise TrioctlError(refusal)
        if role in ("lead", "repair"):
            # r15 guard: never dispatch a pass over a PLAN that writes
            # outside the mailbox repo (the Lead would limp: take-overs,
            # empty merges, unresolvable retire shas).
            _refuse_repo_scope(mailbox, role, iteration, self.loop_core)
        registered_role = "lead" if role == "repair" else role
        agent_id = self._agent_id(registered_role)
        model = self._resolve_model(registered_role)
        prompt = self._prompt(role, iteration, mailbox, context)
        # Per-dispatch nonce: no two dispatches share a prompt hash, so a
        # completion receipt's injection sha256 binds to exactly this one.
        nonce = self._new_dispatch_nonce()
        self._dispatch_nonce = nonce  # last dispatch (back-compat only)
        if nonce:
            prompt += f"\nDispatch nonce: {nonce}\n"
        title = self._title(mailbox, iteration, role, context)
        dispatch: dict[str, Any] = {
            "role": role,
            "session_id": None,
            "fence": None,
            "delivery": None,
            "meta": {
                "role": role,
                "kind": (context or {}).get("kind"),
                "slice": (context or {}).get("slice"),
                "sha": (context or {}).get("sha"),
            },
        }
        eval_wt, eval_degraded = self._bind_slice_eval(
            role, iteration, mailbox, context, dispatch
        )
        # r15.x: every dispatch launched at the aggregate root (not bound to
        # its own eval worktree) holds the root turn; see `_enter_root_turn`.
        # r16 root-free: nothing runs at the root (the Lead works in its own
        # worktree, every eval in a detached one), so no turn is taken.
        at_root = eval_wt is None and self.__dict__.get("_root_free") is None
        if at_root:
            waited = self._enter_root_turn(
                role, mailbox, iteration, (context or {}).get("kind")
            )
            if (
                waited and role == "evaluator" and eval_degraded is None
                and self._repin_after_turn_wait(iteration, mailbox, context)
            ):
                # The core pinned before this dispatch waited; another
                # loop's turn moved the product meanwhile: grade the new pin.
                prompt = self._prompt(role, iteration, mailbox, context)
                if nonce:
                    prompt += f"\nDispatch nonce: {nonce}\n"
        try:
            if role in ("lead", "repair"):
                if at_root:
                    # This pass holds its own turn now: finished evaluators'
                    # sticky turns (held through `_finalize_ship`) end here,
                    # with their integration fences.
                    self._release_sticky_root_turns()
                # Cross-loop `writes:` refusal: every mode (r16-rc).
                self._check_writes_overlap(mailbox, iteration)
            return self._run_bound(
                role, iteration, mailbox, context, agent_id, model, prompt, title,
                dispatch, eval_wt, eval_degraded, nonce,
            )
        except (RootOccupiedError, WritesOverlapError) as exc:
            self.driver_stop = getattr(exc, "stop", None)
            raise
        finally:
            if at_root:
                if role == "evaluator" and eval_degraded is None:
                    # Held with the fence: released at the next Lead/repair
                    # dispatch or loop end (`release_root_turns`).
                    self._keep_root_turn_sticky()
                else:
                    self._exit_root_turn()

    def _run_bound(
        self,
        role: str,
        iteration: int,
        mailbox: Path,
        context: dict[str, Any] | None,
        agent_id: str,
        model: str,
        prompt: str,
        title: str,
        dispatch: dict[str, Any],
        eval_wt: dict[str, Any] | None,
        eval_degraded: str | None,
        nonce: str | None,
    ) -> int:
        """The dispatch proper (root turn, if any, already held by `_run`)."""
        workspace = self._workspace
        if self.__dict__.get("_root_free") is not None:
            # r16: nothing at the root to release or restore.
            self._root_free_prepare(role, iteration, mailbox, context, dispatch)
        elif eval_degraded is not None and worker_worktrees is not None:
            # Degraded slice-eval: the non-isolated path. The Lead may be
            # live at the root, so never wait for / release the root and
            # hold no integration fence (the evaluator grades its own
            # worktree at the pin); only baseline the root config once.
            self._snapshot_root_config()
        elif self._isolate and worker_worktrees is not None and eval_wt is None:
            # Root-bound dispatch (Lead, repair, lockstep evaluator,
            # integration-eval): the root must be free first.
            self._release_root(mailbox)
            self._prepare_root_config(mailbox)
            if role == "evaluator":
                # No worker merge may land while the aggregate is graded or
                # retired; held until the next Lead/repair dispatch after
                # this evaluation FINISHED, or loop end (acceptance is also
                # bound to the exact pin).
                token = worker_worktrees.acquire_fence(
                    self.repo, reason=f"{role} iteration {iteration}", mailbox=mailbox,
                )
                dispatch["fence"] = token
                with self._own_lock:
                    self._fence_tokens[token] = False
                # r15: every declared repo is graded (and retired) too; no
                # worker merge may land in any of them meanwhile.
                dispatch["repo_fences"] = []
                for declared in _declared_repos(mailbox).values():
                    extra = worker_worktrees.acquire_fence(
                        declared["path"], reason=f"{role} iteration {iteration}",
                        mailbox=mailbox,
                    )
                    dispatch["repo_fences"].append(extra)
                    with self._own_lock:
                        self._fence_tokens[extra] = False
                        self._fence_repos[extra] = Path(declared["path"])
            else:
                self._release_fences(finished_only=True)
        elif self._restore_root_nonisolated and worker_worktrees is not None and eval_wt is None:
            self._snapshot_root_config()
        if eval_wt is not None:
            workspace = eval_wt["path"]
            prompt = self._eval_workspace_preface(eval_wt, mailbox) + prompt
        client = self._client()
        started = time.monotonic()
        if role == "lead":
            before_text = _mailbox_text(mailbox / "LOG.md")
            before_mtime = _mailbox_mtime(mailbox / "LOG.md")
        else:
            before_text = _mailbox_text(mailbox / "VERDICT.md")
            before_mtime = _mailbox_mtime(mailbox / "VERDICT.md")
        if self._completion_receipts:
            dispatch["delivery"] = {
                "mailbox": mailbox,
                "prompt": prompt,
                "baseline_text": before_text,
                "base": _dispatch_provenance(
                    mailbox, self.repo, role, iteration, prompt, before_text,
                    context, agent_id=agent_id, model=model, title=title,
                    nonce=nonce,
                ),
            }
        dispatch["workspace"] = workspace
        dispatch["prompt_token"] = uuid.uuid4().hex
        _register_dispatch_prompt(
            dispatch["prompt_token"], mailbox, prompt, dispatch["meta"]
        )
        root_bound = eval_wt is None and self._manages_root_config()
        if root_bound:
            dispatch["root_mailbox"] = mailbox
        degraded_token = None
        if eval_degraded is not None:
            # A known root occupant until it ends (registered right before
            # the launch, dropped in the same critical section that records
            # its finished session): the Lead's next `_release_root` waits
            # for it instead of refusing an unknown cursor-agent.
            degraded_token = uuid.uuid4().hex
            with self._own_lock:
                self.__dict__.setdefault("_degraded_root_evals", {})[degraded_token] = {
                    "slice": (context or {}).get("slice"),
                    "sha": (context or {}).get("sha"),
                    "started": started,
                }
        try:
            code = self._run_dispatch(
                client, agent_id, model, prompt, title, role, iteration,
                mailbox, context, started, before_text, before_mtime,
                dispatch, workspace,
            )
        finally:
            _dispatch_prompt_update(
                dispatch.get("prompt_token"), ended=time.monotonic()
            )
            session_id = dispatch.get("session_id")
            if root_bound and session_id:
                try:
                    worker_worktrees.record_root_session(self.repo, session_id, mailbox)
                except Exception as exc:  # noqa: BLE001 - never mask the dispatch result
                    print(f"trioctl: could not record root session {session_id}: {exc}",
                          file=sys.stderr)
            with self._own_lock:
                if session_id:
                    self._inflight.discard(session_id)
                    self.__dict__.setdefault("_inflight_meta", {}).pop(session_id, None)
                    self._delivery.pop(session_id, None)
                if dispatch.get("fence"):
                    self._fence_tokens[dispatch["fence"]] = True  # finished
                for extra in dispatch.get("repo_fences") or ():
                    self._fence_tokens[extra] = True
                if root_bound and session_id:
                    self._root_finished.append(
                        {"session_id": session_id, "role": role, "workspace": workspace}
                    )
                if degraded_token is not None:
                    self.__dict__.setdefault("_degraded_root_evals", {}).pop(
                        degraded_token, None
                    )
            if eval_wt is not None:
                self._release_eval_worktree(eval_wt, session_id)
        if root_bound and role == "evaluator" and code == 0 and dispatch.get("session_id"):
            # The loop core grades acceptance right after this returns.
            if self._isolate and eval_degraded is None:
                self._end_root_evaluator(mailbox, dispatch["session_id"])
            else:
                self._end_root_sessions_nonisolated(mailbox)
        if root_bound and role in ("lead", "repair") and dispatch.get("session_id"):
            # r15.x: the Lead/repair session ends with its root turn.
            if self._isolate:
                self._end_root_session(mailbox, dispatch["session_id"], role)
            else:
                self._end_root_sessions_nonisolated(mailbox)
        if role in ("lead", "repair") and code == 0:
            # r15 guard on the PLAN this pass wrote: the driver ends with
            # `status: error` (exit 3) before any evaluator is dispatched.
            _refuse_repo_scope(mailbox, role, iteration, self.loop_core)
        return code

    def _eval_workspace_preface(self, eval_wt: dict[str, Any], mailbox: Path) -> str:
        """The ISOLATED EVALUATOR WORKSPACE line of a worktree-bound eval."""
        rf = self.__dict__.get("_root_free")
        if eval_wt.get("integration") and rf is not None:
            declared = "".join(
                f" The declared repo `{d['repo_name']}` is checked out at its pin "
                f"`{d['base']}` in `{d['path']}`."
                for d in eval_wt.get("declared_evals") or []
            )
            return (
                "ISOLATED EVALUATOR WORKSPACE: this session's workspace is the "
                f"task-owned detached worktree `{eval_wt['path']}` at the "
                f"integration pin `{eval_wt['base']}`.{declared} Grade inside it and "
                "do NOT run `git worktree add`/`remove`; never commit in it and "
                "leave it clean. Write VERDICT.md/QUEUE.md only under the absolute "
                f"mailbox `{mailbox}`, and make the SHIP retirement commit(s) in "
                f"the loop's Lead worktree `{rf['lead']}` with `git -C` (see the "
                "ROOT-FREE lines of the OPEN-LOOP CONTEXT).\n\n"
            )
        of_repo = (
            f" (a checkout of the declared repo `{eval_wt['repo_name']}`)"
            if eval_wt.get("repo_name") else ""
        )
        return (
            "ISOLATED EVALUATOR WORKSPACE: this session's workspace is "
            f"the task-owned detached worktree `{eval_wt['path']}`{of_repo} at "
            f"`{eval_wt['base']}`. For step 2 grade inside it and do NOT "
            "run `git worktree add`/`remove`. Leave it clean. Write "
            f"VERDICT.md/QUEUE.md only under the absolute mailbox "
            f"`{mailbox}`.\n\n"
        )

    # ---------------------------------------------------- r16 root-free

    def _bind_root_free_eval(
        self,
        role: str,
        iteration: int,
        mailbox: Path,
        context: dict[str, Any] | None,
        dispatch: dict[str, Any],
    ) -> tuple[dict[str, Any] | None, str | None]:
        """Root-free eval binding: a worktree, or no dispatch -- never the root.

        Slice-eval: a detached worktree at its pin; integration-eval: a
        detached worktree at the integration pin (declared repos at theirs,
        nested ones inside it). The bind is tried twice. A slice-eval that
        still cannot bind is logged (`eval_isolation_failed`) and not
        dispatched (`_EvalBindSkipped`: the loop core retries it, then stops
        with `status: error`); an integration-eval raises (the driver ends
        with a terminal STATE).
        """
        kind = (context or {}).get("kind")
        if role != "evaluator" or kind not in ("slice-eval", "integration-eval"):
            return None, None
        last: BaseException | None = None
        for _attempt in range(2):
            try:
                if kind == "slice-eval":
                    return self._slice_eval_worktree(role, mailbox, context), None
                return self._integration_eval_worktree(mailbox, context or {}), None
            except Exception as exc:  # noqa: BLE001 - retried once, then refused
                last = exc
        reason = str(last) if isinstance(last, TrioctlError) else f"{type(last).__name__}: {last}"
        reason = " ".join(reason.split())
        if kind == "integration-eval":
            raise TrioctlError(
                "cannot bind the integration-eval worktree (root-free runs never "
                f"grade at the repository root): {reason}"
            )
        slice_id = (context or {}).get("slice") or "?"
        sha = str((context or {}).get("sha") or "")[:12]
        dispatch["meta"]["eval_isolation"] = f"failed ({reason})"
        print(
            f"trioctl: slice-eval {slice_id}@{sha}: eval_isolation_failed ({reason}); "
            "not dispatched (no root fallback)",
            file=sys.stderr,
        )
        _append_mailbox_log(
            mailbox,
            f"- iter {iteration} | loop | slice-eval {slice_id} @{sha} "
            f"eval_isolation_failed ({reason}); not graded, retried by the loop",
        )
        raise _EvalBindSkipped(reason)

    def _integration_eval_worktree(
        self, mailbox: Path, context: dict[str, Any]
    ) -> dict[str, Any]:
        """Detached worktree(s) at the integration pin(s) (root-free, r16)."""
        wt = _require_worktrees()
        root = (self._isolate or {}).get("worktree_root")
        pin = str(context.get("pinned_sha") or context.get("sha") or "").strip()
        if not pin:
            raise TrioctlError("integration-eval context has no pinned sha")
        try:
            record = wt.create(
                self.repo, slice_id="integration", mailbox=mailbox,
                root=Path(root) if root else None, role="evaluator", detach_at=pin,
            )
        except (wt.WorktreeError, OSError, subprocess.SubprocessError) as exc:
            raise TrioctlError(f"cannot bind integration-eval worktree: {exc}") from exc
        record["integration"] = True
        record["declared_evals"] = []
        try:
            wt.mark_running(self.repo, record, None)
            pins = dict(context.get("pins") or {})
            for name, declared in _declared_repos(mailbox).items():
                agg = Path(declared["path"])
                rpin = pins.get(name) or wt.rev(agg, "HEAD")
                try:
                    nested = agg.resolve().relative_to(self.repo)
                except ValueError:
                    nested = None
                if nested is not None:
                    sub = root_free.add_detached_eval(
                        wt, agg, Path(record["path"]) / nested, str(rpin),
                        mailbox=mailbox, repo_name=name,
                    )
                else:
                    sub = wt.create(
                        agg, slice_id=f"integration-{name}", mailbox=mailbox,
                        root=_repo_worktree_root(agg, name, root), role="evaluator",
                        detach_at=str(rpin), repo_name=name,
                    )
                wt.mark_running(agg, sub, None)
                record["declared_evals"].append(sub)
        except Exception as exc:
            self._discard_eval_worktree(record, exc)
            for sub in record.get("declared_evals") or []:
                self._discard_eval_worktree(sub, exc)
            raise TrioctlError(
                f"cannot bind integration-eval worktree: {type(exc).__name__}: {exc}"
            ) from exc
        return record

    def _root_free_prepare(
        self,
        role: str,
        iteration: int,
        mailbox: Path,
        context: dict[str, Any] | None,
        dispatch: dict[str, Any],
    ) -> None:
        """Per-dispatch bookkeeping of a root-free run (no root access).

        Lead/repair: release the fences of finished integration-evals.
        Integration-eval: fence this loop's own aggregate(s) (per-branch
        fences: other loops' builders are never retained) and log how far the
        target advanced since the fork (the land merges it).
        """
        if role in ("lead", "repair"):
            self._release_fences(finished_only=True)
            return
        if role != "evaluator" or (context or {}).get("kind") != "integration-eval":
            return
        token = worker_worktrees.acquire_fence(
            self.repo, reason=f"{role} iteration {iteration}", mailbox=mailbox,
        )
        dispatch["fence"] = token
        with self._own_lock:
            self._fence_tokens[token] = False
        dispatch["repo_fences"] = []
        for declared in _declared_repos(mailbox).values():
            extra = worker_worktrees.acquire_fence(
                declared["path"], reason=f"{role} iteration {iteration}", mailbox=mailbox,
            )
            dispatch["repo_fences"].append(extra)
            with self._own_lock:
                self._fence_tokens[extra] = False
                self._fence_repos[extra] = Path(declared["path"])
        rf = self._root_free or {}
        target = rf.get("target")
        if target:
            ahead = worker_worktrees.git(
                self.repo, "rev-list", "--count", f"HEAD..refs/heads/{target}", check=False,
            ).stdout.strip()
            if ahead.isdigit() and int(ahead) > 0:
                _append_mailbox_log(
                    mailbox,
                    f"- iter {iteration} | loop | target {target} advanced by {ahead} "
                    f"commit(s) since {rf.get('branch')} forked; the land merges it",
                )

    def _release_fences(self, *, finished_only: bool) -> None:
        """Release this runner's fence tokens (finished evaluations only, or all)."""
        with self._own_lock:
            tokens = [
                t for t, finished in self._fence_tokens.items()
                if finished or not finished_only
            ]
            for token in tokens:
                self._fence_tokens.pop(token, None)
            repos = {token: self._fence_repos.pop(token, self.repo) for token in tokens}
        for token in tokens:
            # eval-r15 N5: each token on its own -- one vanished repo must
            # not leak the fences of the others.
            try:
                worker_worktrees.release_fence(repos[token], token)
            except Exception as exc:  # noqa: BLE001 - release the rest
                print(
                    f"trioctl: could not release merge fence {token} in "
                    f"{repos[token]}: {type(exc).__name__}: {exc}",
                    file=sys.stderr,
                )

    def release_all_fences(self) -> None:
        """Loop end: no evaluation of this runner can still be running."""
        if worker_worktrees is not None:
            self._release_fences(finished_only=False)

    def _release_eval_worktree(
        self, eval_wt: dict[str, Any], session_id: str | None
    ) -> None:
        """Record this dispatch's own session and end its claim."""
        try:
            ledger = _ledger_repo(eval_wt, self.repo)
            record = worker_worktrees.load_record(ledger, eval_wt["id"])
            if session_id:
                record.setdefault("session_ids", []).append(session_id)
            worker_worktrees.save_record(ledger, record)
            worker_worktrees.mark_finished(ledger, eval_wt["id"])
            for sub in eval_wt.get("declared_evals") or ():
                worker_worktrees.mark_finished(_ledger_repo(sub, self.repo), sub["id"])
        except Exception as exc:  # noqa: BLE001 - never mask the dispatch result
            print(
                f"trioctl: could not update evaluator worktree record "
                f"{eval_wt.get('id')}: {exc}",
                file=sys.stderr,
            )

    def _run_dispatch(
        self,
        client: Any,
        agent_id: str,
        model: str,
        prompt: str,
        title: str,
        role: str,
        iteration: int,
        mailbox: Path,
        context: dict[str, Any] | None,
        started: float,
        before_text: str,
        before_mtime: Any,
        dispatch: dict[str, Any],
        workspace: str,
    ) -> int:
        try:
            snapshot, items = self._create_wait_read(
                client, agent_id, model, prompt, title, role, started,
                workspace=workspace, dispatch=dispatch,
            )
            if _session_status(snapshot) in SESSION_FAILURE_STATUSES:
                return 1
            if self._is_restart_blip(snapshot, items):
                # Empty items on an unbound runner do not prove the turn
                # never ran: hold the session below, never re-send.
                raise TrioctlError(
                    f"session {dispatch.get('session_id')}: runner "
                    "unbound and no items after the wait; the prompt "
                    "was already submitted and is not re-sent"
                )
            # Same session: wait is not role completion. Keep polling
            # until LOG.md / VERDICT.md shows this pass's artifact.
            snapshot = self._wait_for_role_artifact(
                client,
                role,
                iteration,
                mailbox,
                started,
                before_text,
                before_mtime,
                context,
                session_id=dispatch.get("session_id"),
            )
        except broker_http.PromptDeliveryUncertain as exc:
            # A copy may still be queued or running: never re-dispatch
            # or prune it; record it durably and stop for a human. When the
            # only saved user row is a sibling dispatch's prompt, the chat
            # binding was cross-wired (r14 S-1): classify it, still held.
            crosswire = self._crosswire_hold(
                client, exc.session_id, mailbox, dispatch
            )
            self._hold_dispatch(
                mailbox, exc.session_id, role, iteration, title, context,
                exc,
                "mirror_crosswired" if crosswire else "first_prompt_uncertain",
                extra=crosswire,
            )
        except (TrioctlError, broker_http.BrokerHttpError) as exc:
            # This dispatch's own session (a concurrent role's create must
            # never be held or accepted in its place).
            session_id = dispatch.get("session_id")
            if session_id is None:
                # Nothing was delivered (or create said so definitely).
                if isinstance(exc, TrioctlError):
                    raise
                raise TrioctlError(str(exc)) from exc
            # Delivered is not completed. Last-chance accept: a fresh,
            # valid artifact for this attempt/pin is this role's result
            # even when a wait raised at the deadline. Repair has no
            # artifact check (only session idle), so it is never accepted;
            # nor is open-loop slice-eval, whose check only requires this
            # dispatch's own new `## slice <id> @<sha>` heading in VERDICT.md
            # and so cannot tell a finished section from a partial one (the
            # heading can land before the body).
            slice_eval = bool(context and context.get("kind") == "slice-eval")
            if role != "repair" and not slice_eval and _role_artifact_ready(
                mailbox, role, iteration, before_text, before_mtime, context
            ):
                return 0
            # The pane may still be working: no DELETE, no new dispatch.
            self._hold_dispatch(
                mailbox, session_id, role, iteration, title, context,
                exc, "role_completion_uncertain",
            )
        if _session_status(snapshot) in SESSION_FAILURE_STATUSES:
            return 1
        return 0

    def _hold_dispatch(
        self,
        mailbox: Path,
        session_id: str,
        role: str,
        iteration: int,
        title: str,
        context: dict[str, Any] | None,
        exc: Exception,
        hold: str,
        extra: dict[str, Any] | None = None,
    ) -> NoReturn:
        """Record a dispatch that may still run, mark STATE, and raise.

        A dispatch whose provenance was saved at create also embeds it
        (``provenance``), which `omnigent reconcile` needs; a record
        without it stays held for a person.
        """
        with self._dict_lock():
            self.held_session_ids.append(session_id)
        record = {
            "session_id": session_id,
            "role": role,
            "iteration": iteration,
            "title": title,
            "hold": hold,
            "reason": str(exc),
            "recorded_at": time.strftime(
                "%Y-%m-%dT%H:%M:%SZ", time.gmtime()
            ),
        }
        if hold == "mirror_crosswired":
            record["reason"] = "mirror_crosswired"
            record["detail"] = str(exc)
        if extra:
            record.update(extra)
        for key, field in (
            ("evaluator_attempt", "attempt"),
            ("pinned_sha", "pinned_sha"),
            ("kind", "kind"),
            ("slice", "slice"),
        ):
            if context and context.get(key):
                record[field] = context[key]
        provenance = self._final_provenance(role, session_id)
        if provenance is not None:
            record["provenance"] = provenance
        try:
            path = _write_held_record(mailbox, record)
        except OSError as write_exc:
            # No durable record: still try to stop a resume via STATE.
            try:
                _mark_mailbox_held(
                    mailbox,
                    record,
                    _held_record_path(mailbox, session_id),
                )
            except OSError:
                pass
            raise TrioctlError(
                f"{exc}; could NOT record the held dispatch "
                f"({write_exc}): do not resume {mailbox.name} until "
                f"session {session_id} is resolved"
            ) from exc
        try:
            _mark_mailbox_held(mailbox, record, path)
        except OSError as mark_exc:
            print(
                f"trioctl: could not update LOG.md/STATE.md for the "
                f"held dispatch ({mark_exc}); {path} still blocks resume",
                file=sys.stderr,
            )
        raise TrioctlError(f"{exc}; held dispatch recorded at {path}") from exc

    def _wait_for_role_artifact(
        self,
        client: Any,
        role: str,
        iteration: int,
        mailbox: Path,
        started: float,
        before_text: str,
        before_mtime: float,
        context: dict[str, Any] | None = None,
        *,
        session_id: str | None = None,
    ) -> Any:
        """Re-enter wait on this session until the role artifact exists.

        *session_id* is this dispatch's own session (the dispatch path
        always passes it; the per-role ``session_ids`` fallback is only for
        direct callers, since concurrent slice-evals share the role).
        """
        if session_id is None:
            session_id = self.session_ids.get(role)
        if session_id is None:
            raise TrioctlError(f"role {role} has no session id")
        snapshot: Any = {"id": session_id, "status": "idle"}
        while not _role_artifact_ready(
            mailbox, role, iteration, before_text, before_mtime, context
        ):
            remaining = self._timeout - (time.monotonic() - started)
            if remaining <= 0:
                # Last-chance accept: a valid fresh artifact that landed
                # as the timer expired is this attempt. Stale/partial
                # files stay uncertain (timeout), never SHIP.
                if _role_artifact_ready(
                    mailbox,
                    role,
                    iteration,
                    before_text,
                    before_mtime,
                    context,
                ):
                    break
                raise TrioctlError(
                    f"session {session_id} timed out after "
                    f"{self._timeout:g} seconds"
                )
            snapshot = self._wait(
                client, session_id, timeout=remaining,
                **_slice_eval_kind(context),
            )
            if _session_status(snapshot) in SESSION_FAILURE_STATUSES:
                return snapshot
            self._read(client, session_id)
            # Bound GET /items + GET /session when idle dwell is 0.
            # interval=0 stays sleep-free so fake-broker tests stay fast.
            if self._interval > 0:
                remaining = self._timeout - (
                    time.monotonic() - started
                )
                if remaining > 0:
                    time.sleep(min(self._interval, remaining))
        return snapshot


#: Loop-core contract this trioctl drives (``LOOP_CORE_API`` in
#: metrics/trio_loop.py). A core without the constant predates it (1).
REQUIRED_LOOP_CORE_API = 2


#: The sibling module trio_loop.py imports by path (``METRICS_API``): this
#: release's metrics/ set (5 = declared product repos, r15; 6 = root-free
#: open-loop, r16).
REQUIRED_METRICS_API = 6

#: Vendored metrics/ sets this trioctl still drives. A repository whose
#: copy predates r15 (4) runs single-repo mailboxes unchanged; a PLAN.md
#: `repos:` block is refused with it (see ``_old_core_repos_refusal``). A
#: copy before r16 (4, 5) runs lockstep and `--root-bound` open-loop
#: unchanged; a root-free open-loop run is refused with it
#: (``_old_core_root_free_refusal``).
COMPATIBLE_METRICS_APIS = (4, 5, 6)

#: First METRICS_API whose loop core pins, retires and verifies per repo.
MULTI_REPO_METRICS_API = 5

#: First METRICS_API whose loop core takes the root-free `land=` hook (r16).
ROOT_FREE_METRICS_API = 6


def _api_marker(path: Path, name: str) -> int:
    """The single literal module-level int ``name`` of *path*, read without executing it.

    Missing means 1 (predates the marker). Any other binding of *name* at
    module level (a second assignment, an annotated, augmented or
    non-literal one) makes the marker ambiguous: 0, which never matches.
    """
    try:
        source = path.read_bytes()
    except OSError as exc:
        raise TrioctlError(f"cannot read {path}: {exc}") from exc
    return _api_marker_source(source, name, str(path))


def _api_marker_source(source: bytes, name: str, filename: str) -> int:
    """`_api_marker` of module source bytes (e.g. a file at a git revision)."""
    import ast

    try:
        tree = ast.parse(source, filename=filename)
    except (SyntaxError, ValueError) as exc:
        raise TrioctlError(f"cannot read {filename}: {exc}") from exc
    values: list[int] = []
    for node in tree.body:
        if isinstance(node, ast.Assign) and [getattr(t, "id", None) for t in node.targets] == [name]:
            ok = isinstance(node.value, ast.Constant) and type(node.value.value) is int
            values.append(node.value.value if ok else 0)
        elif isinstance(node, (ast.AnnAssign, ast.AugAssign)) and getattr(node.target, "id", None) == name:
            values.append(0)
        elif isinstance(node, ast.Assign) and any(
            name in {getattr(e, "id", None) for e in ast.walk(t)} for t in node.targets
        ):
            values.append(0)
    if not values:
        return 1
    return values[0] if len(values) == 1 else 0


def _loop_core_api(path: Path) -> int:
    """The literal module-level ``LOOP_CORE_API`` of *path* (see :func:`_api_marker`)."""
    return _api_marker(path, "LOOP_CORE_API")


def _bundled_metrics_hint() -> str:
    """Where a matching metrics/ set comes from (eval-r15 N9).

    A release tree (RELEASE/omnigent/trioctl) has RELEASE/metrics next to
    it; the plain install.sh layout (~/.local/bin/trioctl) has no loop core
    beside it, so it names the source checkout instead of a path that does
    not exist (~/.local/metrics).
    """
    bundled = Path(__file__).resolve().parent.parent / "metrics"
    if (bundled / "trio_loop.py").is_file():
        return f"{bundled} (the release this trioctl belongs to)"
    return (
        "the metrics/ directory of the Trio release or checkout this trioctl "
        "was installed from"
    )


def _refuse_core(path: Path, what: str) -> TrioctlError:
    import hashlib

    try:
        digest = hashlib.sha256(path.read_bytes()).hexdigest()[:16]
    except OSError:
        digest = "unreadable"
    return TrioctlError(
        f"incompatible loop core {path} (sha256 {digest}…): {what}. Refresh the "
        f"repository's metrics/ as a set (trio_loop.py, trio-metrics.py, trio-shadow.py, "
        f"trio-check.py) from {_bundled_metrics_hint()} "
        "and commit it, or run the trioctl release that matches the vendored "
        "copy. Nothing was changed."
    )


def _check_loop_core_api(path: Path) -> None:
    """Refuse a loop core whose contract differs from what this trioctl drives.

    trioctl loads the repository's own ``metrics/trio_loop.py`` and that
    file loads its sibling ``trio-metrics.py``. A copy (or one of the two)
    vendored before an upgrade would otherwise run silently -- e.g. an
    unbound open-loop SHIP that can never be accepted -- so a mismatch is a
    clear refusal; the repository's files are never rewritten.
    """
    found = _loop_core_api(path)
    if found != REQUIRED_LOOP_CORE_API:
        raise _refuse_core(
            path, f"LOOP_CORE_API {found}, this trioctl requires {REQUIRED_LOOP_CORE_API}"
        )
    metrics = path.with_name("trio-metrics.py")
    if not metrics.is_file():
        raise _refuse_core(path, f"its sibling {metrics.name} is missing")
    found = _api_marker(metrics, "METRICS_API")
    if found not in COMPATIBLE_METRICS_APIS:
        raise _refuse_core(
            path, f"sibling {metrics.name} has METRICS_API {found}, this trioctl "
            f"requires {REQUIRED_METRICS_API} (or {MULTI_REPO_METRICS_API} without "
            f"root-free open-loop, {min(COMPATIBLE_METRICS_APIS)} also without "
            "PLAN.md repos:) (mixed metrics/ versions)"
        )


def _core_metrics_api(loop_core: Any) -> int:
    """METRICS_API a loaded loop core can honour (1 = unmarked).

    The lower of the core's own ``METRICS_API`` marker and its sibling
    metrics module's (eval-r15 N3): a core that predates r15 carries no
    marker and counts as below ``MULTI_REPO_METRICS_API`` even next to a
    refreshed trio-metrics.py.
    """
    value = getattr(getattr(loop_core, "_METRICS", None), "METRICS_API", 1)
    metrics_api = value if isinstance(value, int) else 1
    core_api = getattr(loop_core, "METRICS_API", None)
    if not isinstance(core_api, int):
        core_api = min(metrics_api, MULTI_REPO_METRICS_API - 1)
    return min(metrics_api, core_api)


def _old_core_repos_refusal(mailbox: Path, loop_core: Any) -> str | None:
    """Refusal line when *mailbox* declares `repos:` but *loop_core* predates r15."""
    api = _core_metrics_api(loop_core)
    if api >= MULTI_REPO_METRICS_API:
        return None
    _module, metrics = _load_trio_check()
    if not metrics.read_repos(Path(mailbox))["declared"]:
        return None
    where = getattr(loop_core, "__file__", None) or "metrics/trio_loop.py"
    # Used before any dispatch and after a Lead/repair pass alike: say what
    # holds in both (eval-r15 N9), never "nothing was dispatched".
    return (
        f"PLAN.md declares repos: (r15 multi-repo slices) but the loop core "
        f"{where} runs on METRICS_API {api}; multi-repo needs "
        f"{MULTI_REPO_METRICS_API}: refresh the repository's metrics/ as a set "
        f"from {_bundled_metrics_hint()} and commit it (no further role is "
        "dispatched)"
    )


def _load_trio_loop(repo: Path) -> Any:
    """Load loop-core by path so the ``omnigent`` directory is not a package."""
    path = repo / "metrics" / "trio_loop.py"
    if not path.is_file():
        raise TrioctlError(f"loop core is missing: {path}")
    _check_loop_core_api(path)
    loader = importlib.machinery.SourceFileLoader("trio_loop", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None or spec.loader is None:
        raise TrioctlError(f"cannot load loop core from {path}")
    module = importlib.util.module_from_spec(spec)
    try:
        loader.exec_module(module)
    except Exception as exc:  # noqa: BLE001 - any load failure is a refusal
        raise _refuse_core(path, f"loading it failed ({type(exc).__name__}: {exc})") from exc
    if not callable(getattr(module, "run_loop", None)):
        raise TrioctlError(f"{path} does not expose run_loop")
    if worker_worktrees is not None and hasattr(module, "owned_residue_check"):
        # The same Omnigent-residue fingerprint trioctl restores by.
        module.owned_residue_check = worker_worktrees.owned_residue
    return module


def _start_observation(mailbox: Path) -> dict[str, Any] | None:
    """Mint a fresh run id and directory under the mailbox, or None.

    Each `loop` invocation (including a resume) is its own observation
    run; iteration labels join runs. Failure only disables observation.
    """
    if worker_events is None:
        print(
            "trioctl: --observe-workers unavailable (worker_events.py "
            "missing); continuing without observation",
            file=sys.stderr,
        )
        return None
    stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
    run_id = f"obs-{stamp}-{worker_events.new_invocation_id()[:8]}"
    directory = mailbox / ".observe" / run_id
    try:
        directory.mkdir(parents=True, exist_ok=False)
    except OSError:
        print(
            "trioctl: --observe-workers could not create its run "
            "directory; continuing without observation",
            file=sys.stderr,
        )
        return None
    paths = worker_events.observe_paths(directory)
    return {
        "run_id": run_id,
        "dir": directory,
        "workers": paths["workers"],
        "phases": paths["phases"],
        "summary": paths["summary"],
        "trioctl": Path(__file__).resolve(),
    }


def _finish_observation(observe: dict[str, Any]) -> None:
    """Write summary.json and print short lines. Never raises."""
    try:
        summary = worker_events.summarize(observe["dir"], observe["run_id"])
        observe["summary"].write_text(
            json.dumps(summary, indent=2, sort_keys=True) + "\n",
            encoding="utf-8",
        )
        for line in worker_events.summary_lines(summary):
            print(f"trioctl: {line}", file=sys.stderr)
        print(f"trioctl: observe summary: {observe['summary']}", file=sys.stderr)
    except Exception:  # noqa: BLE001 - never change the loop exit code
        print(
            "trioctl: observe summary failed; raw events kept in "
            f"{observe.get('dir')}",
            file=sys.stderr,
        )


def command_observe_summary(args: argparse.Namespace) -> int:
    """Recompute one observed run's summary offline (e.g. after SIGKILL)."""
    if worker_events is None:
        raise TrioctlError("worker_events.py is not installed next to trioctl")
    directory = Path(args.mailbox).expanduser().resolve() / ".observe" / args.run_id
    if not directory.is_dir():
        raise TrioctlError(f"no observe run directory: {directory}")
    print(
        json.dumps(
            worker_events.summarize(directory, args.run_id),
            indent=2,
            sort_keys=True,
        )
    )
    return 0


#: `loop` default for `--slice-eval-concurrency` (qualified at 4 in r10).
#: `--slice-eval-concurrency 1` keeps the serial slice-eval path.
DEFAULT_SLICE_EVAL_CONCURRENCY = 4

OLD_CORE_SERIAL_WARNING = (
    "trioctl: vendored loop core predates concurrent slice-eval; running "
    "serial (refresh metrics/ to enable)"
)
LOCKSTEP_CONCURRENCY_NOTICE = (
    "trioctl: lockstep mode: slice-eval concurrency not applicable"
)


def _slice_eval_concurrency_kwargs(
    loop_core: Any,
    args: argparse.Namespace,
    *,
    isolation_off: str | None = None,
) -> dict[str, Any]:
    """Resolve `--slice-eval-concurrency N` / `--slice-eval-drain-seconds`.

    Not given, N defaults to ``DEFAULT_SLICE_EVAL_CONCURRENCY`` (4). The
    default degrades to 1 (the serial path, call unchanged) with one stderr
    line when the loop core's run_loop predates the kwarg, and silently when
    worker isolation is off (*isolation_off* names why). An EXPLICIT N>1 is
    refused in both cases: against an old core as before, and without
    isolation because concurrent slice-evals would share the root checkout.
    Returns {} whenever the resolved call is the pre-r10 serial one.
    """
    raw = getattr(args, "slice_eval_concurrency", None)
    explicit = raw is not None
    value = DEFAULT_SLICE_EVAL_CONCURRENCY if raw is None else raw
    if isinstance(value, bool) or not isinstance(value, int) or value < 1:
        raise TrioctlError("--slice-eval-concurrency must be an integer >= 1")
    drain = getattr(args, "slice_eval_drain_seconds", None)
    if drain is not None and (
        isinstance(drain, bool)
        or not isinstance(drain, (int, float))
        or not math.isfinite(drain)
        or drain < 0
    ):
        raise TrioctlError("--slice-eval-drain-seconds must be a number >= 0")
    if value > 1 and isolation_off is not None:
        if explicit:
            raise TrioctlError(
                f"--slice-eval-concurrency {value} refused: concurrent "
                f"slice-evals need worker isolation, which is off "
                f"({isolation_off}); drop --no-isolate-workers or pass "
                "--slice-eval-concurrency 1"
            )
        value = 1
    try:
        params = inspect.signature(loop_core.run_loop).parameters
    except (TypeError, ValueError):
        params = {}
    if value > 1 and "slice_eval_concurrency" not in params:
        if explicit:
            raise TrioctlError(
                "--slice-eval-concurrency refused: this loop core's run_loop "
                "does not support concurrent slice-evals"
            )
        print(OLD_CORE_SERIAL_WARNING, file=sys.stderr)
        value = 1
    kwargs: dict[str, Any] = {}
    if value != 1:
        kwargs["slice_eval_concurrency"] = value
    if drain is not None:
        if "slice_eval_drain_seconds" not in params:
            raise TrioctlError(
                "--slice-eval-drain-seconds refused: this loop core's run_loop "
                "does not support a slice-eval drain budget"
            )
        kwargs["slice_eval_drain_seconds"] = float(drain)
    return kwargs


def _loop_is_lockstep(mailbox: Path) -> bool:
    """True when `run_loop(mode="auto")` will take the lockstep path."""
    return not (Path(mailbox) / "QUEUE.md").is_file()


def _isolation_default_unavailable(reason: str) -> None:
    print(
        f"trioctl: worker isolation unavailable ({reason}); running without "
        "isolation and with serial slice-evals (pass --no-isolate-workers to "
        "silence)",
        file=sys.stderr,
    )


#: Off reason (and notice) of the lockstep carve-out: a lockstep mailbox (no
#: QUEUE.md) keeps worker isolation OFF unless `--isolate-workers` is given.
LOCKSTEP_ISOLATION_OFF = "lockstep mode"
LOCKSTEP_ISOLATION_NOTICE = (
    "trioctl: lockstep mode: worker isolation stays off by default "
    "(open-loop is the fast path; pass --isolate-workers to opt in)"
)


def _resolve_isolation(
    args: argparse.Namespace, repo: Path, mailbox: Path | None = None
) -> tuple[dict[str, Any] | None, str | None]:
    """Resolve worker isolation: ``(isolate config or None, off reason)``.

    Default ON for an open-loop mailbox (QUEUE.md present). A lockstep
    *mailbox* (no QUEUE.md; lockstep+isolation was never qualified live)
    keeps it OFF with one stderr notice unless ``--isolate-workers`` is
    explicit. ``--no-isolate-workers`` turns it off; ``--isolate-workers``
    makes every prerequisite (including a branch checkout) a hard refusal.
    When it is only the default, a missing prerequisite (worktree module,
    git branch checkout, `--observe-workers`, inherited session-bound Cursor
    bindings) degrades to the pre-r11 non-isolated run with one stderr line.
    Isolation is trioctl-only: it does not depend on the vendored loop core.
    The worktree root is `--worktree-root`, else
    `worker_worktrees.default_worktree_root` (``$TRIO_WORKTREE_ROOT``, else
    ``$XDG_STATE_HOME``/``~/.local/state`` ``/trio-agent-loop/worktrees/
    <repo-name>-<sha256(git common dir)[:12]>``, outside the repository,
    created on the first worktree).
    """
    raw = getattr(args, "isolate_workers", None)
    if raw is False:
        return None, "--no-isolate-workers"
    explicit = raw is True
    if not explicit and mailbox is not None and _loop_is_lockstep(mailbox):
        print(LOCKSTEP_ISOLATION_NOTICE, file=sys.stderr)
        return None, LOCKSTEP_ISOLATION_OFF
    if worker_worktrees is None:
        if explicit:
            _require_worktrees()
        reason = "worker_worktrees.py is not installed next to trioctl"
        _isolation_default_unavailable(reason)
        return None, reason
    wt = worker_worktrees
    if getattr(args, "observe_workers", False):
        if explicit:
            raise TrioctlError(
                "--isolate-workers and --observe-workers each prescribe the one "
                "worker dispatch command; they cannot be combined yet"
            )
        reason = "--observe-workers prescribes its own worker command"
        _isolation_default_unavailable(reason)
        return None, reason
    toplevel = repo
    try:
        toplevel = wt.repo_toplevel(repo)
        branch = wt.git(
            toplevel, "symbolic-ref", "-q", "HEAD", check=False
        ).stdout.strip()
    except (OSError, wt.WorktreeError) as exc:
        if explicit:
            raise TrioctlError(
                f"cannot derive a worktree root: not a git checkout ({exc})"
            ) from exc
        reason = "not a git checkout"
        _isolation_default_unavailable(reason)
        return None, reason
    if not branch.startswith("refs/heads/"):
        if explicit:
            raise TrioctlError(
                "--isolate-workers refused: checkout is not on a branch "
                "(detached HEAD); isolated workers merge back onto a branch. "
                "Check out a branch, or drop --isolate-workers"
            )
        reason = "checkout is not on a branch (detached HEAD)"
        _isolation_default_unavailable(reason)
        return None, reason
    inherited = wt.inherited_cursor_problems()
    if inherited:
        if explicit:
            raise TrioctlError(
                "--isolate-workers refused: Cursor user/system config carries "
                "session-bound Omnigent bindings that every worker would load "
                "(trioctl never edits it): " + "; ".join(inherited)
            )
        reason = (
            "Cursor user/system config carries session-bound Omnigent "
            "bindings: " + "; ".join(inherited)
        )
        _isolation_default_unavailable(reason)
        return None, reason
    if getattr(args, "worktree_root", None):
        root = Path(args.worktree_root).expanduser().resolve()
    else:
        try:
            root = wt.default_worktree_root(wt.repo_toplevel(toplevel))
        except (OSError, wt.WorktreeError) as exc:
            raise TrioctlError(f"cannot derive a worktree root: {exc}") from exc
    print(f"trioctl: worktree root {root}", file=sys.stderr)
    return {"trioctl": Path(__file__).resolve(), "worktree_root": str(root)}, None


def _abandoned_slice_eval_threads(
    before: frozenset[threading.Thread] | set[threading.Thread] = frozenset(),
) -> list[threading.Thread]:
    """Live slice-eval pool workers (loop core `thread_name_prefix`) not in
    `before` (the threads alive when this loop run started).

    After the loop core's exit drain these are only evals it abandoned: a
    finished or idle pool worker exits as soon as the pool is shut down.
    """
    current = threading.current_thread()
    return [
        t for t in threading.enumerate()
        if t is not current and t not in before and t.is_alive()
        and t.name.startswith("slice-eval")
    ]


def command_loop(args: argparse.Namespace) -> int:
    """`trioctl omnigent loop`: run `_command_loop`, then exit promptly.

    A slice-eval the loop core's exit drain abandoned is still running on a
    non-daemon `ThreadPoolExecutor` worker, and Python's exit hook
    (`concurrent.futures` atexit / `threading._shutdown`) would join it --
    blocking process exit up to the role timeout even though cleanup is
    done. So when any such thread is alive after cleanup, flush stdio and
    `os._exit(code)` without joining it (`_command_loop`'s cleanup has
    already held or skipped its session, never deleted it). Exits with no
    abandoned eval are unchanged.
    """
    before = set(threading.enumerate())
    try:
        code = _command_loop(args)
    except TrioctlError as exc:
        if not _abandoned_slice_eval_threads(before):
            raise
        print(f"trioctl: {exc}", file=sys.stderr)
        code = 1
    except Exception:  # noqa: BLE001 - report, then still exit promptly
        if not _abandoned_slice_eval_threads(before):
            raise
        import traceback

        traceback.print_exc()
        code = 1
    abandoned = _abandoned_slice_eval_threads(before)
    if abandoned:
        print(
            f"trioctl: exiting without joining {len(abandoned)} abandoned "
            "slice-eval thread(s)",
            file=sys.stderr,
        )
        for stream in (sys.stdout, sys.stderr):
            try:
                stream.flush()
            except Exception:  # noqa: BLE001 - exit regardless
                pass
        os._exit(code)
    return code


#: Driver/runtime files a loop run creates inside the mailbox; never
#: product and never committed (r14 M-1).
MAILBOX_RUNTIME_IGNORES = (
    ".dispatch/", ".driver.json", ".driver.pid", ".session.json",
    ".sessions/", "driver.log", ".lock", ".repairs",
)
#: Runtime entries that are directories (``.lock`` is the loop core's lock
#: dir), so an existing ``<name>/`` line already covers them.
_MAILBOX_RUNTIME_DIRS = frozenset({".dispatch", ".sessions", ".lock"})


def _ensure_mailbox_gitignore(mailbox: Path) -> list[str]:
    """Append the missing MAILBOX_RUNTIME_IGNORES lines to ``<mailbox>/.gitignore``.

    Idempotent and append-only: existing lines are never rewritten or
    reordered. An entry counts as present when an existing line names it
    (ignoring a leading ``/``, and a trailing ``/`` for directory entries);
    a user negation (``!name``) also counts, as a deliberate choice. The
    file may itself stay untracked: it lies inside the mailbox, which the
    dirty-checkout gate (``classify_aggregate``) and the loop core's
    untracked-product scan both skip; the SHIP retirement commit of the
    mailbox picks it up like any other mailbox file. Returns the lines
    added.
    """
    path = Path(mailbox) / ".gitignore"
    try:
        text = path.read_text(encoding="utf-8")
    except FileNotFoundError:
        text = ""
    present: set[str] = set()
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        line = line.lstrip("!").lstrip("/")
        name = line.rstrip("/")
        if line.endswith("/") and name not in _MAILBOX_RUNTIME_DIRS:
            continue  # a dir-only pattern does not cover a runtime file
        present.add(name)
    missing = [e for e in MAILBOX_RUNTIME_IGNORES if e.rstrip("/") not in present]
    if not missing:
        return []
    prefix = "" if not text or text.endswith("\n") else "\n"
    header = "" if text else "# Trio loop runtime files (added by trioctl)\n"
    with open(path, "a", encoding="utf-8") as fh:
        fh.write(prefix + header + "".join(f"{e}\n" for e in missing))
    return missing


# --------------------------------------------------------------------------
# r16a root-free open-loop (see omnigent/root_free.py and
# docs/ROOT-FREE-OPEN-LOOP.md). `_command_loop` calls `_root_free_begin`
# first: None keeps today's root-bound path byte-identical.

#: A verified SHIP whose land onto the target is blocked, conflicted or
#: starved (resumable with `trioctl omnigent land --mailbox ...`).
NEEDS_LAND_EXIT = 8

ROOT_FREE_BOUND_NOTICE = (
    "trioctl: {why}: running this open-loop at the repository root "
    "(pre-r16 root-bound mode)"
)


def _root_free_wanted(args: argparse.Namespace, mailbox: Path) -> tuple[bool, str | None]:
    """(root-free?, why not). Default ON for open-loop; flags only disable it."""
    raw = getattr(args, "root_free", None)
    if raw is False:
        return False, None
    if root_free is None or worker_worktrees is None:
        return False, "root_free.py/worker_worktrees.py are not installed next to trioctl"
    probe = root_free._existing_ancestor(Path(mailbox))
    if worker_worktrees.git(probe, "rev-parse", "--show-toplevel", check=False).returncode != 0:
        return False, None  # not a git checkout: nothing to fork (isolation says why)
    open_loop = (mailbox / "QUEUE.md").is_file() or (
        root_free.live_mailbox(worker_worktrees, mailbox) is not None
    )
    if not open_loop:
        return False, None  # lockstep stays root-bound (r16b)
    if getattr(args, "isolate_workers", None) is False:
        # An explicit opt-out of isolation is root-bound, as before (silent
        # unless --root-free was asked for too: refused below).
        return False, ("--no-isolate-workers (root-free needs isolated builders)"
                       if raw is True else None)
    if getattr(args, "observe_workers", False):
        return False, "--observe-workers prescribes its own (non-isolated) worker command"
    inherited = worker_worktrees.inherited_cursor_problems()
    if inherited:
        return False, (
            "Cursor user/system config carries session-bound Omnigent bindings "
            "(worker isolation unavailable): " + "; ".join(inherited)
        )
    return True, None


def _target_metrics_api(home: Path, target: str) -> int | None:
    """METRICS_API the metrics/ set committed at the tip of *target* honours
    (None = no trio-metrics.py or trio_loop.py there).

    The lower of the two markers, as `_core_metrics_api` rules for a loaded
    core (eval-r16rc F1): trio-metrics.py's `METRICS_API`, and the core
    trio_loop.py's own marker (unmarked = predates r15 = at most 4). Read
    with `git cat-file` before anything is created.
    """
    blobs: dict[str, bytes] = {}
    for name in ("trio-metrics.py", "trio_loop.py"):
        proc = subprocess.run(
            ["git", "-C", str(home), "cat-file", "blob", f"refs/heads/{target}:metrics/{name}"],
            capture_output=True,
        )
        if proc.returncode != 0:
            return None
        blobs[name] = proc.stdout
    metrics_api = _api_marker_source(
        blobs["trio-metrics.py"], "METRICS_API", f"{target}:metrics/trio-metrics.py"
    )
    core_api = _api_marker_source(
        blobs["trio_loop.py"], "METRICS_API", f"{target}:metrics/trio_loop.py"
    )
    if core_api == 1:  # unmarked core: predates r15
        core_api = min(metrics_api, MULTI_REPO_METRICS_API - 1)
    return min(metrics_api, core_api)


def _root_free_declared(mailbox: Path) -> list[dict[str, Any]]:
    """The ROOT mailbox's declared repos (their own checkouts), PLAN order."""
    _module, metrics = _load_trio_check()
    info = metrics.read_repos(Path(mailbox))
    if info["errors"]:
        return []
    return [
        {"name": r["name"], "path": Path(r.get("main_path") or r["path"]),
         "raw_path": r.get("raw_path"), "base": r.get("base")}
        for r in info["repos"]
    ]


def _root_free_plan_facts(mailbox: Path) -> tuple[dict[str, list[str]], dict[str, str]]:
    """({repo: writes+reads paths}, {repo: full_check}) of the live PLAN.md."""
    _module, metrics = _load_trio_check()
    try:
        text = (Path(mailbox) / "PLAN.md").read_text(encoding="utf-8", errors="replace")
    except OSError:
        return {}, {}
    repos = _declared_repos(mailbox)
    watched: dict[str, list[str]] = {}
    for sl in metrics.parse_slices_block(text) or []:
        name = metrics.slice_repo_name(sl, repos) or "home"
        for key in ("writes", "reads"):
            for item in sl.get(key) or []:
                item = str(item).strip()
                if not item or item.startswith("api:"):
                    continue
                if item.startswith("./"):
                    item = item[2:]
                watched.setdefault(name, []).append(item.rstrip("/"))
    checks, _errors = metrics.parse_full_check(text)
    return watched, checks


def _root_free_info(record: dict[str, Any]) -> dict[str, Any]:
    """The OmnigentRunner `root_free=` view of a Lead record."""
    return {
        "home": record["repo"],
        "lead": record["path"],
        "branch": record["branch"],
        "target": record["target_ref"],
        "target_base": record.get("target_base"),
        "mailbox_rel": record["mailbox_rel"],
        "slug": record["slug"],
        "repo_targets": {
            name: info.get("target_ref") for name, info in (record.get("repos") or {}).items()
        },
        "repo_aggregates": {
            name: info.get("path") for name, info in (record.get("repos") or {}).items()
            if info.get("path")
        },
    }


def _discard_pristine_lead(
    mailbox: Path, why: str, *, land_only: bool = False, branches_only: bool = False,
) -> bool:
    """Drop *mailbox*'s root-free Lead worktree + branch when it made no
    progress (eval-r16rc F1); True when it was removed (message printed)."""
    if land_only or root_free is None or worker_worktrees is None:
        return False
    try:
        home, rel = root_free.locate(worker_worktrees, mailbox)
    except root_free.RootFreeError:
        return False
    record = root_free.load_record(worker_worktrees, home, root_free.loop_slug(rel))
    if not root_free.active(record) or record.get("mailbox_rel") != rel:
        return False
    if _live_driver_of(home, rel) is not None:
        return False
    try:
        done = root_free.discard_pristine(
            worker_worktrees, record, why, branches_only=branches_only
        )
    except (root_free.RootFreeError, worker_worktrees.WorktreeError, OSError) as exc:
        print(f"trioctl: root-free: could not remove the unused Lead worktree: {exc}",
              file=sys.stderr)
        return False
    if done:
        print(
            f"trioctl: root-free: {rel}: Lead worktree {record['path']} and branch "
            f"{record['branch']} had no loop progress; removed ({why})",
            file=sys.stderr,
        )
    return done


def _root_lock_refused(root_box: Path, rel: str, *, clear_stale: bool) -> bool:
    """True (message printed) when a live driver holds *root_box*'s `.lock`."""
    holder = root_free.root_lock_holder(
        root_box, clear_stale=clear_stale,
        log=lambda line: print(f"trioctl: {line}", file=sys.stderr),
    )
    if holder is None:
        return False
    who = f"pid {holder}" if holder else "a driver taking the lock (no pid yet)"
    print(
        f"trioctl: mailbox {rel} is owned by a live driver ({who}, {root_box}/.lock; "
        "a root-bound, lockstep or older-release loop): not starting it root-free; "
        "nothing was created or changed. Wait for that driver to finish (or stop it) "
        "and start again",
        file=sys.stderr,
    )
    return True


def _root_free_begin(
    args: argparse.Namespace, cwd: Path, mailbox: Path, *, land_only: bool = False
) -> dict[str, Any] | int | None:
    """Enter root-free mode for `loop` (r16a), or None for the root-bound path.

    Creates/re-attaches the loop's Lead worktree (never touching the root's
    tree, index or `.cursor`), installs dependencies once, records the
    target in the live STATE.md and announces the loop in the registry.
    Returns the context dict, an exit code (refused: nothing changed), or
    None when the run is not root-free (lockstep, `--root-bound`, ...).
    """
    wanted, why = _root_free_wanted(args, mailbox)
    if not wanted and root_free is not None and worker_worktrees is not None:
        live = root_free.live_mailbox(worker_worktrees, mailbox)
        if live is not None and _discard_pristine_lead(
            mailbox, why or "--root-bound", land_only=land_only,
        ):
            live = None  # nothing of the root-free attempt was worth keeping
        if live is not None:
            print(
                f"trioctl: {mailbox} belongs to a root-free loop (live mailbox {live}); "
                f"it cannot run root-bound ({why or '--root-bound'}): continue it "
                "root-free, or `trioctl omnigent abandon` it first",
                file=sys.stderr,
            )
            return 2
    if not wanted:
        explicit = getattr(args, "root_free", None) is True
        if why and explicit:
            print(f"trioctl: --root-free refused: {why}", file=sys.stderr)
            return 2
        if why:
            print(ROOT_FREE_BOUND_NOTICE.format(why=why), file=sys.stderr)
        return None
    wt = worker_worktrees
    try:
        home, rel = root_free.locate(wt, mailbox)
    except root_free.RootFreeError as exc:
        print(f"trioctl: {exc}", file=sys.stderr)
        return 3
    # This driver loads the loop core (and runs its gate scripts) from the
    # Lead worktree: never leave bytecode caches behind in it (they would
    # be untracked product paths unless the repository ignores them).
    sys.dont_write_bytecode = True
    os.environ["PYTHONDONTWRITEBYTECODE"] = "1"
    slug = root_free.loop_slug(rel)
    record = root_free.load_record(wt, home, slug)
    entry = _live_driver_of(home, rel)
    if entry is not None and entry.get("pid") != os.getpid():
        print(
            f"trioctl: mailbox {rel} is owned by a live {entry.get('mode') or 'root-bound'} "
            f"driver (pid {entry.get('pid')}"
            + (f", Lead worktree {entry.get('lead_worktree')}" if entry.get("lead_worktree")
               else "")
            + ")",
            file=sys.stderr,
        )
        return 5
    # eval-r16rc B1: a root-bound, lockstep, native or pre-r16 driver never
    # registers; its only mark is the ROOT mailbox's `.lock` (the loop
    # core's mailbox lock). A live holder owns the mailbox: refuse before
    # anything is created or written (as 9a224c1 does: exit 5).
    root_box = Path(home) / rel
    if _root_lock_refused(root_box, rel, clear_stale=False):
        return 5
    if root_free.active(record) and record.get("state") == "active" and not land_only:
        # eval-r16rc F1: a Lead worktree that never made progress (refused
        # after it was seeded, e.g. an old metrics/ set on the target) is
        # re-seeded once the target moved on (`metrics refresh --commit`).
        base = str(record.get("target_base") or "")
        now = wt.rev(home, f"refs/heads/{record.get('target_ref')}")
        if now and base and now != base and _discard_pristine_lead(
            mailbox, f"{record.get('target_ref')} moved {base[:12]}..{now[:12]}",
            land_only=land_only,
        ):
            record = root_free.load_record(wt, home, slug)
    if not root_free.active(record) and not land_only:
        # r15 guard before anything exists: a refused PLAN never gets a Lead
        # worktree, and the root stays untouched (stderr only).
        refused = _repo_scope_refusals(mailbox) if (mailbox / "PLAN.md").is_file() else []
        if refused:
            for line in refused:
                print(f"trioctl: {line}", file=sys.stderr)
            print("trioctl: root-free: nothing was created; fix PLAN.md at "
                  f"{mailbox} and start again", file=sys.stderr)
            return 3
    if not root_free.active(record):
        if land_only:
            print(f"trioctl: {rel} has no root-free loop to land", file=sys.stderr)
            return 2
        # Cross-loop `writes:` refusal before anything exists (the
        # authoritative check repeats under the registry lock at
        # registration); the root mailbox is never written: stderr only.
        overlap = [] if _allow_overlapping_loops(args) else _writes_overlap_problems(
            Path(os.path.realpath(str(home))), mailbox
        )
        if overlap:
            for problem in overlap:
                print(
                    f"trioctl: refusing to start {mailbox}: {problem} (set "
                    f"{ALLOW_OVERLAPPING_LOOPS_ENV}=1 or --allow-overlapping-writes to "
                    "override); nothing was created",
                    file=sys.stderr,
                )
            return REPO_SCOPE_REFUSED_EXIT
        target = getattr(args, "target", None) or root_free._branch_of(wt, home)
        if not target:
            why = (
                f"{home} is not on a branch (detached HEAD) and no --target "
                "names the branch this loop lands onto"
            )
            if getattr(args, "root_free", None) is True:
                print(f"trioctl: --root-free refused: {why}", file=sys.stderr)
                return 2
            print(ROOT_FREE_BOUND_NOTICE.format(why=why), file=sys.stderr)
            return None
        api = _target_metrics_api(home, target)
        if api is None or api < ROOT_FREE_METRICS_API:
            bundled = Path(__file__).resolve().parent.parent / "metrics"
            found = "no committed metrics/ set" if api is None else f"METRICS_API {api}"
            print(
                f"trioctl: root-free open-loop (r16) needs the loop core committed on "
                f"{target} with METRICS_API >= {ROOT_FREE_METRICS_API} ({found}): refresh "
                f"the repository's metrics/ as a set from {bundled} and commit it to "
                f"{target} (with {target} checked out: `{METRICS_REFRESH_COMMAND}`), "
                "or pass --root-bound to run this loop at the repository root as "
                "before. Nothing was changed.",
                file=sys.stderr,
            )
            return 3
    worktree_root = (
        Path(args.worktree_root).expanduser().resolve()
        if getattr(args, "worktree_root", None)
        else wt.default_worktree_root(wt.repo_toplevel(home))
    )
    declared = [] if root_free.active(record) else _root_free_declared(mailbox)
    # Committed to proceed: re-check the root lock and clear a stale one the
    # way the loop core's `_acquire_lock` does (dead pid / old pid-less lock).
    if _root_lock_refused(root_box, rel, clear_stale=True):
        return 5
    try:
        record, created = root_free.begin(
            wt, home=home, mailbox_rel=rel, worktree_root=worktree_root,
            target=getattr(args, "target", None), declared=declared,
            repo_roots=lambda main, name: _repo_worktree_root(main, name, worktree_root),
        )
    except (root_free.RootFreeError, wt.WorktreeError) as exc:
        print(f"trioctl: root-free: {exc}", file=sys.stderr)
        return 3
    lead = Path(record["path"])
    live = Path(record["live_mailbox"])
    live.mkdir(parents=True, exist_ok=True)
    args.worktree_root = str(worktree_root)
    print(
        f"trioctl: root-free: {'created' if created else 're-attached'} Lead worktree "
        f"{lead} (branch {record['branch']} from {record['target_ref']}"
        f"@{str(record.get('target_base'))[:12]}); live mailbox {live}",
        file=sys.stderr,
    )
    try:
        core = _load_trio_loop(lead)
        refusal = None
    except TrioctlError as exc:
        core, refusal = None, str(exc)
    if core is not None and _core_metrics_api(core) < ROOT_FREE_METRICS_API:
        refusal = (
            f"the loop core in {lead} predates root-free open-loop "
            f"(METRICS_API {_core_metrics_api(core)}); refresh metrics/ on "
            f"{record['target_ref']} (`{METRICS_REFRESH_COMMAND}` with it checked "
            "out) or pass --root-bound"
        )
    if refusal is not None:
        print(f"trioctl: {refusal}", file=sys.stderr)
        if _discard_pristine_lead(mailbox, "refused: loop core", land_only=land_only):
            print(f"trioctl: root-free: removed the unused Lead worktree {lead} and "
                  f"branch {record['branch']} (no loop progress); the next start "
                  "re-seeds from the target's tip", file=sys.stderr)
        else:
            print(
                f"trioctl: root-free: Lead worktree {lead} kept (it has loop progress); "
                f"after fixing metrics/ merge {record['target_ref']} into "
                f"{record['branch']} there, or `trioctl omnigent abandon --mailbox "
                f"{rel}` and `git branch -D {record['branch']}` to start over",
                file=sys.stderr,
            )
        return 3
    state_path = live / "STATE.md"
    core._read_state(state_path)  # creates a missing STATE.md
    core._update_state(state_path, {
        "target_ref": record["target_ref"],
        "target_base": str(record.get("target_base") or ""),
    })
    if not record.get("setup_done") and not land_only:
        failure = _root_free_setup(record, args)
        if failure is not None:
            core._update_state(state_path, {"status": "error", "phase": "worktree-setup"})
            core._append_log(
                live, f"- iter {_state_iteration(live)} | loop | Lead worktree setup "
                f"failed: {' '.join(failure.split())[:600]}",
            )
            print(f"trioctl: root-free: Lead worktree setup failed:\n{failure}", file=sys.stderr)
            return 3
        record["setup_done"] = True
        root_free.save_record(wt, home, record)
    # The live-loop registry record is written by `_register_live_loop`
    # (the one writer, every mode) once the runner exists.
    return {
        "home": home, "repo": lead, "mailbox": live, "record": record, "slug": slug,
        "core": core, "info": _root_free_info(record), "created": created,
    }


def _root_free_setup(record: dict[str, Any], args: argparse.Namespace) -> str | None:
    """Install dependencies once in a new Lead worktree (and declared
    aggregates): the profile's `worktree_setup`, else `.cursor/worktrees.json`.
    None = done/nothing to do; else the failure (command + output tail)."""
    try:
        profile = load_config(_run_config_path(args)).get("worktree_setup")
    except Exception:  # noqa: BLE001 - no readable profile: repository setup only
        profile = None
    home = Path(record["repo"])
    targets = [(Path(record["path"]), profile)] + [
        (Path(info["path"]), None) for info in (record.get("repos") or {}).values()
    ]
    for path, prof in targets:
        commands = root_free.setup_commands(path, prof)
        if not commands:
            continue
        cmds, source = commands
        print(f"trioctl: root-free: setting up {path} ({source}): {'; '.join(cmds)}",
              file=sys.stderr)
        ok, tail = root_free.run_setup(
            path, cmds, home=home, timeout=getattr(args, "wait_timeout", None),
        )
        if not ok:
            return f"{path} ({source}): {tail}"
    return None


def _root_free_land_hook(rf: dict[str, Any], args: argparse.Namespace) -> Any:
    """The loop core's `land=` hook of a root-free run."""
    wt = worker_worktrees
    home, slug, core = rf["home"], rf["slug"], rf["core"]

    def land(mailbox: Path, iteration: int) -> dict[str, Any]:
        record = root_free.load_record(wt, home, slug)
        if not root_free.active(record):
            return {"status": "error", "detail": f"Lead worktree record lead-{slug} is gone"}
        state = core._read_state(Path(mailbox) / "STATE.md")
        pins = {"home": str(state.get("evaluated_sha") or "").strip()}
        pins.update(core._state_repo_pins(state))
        watched, checks = _root_free_plan_facts(Path(mailbox))

        def pre_land() -> None:
            try:
                _run_worktree_cleanup(Path(record["path"]), Path(mailbox), core)
            except Exception as exc:  # noqa: BLE001 - cleanup never blocks a land
                print(f"trioctl: pre-land worktree cleanup failed: {exc}", file=sys.stderr)

        return root_free.land(
            wt, record, core=core, iteration=iteration, pins=pins, watched=watched,
            full_checks=checks, timeout=getattr(args, "wait_timeout", None),
            pre_land=pre_land,
            log=lambda line: print(f"trioctl: {line}", file=sys.stderr),
        )

    return land


def _root_free_finish(rf: dict[str, Any], args: argparse.Namespace) -> None:
    """Loop end (after prune, fences, worker cleanup and the registry
    record's removal): after a successful land, remove the Lead worktree(s)
    and branches."""
    wt = worker_worktrees
    home, slug = rf["home"], rf["slug"]
    record = root_free.load_record(wt, home, slug)
    if not record or record.get("state") != "landed":
        if record and root_free.active(record):
            print(
                f"trioctl: root-free: Lead worktree {record['path']} (branch "
                f"{record['branch']}) kept; live mailbox {record['live_mailbox']}",
                file=sys.stderr,
            )
        return
    try:
        result = root_free.teardown(
            wt, record, keep_branch=bool(getattr(args, "keep_branch", False)),
            log=lambda line: print(f"trioctl: root-free: {line}", file=sys.stderr),
        )
    except Exception as exc:  # noqa: BLE001 - the land already succeeded
        print(f"trioctl: root-free: Lead worktree teardown failed: {exc}", file=sys.stderr)
        return
    for name, why in result["retained"].items():
        print(f"trioctl: root-free: kept the {name} Lead worktree ({why}); "
              f"`trioctl omnigent abandon --mailbox {record['mailbox_rel']}` removes "
              "it once you checked it", file=sys.stderr)
    for name, why in result["branches_kept"].items():
        print(f"trioctl: root-free: kept branch {record['branch']} in {name} ({why})",
              file=sys.stderr)
    if not result["retained"]:
        print(f"trioctl: root-free: landed and removed Lead worktree {record['path']}",
              file=sys.stderr)


#: The loop core set a repository vendors under `metrics/` (always as a set).
METRICS_SET = ("trio_loop.py", "trio-metrics.py", "trio-shadow.py", "trio-check.py")
#: install.sh copies the release's set here (next to trioctl) with a PIN file.
INSTALLED_METRICS_SET_DIR = "trio-release-metrics"
METRICS_REFRESH_COMMAND = "trioctl omnigent metrics refresh --commit"


def _release_metrics_source() -> tuple[Path, str] | None:
    """(directory holding this release's four metrics/ files, pin), or None.

    A release/source tree has `<root>/metrics/` next to `<root>/omnigent/`;
    the install.sh layout has `trio-release-metrics/` next to trioctl
    (with a PIN file naming the release commit). The pin is that PIN file,
    else the git commit of a source checkout, else (a release bundle made
    with `git archive` and no PIN file, e.g. the installed adapter's
    `releases/<sha>/metrics`) `sha256:<12 hex>` of the four files --
    accepted, and written into the refresh commit message as is. Release
    bundles should write `<release>/metrics/PIN` (the 12-char release sha).
    """
    here = Path(__file__).resolve().parent
    for directory in (here.parent / "metrics", here / INSTALLED_METRICS_SET_DIR):
        if all((directory / name).is_file() for name in METRICS_SET):
            break
    else:
        return None
    pin = ""
    with contextlib.suppress(OSError):
        pin = (directory / "PIN").read_text(encoding="utf-8").strip()
    if not pin:
        proc = subprocess.run(
            ["git", "-C", str(directory), "rev-parse", "--short=12", "HEAD"],
            capture_output=True, text=True,
        )
        if proc.returncode == 0 and proc.stdout.strip():
            pin = proc.stdout.strip()
            dirty = subprocess.run(
                ["git", "-C", str(directory), "status", "--porcelain", "--", "."],
                capture_output=True, text=True,
            )
            if dirty.returncode == 0 and dirty.stdout.strip():
                pin += "-dirty"
    api = _api_marker_source(
        (directory / "trio-metrics.py").read_bytes(), "METRICS_API", "trio-metrics.py"
    )
    if not pin:
        import hashlib

        digest = hashlib.sha256(
            b"".join((directory / name).read_bytes() for name in METRICS_SET)
        ).hexdigest()[:12]
        pin = f"sha256:{digest}"
    return directory, f"{pin}, METRICS_API {api}"


def _metrics_refresh_targets(args: argparse.Namespace) -> list[Path]:
    """The repository `metrics refresh` writes: --repo (default: the cwd's
    repository), or with --mailbox the mailbox's (home) repository only.

    Only home's committed set is ever checked (the root-free pre-check,
    the repo-local trio-check/trio-shadow the models run); declared product
    clones never need a vendored loop core (eval-r16rc N3). Refresh another
    repository explicitly with --repo <path>.
    """
    if getattr(args, "mailbox", None) is not None:
        mailbox = Path(args.mailbox).expanduser()
        if not mailbox.is_absolute():
            mailbox = Path.cwd() / mailbox
        targets = [worker_worktrees.repo_toplevel(root_free._existing_ancestor(mailbox.resolve())
                                                  if root_free is not None else mailbox.resolve())]
    else:
        repo = Path(getattr(args, "repo", None) or Path.cwd()).expanduser().resolve()
        targets = [worker_worktrees.repo_toplevel(repo)]
    out: list[Path] = []
    for target in targets:
        top = worker_worktrees.repo_toplevel(target)
        if top not in out:
            out.append(top)
    return out


def _metrics_diff_line(rel: str, old: bytes | None, new: bytes) -> str:
    if old is None:
        return f"  {rel}: added ({len(new.splitlines())} lines)"
    if old == new:
        return f"  {rel}: unchanged"
    import difflib

    plus = minus = 0
    for line in difflib.unified_diff(
        old.decode("utf-8", "replace").splitlines(),
        new.decode("utf-8", "replace").splitlines(), lineterm="", n=0,
    ):
        if line.startswith("+") and not line.startswith("+++"):
            plus += 1
        elif line.startswith("-") and not line.startswith("---"):
            minus += 1
    return f"  {rel}: updated (+{plus} -{minus})"


def command_metrics_refresh(args: argparse.Namespace) -> int:
    """`trioctl omnigent metrics refresh`: vendor this release's loop core.

    Copies the release's four `metrics/` files (trio_loop.py,
    trio-metrics.py, trio-shadow.py, trio-check.py) into the repository
    (`--repo`, default the current one), or into the mailbox's home
    repository (`--mailbox`; never its declared product repos), and prints a
    per-file diff summary. With `--commit` each changed repository gets
    one commit `chore: vendor trio loop core (<pin>)` of exactly those files
    on its current branch. Refuses (exit 2, nothing written anywhere) when
    any target's `metrics/` has uncommitted or untracked changes, or with
    `--commit` on a detached HEAD.
    """
    if worker_worktrees is None:
        raise TrioctlError("worker_worktrees.py is not installed next to trioctl")
    source = _release_metrics_source()
    if source is None:
        print(
            "trioctl: this trioctl has no release metrics/ set next to it (a release "
            f"tree's metrics/ or {INSTALLED_METRICS_SET_DIR}/ from install.sh); "
            "re-run install.sh from the Trio checkout",
            file=sys.stderr,
        )
        return 2
    directory, pin = source
    try:
        targets = _metrics_refresh_targets(args)
    except (TrioctlError, worker_worktrees.WorktreeError) as exc:
        print(f"trioctl: metrics refresh: {exc}", file=sys.stderr)
        return 2
    problems: list[str] = []
    for repo in targets:
        proc = subprocess.run(
            ["git", "-C", str(repo), "status", "--porcelain=v1", "--untracked-files=all",
             "--", "metrics"],
            capture_output=True, text=True,
        )
        if proc.returncode != 0:
            problems.append(f"{repo}: git status failed: {proc.stderr.strip()}")
        elif proc.stdout.strip():
            problems.append(
                f"{repo}/metrics has uncommitted changes (commit or stash them first): "
                + "; ".join(proc.stdout.splitlines()[:8])
            )
        if getattr(args, "commit", False):
            head = subprocess.run(
                ["git", "-C", str(repo), "symbolic-ref", "-q", "--short", "HEAD"],
                capture_output=True, text=True,
            )
            if head.returncode != 0:
                problems.append(f"{repo} is on a detached HEAD: check out a branch to commit")
    if problems:
        for line in problems:
            print(f"trioctl: metrics refresh refused: {line}", file=sys.stderr)
        print("trioctl: nothing was changed", file=sys.stderr)
        return 2
    print(f"release metrics set: {directory} ({pin})")
    if pin.startswith("sha256:"):
        print(f"  (no PIN file in {directory} and not a git checkout: the pin is the "
              "files' sha256; a release bundle should write metrics/PIN)")
    for repo in targets:
        (repo / "metrics").mkdir(exist_ok=True)
        changed: list[str] = []
        lines: list[str] = []
        for name in METRICS_SET:
            dest = repo / "metrics" / name
            new = (directory / name).read_bytes()
            old = dest.read_bytes() if dest.is_file() else None
            lines.append(_metrics_diff_line(f"metrics/{name}", old, new))
            if old != new:
                tmp = dest.with_name(f".{name}.refresh-{os.getpid()}")
                tmp.write_bytes(new)
                with contextlib.suppress(OSError):
                    os.chmod(tmp, (directory / name).stat().st_mode & 0o777)
                os.replace(tmp, dest)
                changed.append(f"metrics/{name}")
        print(f"{repo}:")
        for line in lines:
            print(line)
        if not changed:
            print("  already current; nothing to commit")
            continue
        if not getattr(args, "commit", False):
            print("  not committed (pass --commit to commit these files)")
            continue
        add = subprocess.run(
            ["git", "-C", str(repo), "add", "--", *changed], capture_output=True, text=True,
        )
        commit = add if add.returncode != 0 else subprocess.run(
            ["git", "-C", str(repo), "commit", "-q", "-m",
             f"chore: vendor trio loop core ({pin})", "--", *changed],
            capture_output=True, text=True,
        )
        if commit.returncode != 0:
            print(f"trioctl: metrics refresh: commit failed in {repo}: "
                  f"{(commit.stderr or commit.stdout).strip()}", file=sys.stderr)
            return 3
        sha = subprocess.run(
            ["git", "-C", str(repo), "rev-parse", "--short=12", "HEAD"],
            capture_output=True, text=True,
        ).stdout.strip()
        branch = subprocess.run(
            ["git", "-C", str(repo), "symbolic-ref", "--short", "HEAD"],
            capture_output=True, text=True,
        ).stdout.strip()
        print(f"  committed {sha} on {branch}: chore: vendor trio loop core ({pin})")
    return 0


def command_land(args: argparse.Namespace) -> int:
    """`trioctl omnigent land`: finish landing a root-free loop (r16a).

    For a `needs_land` loop (blocked by local changes at the target's
    checkout, a merge conflict you resolved in the Lead worktree, or a
    starved land) this re-runs the land -- and, when the target moved under
    this loop's paths, the integration re-verification -- through the same
    driver as `loop`; a landed loop whose Lead worktree is still there is
    only cleaned up. Nothing is dispatched to a Lead.
    """
    repo = Path.cwd().resolve()
    mailbox = Path(args.mailbox).expanduser()
    if not mailbox.is_absolute():
        mailbox = repo / mailbox
    if root_free is None or worker_worktrees is None:
        raise TrioctlError("root_free.py/worker_worktrees.py are not installed next to trioctl")
    home, rel = root_free.locate(worker_worktrees, mailbox)
    record = root_free.load_record(worker_worktrees, home, root_free.loop_slug(rel))
    if not root_free.active(record):
        print(f"trioctl: {rel} has no root-free loop waiting to land", file=sys.stderr)
        return 2
    if record.get("state") == "landed":
        _root_free_finish({"home": home, "slug": record["slug"]}, args)
        return 0
    live = Path(record["live_mailbox"])
    status = ""
    try:
        text = (live / "STATE.md").read_text(encoding="utf-8")
        match = re.search(r"^\s*(?:-\s+)?status\s*:\s*(\S+)", text, re.M | re.I)
        status = match.group(1).lower() if match else ""
        phase = re.search(r"^\s*(?:-\s+)?phase\s*:\s*(\S+)", text, re.M | re.I)
        phase_word = phase.group(1).lower() if phase else ""
    except OSError:
        phase_word = ""
    if status != "needs_land" and not (status == "shipped" and phase_word == "landing") and not (
        status == "error" and phase_word == "land-error"  # rc before eval-r16rc F2
    ):
        print(
            f"trioctl: {rel} is {status or 'not started'!r}, not waiting to land "
            f"(`trioctl omnigent loop --mailbox {rel}` continues it)",
            file=sys.stderr,
        )
        return 2
    loop_argv = [
        "omnigent", "loop", "--mailbox", str(args.mailbox),
        "--max-iterations", str(args.max_iterations),
        "--wait-timeout", str(args.wait_timeout), "--root-free",
    ]
    if args.base_url:
        loop_argv += ["--base-url", args.base_url]
    if args.keep_sessions:
        loop_argv.append("--keep-sessions")
    if args.keep_branch:
        loop_argv.append("--keep-branch")
    loop_args = parser().parse_args(loop_argv)
    loop_args.land_only = True
    return command_loop(loop_args)


def command_abandon(args: argparse.Namespace) -> int:
    """`trioctl omnigent abandon`: retire a root-free loop without landing it.

    Removes its Lead worktree(s) through the owner-verified guards (retained
    when unsafe) and KEEPS the `trio/<slug>` branch(es), so no commit is
    lost; refuses while a driver runs the loop.
    """
    if root_free is None or worker_worktrees is None:
        raise TrioctlError("root_free.py/worker_worktrees.py are not installed next to trioctl")
    repo = Path.cwd().resolve()
    mailbox = Path(args.mailbox).expanduser()
    if not mailbox.is_absolute():
        mailbox = repo / mailbox
    home, rel = root_free.locate(worker_worktrees, mailbox)
    slug = root_free.loop_slug(rel)
    record = root_free.load_record(worker_worktrees, home, slug)
    if not record or record.get("state") == "removed":
        print(f"trioctl: {rel} has no root-free Lead worktree", file=sys.stderr)
        return 2
    entry = _live_driver_of(home, rel)
    if entry is not None:
        print(f"trioctl: a driver (pid {entry.get('pid')}) still runs {rel}", file=sys.stderr)
        return 5
    result = root_free.teardown(
        worker_worktrees, record, abandon=True,
        log=lambda line: print(f"trioctl: {line}", file=sys.stderr),
    )
    payload = {"mailbox": rel, "branch": record["branch"], **result}
    print(json.dumps(payload, indent=2, sort_keys=True))
    return 0 if not result["retained"] else ISOLATED_RETAINED_EXIT


def command_status(args: argparse.Namespace) -> int:
    """`trioctl omnigent status`: where a mailbox's loop lives and its STATE (r16)."""
    repo = Path.cwd().resolve()
    mailbox = Path(args.mailbox).expanduser()
    if not mailbox.is_absolute():
        mailbox = repo / mailbox
    payload: dict[str, Any] = {"mailbox": str(mailbox.resolve()), "root_free": False}
    if root_free is not None and worker_worktrees is not None:
        try:
            home, rel = root_free.locate(worker_worktrees, mailbox)
            record = root_free.load_record(worker_worktrees, home, root_free.loop_slug(rel))
        except root_free.RootFreeError:
            record, rel, home = None, None, None
        if record:
            driver = _live_driver_of(home, rel)
            live_entries = [driver] if driver else []
            payload.update({
                "root_free": True,
                "record_state": record.get("state"),
                "live_mailbox": record.get("live_mailbox"),
                "lead_worktree": record.get("path"),
                "branch": record.get("branch"),
                "target_ref": record.get("target_ref"),
                "target_base": record.get("target_base"),
                "landed": record.get("landed") or {},
                "driver": live_entries[0] if live_entries else None,
            })
    if "driver" not in payload and worker_worktrees is not None:
        # Root-bound/lockstep loops: the live driver from the same registry.
        try:
            top = Path(os.path.realpath(str(worker_worktrees.repo_toplevel(mailbox.resolve()))))
            rel = mailbox.resolve().relative_to(top).as_posix()
            payload["driver"] = _live_driver_of(top, rel)
        except Exception:  # noqa: BLE001 - not in a git checkout: no registry
            payload["driver"] = None
    live = Path(payload.get("live_mailbox") or payload["mailbox"])
    state: dict[str, str] = {}
    try:
        for line in (live / "STATE.md").read_text(encoding="utf-8").splitlines():
            key, sep, value = line.partition(":")
            if sep and key.strip() and not key.startswith(" "):
                state[key.strip().lstrip("- ").strip()] = value.strip()
    except OSError:
        pass
    payload["state"] = state
    if getattr(args, "json", False):
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        for key in ("mailbox", "root_free", "live_mailbox", "lead_worktree", "branch",
                    "target_ref", "record_state"):
            if key in payload:
                print(f"{key}: {payload[key]}")
        driver = payload.get("driver")
        if driver:
            print(f"driver: pid {driver.get('pid')} ({driver.get('mode')}) since "
                  f"{driver.get('started_at')}")
        for key in ("status", "phase", "iteration", "landed"):
            if key in state:
                print(f"state.{key}: {state[key]}")
    return 0


def _command_loop(args: argparse.Namespace) -> int:
    """Run loop-core with the Omnigent role runner.

    Session cleanup is default-on and scoped to this run: unless
    `--keep-sessions` is passed, the sessions this run itself created are
    archived then deleted after the loop returns, regardless of its exit
    code -- never a session from an earlier run. See
    `_run_post_loop_session_prune`.
    """
    repo = Path.cwd().resolve()
    mailbox = Path(args.mailbox).expanduser()
    if not mailbox.is_absolute():
        mailbox = repo / mailbox
    mailbox = mailbox.resolve()
    # r16a: an open-loop runs root-free (its own Lead worktree) unless
    # `--root-bound`; from here on `repo`/`mailbox` are that worktree and
    # its live mailbox, and the root is never touched until the land.
    rf = _root_free_begin(args, repo, mailbox, land_only=getattr(args, "land_only", False))
    if isinstance(rf, int):
        return rf
    if rf is not None:
        repo, mailbox = rf["repo"], rf["mailbox"]
    mailbox.mkdir(parents=True, exist_ok=True)
    if getattr(args, "reconcile_held", False) and _held_records(mailbox):
        # Opt-in (default OFF): one bounded reconcile before the refusal.
        # Only an applied late-valid completion continues; anything else
        # keeps the hold and the exit-7 refusal below.
        if reconcile is None:
            print("trioctl: --reconcile-held: reconcile.py missing; "
                  "hold kept", file=sys.stderr)
        else:
            decision, _obs = _reconcile_bounded(
                mailbox, repo,
                _session_client(getattr(args, "base_url", None)),
                apply=True,
                max_wait=getattr(args, "reconcile_wait", 0.0),
                interval=getattr(args, "reconcile_interval", 15.0),
            )
            print(
                f"trioctl: reconcile held dispatch: {decision['action']} "
                f"({decision['code']}): "
                + "; ".join(decision.get("reasons", [])),
                file=sys.stderr,
            )
    refusal = _held_dispatch_message(mailbox)
    if refusal:
        print(f"trioctl: {refusal}", file=sys.stderr)
        return HELD_DISPATCH_EXIT
    # Silent, append-only; after the held refusal so a refused start
    # leaves the mailbox byte-identical.
    try:
        _ensure_mailbox_gitignore(mailbox)
    except OSError as exc:
        print(f"trioctl: could not update {mailbox / '.gitignore'}: {exc}", file=sys.stderr)
    # r14.1 F3: same-cwd lock files of workspaces that no longer exist
    # (and r15.x root-turn lock files of roots that no longer exist).
    _prune_same_cwd_locks()
    _prune_same_cwd_locks(_root_turn_lock_dir())
    loop_core = _load_trio_loop(repo)
    # r15 guard: a PLAN with a slice outside its repo (or an invalid
    # `repos:` block), or a `repos:` PLAN on a vendored loop core that
    # predates multi-repo, is refused before anything is dispatched --
    # under the mailbox lock (eval-r15a F2): a mailbox a live driver owns
    # is left byte-identical (exit 5, as the loop core itself refuses it).
    refused = _repo_scope_refusals(mailbox)
    old_core = _old_core_repos_refusal(mailbox, loop_core)
    if old_core:
        refused = [*refused, old_core]
    if refused:
        acquire = getattr(loop_core, "_acquire_lock", None)
        release = getattr(loop_core, "_release_lock", None)
        lock = acquire(mailbox) if callable(acquire) else None
        if callable(acquire) and lock is None:
            for line in refused:
                print(f"trioctl: {line}", file=sys.stderr)
            return 5
        try:
            _mark_repo_scope_refused(mailbox, refused)
        finally:
            if callable(release):
                release(lock)
        for line in refused:
            print(f"trioctl: {line}", file=sys.stderr)
        return 3
    # r11: worker isolation and concurrent slice-eval are default ON; the
    # --no-isolate-workers / --slice-eval-concurrency 1 flags disable them.
    # A lockstep mailbox keeps isolation (and so concurrency) off unless
    # --isolate-workers is explicit (the lockstep carve-out).
    isolate, isolation_off = _resolve_isolation(args, repo, mailbox)
    concurrency_off = isolation_off
    if (
        isolation_off == LOCKSTEP_ISOLATION_OFF
        and getattr(args, "slice_eval_concurrency", None) is not None
    ):
        # An explicit N in lockstep keeps its pre-carve-out meaning:
        # accepted, and reported "not applicable" below.
        concurrency_off = None
    loop_kwargs = _slice_eval_concurrency_kwargs(
        loop_core, args, isolation_off=concurrency_off
    )
    if rf is not None:
        loop_kwargs["land"] = _root_free_land_hook(rf, args)
    if (
        loop_kwargs.get("slice_eval_concurrency", 1) > 1
        and _loop_is_lockstep(mailbox)
    ):
        print(LOCKSTEP_CONCURRENCY_NOTICE, file=sys.stderr)
    observe = (
        _start_observation(mailbox)
        if getattr(args, "observe_workers", False)
        else None
    )
    runner_kwargs: dict[str, Any] = {}
    if observe:
        runner_kwargs["observe"] = observe
        print(
            f"trioctl: observing workers as run {observe['run_id']} "
            f"in {observe['dir']}",
            file=sys.stderr,
        )
    if isolate:
        runner_kwargs["isolate_workers"] = isolate
        # Restart-safe: finish removals an earlier run left half done and
        # retire anything already accepted before new work starts.
        _run_worktree_cleanup(repo, mailbox)
    if rf is not None:
        runner_kwargs["root_free"] = rf["info"]
    runner = OmnigentRunner(
        repo=repo,
        base_url=getattr(args, "base_url", None),
        timeout=getattr(args, "wait_timeout", DEFAULT_LOOP_WAIT_TIMEOUT),
        runner_id=getattr(args, "runner_id", None),
        host_id=getattr(args, "host_id", None),
        workspace=str(repo),
        completion_receipts=getattr(args, "completion_receipts", False),
        end_root_sessions=not getattr(args, "keep_sessions", False),
        restore_root_config=not isolate,
        **runner_kwargs,
    )
    # r15: a Lead pass that adds `repos:` to PLAN.md on an old core is
    # refused like any other out-of-repo slice (see OmnigentRunner._run).
    runner.loop_core = loop_core
    # Live-loop registry (one record per loop, every mode) + the cross-loop
    # `writes:` refusal (root-bound, lockstep and root-free alike).
    registration, refused_code = _register_live_loop(
        args, repo, mailbox, loop_core, runner, rf=rf,
    )
    if refused_code is not None:
        if observe:
            _finish_observation(observe)
        if rf is not None and rf.get("created"):
            # eval-r16rc N5: a racing overlapping start lost at registration:
            # nothing was dispatched, so the Lead worktree it just made goes.
            _discard_pristine_lead(
                Path(rf["home"]) / rf["info"]["mailbox_rel"], "refused at registration",
                branches_only=True,
            )
        return refused_code
    _clear_driver_stop_reason(loop_core, mailbox)
    keep_sessions = getattr(args, "keep_sessions", False)
    ids_file = mailbox / ".sessions" / f"run-{os.getpid()}.ids"
    previous_ids_env = os.environ.get(SESSION_IDS_ENV_VAR)
    if keep_sessions:
        os.environ.pop(SESSION_IDS_ENV_VAR, None)
    else:
        os.environ[SESSION_IDS_ENV_VAR] = str(ids_file)

    # Install SIGINT/SIGTERM handlers that raise KeyboardInterrupt so the
    # `finally` below always runs. Without this, a signal during run_loop
    # would unwind straight through `finally` (env restore only) and skip
    # prune, leaking this run's role tmux sessions (200-600 MB each) --
    # terminals only die on broker DELETE, never on process exit.
    previous_sigint = signal.signal(signal.SIGINT, _loop_signal_handler)
    previous_sigterm = signal.signal(signal.SIGTERM, _loop_signal_handler)
    try:
        exit_code = loop_core.run_loop(
            mailbox, args.max_iterations, runner, repo=repo, **loop_kwargs
        )
        stop = getattr(runner, "driver_stop", None)
        if stop:
            # A Lead-thread stop (root-occupied, writes-overlap): the core
            # recorded `status: error`; it is a human's call, not an error.
            return _apply_driver_stop(loop_core, mailbox, stop)
        return exit_code
    except RepoScopeRefusal:
        # Lockstep propagates runner errors; the refusal is already in
        # LOG.md/STATE.md and on stderr (open-loop returns 3 itself).
        return 3
    except KeyboardInterrupt:
        # SIGINT/SIGTERM arrived: prune first (in finally), then exit 130.
        return 130
    except Exception as exc:  # noqa: BLE001 - never leave STATE running
        # ONE mechanism for every driver stop (r15.x `_apply_driver_stop`,
        # which also covers r16a's "any driver exception leaves a terminal
        # STATE"): e.g. the integration-eval dispatch (or, root-free, its
        # worktree bind) raising out of the loop core while STATE.md said
        # `running` and `.driver.json` `eval_alive: true`.
        stop = getattr(runner, "driver_stop", None)
        if stop:
            return _apply_driver_stop(loop_core, mailbox, stop)
        # A held dispatch already set `status: needs_human` (exit 7 on
        # resume): only its sidecars change; a status that is already
        # terminal is kept.
        code = _apply_driver_stop(
            loop_core, mailbox,
            {"status": "error", "phase": "driver-exception", "reason": "driver-exception",
             "message": " ".join(f"{type(exc).__name__}: {exc}".split())[:800], "exit": 3},
            state=not _held_records(mailbox), keep_terminal=True,
        )
        if rf is not None:
            # Root-free: a clean exit 3 (the Lead worktree is kept; resume
            # re-attaches). Root-bound keeps propagating (exit 1 from `main`).
            return code
        raise
    finally:
        # Restore the prior handlers and env, then prune this run's created
        # sessions. Prune lives in `finally` (not after the try) so a
        # signal or any exception still cleans up -- role tmux sessions
        # only die on broker DELETE, never on process exit.
        signal.signal(signal.SIGINT, previous_sigint)
        signal.signal(signal.SIGTERM, previous_sigterm)
        if previous_ids_env is None:
            os.environ.pop(SESSION_IDS_ENV_VAR, None)
        else:
            os.environ[SESSION_IDS_ENV_VAR] = previous_ids_env
        torn_down: list[str] = []
        if not keep_sessions:
            created = list(getattr(runner, "created_session_ids", []) or [])
            created.extend(_read_session_ids_file(ids_file))
            held = set(getattr(runner, "held_session_ids", []) or [])
            records = _held_records(mailbox)
            held.update(
                str(record.get("session_id"))
                for _path, record in records
                if record.get("session_id")
            )
            for session_id in sorted(held):
                print(
                    f"trioctl: kept session {session_id}: delivery or role "
                    "completion uncertain; held record "
                    f"{_held_record_path(mailbox, session_id)}",
                    file=sys.stderr,
                )
            created = [sid for sid in created if sid not in held]
            # A slice-eval pool worker may still be running its dispatch
            # (abandoned by an interrupted or expired drain): never DELETE
            # that session out from under it. Only in-flight sessions whose
            # meta says kind == "slice-eval" are skipped; every other
            # in-flight session (Lead, repair, integration-eval, N=1) is
            # pruned exactly as before, so Ctrl-C mid-Lead-turn still kills
            # the Lead's pane.
            inflight: set[str] = set()
            snapshot_fn = getattr(runner, "inflight_sessions", None)
            if callable(snapshot_fn):
                try:
                    inflight = {
                        str(sid)
                        for sid, meta in (snapshot_fn() or {}).items()
                        if isinstance(meta, dict)
                        and meta.get("kind") == "slice-eval"
                    }
                except Exception:  # noqa: BLE001 - cleanup must still run
                    inflight = set()
            for session_id in sorted(inflight & set(created)):
                print(
                    f"trioctl: skipped_inflight session {session_id}: a "
                    "worker thread still owns it; not pruned",
                    file=sys.stderr,
                )
            created = [sid for sid in created if sid not in inflight]
            if any(not record.get("session_id") for _path, record in records):
                # An unreadable hold could name any of them: keep all.
                print(
                    "trioctl: unreadable held record under "
                    f"{mailbox / '.sessions'}; skipping session prune",
                    file=sys.stderr,
                )
                created = []
            torn_down = _run_post_loop_session_prune(
                mailbox, getattr(args, "base_url", None), created,
                keep_unarchived=getattr(args, "keep_unarchived", False),
            ) or []
            try:
                ids_file.unlink()
            except OSError:
                pass
        if isolate:
            try:
                runner.release_all_fences()
            except Exception as exc:  # noqa: BLE001
                print(f"trioctl: could not release integration fence: {exc}", file=sys.stderr)
            if not keep_sessions:
                try:
                    runner.restore_root_config_final(mailbox)
                except Exception as exc:  # noqa: BLE001 - never change the exit code
                    print(f"trioctl: root Cursor config restore failed: {exc}", file=sys.stderr)
            _release_root_turns_of(runner)
            # After prune, so deleted role sessions no longer hold their
            # worktrees; held sessions keep theirs (see _blocking_state).
            # Their runners exit asynchronously after archive/DELETE, so
            # worktrees they still hold are re-checked once they exit.
            try:
                _run_worktree_cleanup(repo, mailbox, torn_down=torn_down)
            except Exception as exc:  # noqa: BLE001 - never change the exit code
                print(f"trioctl: worker worktree cleanup failed: {exc}", file=sys.stderr)
        elif not keep_sessions:
            # Non-isolated: the root sessions were just pruned; undo their
            # own Omnigent merges into the root `.cursor` config.
            try:
                runner.restore_root_config_final(mailbox)
            except Exception as exc:  # noqa: BLE001 - never change the exit code
                print(f"trioctl: root Cursor config restore failed: {exc}", file=sys.stderr)
        _release_root_turns_of(runner)
        if registration is not None:
            registration.unregister()
        if rf is not None:
            _root_free_finish(rf, args)
        if observe:
            _finish_observation(observe)


def _release_root_turns_of(runner: Any) -> None:
    """Loop end: drop every root turn *runner* holds (never raises)."""
    release = getattr(runner, "release_root_turns", None)
    if callable(release):
        try:
            release()
        except Exception as exc:  # noqa: BLE001 - never change the exit code
            print(f"trioctl: could not release the root turn: {exc}", file=sys.stderr)


def _register_live_loop(
    args: argparse.Namespace, repo: Path, mailbox: Path, loop_core: Any, runner: Any,
    rf: dict[str, Any] | None = None,
) -> tuple["_LoopRegistration | None", int | None]:
    """Loop start (every mode): refuse overlapping `writes:` with live loops
    of the repository, then write this driver's registry record.

    Returns ``(registration or None, refusal exit code or None)``. The check
    and the registration happen under one registry flock, so two drivers
    starting together cannot both miss each other. A live driver already
    registered for the same mailbox refuses the start (exit 5, nothing
    written), as the loop core's mailbox lock would.
    """
    if worker_worktrees is None:
        return None, None
    if rf is not None:
        # r16 root-free: the loop belongs to the repository root, its
        # driver works on the Lead worktree's live mailbox.
        root = Path(os.path.realpath(str(rf["home"])))
        registration = _LoopRegistration(
            root, root / rf["info"]["mailbox_rel"], root_free_info=rf["info"],
            live_mailbox=mailbox,
        )
    else:
        root = Path(os.path.realpath(str(worker_worktrees.cursor_project_root(repo))))
        registration = _LoopRegistration(
            root, mailbox, mode="lockstep" if _loop_is_lockstep(mailbox) else "root-bound",
        )
    if _loop_registry_dir(root) is None:
        return None, None
    allow = _allow_overlapping_loops(args)
    with _loop_registry_guard(root):
        owner = _live_driver_of(root, registration.rel())
        if owner is not None and owner.get("pid") != os.getpid():
            print(
                f"trioctl: mailbox {registration.rel()} is owned by a live driver "
                f"(pid {owner.get('pid')}, {owner.get('mode') or 'root-bound'})",
                file=sys.stderr,
            )
            return None, 5
        problems = _writes_overlap_problems(root, mailbox)
        if problems and not allow:
            _refuse_overlap_at_start(loop_core, mailbox, problems)
            return None, REPO_SCOPE_REFUSED_EXIT
        registration.register()
    try:
        runner.loop_registry = {"root": str(root), "allow": allow, "logged": set(problems)}
    except AttributeError:
        pass
    iteration = _state_iteration(mailbox)
    for problem in problems:
        print(f"trioctl: warning: {problem}; {ALLOW_OVERLAPPING_LOOPS_ENV}=1 proceeds",
              file=sys.stderr)
        _append_mailbox_log(
            mailbox,
            f"- iter {iteration} | loop | warning: {problem}; "
            f"{ALLOW_OVERLAPPING_LOOPS_ENV}=1 proceeds (one shared aggregate: unsafe)",
        )
    return registration, None


def _refuse_overlap_at_start(loop_core: Any, mailbox: Path, problems: list[str]) -> None:
    """stderr + one LOG line (under the mailbox lock when free); STATE untouched."""
    for problem in problems:
        print(
            f"trioctl: refusing to start {mailbox}: {problem} (both loops share one "
            f"aggregate checkout; set {ALLOW_OVERLAPPING_LOOPS_ENV}=1 to override)",
            file=sys.stderr,
        )
    acquire = getattr(loop_core, "_acquire_lock", None)
    release = getattr(loop_core, "_release_lock", None)
    lock = acquire(mailbox) if callable(acquire) else None
    if callable(acquire) and lock is None:
        return  # a live driver owns this mailbox: leave it byte-identical
    try:
        _append_mailbox_log(
            mailbox,
            f"- iter {_state_iteration(mailbox)} | loop | refused to start: "
            + "; ".join(problems),
        )
    finally:
        if callable(release):
            release(lock)


def _clear_driver_stop_reason(loop_core: Any, mailbox: Path) -> None:
    """Resume: drop a `reason:` this driver wrote at an earlier stop."""
    state_path = mailbox / "STATE.md"
    try:
        text = state_path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return
    match = re.search(r"^\s*(?:-\s+)?reason\s*:\s*(\S+)", text, re.M | re.I)
    if not match or match.group(1) not in DRIVER_STOP_REASONS:
        return
    acquire = getattr(loop_core, "_acquire_lock", None)
    release = getattr(loop_core, "_release_lock", None)
    lock = acquire(mailbox) if callable(acquire) else None
    if callable(acquire) and lock is None:
        return
    try:
        _set_state_reason(state_path, None)
    finally:
        if callable(release):
            release(lock)


def _apply_driver_stop(
    loop_core: Any, mailbox: Path, stop: dict[str, Any], *, state: bool = True,
    keep_terminal: bool = False,
) -> int:
    """Record a driver stop: STATE status/phase/reason, one LOG line, sidecars.

    Written under the mailbox lock (a live driver that took the mailbox over
    meanwhile is left alone); `.driver.json`/`.session.json` get
    ``lead_alive``/``eval_alive`` false, so nothing reads as still running.
    With *keep_terminal* a STATE status that is already terminal (the
    core finished before the exception) is not overwritten. Returns the
    stop's exit code.
    """
    message = str(stop.get("message") or "")
    if state:
        print(f"trioctl: {stop.get('phase')}: {message}", file=sys.stderr)
    acquire = getattr(loop_core, "_acquire_lock", None)
    release = getattr(loop_core, "_release_lock", None)
    lock = acquire(mailbox) if callable(acquire) else None
    if callable(acquire) and lock is None:
        print(f"trioctl: {mailbox} is owned by another driver now; STATE.md left as is",
              file=sys.stderr)
        return int(stop.get("exit") or 3)
    try:
        state_path = mailbox / "STATE.md"
        update = getattr(loop_core, "_update_state", None)
        if state:
            try:
                terminal = False
                if keep_terminal and state_path.is_file():
                    current = re.search(
                        r"^\s*(?:-\s+)?status\s*:\s*(\S+)",
                        state_path.read_text(encoding="utf-8", errors="replace"), re.M | re.I,
                    )
                    codes = getattr(loop_core, "TERMINAL_CODES", {}) or {}
                    terminal = bool(current and current.group(1).lower() in codes)
                if callable(update) and state_path.is_file() and not terminal:
                    update(state_path, {"status": str(stop["status"]),
                                        "phase": str(stop["phase"])})
                _set_state_reason(state_path, str(stop.get("reason") or stop["phase"]))
            except (OSError, KeyError) as exc:
                print(f"trioctl: could not update {state_path}: {exc}", file=sys.stderr)
            _append_mailbox_log(
                mailbox,
                f"- iter {_state_iteration(mailbox)} | loop | {stop.get('status')} "
                f"({stop.get('phase')}): {message}",
            )
        for name in (".driver.json", ".session.json"):
            path = mailbox / name
            try:
                payload = json.loads(path.read_text(encoding="utf-8"))
            except (OSError, ValueError):
                continue
            if not isinstance(payload, dict):
                continue
            payload.update({"lead_alive": False, "eval_alive": False, "phase": "done"})
            if name == ".driver.json" and state:
                payload["stop"] = {k: stop.get(k) for k in ("status", "phase", "reason")}
            try:
                path.write_text(json.dumps(payload) + "\n", encoding="utf-8")
            except OSError:
                pass
    finally:
        if callable(release):
            release(lock)
    return int(stop.get("exit") or 3)


def _resolve_mailbox(value: Any, repo: Path) -> Path:
    mailbox = Path(value).expanduser()
    if not mailbox.is_absolute():
        mailbox = repo / mailbox
    return _live_mailbox_or(mailbox.resolve())


def _live_mailbox_or(mailbox: Path) -> Path:
    """r16: the live copy of a root mailbox a root-free loop owns, else *mailbox*.

    The user (and coordinators) keep naming the root path (`--mailbox
    loop/<x>` from the repository root); while the loop runs -- or has not
    landed yet -- its mailbox lives in the Lead worktree.
    """
    if root_free is None or worker_worktrees is None:
        return mailbox
    try:
        live = root_free.live_mailbox(worker_worktrees, mailbox)
    except Exception:  # noqa: BLE001 - resolution is best effort
        live = None
    return live.resolve() if live is not None else mailbox


def _reconcile_decision(
    mailbox: Path, repo: Path, client: Any
) -> tuple[dict[str, Any], dict[str, Any]]:
    """Read-only observe + pure decide (GETs only; no file writes)."""
    obs = reconcile.observe(
        mailbox, repo=repo, client=client,
        artifact_ready=_role_artifact_ready, broker_http=broker_http,
    )
    if not obs["holds"]:
        decision = {"action": "none", "code": "nothing_held",
                    "reasons": ["no held record"]}
    else:
        decision = reconcile.decide(obs.get("record"), obs)
    return decision, obs


def _reconcile_bounded(
    mailbox: Path,
    repo: Path,
    client: Any,
    *,
    apply: bool,
    max_wait: float,
    interval: float,
    loop_core: Any = None,
) -> tuple[dict[str, Any], dict[str, Any]]:
    """Poll `decide` while it says waiting (bounded), then maybe apply.

    The same decision function drives dry-run, `reconcile --apply` and
    `loop --reconcile-held`; apply re-decides under the mailbox lock.
    """
    deadline = time.monotonic() + max(max_wait, 0.0)
    while True:
        decision, obs = _reconcile_decision(mailbox, repo, client)
        if decision["action"] != "waiting" or time.monotonic() >= deadline:
            break
        time.sleep(max(min(interval, deadline - time.monotonic()), 0.0))
    journal = obs.get("journal") or {}
    resumable = journal.get("step") in ("applying", "done")
    if apply and (decision["action"] == "ready" or resumable):
        decision = reconcile.apply_once(
            mailbox, repo=repo, client=client,
            loop_core=loop_core or _load_trio_loop(repo),
            artifact_ready=_role_artifact_ready, broker_http=broker_http,
        )
    return decision, obs


RECONCILE_OK_ACTIONS = ("ready", "applied", "none")


def command_reconcile(args: argparse.Namespace) -> int:
    """Decide (and with --apply, perform) one held-dispatch reconcile.

    Default is a dry run: GET session/items and read files only -- no
    lock, no journal, no POST/DELETE, no mailbox or git writes.
    """
    if reconcile is None:
        raise TrioctlError("reconcile.py is not installed next to trioctl")
    repo = Path.cwd().resolve()
    mailbox = _resolve_mailbox(args.mailbox_pos or args.mailbox, repo)
    if not mailbox.is_dir():
        raise TrioctlError(f"mailbox {mailbox} does not exist")
    if args.apply and args.dry_run:
        raise TrioctlError("--apply and --dry-run are exclusive")
    client = None if args.offline else _session_client(args.base_url)
    if args.apply and client is None:
        raise TrioctlError("--apply needs the broker (drop --offline)")
    decision, obs = _reconcile_bounded(
        mailbox, repo, client,
        apply=args.apply,
        max_wait=args.max_wait if args.watch else 0.0,
        interval=args.interval,
    )
    payload = {
        "mailbox": str(mailbox),
        "dry_run": not args.apply,
        "decision": decision,
        "observation": reconcile.evidence(obs),
        "would_apply": decision["action"] == "ready" and not args.apply,
        "contract": {k: v for k, v in reconcile.CONTRACT.items()
                     if k.endswith("label")},
    }
    if args.json:
        _print_json(payload)
    else:
        print(f"{decision['action']}: {decision['code']}")
        for reason in decision.get("reasons", []):
            print(f"  - {reason}")
    return 0 if decision["action"] in RECONCILE_OK_ACTIONS else (
        HELD_DISPATCH_EXIT
    )


def _loop_signal_handler(signum: int, frame: object) -> None:
    """SIGINT/SIGTERM handler installed by `command_loop`.

    Raises KeyboardInterrupt so the loop's `finally` runs prune. Kept at
    module scope so tests can invoke it directly; SIGINT and SIGTERM share
    this one handler.
    """
    raise KeyboardInterrupt


def omnigent_registry_path() -> Path:
    """Return the existing user-owned role registry path."""
    return (
        Path(os.environ.get("OMNIGENT_HOME", str(Path.home() / ".omnigent")))
        / "agents"
        / "trio-omnigent-roles"
        / "registry.json"
    )


def _scout_agent_id(entries: object) -> str | None:
    """Read a scout registration from either supported registry key."""
    if not isinstance(entries, dict):
        return None
    for key in ("trio-omnigent-scout", "scout"):
        entry = entries.get(key)
        if isinstance(entry, str) and entry.strip():
            return entry.strip()
        if isinstance(entry, dict):
            for field in ("agent_id", "agentId", "id"):
                value = entry.get(field)
                if isinstance(value, str) and value.strip():
                    return value.strip()
    return None


def check_live_session(
    config: dict[str, Any] | None,
    catalogs: dict[str, list[dict[str, Any]]],
    base_url: str,
) -> dict[str, Any]:
    """Probe session creation, snapshot, and item retrieval on demand."""
    path = omnigent_registry_path()
    if config is None:
        return {
            "check": "omnigent:session-api",
            "ok": False,
            "detail": "cannot resolve scout model because config is invalid",
        }
    try:
        entries = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        return {
            "check": "omnigent:session-api",
            "ok": False,
            "detail": f"scout agent registry unavailable at {path}: {exc}",
        }
    agent_id = os.environ.get("OMNIGENT_LIVE_SESSION_AGENT_ID", "").strip()
    agent_id = agent_id or _scout_agent_id(entries)
    try:
        provider = config["roles"]["scout"].get("provider")
        resolved = resolve_role(
            "scout",
            config,
            models=catalogs.get(provider, []),
        )
        client = _session_client(base_url)
        if not agent_id:
            listed = client.list_agents()
            rows = listed.get("data") if isinstance(listed, dict) else listed
            if not isinstance(rows, list):
                rows = []
            for row in rows:
                if not isinstance(row, dict):
                    continue
                name = str(row.get("name") or "")
                row_id = row.get("id") or row.get("agent_id")
                if name == "cursor-native-ui" and isinstance(row_id, str):
                    agent_id = row_id
                    break
        if not agent_id:
            return {
                "check": "omnigent:session-api",
                "ok": False,
                "detail": (
                    "no scout agent_id; set OMNIGENT_LIVE_SESSION_AGENT_ID "
                    "or expose cursor-native-ui on GET /v1/agents"
                ),
            }
        created = client.create_session(
            agent_id,
            resolved["model"],
            "Reply with the single word pong and stop.",
            "trioctl doctor",
        )
        if not isinstance(created, dict):
            raise TrioctlError("session create returned a non-object response")
        session_id = created.get("id") or created.get("session_id")
        if not isinstance(session_id, str) or not session_id:
            raise TrioctlError("session create response has no session id")
        snapshot = client.get_session(session_id)
        items = client.get_items(session_id)
        if isinstance(items, dict) and isinstance(items.get("items"), list):
            item_count = len(items["items"])
        elif isinstance(items, list):
            item_count = len(items)
        else:
            item_count = "received"
        status = _session_status(snapshot) or "unknown"
        return {
            "check": "omnigent:session-api",
            "ok": True,
            "detail": (
                f"{session_id}: status={status}, items={item_count}, "
                f"model={resolved['model']}"
            ),
        }
    except (TrioctlError, broker_http.BrokerHttpError) as exc:
        return {
            "check": "omnigent:session-api",
            "ok": False,
            "detail": str(exc),
        }


def command_doctor(args: argparse.Namespace) -> int:
    path = config_path(args.config)
    checks: list[dict[str, Any]] = []
    try:
        config = load_config(path)
    except TrioctlError as exc:
        config = None
        checks.append({"check": "config", "ok": False, "detail": str(exc)})
    else:
        checks.append({"check": "config", "ok": True, "detail": str(path)})

    providers = {
        spec.get("provider")
        for spec in (config or {}).get("roles", {}).values()
        if isinstance(spec, dict)
    }
    required_commands = {"omnigent"}
    required_commands.update(
        {"claude" if provider == "claude" else provider for provider in providers}
    )
    if "cursor" in required_commands:
        required_commands.remove("cursor")
        required_commands.add("cursor-agent")
    for command in sorted(required_commands):
        found = shutil.which(command)
        checks.append(
            {
                "check": f"command:{command}",
                "ok": found is not None,
                "detail": found or "not on PATH",
            }
        )
    try:
        detail = omnigent_contract()
        checks.append(
            {"check": "omnigent:session-contract", "ok": True, "detail": detail}
        )
    except TrioctlError as exc:
        checks.append(
            {
                "check": "omnigent:session-contract",
                "ok": False,
                "detail": str(exc),
            }
        )

    checks.append(check_cursor_approval_mode())

    prompt_repo = Path.cwd().resolve()
    try:
        prompt_dirs = {
            role: OmnigentRunner(repo=prompt_repo)._prompt_path(role).parent
            for role in ("lead", "evaluator")
        }
    except TrioctlError as exc:
        checks.append({"check": "prompts", "ok": False, "detail": str(exc)})
    else:
        resolved = sorted({str(directory) for directory in prompt_dirs.values()})
        checks.append(
            {"check": "prompts", "ok": True, "detail": ", ".join(resolved)}
        )

    catalogs: dict[str, list[dict[str, Any]]] = {}
    for provider, loader in (("codex", codex_models), ("cursor", cursor_models)):
        if provider not in providers:
            continue
        try:
            catalogs[provider] = loader(args.timeout)
            checks.append(
                {
                    "check": f"{provider}:model/list",
                    "ok": True,
                    "detail": f"{len(catalogs[provider])} available models",
                }
            )
        except TrioctlError as exc:
            checks.append(
                {"check": f"{provider}:model/list", "ok": False, "detail": str(exc)}
            )

    if config is not None:
        for role in ROLES:
            try:
                resolved = resolve_role(
                    role,
                    config,
                    models=catalogs.get(config["roles"][role].get("provider"), []),
                )
                effort = resolved.get("reasoning_effort") or resolved.get(
                    "model_effort"
                )
                detail = f"{resolved['model']} / {effort} ({resolved['source']})"
                if role == "docs" and config.get("_docs_role_fallback"):
                    detail += "; no [roles.docs] configured, using [roles.scout]"
                checks.append(
                    {
                        "check": f"role:{role}",
                        "ok": True,
                        "detail": detail,
                    }
                )
            except TrioctlError as exc:
                checks.append(
                    {"check": f"role:{role}", "ok": False, "detail": str(exc)}
                )

    registry = omnigent_registry_path()
    try:
        entries = json.loads(registry.read_text())
        if entries.get("_profile") != REGISTRY_PROFILE:
            raise TrioctlError(
                "registered role profile is stale; back up registry.json and "
                "re-register Lead/Evaluator from the current role configs"
            )
        # Only the two orchestration roles are durable Omnigent agents. Cursor
        # workers are ephemeral headless CLI runs, avoiding cursor-native's
        # one-chat-per-workspace transcript ownership collision.
        expected = {"trio-omnigent-lead", "trio-omnigent-evaluator"}
        missing = sorted(expected - set(entries))
        if missing:
            raise TrioctlError(f"missing: {', '.join(missing)}")
        obsolete = sorted(
            {"trio-omnigent-builder", "trio-omnigent-scout"} & set(entries)
        )
        if obsolete:
            raise TrioctlError(
                "obsolete persistent Cursor roles: "
                f"{', '.join(obsolete)}; remove them and restart Omnigent once"
            )
        checks.append({"check": "registry", "ok": True, "detail": str(registry)})
    except (OSError, json.JSONDecodeError, TypeError, TrioctlError) as exc:
        checks.append({"check": "registry", "ok": False, "detail": str(exc)})

    if getattr(args, "live_session", False):
        checks.append(
            check_live_session(
                config,
                catalogs,
                getattr(args, "base_url", broker_http.DEFAULT_BASE_URL),
            )
        )

    if args.json:
        print(
            json.dumps(
                {"ok": all(item["ok"] for item in checks), "checks": checks}, indent=2
            )
        )
    else:
        for item in checks:
            status = item.get("status") or ("PASS" if item["ok"] else "FAIL")
            print(f"{status} {item['check']}: {item['detail']}")
    return 0 if all(item["ok"] for item in checks) else 1


def _add_root_free_arguments(loop: argparse.ArgumentParser) -> None:
    """r16a root-free open-loop flags of `loop` (default ON for open-loop)."""
    mode = loop.add_mutually_exclusive_group()
    mode.add_argument(
        "--root-free",
        dest="root_free",
        action="store_const",
        const=True,
        default=None,
        help="open-loop (default): run every role in this loop's own Lead "
        "worktree on branch trio/<mailbox>, never at the repository root, and "
        "land it onto the target branch after SHIP; given explicitly, an "
        "unmet prerequisite is a refusal instead of a root-bound run",
    )
    mode.add_argument(
        "--root-bound",
        dest="root_free",
        action="store_const",
        const=False,
        help="run this open-loop at the repository root (pre-r16 behaviour)",
    )
    loop.add_argument(
        "--target",
        default=None,
        help="root-free: the branch the loop forks from and lands onto "
        "(default: the branch checked out at the repository root)",
    )
    loop.add_argument(
        "--keep-branch",
        action="store_true",
        help="root-free: keep the trio/<mailbox> branch(es) after a successful land",
    )


def parser() -> argparse.ArgumentParser:
