def _append_mailbox_log(mailbox: Path, line: str) -> None:
    """Append one LOG.md line (newline-safe, like the loop core's `_append_log`)."""
    log = Path(mailbox) / "LOG.md"
    try:
        prefix = ""
        if log.is_file():
            with open(log, "rb") as fh:
                fh.seek(0, os.SEEK_END)
                if fh.tell():
                    fh.seek(-1, os.SEEK_END)
                    prefix = "" if fh.read(1) == b"\n" else "\n"
        with open(log, "a", encoding="utf-8") as fh:
            fh.write(prefix + line.rstrip("\n") + "\n")
    except OSError as exc:
        print(f"trioctl: could not append to {log}: {exc}", file=sys.stderr)


