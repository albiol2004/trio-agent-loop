class TrioctlError(RuntimeError):
    """A user-actionable configuration or discovery failure."""


def _load_broker_http() -> Any:
    """Load the sibling client without importing this directory as a package."""
    path = Path(__file__).with_name("broker_http.py")
    loader = importlib.machinery.SourceFileLoader(
        "trioctl_broker_http",
        str(path),
    )
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise ImportError(f"cannot load broker client: {path}")
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


# The repository directory is named ``omnigent``.  A non-package loader keeps
# running from the repository root from accidentally resolving that directory.
broker_http = _load_broker_http()


def config_path(value: str | None = None) -> Path:
    if value:
        return Path(value).expanduser()
    override = os.environ.get("TRIOCTL_CONFIG")
    if override:
        return Path(override).expanduser()
    base = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    return base / "trio-agent-loop" / "omnigent.toml"


def load_config(path: Path) -> dict[str, Any]:
    try:
        data = tomllib.loads(path.read_text())
    except FileNotFoundError as exc:
        raise TrioctlError(
            f"config not found: {path}; run 'trioctl omnigent configure'"
        ) from exc
    except (OSError, tomllib.TOMLDecodeError) as exc:
        raise TrioctlError(f"cannot read config {path}: {exc}") from exc
    if data.get("version") != 1:
        raise TrioctlError(f"{path}: version must be 1")
    roles = data.get("roles")
    if not isinstance(roles, dict):
        raise TrioctlError(f"{path}: missing [roles.*] tables")
    docs_fallback = False
    if not isinstance(roles.get("docs"), dict) and isinstance(roles.get("scout"), dict):
        # ``docs`` is a newer role; older profiles omit it. Reuse the scout
        # table (same provider family, ephemeral Cursor worker) so existing
        # profiles keep working without edits.
        roles["docs"] = dict(roles["scout"])
        docs_fallback = True
    missing = [role for role in ROLES if not isinstance(roles.get(role), dict)]
    if missing:
        raise TrioctlError(f"{path}: missing roles: {', '.join(missing)}")
    data["_docs_role_fallback"] = docs_fallback
    return data


def _send(proc: subprocess.Popen[str], payload: dict[str, Any]) -> None:
    if proc.stdin is None:
        raise TrioctlError("Codex app-server stdin is unavailable")
    proc.stdin.write(json.dumps(payload, separators=(",", ":")) + "\n")
    proc.stdin.flush()


def _wait_response(
    proc: subprocess.Popen[str],
    selector: selectors.BaseSelector,
    request_id: int,
    deadline: float,
) -> dict[str, Any]:
    while time.monotonic() < deadline:
        events = selector.select(max(0.0, min(0.5, deadline - time.monotonic())))
        if not events:
            if proc.poll() is not None:
                break
            continue
        if proc.stdout is None:
            break
        line = proc.stdout.readline()
        if not line:
            break
        try:
            message = json.loads(line)
        except json.JSONDecodeError:
            continue
        if message.get("id") == request_id:
            if "error" in message:
                raise TrioctlError(f"Codex app-server error: {message['error']}")
            return message
    raise TrioctlError(f"Codex app-server timed out waiting for response {request_id}")


def codex_models(timeout: float = 15.0) -> list[dict[str, Any]]:
    codex = shutil.which("codex")
    if not codex:
        raise TrioctlError("codex is not on PATH")
    try:
        proc = subprocess.Popen(
            [codex, "app-server", "--stdio"],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            bufsize=1,
        )
    except OSError as exc:
        raise TrioctlError(f"could not start Codex app-server: {exc}") from exc

    selector = selectors.DefaultSelector()
    assert proc.stdout is not None
    selector.register(proc.stdout, selectors.EVENT_READ)
    deadline = time.monotonic() + timeout
    try:
        _send(
            proc,
            {
                "id": 1,
                "method": "initialize",
                "params": {
                    "clientInfo": {"name": "trioctl", "version": VERSION},
                    "capabilities": {"experimentalApi": True},
                },
            },
        )
        _wait_response(proc, selector, 1, deadline)
        _send(proc, {"method": "initialized"})

        models: list[dict[str, Any]] = []
        cursor: str | None = None
        request_id = 2
        while True:
            params: dict[str, Any] = {"includeHidden": False}
            if cursor:
                params["cursor"] = cursor
            _send(
                proc,
                {"id": request_id, "method": "model/list", "params": params},
            )
            envelope = _wait_response(proc, selector, request_id, deadline)
            result = envelope.get("result")
            if not isinstance(result, dict) or not isinstance(result.get("data"), list):
                raise TrioctlError("Codex model/list returned an invalid response")
            for item in result["data"]:
                if isinstance(item, dict):
                    models.append(item)
            cursor = result.get("nextCursor")
            if cursor is None:
                return models
            if not isinstance(cursor, str) or not cursor:
                raise TrioctlError("Codex model/list returned an invalid cursor")
            request_id += 1
    finally:
        selector.close()
        if proc.poll() is None:
            proc.terminate()
        try:
            proc.communicate(timeout=3)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.communicate()


def cursor_models(timeout: float = 15.0) -> list[dict[str, Any]]:
    """Return the authenticated Cursor CLI's live account model catalog."""
    cursor = shutil.which("cursor-agent")
    if not cursor:
        raise TrioctlError("cursor-agent is not on PATH")
    try:
        result = subprocess.run(
            [cursor, "models"],
            capture_output=True,
            text=True,
            timeout=timeout,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise TrioctlError(f"could not query Cursor models: {exc}") from exc
    if result.returncode:
        detail = result.stderr.strip() or result.stdout.strip()
        raise TrioctlError(
            f"Cursor model listing failed: {detail or result.returncode}"
        )

    models: list[dict[str, Any]] = []
    for line in result.stdout.splitlines():
        match = re.match(r"^(\S+)\s+-\s+(.+?)\s*$", line)
        if match:
            model_id, display_name = match.groups()
            models.append(
                {"id": model_id, "model": model_id, "displayName": display_name}
            )
    if not models:
        raise TrioctlError("Cursor model listing returned no parseable models")
    return models


def _efforts(model: dict[str, Any]) -> set[str]:
    values = model.get("supportedReasoningEfforts", [])
    if not isinstance(values, list):
        return set()
    return {
        item["reasoningEffort"]
        for item in values
        if isinstance(item, dict) and isinstance(item.get("reasoningEffort"), str)
    }


def _model_rank(model: dict[str, Any]) -> tuple[int, ...]:
    value = str(model.get("model") or model.get("id") or "")
    match = re.search(r"gpt-(\d+)(?:\.(\d+))?(?:\.(\d+))?", value, re.I)
    numbers = tuple(int(part or 0) for part in match.groups()) if match else (0, 0, 0)
    return (*numbers, int(bool(model.get("isDefault"))))


def _family_matches(model: dict[str, Any], family: str) -> bool:
    needle = re.sub(r"[^a-z0-9]+", "-", family.lower()).strip("-")
    values = (
        re.sub(r"[^a-z0-9]+", "-", str(model.get(key) or "").lower()).strip("-")
        for key in ("id", "model", "displayName")
    )
    return any(needle in value for value in values)


def resolve_role(
    role: str,
    config: dict[str, Any],
    *,
    models: list[dict[str, Any]] | None = None,
    allow_fallback: bool = False,
) -> dict[str, Any]:
    if role not in ROLES:
        raise TrioctlError(f"unknown role: {role}")
    spec = config["roles"][role]
    provider = spec.get("provider")
    effort = spec.get("effort")
    if provider not in {"claude", "codex", "cursor"} or not isinstance(effort, str):
        raise TrioctlError(f"roles.{role}: provider/effort is invalid")

    if provider == "claude":
        model = spec.get("model")
        if not isinstance(model, str) or not model:
            raise TrioctlError(f"roles.{role}: Claude roles require model")
        return {
            "role": role,
            "provider": provider,
            "model": model,
            "reasoning_effort": effort,
            "source": "configured-alias",
        }

    try:
        catalog = (
            models
            if models is not None
            else (cursor_models() if provider == "cursor" else codex_models())
        )
        exact = spec.get("model")
        family = spec.get("model_family")
        if isinstance(exact, str) and exact:
            matches = [
                item for item in catalog if exact in {item.get("id"), item.get("model")}
            ]
        elif isinstance(family, str) and family:
            matches = [item for item in catalog if _family_matches(item, family)]
        else:
            raise TrioctlError(
                f"roles.{role}: {provider} roles require model or model_family"
            )
        if provider == "cursor":
            fast = spec.get("fast", False)
            matches = [
                item
                for item in matches
                if str(item.get("model") or item.get("id") or "").endswith(
                    f"-{effort}" + ("-fast" if fast else "")
                )
            ]
        if not matches:
            wanted = exact or f"family {family!r}"
            raise TrioctlError(
                f"roles.{role}: no available {provider} model matches {wanted} "
                f"at effort {effort!r}"
            )
        selected = max(matches, key=_model_rank)
        supported = _efforts(selected) if provider == "codex" else set()
        if provider == "codex" and supported and effort not in supported:
            name = selected.get("model") or selected.get("id")
            raise TrioctlError(
                f"roles.{role}: {name} does not support effort {effort!r}; "
                f"available: {', '.join(sorted(supported))}"
            )
        model = selected.get("model") or selected.get("id")
        if not isinstance(model, str) or not model:
            raise TrioctlError("selected Codex model has no usable identifier")
        return {
            "role": role,
            "provider": provider,
            "model": model,
            "reasoning_effort": effort if provider == "codex" else None,
            "model_effort": effort if provider == "cursor" else None,
            "source": f"{provider}-model-list",
        }
    except TrioctlError:
        fallback = spec.get("fallback_model")
        if not allow_fallback or not isinstance(fallback, str) or not fallback:
            raise
        return {
            "role": role,
            "provider": provider,
            "model": fallback,
            "reasoning_effort": effort if provider == "codex" else None,
            "model_effort": effort if provider == "cursor" else None,
            "source": "explicit-fallback",
        }


def omnigent_contract() -> str:
    """Verify the installed Omnigent package exposes Trio's required seams."""
    executable = shutil.which("omnigent")
    if not executable:
        raise TrioctlError("omnigent is not on PATH")
    try:
        first_line = Path(executable).read_text().splitlines()[0]
    except (OSError, IndexError) as exc:
        raise TrioctlError(f"cannot inspect {executable}: {exc}") from exc
    if not first_line.startswith("#!"):
        raise TrioctlError(f"{executable} has no Python shebang")
    interpreter = first_line[2:]
    probe = """
from omnigent.tools.builtins.spawn import SysSessionCreateTool

# 0.14 renamed the helper; 0.12 (and the 0.14 fork alias) still
# export _resolve_agent_spec. Prefer the new name, fall back.
try:
    from omnigent.server.routes.sessions import _resolve_subagent_spec as _resolve
except ImportError:
    from omnigent.server.routes.sessions import _resolve_agent_spec as _resolve

create_props = SysSessionCreateTool().get_schema()["function"]["parameters"]["properties"]
assert "reasoning_effort" in create_props
assert callable(_resolve)
"""
    try:
        result = subprocess.run(
            [interpreter, "-c", probe],
            capture_output=True,
            text=True,
            timeout=15,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise TrioctlError(f"Omnigent contract probe failed: {exc}") from exc
    if result.returncode:
        detail = result.stderr.strip().splitlines()
        suffix = detail[-1] if detail else f"exit {result.returncode}"
        raise TrioctlError(f"required session/launch support is missing: {suffix}")
    return "session-create effort and registered native launch propagation available"


def cursor_cli_config_path() -> Path:
    """Location of the Cursor CLI's user config (respects $HOME)."""
    return Path.home() / ".cursor" / "cli-config.json"


def check_cursor_approval_mode() -> dict[str, Any]:
    """Doctor check: Cursor CLI must run with approvalMode="unrestricted".

    --require-unrestricted: when a Lead/Evaluator --yolo session runs on
    top of a Cursor CLI still set to "allowlist", cursor-agent surfaces
    interactive approval prompts. Omnigent's _yolo_auto_accept workaround
    retries those for 3 attempts and then gives up, surfacing a manual
    ApprovalCard and stalling the loop.
    """
    path = cursor_cli_config_path()
    fix_hint = (
        "run `trioctl omnigent fix-approval-mode` (or set approvalMode to "
        '"unrestricted" and sandbox.mode to "disabled" by hand) in '
        f"{path}"
    )
    if not path.exists():
        return {
            "check": "cursor:approval-mode",
            "ok": True,
            "status": "WARN",
            "detail": (
                f"{path} not found; cursor-agent will use its built-in "
                "default approval mode, which may not be unrestricted. "
                f"--require-unrestricted: {fix_hint}"
            ),
        }
    try:
        data = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        return {
            "check": "cursor:approval-mode",
            "ok": False,
            "status": "FAIL",
            "detail": f"cannot read/parse {path}: {exc}. {fix_hint}",
        }
    mode = data.get("approvalMode") if isinstance(data, dict) else None
    if mode == "unrestricted":
        return {
            "check": "cursor:approval-mode",
            "ok": True,
            "status": "PASS",
            "detail": f'{path}: approvalMode="unrestricted"',
        }
    return {
        "check": "cursor:approval-mode",
        "ok": False,
        "status": "FAIL",
        "detail": (
            f"{path}: approvalMode={mode!r} (need \"unrestricted\"). "
            "--require-unrestricted: Lead/Evaluator --yolo sessions "
            "otherwise fall back to Omnigent's 3-attempt auto-accept and "
            f"surface manual approval cards. Fix: {fix_hint}"
        ),
    }


def command_fix_approval_mode(args: argparse.Namespace) -> int:
    path = cursor_cli_config_path()
    if not path.exists():
        raise TrioctlError(
            f"{path} does not exist; run cursor-agent once to create it, "
            'or create it manually with {"approvalMode": "unrestricted"}'
        )
    raw = path.read_text()
    try:
        data = json.loads(raw)
    except json.JSONDecodeError as exc:
        raise TrioctlError(f"{path} is not valid JSON, refusing to edit: {exc}") from exc
    before = json.dumps(data, indent=2, sort_keys=True)
    timestamp = time.strftime("%Y%m%dT%H%M%S")
    backup = path.with_name(f"{path.name}.bak-trio-{timestamp}")
    shutil.copyfile(path, backup)
    data["approvalMode"] = "unrestricted"
    sandbox = data.get("sandbox")
    if not isinstance(sandbox, dict):
        sandbox = {}
    sandbox["mode"] = "disabled"
    data["sandbox"] = sandbox
    after = json.dumps(data, indent=2, sort_keys=True)
    path.write_text(after + "\n")
    print(f"Backed up: {backup}")
    print("Before:")
    print(before)
    print("After:")
    print(after)
    return 0


def command_configure(args: argparse.Namespace) -> int:
    target = config_path(args.config)
    if target.exists() and not args.force:
        print(f"Preserving existing config: {target}")
        return 0
    source = DEFAULT_CONFIG
    if not source.is_file():
        raise TrioctlError(f"default config is missing: {source}")
    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(source, target)
    print(f"Wrote config: {target}")
    return 0


def command_models(args: argparse.Namespace) -> int:
    catalogs = {}
    if args.provider in {"codex", "all"}:
        catalogs["codex"] = codex_models(args.timeout)
    if args.provider in {"cursor", "all"}:
        catalogs["cursor"] = cursor_models(args.timeout)
    if args.json:
        print(json.dumps({"providers": catalogs}, indent=2, sort_keys=True))
        return 0
    for provider, models in catalogs.items():
        print(f"{provider}:")
        for model in models:
            name = model.get("model") or model.get("id") or "?"
            if provider == "codex":
                detail = ", ".join(sorted(_efforts(model))) or "unspecified"
            else:
                detail = model.get("displayName") or "available"
            default = " (default)" if model.get("isDefault") else ""
            print(f"  {name}{default}: {detail}")
    return 0


def command_resolve(args: argparse.Namespace) -> int:
    config = load_config(config_path(args.config))
    result = resolve_role(args.role, config, allow_fallback=args.allow_fallback)
    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        effort = result.get("reasoning_effort") or result.get("model_effort")
        print(f"{result['role']}: {result['model']} / {effort} ({result['source']})")
    return 0


def run_cursor_worker(
    role: str,
    config: dict[str, Any],
    *,
    prompt: str,
    workspace: Path,
    models: list[dict[str, Any]] | None = None,
    timeout: float | None = None,
) -> str:
    """Run one ephemeral Cursor worker with the live profile-resolved model."""
    if role not in CURSOR_WORKER_ROLES:
        raise TrioctlError(
            f"Cursor worker role must be one of: {', '.join(CURSOR_WORKER_ROLES)}"
        )
    if not prompt.strip():
        raise TrioctlError("Cursor worker prompt is empty")
    resolved = resolve_role(role, config, models=models)
    if resolved["provider"] != "cursor":
        raise TrioctlError(f"roles.{role}: provider must be cursor for worker dispatch")
    cursor = shutil.which("cursor-agent")
    if not cursor:
        raise TrioctlError("cursor-agent is not on PATH")
    command = [
        cursor,
        "-p",
        "--output-format",
        "text",
        "--model",
        resolved["model"],
        "--force",
        "--trust",
        "--approve-mcps",
        "--workspace",
        str(workspace.resolve()),
    ]
    if role == "scout":
        command.extend(["--mode", "ask"])
    full_prompt = f"{CURSOR_ROLE_PROMPTS[role]}\n\nTASK FROM LEAD:\n{prompt.strip()}\n"
    try:
        result = subprocess.run(
            command,
            input=full_prompt,
            capture_output=True,
            text=True,
            timeout=timeout,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise TrioctlError(f"Cursor {role} failed to run: {exc}") from exc
    if result.returncode:
        detail = result.stderr.strip() or result.stdout.strip()
        raise TrioctlError(
            f"Cursor {role} exited {result.returncode}: {detail or 'no output'}"
        )
    output = result.stdout.strip()
    if not output:
        raise TrioctlError(f"Cursor {role} completed without output")
    return output


def command_run(args: argparse.Namespace) -> int:
    """Run one headless Cursor worker (a separate OS process from `loop`).

    `run_cursor_worker` drives `cursor-agent` directly and never opens an
    Omnigent broker session, so today there is no id to append to a
    `loop` run's `SESSION_IDS_ENV_VAR` ids file -- that file only ever
    gains entries through `_record_created_session_id`, which this
    process-boundary hook exists to route a headless worker's session id
    through if a future dispatch path ever opens a broker-tracked one.
    """
    config = load_config(config_path(args.config))
    if args.prompt_file == "-":
        prompt = sys.stdin.read()
    else:
        try:
            prompt = Path(args.prompt_file).read_text()
        except OSError as exc:
            raise TrioctlError(
                f"cannot read prompt file {args.prompt_file}: {exc}"
            ) from exc
    output = run_cursor_worker(
        args.role,
        config,
        prompt=prompt,
        workspace=Path(args.workspace),
        timeout=args.timeout,
    )
    print(output)
    return 0


SESSION_FAILURE_STATUSES = {"failed", "error"}


def _session_items(payload: Any) -> list[Any]:
    """Extract item rows from either the API list or envelope response."""
    if isinstance(payload, list):
        return payload
    if isinstance(payload, dict):
        for key in ("items", "data"):
            value = payload.get(key)
            if isinstance(value, list):
                return value
    return []


def _item_role(item: Any) -> str:
    """Read a conversation item's role across API envelope versions."""
    if not isinstance(item, dict):
        return ""
    role = item.get("role")
    if isinstance(role, str):
        return role.lower()
    data = item.get("data")
    role = data.get("role") if isinstance(data, dict) else None
    return role.lower() if isinstance(role, str) else ""


def _is_completed_assistant_message(item: Any) -> bool:
    """Return whether an item is a finished assistant message, not a turn.

    Live Cursor rows use type=message, role=assistant, status=completed.
    type=turn marks turn start and is not terminal. Mid-turn assistant
    progress is also completed, so callers must still require idle-after-
    running.
    """
    if not isinstance(item, dict):
        return False
    if _item_role(item) != "assistant":
        return False
    kind = str(item.get("type") or "message").lower()
    if kind in {"turn", "resource_event"}:
        return False
    if kind not in {"message", "assistant", "response"}:
        return False
    status = str(item.get("status") or "").lower()
    return status in {"completed", "done"}


def _has_completed_assistant_message(payload: Any) -> bool:
    """Return whether any item in a poll page is a finished assistant message."""
    return any(
        _is_completed_assistant_message(item) for item in _session_items(payload)
    )


def _get_latest_items(client: Any, session_id: str) -> Any:
    """Fetch a short newest-first page so wait can see assistant completion."""
    method = getattr(client, "get_items", None)
    if method is None:
        raise TrioctlError("broker client has no session-items method")
    try:
        return method(session_id, limit=10, order="desc")
    except TypeError:
        # Keep small test doubles compatible while the real client uses the
        # explicit API query that prevents downloading the whole transcript.
        return method(session_id)


def _session_runner_id(snapshot: Any) -> str | None:
    """Return a bound runner id, or None when the runner has not attached."""
    if not isinstance(snapshot, dict):
        return None
    value = snapshot.get("runner_id")
    if isinstance(value, str) and value.strip():
        return value.strip()
    return None


def _runner_is_bound(snapshot: Any) -> bool:
    """Treat a missing runner_id field as bound so older fakes still work.

    Live snapshots include ``runner_id``. Null means the pre-running window
    and is never a completion signal. Tests that omit the field are unchanged.
    """
    if not isinstance(snapshot, dict) or "runner_id" not in snapshot:
        return True
    return _session_runner_id(snapshot) is not None


def _wait_for_session(
    client: Any,
    session_id: str,
    *,
    timeout: float,
    interval: float,
    stable_idle: float = 0.0,
) -> Any:
    """Wait until Cursor has run a turn, then stayed idle.

    Live Grok Lead sessions often omit assistant rows from GET /items
    (only a resource_event remains). Cursor-native instead emits an
    early completed assistant ack while the role is still working.
    Completion is therefore idle + bound runner, held for
    ``stable_idle`` seconds, when either:

    - a completed assistant message is present, or
    - the session has been ``running`` and at least one item exists.

    ``running`` resets the dwell. A null ``runner_id`` and a type=turn
    row are never terminal. Failed statuses return at once. Timeouts
    stay distinct.

    Right after an Omnigent restart, a session can cycle bound -> running
    -> idle within seconds with **zero** items (the runner later shows as
    unbound again, ``runner_id: None``): a restart blip, not a completed
    pass. A real turn always leaves at least one item behind (the
    ``terminal_cursor_main`` resource_event), so an idle+bound+saw_running
    snapshot with no items at all is treated as not-yet-terminal instead
    of starting (or continuing) the ``stable_idle`` dwell.
    """
    if timeout < 0:
        raise TrioctlError("--timeout must be non-negative")
    if interval < 0:
        raise TrioctlError("--interval must be non-negative")
    if stable_idle < 0:
        raise TrioctlError("stable_idle must be non-negative")

    get_session = getattr(client, "get_session", None)
    if get_session is None:
        raise TrioctlError("broker client has no session-wait method")
    saw_running = False
    idle_since: float | None = None
    deadline = time.monotonic() + timeout

    while True:
        items = _get_latest_items(client, session_id)
        snapshot = get_session(session_id)
        status = _session_status(snapshot)
        if status in SESSION_FAILURE_STATUSES:
            return snapshot
        bound = _runner_is_bound(snapshot)
        has_assistant = _has_completed_assistant_message(items)
        now = time.monotonic()

        if status == "running":
            saw_running = True
            idle_since = None
        elif status == "idle" and bound and (
            has_assistant
            or (saw_running and _session_items(items))
        ):
            # Assistant acks and resource_event-only Grok turns both
            # need idle to stick. A post-restart blip is idle+bound
            # after running with zero items and never starts the dwell.
            if idle_since is None:
                idle_since = now
            if now - idle_since >= stable_idle:
                return snapshot
        else:
            idle_since = None

        if now >= deadline:
            raise TrioctlError(
                f"session {session_id} timed out after {timeout:g} seconds"
            )
        remaining = deadline - now
        time.sleep(min(interval, remaining))


def _mailbox_text(path: Path) -> str:
    """Read a mailbox file; missing files count as empty."""
    try:
        return path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return ""


def _mailbox_mtime(path: Path) -> float:
    """Return mtime, or 0 when the file is missing."""
    try:
        return path.stat().st_mtime
    except OSError:
        return 0.0


def _lead_log_line_present(text: str, iteration: int) -> bool:
    """True when LOG.md has this iteration's Lead Format-A line."""
    prefix = f"- iter {iteration} | lead |"
    return any(line.startswith(prefix) for line in text.splitlines())


def _verdict_line_ready(text: str) -> bool:
    """True when the first non-empty VERDICT.md line matches grammar."""
    for raw in text.splitlines():
        line = raw.strip()
        if not line:
            continue
        return bool(_ROLE_VERDICT_RE.match(line))
    return False


def _verdict_mentions_iteration(text: str, iteration: int) -> bool:
    """True when this attempt's iteration is named in the verdict body."""
    needle = f"iteration {iteration}"
    return needle.lower() in text.lower()


def _verdict_field_values(text: str, key: str) -> list[str]:
    """Values for exact ``key:`` lines (not a prefix of a longer key)."""
    want_key = key.strip().lower()
    found: list[str] = []
    if not want_key:
        return found
    for raw in text.splitlines():
        line = raw.strip()
        if ":" not in line:
            continue
        name, rest = line.split(":", 1)
        if name.strip().lower() != want_key:
            continue
        got = rest.strip()
        if got:
            found.append(got)
    return found


def _verdict_records_attempt(text: str, attempt: str) -> bool:
    """True when VERDICT.md names this unique evaluator attempt."""
    want = attempt.strip().lower()
    if not want:
        return False
    return any(
        got.lower() == want for got in _verdict_field_values(text, "attempt")
    )


def _verdict_records_sha(text: str, sha: str) -> bool:
    """True when ``evaluated:`` records the expected pinned revision."""
    want = sha.strip().lower()
    if not want:
        return False
    for got in _verdict_field_values(text, "evaluated"):
        value = got.strip().lower()
        if value == want or want.startswith(value) or value.startswith(want):
            return True
    return False


def _role_artifact_ready(
    mailbox: Path,
    role: str,
    iteration: int,
    before_text: str,
    before_mtime: float,
    context: dict[str, Any] | None = None,
) -> bool:
    """True when this role wrote a fresh mailbox artifact for this attempt.

    Open-loop slice-eval APPENDS a ``## slice <id> @<sha> — …`` section
    and never a ``VERDICT:`` first line. That kind still needs VERDICT.md
    *content* to change; a stale file that merely exists (or is touched)
    is not this attempt. ``before_mtime`` is kept for callers but is not
    a freshness signal — mtime-only bumps must not accept stale text.
    """
    del before_mtime
    if role == "lead":
        path = mailbox / "LOG.md"
        text = _mailbox_text(path)
        if not _lead_log_line_present(text, iteration):
            return False
        return text != before_text
    if role == "evaluator":
        path = mailbox / "VERDICT.md"
        text = _mailbox_text(path)
        if text == before_text:
            return False
        slice_eval = bool(
            context and context.get("kind") == "slice-eval"
        )
        if slice_eval:
            return True
        if not _verdict_line_ready(text):
            return False
        if not _verdict_mentions_iteration(text, iteration):
            return False
        pinned = None
        attempt = None
        if context:
            pinned = context.get("pinned_sha") or context.get("expected_sha")
            attempt = context.get("evaluator_attempt")
        if attempt and not _verdict_records_attempt(text, str(attempt)):
            return False
        if pinned:
            return _verdict_records_sha(text, str(pinned))
        return True
    return True


def _session_client(base_url: str | None = None) -> Any:
    """Build a client using the documented loopback default."""
    return broker_http.BrokerClient(
        base_url or broker_http.DEFAULT_BASE_URL,
    )


def _print_json(payload: Any) -> None:
    """Keep all session subcommands machine-readable."""
    print(json.dumps(payload, indent=2, sort_keys=True))


def command_session_create(args: argparse.Namespace) -> int:
    """Create one broker session and print the server response."""
    client = _session_client(args.base_url)
    try:
        result = client.create_session(
            args.agent_id,
            args.model,
            args.message,
            getattr(args, "title", None),
            runner_id=getattr(args, "runner_id", None),
            host_id=getattr(args, "host_id", None),
            workspace=getattr(args, "workspace", None),
        )
    except broker_http.BrokerHttpError as exc:
        raise TrioctlError(str(exc)) from exc
    _print_json(result)
    return 0


def _session_status(snapshot: Any) -> str:
    """Read a normalized status from a broker session snapshot."""
    if not isinstance(snapshot, dict):
        return ""
    status = snapshot.get("status")
    return status.lower() if isinstance(status, str) else ""


def command_session_wait(args: argparse.Namespace) -> int:
    """Poll a broker session until the requested turn has finished."""
    client = _session_client(getattr(args, "base_url", None))
    try:
        snapshot = _wait_for_session(
            client,
            args.session_id,
            timeout=args.timeout,
            interval=args.interval,
        )
    except broker_http.BrokerHttpError as exc:
        raise TrioctlError(str(exc)) from exc
    _print_json(snapshot)
    return 1 if _session_status(snapshot) in SESSION_FAILURE_STATUSES else 0


def command_session_read(args: argparse.Namespace) -> int:
    """Read one session's committed items and print the response."""
    if args.limit < 0:
        raise TrioctlError("--limit must be non-negative")
    if args.order not in {"asc", "desc"}:
        raise TrioctlError("--order must be asc or desc")
    client = _session_client(getattr(args, "base_url", None))
    try:
        result = client.get_items(
            args.session_id,
            limit=args.limit,
            order=args.order,
        )
    except broker_http.BrokerHttpError as exc:
        raise TrioctlError(str(exc)) from exc
    _print_json(result)
    return 0


# Headless `trioctl omnigent loop` iterations each create a titled broker
# session (see ``OmnigentRunner._title``) that otherwise lives forever in
# the Omnigent UI history. Mailbox files record the outcome but not the
# role's reasoning, so pruning archives the full transcript before it
# deletes the broker session.
#
# The broker rejects GET .../items?limit=<n> above 1000 with HTTP 422, so
# a transcript longer than that must be paged: SESSION_ARCHIVE_PAGE_LIMIT
# per request, advancing an `after` item-id cursor until a page comes back
# short. The items route has no `offset` -- only cursor pagination.
SESSION_ARCHIVE_PAGE_LIMIT = 1000

# GET /v1/sessions defaults to the newest 20 sessions and caps `limit` at
# 1000 (also cursor-paginated, no `offset`), so the prune must page through
# SESSION_LIST_PAGE_LIMIT-sized windows to see every session it might need
# to match, not just the newest handful.
SESSION_LIST_PAGE_LIMIT = 1000

# A `trioctl omnigent loop` process exports this before running the loop,
# pointing at `<mailbox>/.sessions/run-<pid>.ids` -- a run-scoped, one-id-
# per-line record of every broker session this run created. `OmnigentRunner`
# appends to it directly (belt-and-suspenders alongside its in-memory
# `created_session_ids`); a headless `trioctl omnigent run <role>` worker
# spawned in a separate OS process during the run cannot share that memory
# and would append through the same env var if its dispatch path ever opens
# a broker session of its own. Reading it back after the loop exits, unioned
# with the in-memory ids, is what lets the default post-loop cleanup delete
# exactly this run's sessions and nothing from an earlier run.
SESSION_IDS_ENV_VAR = "TRIO_MAILBOX_SESSION_IDS"


def _append_session_id_to_file(path: Path, session_id: str) -> None:
    """Append one session id to a run's ids file, creating its directory."""
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as handle:
        handle.write(f"{session_id}\n")


def _record_created_session_id(session_id: str) -> None:
    """Append `session_id` to this run's ids file, if one is tracked.

    A no-op when `SESSION_IDS_ENV_VAR` is unset -- e.g. a bare `sessions
    create`/`run` invocation made outside a `loop` run.
    """
    path_value = os.environ.get(SESSION_IDS_ENV_VAR)
    if not path_value:
        return
    _append_session_id_to_file(Path(path_value), session_id)


def _read_session_ids_file(path: Path) -> list[str]:
    """Read one run's recorded session ids, ignoring a missing file."""
    try:
        text = path.read_text(encoding="utf-8")
    except OSError:
        return []
    return [line.strip() for line in text.splitlines() if line.strip()]


def _sanitise_archive_slug(value: str) -> str:
    """Collapse a title or timestamp into a filesystem-safe slug."""
    slug = re.sub(r"[^A-Za-z0-9]+", "-", value).strip("-")
    return slug or "session"


def _session_archive_filename(row: dict[str, Any]) -> str:
    """Name an archive file from the session's listing row.

    Format: ``<created_at>-<sanitised title>-<id8>.jsonl``.
    """
    session_id = str(row.get("id") or row.get("session_id") or "unknown")
    created_at = row.get("created_at") or row.get("createdAt") or "unknown"
    title = row.get("title") or "untitled"
    return (
        f"{_sanitise_archive_slug(str(created_at))}-"
        f"{_sanitise_archive_slug(str(title))}-{session_id[:8]}.jsonl"
    )


def _item_cursor_id(item: Any) -> str | None:
    """Read an item row's id for cursor paging, or ``None`` if unusable."""
    if isinstance(item, dict):
        value = item.get("id")
        if isinstance(value, str) and value:
            return value
    return None


def _fetch_session_items_paged(
    client: Any, session_id: str
) -> tuple[list[Any], Any]:
    """Page a session's full item history at SESSION_ARCHIVE_PAGE_LIMIT per
    request (the broker rejects a larger ``limit`` with HTTP 422),
    advancing an ``after`` item-id cursor to the previous page's last item
    until a page returns fewer items than the page limit (or none). The
    items route only supports cursor pagination -- there is no ``offset``.

    Returns ``(items, error)``: whatever items were read successfully,
    plus the ``BrokerHttpError`` that stopped the read early, or ``None``
    on a clean full read. A mid-transcript failure still yields whatever
    was read before it, instead of losing everything. A cursor that fails
    to advance between two pages (an unusable or repeated last-item id)
    also stops the read with an error, rather than looping forever on the
    same page.
    """
    items: list[Any] = []
    after: str | None = None
    while True:
        try:
            payload = client.get_items(
                session_id,
                limit=SESSION_ARCHIVE_PAGE_LIMIT,
                order="asc",
                after=after,
            )
        except broker_http.BrokerHttpError as exc:
            return items, exc
        page = _session_items(payload)
        if not page:
            return items, None
        items.extend(page)
        if len(page) < SESSION_ARCHIVE_PAGE_LIMIT:
            return items, None
        next_after = _item_cursor_id(page[-1])
        if not next_after or next_after == after:
            return items, broker_http.BrokerHttpError(
                f"GET .../{session_id}/items cursor did not advance past "
                f"{after!r}; aborting to avoid an infinite loop"
            )
        after = next_after


def _fetch_all_broker_sessions(
    client: Any, *, kind: str | None = None
) -> list[dict[str, Any]]:
    """Page ``client.list_sessions()`` at SESSION_LIST_PAGE_LIMIT per
    request until a page returns fewer rows than the limit (or none), so
    the prune can see every session on the broker instead of just the
    server's default newest-20 window. Advances an ``after`` session-id
    cursor to the previous page's last row; a cursor that fails to
    advance between two pages raises instead of looping forever.

    ``kind`` is forwarded to ``list_sessions`` as-is; omitted (``None``)
    it leaves the server on its own default, which excludes the
    ``sub_agent``-kind sessions the Omnigent UI creates via
    ``sys_session_create``.
    """
    list_sessions = getattr(client, "list_sessions", None)
    if list_sessions is None:
        raise TrioctlError("broker client has no session-list method")
    rows: list[dict[str, Any]] = []
    after: str | None = None
    while True:
        list_kwargs: dict[str, Any] = {"limit": SESSION_LIST_PAGE_LIMIT, "after": after}
        if kind is not None:
            list_kwargs["kind"] = kind
        try:
            payload = list_sessions(**list_kwargs)
        except broker_http.BrokerHttpError as exc:
            raise TrioctlError(str(exc)) from exc
        page = [row for row in _session_items(payload) if isinstance(row, dict)]
        if not page:
            return rows
        rows.extend(page)
        if len(page) < SESSION_LIST_PAGE_LIMIT:
            return rows
        last_row_id = page[-1].get("id") or page[-1].get("session_id")
        if not isinstance(last_row_id, str) or not last_row_id or last_row_id == after:
            raise TrioctlError(
                "GET /v1/sessions cursor did not advance past "
                f"{after!r}; aborting to avoid an infinite loop"
            )
        after = last_row_id


def _session_title_matches_mailbox(title: str, mailbox: Path) -> bool:
    """True iff `title` is a trioctl loop session title scoped to `mailbox`.

    Loop session titles use the locked scheme
    ``trioctl <mailbox.name> <role>:iteration <N>`` (plus an optional
    open-loop suffix like `` lead-pass`` / `` integration-eval`` /
    `` slice-eval:<id>``), so a title matches `mailbox` iff it starts with
    the ``trioctl <mailbox.name> `` prefix. Registration-anchor titles --
    e.g. ``trio-omnigent-lead``, ``trio-omnigent-evaluator``,
    ``lead:omnigent/trio-omnigent-roles/lead``, config-path idle sessions,
    and untitled/empty rows -- never carry that prefix, so prune never
    deletes them; sessions for another mailbox carry their own
    ``trioctl <other-mailbox> `` prefix and are likewise left alone.
    """
    return title.startswith(f"trioctl {mailbox.name} ")


def _prune_broker_sessions(
    client: Any,
    mailbox: Path,
    *,
    all_scope: bool = False,
    dry_run: bool = False,
    keep_failed: bool = False,
    session_ids: Any = None,
    include_sub_agents: bool = False,
    keep_unarchived: bool = False,
) -> dict[str, int]:
    """Archive-then-delete broker sessions, id-scoped or title-scoped.

    Two mutually exclusive selection modes:

    - ``session_ids`` given (id-scoped): only rows whose id is in that
      iterable are touched -- the mode the default post-loop cleanup uses,
      so a session from an earlier run (even one matching this mailbox's
      title prefix) is never touched.
    - ``session_ids`` omitted (title-scoped, the manual/bulk form): only
      sessions whose title starts with ``trioctl <mailbox.name> `` (or,
      with ``all_scope``, any ``trioctl `` title) are touched -- other
      projects share the same broker.

    Title-scoped prune still skips ``running`` so a bulk sweep cannot
    kill a live session. Id-scoped post-loop prune does **not**: the
    loop has already finished, and cursor-native often stays ``running``
    after wait returns (0.14 smoke left tmux panes until DELETE).
    ``keep_failed``
    additionally skips ``failed``/``error`` sessions, and every archived
    transcript is written under ``<mailbox>/.sessions/`` *before* its
    broker session is deleted.

    ``include_sub_agents`` widens the *listing* only: it passes
    ``kind="any"`` to the broker so ``sub_agent``-kind sessions -- e.g.
    ones the Omnigent UI's trio-omnigent skill creates via
    ``sys_session_create``, invisible under the server's ``kind=default``
    listing -- are among the rows considered. Title matching above is
    unchanged either way; a session is still only touched if its title
    actually matches.

    ``keep_unarchived`` only affects sessions whose item read fails even
    after one retry: by default such a session is still deleted with a
    partial archive and a stderr warning (delete is the only path that
    kills the broker's tmux terminal; keeping it leaks 200-600 MB of
    RAM per role). With ``keep_unarchived`` the old keep-and-skip
    behavior is restored for callers that would rather leak than lose
    an incomplete transcript.
    """
    rows = _fetch_all_broker_sessions(
        client, kind="any" if include_sub_agents else None
    )
    if session_ids is not None:
        wanted_ids = {sid for sid in session_ids if isinstance(sid, str) and sid}

        def _matches(row: dict[str, Any]) -> bool:
            row_id = row.get("id") or row.get("session_id")
            return isinstance(row_id, str) and row_id in wanted_ids

    else:
        all_prefix = "trioctl "

        def _matches(row: dict[str, Any]) -> bool:
            # Loop session titles use the locked scheme
            # ``trioctl <mailbox.name> <role>:iteration <N>`` (plus an
            # optional open-loop suffix), so a mailbox-scoped prune matches
            # iff the title starts with ``trioctl <mailbox.name> ``. Skill /
            # worker titles use ``<role>:iteration <N>`` right after that
            # prefix. Registration-anchor titles -- e.g.
            # ``trio-omnigent-lead``, ``trio-omnigent-evaluator``,
            # ``lead:omnigent/trio-omnigent-roles/lead``, config-path idle
            # sessions, and untitled/empty rows -- never carry that prefix,
            # so prune never deletes them. With ``all_scope`` any
            # ``trioctl `` title matches regardless of mailbox.
            title = row.get("title")
            if not isinstance(title, str):
                return False
            if all_scope:
                return title.startswith(all_prefix)
            return _session_title_matches_mailbox(title, mailbox)

    counts = {
        "archived": 0,
        "deleted": 0,
        "skipped_running": 0,
        "skipped_failed": 0,
        "failed": 0,
    }
    sessions_dir = mailbox / ".sessions"
    for row in rows:
        if not _matches(row):
            continue
        title = row.get("title") or "untitled"
        session_id = row.get("id") or row.get("session_id")
        if not isinstance(session_id, str) or not session_id:
            continue
        status = _session_status(row)
        # Bulk title prune: never interrupt a live session.
        # Post-loop id list: delete anyway so the tmux pane dies.
        if status == "running" and session_ids is None:
            counts["skipped_running"] += 1
            print(f"trioctl: skip (running): {session_id} {title}")
            continue
        if keep_failed and status in SESSION_FAILURE_STATUSES:
            counts["skipped_failed"] += 1
            print(f"trioctl: skip (failed, --keep-failed): {session_id} {title}")
            continue
        if dry_run:
            print(f"trioctl: dry-run would archive and delete: {session_id} {title}")
            continue
        items, read_error = _fetch_session_items_paged(client, session_id)
        if read_error is not None:
            # Retry the item read once: a transient broker hiccup should
            # not strand a terminal. If the retry still fails we keep
            # the best items read so far and apply the partial-archive
            # policy below.
            items, read_error = _fetch_session_items_paged(
                client, session_id
            )
        sessions_dir.mkdir(parents=True, exist_ok=True)
        archive_path = sessions_dir / _session_archive_filename(row)
        with archive_path.open("w", encoding="utf-8") as handle:
            handle.write(json.dumps(row, sort_keys=True) + "\n")
            for item in items:
                handle.write(json.dumps(item, sort_keys=True) + "\n")
        if read_error is not None:
            # The transcript could not be fully read even after one
            # retry. Delete is the only path that kills the broker's
            # tmux terminal; keeping an unarchived session leaks RAM
            # (200-600 MB per role terminal). Default: warn on stderr
            # and delete anyway with a partial archive (counts as both
            # `failed` and `deleted`). --keep-unarchived opts back into
            # the old keep-and-skip behavior for callers that would
            # rather leak than lose an incomplete transcript.
            counts["failed"] += 1
            if keep_unarchived:
                print(
                    f"trioctl: failed to fully read items for "
                    f"{session_id} {title}: {read_error} "
                    f"({len(items)} item(s) saved to {archive_path}; "
                    f"session kept, not deleted)",
                    file=sys.stderr,
                )
                continue
            print(
                f"trioctl: failed to fully read items for {session_id} "
                f"{title}: {read_error} ({len(items)} item(s) saved to "
                f"{archive_path}; deleting anyway -- transcript was "
                f"not fully archived)",
                file=sys.stderr,
            )
        else:
            counts["archived"] += 1
        delete_session = getattr(client, "delete_session", None)
        if delete_session is None:
            raise TrioctlError("broker client has no session-delete method")
        try:
            delete_session(session_id)
        except broker_http.BrokerHttpError as exc:
            raise TrioctlError(str(exc)) from exc
        counts["deleted"] += 1
        if read_error is None:
            print(
                f"trioctl: archived and deleted {session_id} -> "
                f"{archive_path}"
            )
        else:
            print(
                f"trioctl: deleted with partial archive {session_id} "
                f"-> {archive_path}"
            )
    return counts


def command_sessions_prune(args: argparse.Namespace) -> int:
    """Manual/bulk form: archive then delete broker sessions by title prefix.

    Matches every session whose title starts with ``trioctl <mailbox.name>
    `` (or, with ``--all``, any ``trioctl `` title) regardless of which run
    created it -- unlike `loop`'s default post-loop cleanup, which is
    scoped to only the sessions that run itself created. Use this for a
    one-off sweep, or to clean up sessions left behind by a run that never
    reached its own cleanup (e.g. `--keep-sessions`, or a crash).

    ``--include-sub-agents`` additionally lists ``kind=sub_agent`` broker
    sessions -- e.g. ones the Omnigent UI's trio-omnigent skill creates via
    ``sys_session_create`` -- which the default listing hides. Matching
    still requires the same ``trioctl <mailbox.name> `` title prefix, so
    the flag only helps when a sub-agent session actually carries that
    title.
    """
    mailbox = Path(args.mailbox).expanduser().resolve()
    client = _session_client(getattr(args, "base_url", None))
    counts = _prune_broker_sessions(
        client,
        mailbox,
        all_scope=args.all,
        dry_run=args.dry_run,
        keep_failed=args.keep_failed,
        include_sub_agents=args.include_sub_agents,
        keep_unarchived=args.keep_unarchived,
    )
    print(
        f"trioctl: archived {counts['archived']}, deleted {counts['deleted']}, "
        f"skipped running {counts['skipped_running']}, "
        f"failed {counts['failed']}"
    )
    return 0


def _run_post_loop_session_prune(
    mailbox: Path,
    base_url: str | None,
    session_ids: Any,
    *,
    keep_unarchived: bool = False,
) -> None:
    """Best-effort cleanup after a headless `loop` run exits (default-on).

    Runs after the loop returns regardless of its exit code, unless the
    run passed `--keep-sessions`. Id-scoped to exactly `session_ids` --
    the union of the run's `OmnigentRunner.created_session_ids` and its
    `.sessions/run-<pid>.ids` file -- never by title prefix, so a session
    left behind by an earlier run (even one for this same mailbox) is
    never touched. Always a real archive-then-delete pass (never
    `--dry-run`, no `--keep-failed`). A prune failure is reported but
    never overrides the loop's own exit code.

    ``keep_unarchived`` defaults off so the loop always deletes a
    session whose transcript could not be fully archived even after one
    retry -- terminals only die on broker DELETE, never on process
    exit, so keeping them leaks 200-600 MB of RAM per role. The matching
    `loop --keep-unarchived` flag opts back into keep-and-skip.
    """
    ids = sorted({sid for sid in session_ids if isinstance(sid, str) and sid})
    if not ids:
        return
    try:
        client = _session_client(base_url)
        counts = _prune_broker_sessions(
            client, mailbox, session_ids=ids,
            keep_unarchived=keep_unarchived,
        )
    except TrioctlError as exc:
        print(f"trioctl: session prune failed: {exc}", file=sys.stderr)
        return
    print(
        "trioctl: session prune archived "
        f"{counts['archived']}, deleted {counts['deleted']}, "
        f"skipped running {counts['skipped_running']}, "
        f"failed {counts['failed']}"
    )


# Kind-specific Open-loop procedures appended to OPEN-LOOP CONTEXT blocks.
# Sourced from prompts/canonical/lead.md ("Open-loop mode", steps 1-5) and
# prompts/canonical/evaluator.md ("Open-loop mode", steps 1-7) so Omnigent
# roles — whose config.yaml files are hand-maintained and never receive
# these canonical sections — get the same procedural rules the native Trio
# loop gets. Without this, an Omnigent Lead can commit `slice(<id>):`
# work every pass and never append the `retired:` entry to QUEUE.md that
# lets the Evaluator ever grade it (observed in a real open-loop run).
_OPEN_LOOP_LEAD_PASS_PROCEDURE = (
    "Open-loop mode is active (loop/QUEUE.md exists) — run this procedure\n"
    "instead of waiting for a verdict:\n"
    "1. Take `open` faults first, in order: mark the fault `taken`, fix\n"
    "   strictly within its `scope:`, commit `slice(<id>): fix f<N> ...`,\n"
    "   then mark it `done` (or `stale` if every path in its `scope:` was\n"
    "   already rewritten after `observed_at` and the reason no longer\n"
    "   applies).\n"
    "2. Otherwise take the next `planned` slice from PLAN.md's `slices:`\n"
    "   block. Give every slice you plan an `accepts:` list — that is what\n"
    "   the Evaluator grades it against. Dispatch disjoint-writes slices to\n"
    "   builders concurrently: slices whose `writes:` are pairwise disjoint\n"
    "   and whose `reads:` name nothing another slice in the wave writes\n"
    "   may be run as separate builders at the same time.\n"
    "3. On finishing a slice: commit it, set `status: complete` for it in\n"
    "   PLAN.md's `slices:` block, and append a `retired:` entry to\n"
    "   QUEUE.md (`slice`, the full sha it's retired at, `at`) — a pass\n"
    "   that commits without appending a `retired:` entry is incomplete.\n"
    "   A post-fix commit (step 1) does not edit that entry — it appends a\n"
    "   NEW `retired:` entry for the same slice id at the fix's sha.\n"
    "4. Never wait for a verdict before starting the next fault or slice —\n"
    "   the Evaluator grades retired slices independently, on its own\n"
    "   schedule.\n"
    "5. Backpressure: while 2 or more faults are `open` or `taken`, take no\n"
    "   new slice — drain faults first.\n"
    "Append one line to loop/LOG.md: `- iter N | lead | <summary>`.\n"
)

_OPEN_LOOP_SLICE_EVAL_PROCEDURE = (
    "Open-loop mode is active — grade only slice `{slice}` at sha `{sha}`,\n"
    "never the moving working tree:\n"
    "1. Run `python3 metrics/trio-shadow.py --mailbox <mailbox>\n"
    "   --require-commits --slice {slice}`; it must exit 0 before you grade.\n"
    "2. `git worktree add <tmp> {sha}`, then grade ONLY this slice's\n"
    "   `accepts:` (from PLAN.md) inside that worktree; run\n"
    "   `git worktree remove <tmp>` when done.\n"
    "3. Append to VERDICT.md a section headed exactly\n"
    "   `## slice {slice} @{sha} — SHIP` or\n"
    "   `## slice {slice} @{sha} — ITERATE`, with per-accepts evidence.\n"
    "   Do NOT rewrite or truncate VERDICT.md; open it in append mode\n"
    "   (`>>`) — existing sections must survive byte-for-byte.\n"
    "   That section body must never contain a line starting with\n"
    "   `VERDICT:` — that token is reserved for the integration verdict.\n"
    "4. SHIP → append the section, record only, append no fault. ITERATE →\n"
    "   also append one `faults:` entry to QUEUE.md: `id: f<N>`, `slice`,\n"
    "   `observed_at: {sha}`, `scope`, `reason`, `status: open`.\n"
    "5. Never edit `retired:` entries, and never set a fault's\n"
    "   `taken`/`done`/`stale` status — those transitions are the Lead's\n"
    "   job.\n"
)

_OPEN_LOOP_INTEGRATION_EVAL_PROCEDURE = (
    "Open-loop mode is active — every planned slice is retired and no\n"
    "fault is `open`/`taken`, so run one integration evaluation of HEAD\n"
    "against GOAL.md's acceptance criteria (the Method and Output sections\n"
    "above apply in full):\n"
    "1. Overwrite loop/VERDICT.md; the FIRST LINE must be exactly one of\n"
    "   `VERDICT: SHIP`, `VERDICT: ITERATE`, `VERDICT: NEEDS_HUMAN`, or\n"
    "   `VERDICT: BLOCKED`, followed by the standard verdict body.\n"
    "2. SHIP → follow the Retirement commit convention: commit the\n"
    "   verified product changes as `slice(<id>): ...`, append your\n"
    "   LOG.md line, then commit loop/ as `loop: iteration N — SHIP`,\n"
    "   recording each `commit: <full sha>` in VERDICT.md.\n"
    "3. ITERATE → append one `faults:` entry to QUEUE.md (`id: f<N>`,\n"
    "   `scope`, `reason`, `status: open`) and leave the tree uncommitted\n"
    "   for the Lead's next pass.\n"
)


def _omnigent_prompt_dirs(repo: Path) -> list[Path]:
    """Ordered directories to search for checked-in Omnigent role prompts.

    An installed `trioctl` (see install.sh's `--omnigent` mode) has no
    `omnigent/entrypoints/trio-omnigent/prompts` of its own next to the
    target project or next to the installed script itself, so the search
    falls through to `$TRIO_OMNIGENT_PROMPTS` when set, then the skill
    directories install.sh writes the same prompts into for Claude Code
    and Codex.
    """
    tail = Path("omnigent", "entrypoints", "trio-omnigent", "prompts")
    dirs = [repo / tail, Path(__file__).resolve().parent.parent / tail]
    env_dir = os.environ.get("TRIO_OMNIGENT_PROMPTS")
    if env_dir:
        dirs.append(Path(env_dir).expanduser())
    home = Path.home()
    dirs.append(home / ".claude" / "skills" / "trio-omnigent" / "prompts")
    dirs.append(home / ".agents" / "skills" / "trio-omnigent" / "prompts")
    return dirs


class OmnigentRunner:
    """Run Trio judgment roles through fresh broker sessions."""

    session_ids: dict[str, str]
    created_session_ids: list[str]

    def __init__(
        self,
        repo: Path | None = None,
        *,
        broker_client: Any | None = None,
        client: Any | None = None,
        config: dict[str, Any] | None = None,
        models: dict[str, list[dict[str, Any]]] | None = None,
        base_url: str | None = None,
        timeout: float = DEFAULT_LOOP_WAIT_TIMEOUT,
        interval: float = 1.0,
        runner_id: str | None = None,
        host_id: str | None = None,
        workspace: str | None = None,
    ) -> None:
        if broker_client is not None and client is not None:
            raise ValueError("provide only one broker client")
        self.repo = Path(repo or Path.cwd()).resolve()
        self._config = config
        self._models = models or {}
        self._broker_client = (
            broker_client if broker_client is not None else client
        )
        self._base_url = base_url or broker_http.DEFAULT_BASE_URL
        self._timeout = timeout
        self._interval = interval
        self._runner_id = runner_id
        # Dedicated host launch (default). runner_id remains an override
        # that binds an already-online runner instead of spawning one.
        self._host_id = host_id
        self._workspace = workspace or str(self.repo)
        self.session_ids: dict[str, str] = {}
        self.created_session_ids: list[str] = []

    def _load_config(self) -> dict[str, Any]:
        """Load the user profile only when the first role is dispatched."""
        if self._config is None:
            self._config = load_config(config_path())
        return self._config

    def _agent_id(self, role: str) -> str:
        """Resolve only the exact persisted Lead/Evaluator registry key."""
        path = omnigent_registry_path()
        try:
            entries = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as exc:
            raise TrioctlError(
                f"cannot read Omnigent role registry {path}: {exc}"
            ) from exc
        key = f"trio-omnigent-{role}"
        entry = entries.get(key) if isinstance(entries, dict) else None
        agent_id = entry.get("agent_id") if isinstance(entry, dict) else None
        if not isinstance(agent_id, str) or not agent_id.strip():
            raise TrioctlError(
                f"{path}: {key} is missing a non-empty agent_id"
            )
        return agent_id.strip()

    def _resolve_model(self, role: str) -> str:
        """Resolve a role through trioctl's strict, no-fallback resolver."""
        config = self._load_config()
        spec = config["roles"][role]
        provider = spec.get("provider")
        if provider in self._models:
            resolved = resolve_role(
                role,
                config,
                models=self._models[provider],
            )
        else:
            resolved = resolve_role(role, config)
        model = resolved.get("model")
        if not isinstance(model, str) or not model:
            raise TrioctlError(f"roles.{role}: resolver returned no model")
        return model

    def _prompt_path(self, role: str) -> Path:
        """Find the checked-in prompt, including from an installed trioctl.

        An installed ``trioctl`` (``~/.local/bin/trioctl``) has no source
        tree of its own, so the first two candidates below never resolve
        for it; install.sh instead writes the same prompts into the
        Claude Code and Codex skill directories, which the last two
        candidates fall back to.
        """
        filename = f"{role}.md"
        candidates = [directory / filename for directory in _omnigent_prompt_dirs(self.repo)]
        for path in candidates:
            if path.is_file():
                return path
        tried = ", ".join(str(path) for path in candidates)
        raise TrioctlError(f"missing Omnigent prompt: {filename} (tried: {tried})")

    @staticmethod
    def _open_loop_context_block(context: dict[str, Any]) -> str:
        """Build the OPEN-LOOP CONTEXT block prepended to open-loop prompts.

        Line 1 matches portable/driver.sh's build_prompt byte-for-byte:
        `kind=<kind>[ slice=<slice>][ sha=<sha>]`. Omnigent roles otherwise
        never see the canonical Open-loop procedure (their config.yaml is
        hand-maintained and only gets the one-paragraph description), so a
        kind-specific rendering of it is appended before the blank line
        that separates the block from the role's normal prompt.
        """
        kind = context.get("kind") or ""
        line = f"OPEN-LOOP CONTEXT: kind={kind}"
        slice_id = context.get("slice")
        if slice_id:
            line += f" slice={slice_id}"
        sha = context.get("sha")
        if sha:
            line += f" sha={sha}"
        if kind == "lead-pass":
            procedure = _OPEN_LOOP_LEAD_PASS_PROCEDURE
        elif kind == "slice-eval":
            procedure = _OPEN_LOOP_SLICE_EVAL_PROCEDURE.format(
                slice=slice_id or "<slice>", sha=sha or "<sha>"
            )
        elif kind == "integration-eval":
            procedure = _OPEN_LOOP_INTEGRATION_EVAL_PROCEDURE
        else:
            procedure = ""
        if not procedure:
            return line + "\n\n"
        return line + "\n" + procedure + "\n"

    def _prompt(
        self,
        role: str,
        iteration: int,
        mailbox: Path,
        context: dict[str, Any] | None = None,
    ) -> str:
        """Fill a role prompt without interpreting braces in its prose."""
        prompt_role = "lead" if role == "repair" else role
        template = self._prompt_path(prompt_role).read_text(encoding="utf-8")
        values = {
            "{mailbox}": str(mailbox.resolve()),
            "{iteration}": str(iteration),
            "{repo}": str(self.repo),
        }
        for placeholder, value in values.items():
            template = template.replace(placeholder, value)
        if role != "repair":
            result = template.rstrip() + "\n"
        else:
            verdict_path = mailbox / "VERDICT.md"
            try:
                verdict = verdict_path.read_text(
                    encoding="utf-8", errors="replace"
                ).strip()
            except OSError as exc:
                raise TrioctlError(
                    f"cannot read repair verdict {verdict_path}: {exc}"
                ) from exc
            scope_note = next(
                (line for line in verdict.splitlines() if line.strip()),
                "VERDICT.md has no scope line",
            )
            result = (
                template.rstrip()
                + "\n\n## Scoped repair\n"
                + f"Read `{verdict_path}` and fix only its listed scope.\n"
                + f"Scope note: {scope_note}\n"
                + f"Append `- iter {iteration} | repair | <one-line summary>` "
                "to LOG.md for this repair.\n"
            )
        if context and context.get("mode") == "open-loop":
            result = self._open_loop_context_block(context) + result
        elif context and (
            context.get("evaluator_attempt") or context.get("pinned_sha")
        ):
            # Default lockstep: pass the persisted pin and unique attempt
            # through the actual Omnigent prompt so artifact wait can
            # match this dispatch, not leftover same-iteration text.
            attempt = str(context.get("evaluator_attempt") or "")
            sha = str(
                context.get("pinned_sha") or context.get("expected_sha") or ""
            )
            result = (
                f"LOCKSTEP CONTEXT: attempt={attempt} sha={sha}\n\n"
                + result
            )
        return result

    def _client(self) -> Any:
        """Reuse an injected fake or build the real HTTP client once."""
        if self._broker_client is None:
            self._broker_client = _session_client(self._base_url)
        return self._broker_client

    @staticmethod
    def _create(
        client: Any,
        agent_id: str,
        model: str,
        prompt: str,
        title: str,
        runner_id: str | None = None,
        host_id: str | None = None,
        workspace: str | None = None,
    ) -> Any:
        """Call the checked-in client seam or a small test double.

        Extra kwargs (`runner_id`, `host_id`, `workspace`) are forwarded
        only when the target method declares them (or accepts **kwargs).
        The fakes in test_omnigent_loop.py take the legacy 4-argument
        shape and must keep working unchanged.
        """
        method = getattr(client, "create_session", None) or getattr(
            client, "create", None
        )
        if method is None:
            raise TrioctlError("broker client has no session-create method")
        extra: dict[str, Any] = {}
        if runner_id:
            extra["runner_id"] = runner_id
        if host_id:
            extra["host_id"] = host_id
        if workspace:
            extra["workspace"] = workspace
        if extra:
            try:
                params = inspect.signature(method).parameters
            except (TypeError, ValueError):
                params = {}
            accepts_kwargs = any(
                p.kind == inspect.Parameter.VAR_KEYWORD
                for p in params.values()
            )
            forwarded = {
                key: value
                for key, value in extra.items()
                if key in params or accepts_kwargs
            }
            if forwarded:
                return method(
                    agent_id, model, prompt, title, **forwarded
                )
        return method(agent_id, model, prompt, title)

    def _wait(
        self,
        client: Any,
        session_id: str,
        timeout: float | None = None,
    ) -> Any:
        """Wait through a fake seam or poll the real broker session."""
        wait_timeout = self._timeout if timeout is None else timeout
        method = getattr(client, "wait_session", None) or getattr(
            client, "wait", None
        )
        if method is not None:
            try:
                return method(
                    session_id,
                    timeout=wait_timeout,
                    interval=self._interval,
                )
            except TypeError:
                return method(session_id)

        # Live Cursor turns have think/tool gaps that look idle. Hold
        # idle after running (or after an early assistant ack) so those
        # gaps are not terminal. Tests use interval=0 and skip the dwell.
        # TRIO_OMNIGENT_IDLE_DWELL overrides the live default (30s).
        return _wait_for_session(
            client,
            session_id,
            timeout=wait_timeout,
            interval=self._interval,
            stable_idle=(
                0.0
                if self._interval == 0
                else broker_http._env_float(
                    "TRIO_OMNIGENT_IDLE_DWELL", 30.0
                )
            ),
        )

    @staticmethod
    def _read(client: Any, session_id: str) -> Any:
        """Read committed session items before returning to the loop driver."""
        method = (
            getattr(client, "get_items", None)
            or getattr(client, "read_session", None)
            or getattr(client, "read", None)
        )
        if method is None:
            raise TrioctlError("broker client has no session-read method")
        return method(session_id)

    @staticmethod
    def _session_id(created: Any) -> str | None:
        if isinstance(created, dict):
            value = created.get("id") or created.get("session_id")
            return value if isinstance(value, str) and value else None
        return created if isinstance(created, str) and created else None

    @staticmethod
    def _title(
        mailbox: Path,
        iteration: int,
        role: str,
        context: dict[str, Any] | None,
    ) -> str:
        """Base title, plus the open-loop kind (and slice, for slice-eval).

        Locked scheme: ``trioctl <mailbox.name> <role>:iteration <N>`` plus
        an optional open-loop suffix (`` lead-pass`` / `` integration-eval`` /
        `` slice-eval:<id>``). The ``trioctl <mailbox.name> `` prefix is what
        `sessions prune` matches (see ``_session_title_matches_mailbox``),
        and the ``:`` right after that prefix satisfies Omnigent's
        ``_parse_session_title`` -- a colon is required there, otherwise
        agent/title parse to None and ``sys_session_close`` rejects the
        session as ``session_not_a_sub_agent``.
        """
        # NOTE: the colon sits AFTER ``trioctl <mailbox.name> `` so the
        # prefix-scoped prune match (``title.startswith(...)``) and the
        # colon-aware ``_parse_session_title`` both keep working.
        title = f"trioctl {mailbox.name} {role}:iteration {iteration}"
        if context and context.get("mode") == "open-loop":
            kind = context.get("kind")
            slice_id = context.get("slice")
            if kind == "slice-eval" and slice_id:
                title += f" slice-eval:{slice_id}"
            elif kind:
                title += f" {kind}"
        return title

    def _create_wait_read(
        self,
        client: Any,
        agent_id: str,
        model: str,
        prompt: str,
        title: str,
        role: str,
    ) -> tuple[Any, Any]:
        """One create+wait+read cycle. Returns (session snapshot, items)."""
        created = self._create(
            client,
            agent_id,
            model,
            prompt,
            title,
            runner_id=self._runner_id,
            host_id=self._host_id,
            workspace=self._workspace,
        )
        session_id = self._session_id(created)
        if session_id is None:
            raise TrioctlError("session create response has no session id")
        self.session_ids[role] = session_id
        self.created_session_ids.append(session_id)
        _record_created_session_id(session_id)
        snapshot = self._wait(client, session_id)
        items = self._read(client, session_id)
        return snapshot, items

    @staticmethod
    def _is_restart_blip(snapshot: Any, items: Any) -> bool:
        """A post-restart runner blip: unbound, and no items at all.

        `_wait_for_session` already refuses to treat a bound+running+idle,
        zero-item snapshot as terminal, but a session can still finish its
        wait (e.g. an immediate idle pong) and only *afterward* show an
        unbound runner with nothing read back -- the same restart blip
        observed in the real run, just caught one step later.
        """
        return not _runner_is_bound(snapshot) and not _session_items(items)

    def run(
        self,
        role: str,
        iteration: int,
        mailbox: Path,
        context: dict[str, Any] | None = None,
    ) -> int:
        """Create, await, and read one Lead, Evaluator, or repair session.

        A restart blip (unbound runner, zero items back) is retried once
        on the **same** session: re-post the prompt after a short delay.
        Creating a second session for the same role/iteration is what
        left duplicate Leads and `phase: error` in the 0.14 trial.
        A second miss in a row is a real failure and returns 1.
        """
        if role not in {"lead", "evaluator", "repair"}:
            raise TrioctlError(f"unknown Omnigent loop role: {role}")
        mailbox = Path(mailbox).resolve()
        registered_role = "lead" if role == "repair" else role
        agent_id = self._agent_id(registered_role)
        model = self._resolve_model(registered_role)
        prompt = self._prompt(role, iteration, mailbox, context)
        title = self._title(mailbox, iteration, role, context)
        client = self._client()
        started = time.monotonic()
        if role == "lead":
            before_text = _mailbox_text(mailbox / "LOG.md")
            before_mtime = _mailbox_mtime(mailbox / "LOG.md")
        else:
            before_text = _mailbox_text(mailbox / "VERDICT.md")
            before_mtime = _mailbox_mtime(mailbox / "VERDICT.md")
        try:
            snapshot, items = self._create_wait_read(
                client, agent_id, model, prompt, title, role
            )
            if _session_status(snapshot) not in SESSION_FAILURE_STATUSES and (
                self._is_restart_blip(snapshot, items)
            ):
                time.sleep(10.0)
                snapshot, items = self._repost_wait_read(
                    client, role, prompt
                )
            if _session_status(snapshot) in SESSION_FAILURE_STATUSES:
                return 1
            if self._is_restart_blip(snapshot, items):
                return 1
            # Same session: wait is not role completion. Keep polling
            # until LOG.md / VERDICT.md shows this pass's artifact.
            snapshot = self._wait_for_role_artifact(
                client,
                role,
                iteration,
                mailbox,
                started,
                before_text,
                before_mtime,
                context,
            )
        except broker_http.BrokerHttpError as exc:
            raise TrioctlError(str(exc)) from exc
        if _session_status(snapshot) in SESSION_FAILURE_STATUSES:
            return 1
        return 0

    def _wait_for_role_artifact(
        self,
        client: Any,
        role: str,
        iteration: int,
        mailbox: Path,
        started: float,
        before_text: str,
        before_mtime: float,
        context: dict[str, Any] | None = None,
    ) -> Any:
        """Re-enter wait on this session until the role artifact exists."""
        session_id = self.session_ids.get(role)
        if session_id is None:
            raise TrioctlError(f"role {role} has no session id")
        snapshot: Any = {"id": session_id, "status": "idle"}
        while not _role_artifact_ready(
            mailbox, role, iteration, before_text, before_mtime, context
        ):
            remaining = self._timeout - (time.monotonic() - started)
            if remaining <= 0:
                # Last-chance accept: a valid fresh artifact that landed
                # as the timer expired is this attempt. Stale/partial
                # files stay uncertain (timeout), never SHIP.
                if _role_artifact_ready(
                    mailbox,
                    role,
                    iteration,
                    before_text,
                    before_mtime,
                    context,
                ):
                    break
                raise TrioctlError(
                    f"session {session_id} timed out after "
                    f"{self._timeout:g} seconds"
                )
            snapshot = self._wait(client, session_id, timeout=remaining)
            if _session_status(snapshot) in SESSION_FAILURE_STATUSES:
                return snapshot
            self._read(client, session_id)
            # Bound GET /items + GET /session when idle dwell is 0.
            # interval=0 stays sleep-free so fake-broker tests stay fast.
            if self._interval > 0:
                remaining = self._timeout - (
                    time.monotonic() - started
                )
                if remaining > 0:
                    time.sleep(min(self._interval, remaining))
        return snapshot

    def _repost_wait_read(
        self, client: Any, role: str, prompt: str
    ) -> tuple[Any, Any]:
        """Re-post the first prompt on the existing session, then wait."""
        session_id = self.session_ids.get(role)
        if not session_id:
            raise TrioctlError(
                f"restart-blip retry has no session id for role {role}"
            )
        send = getattr(client, "send_message", None)
        if send is not None:
            send(session_id, prompt)
        ensure = getattr(client, "ensure_first_prompt", None)
        if ensure is not None:
            ensure(session_id, prompt)
        snapshot = self._wait(client, session_id)
        items = self._read(client, session_id)
        return snapshot, items


def _load_trio_loop(repo: Path) -> Any:
    """Load loop-core by path so the ``omnigent`` directory is not a package."""
    path = repo / "metrics" / "trio_loop.py"
    if not path.is_file():
        raise TrioctlError(f"loop core is missing: {path}")
    loader = importlib.machinery.SourceFileLoader("trio_loop", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None or spec.loader is None:
        raise TrioctlError(f"cannot load loop core from {path}")
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    if not callable(getattr(module, "run_loop", None)):
        raise TrioctlError(f"{path} does not expose run_loop")
    return module


def command_loop(args: argparse.Namespace) -> int:
    """Run loop-core with the Omnigent role runner.

    Session cleanup is default-on and scoped to this run: unless
    `--keep-sessions` is passed, the sessions this run itself created are
    archived then deleted after the loop returns, regardless of its exit
    code -- never a session from an earlier run. See
    `_run_post_loop_session_prune`.
    """
    repo = Path.cwd().resolve()
    mailbox = Path(args.mailbox).expanduser()
    if not mailbox.is_absolute():
        mailbox = repo / mailbox
    mailbox = mailbox.resolve()
    mailbox.mkdir(parents=True, exist_ok=True)
    loop_core = _load_trio_loop(repo)
    runner = OmnigentRunner(
        repo=repo,
        base_url=getattr(args, "base_url", None),
        timeout=getattr(args, "wait_timeout", DEFAULT_LOOP_WAIT_TIMEOUT),
        runner_id=getattr(args, "runner_id", None),
        host_id=getattr(args, "host_id", None),
        workspace=str(repo),
    )
    keep_sessions = getattr(args, "keep_sessions", False)
    ids_file = mailbox / ".sessions" / f"run-{os.getpid()}.ids"
    previous_ids_env = os.environ.get(SESSION_IDS_ENV_VAR)
    if keep_sessions:
        os.environ.pop(SESSION_IDS_ENV_VAR, None)
    else:
        os.environ[SESSION_IDS_ENV_VAR] = str(ids_file)

    # Install SIGINT/SIGTERM handlers that raise KeyboardInterrupt so the
    # `finally` below always runs. Without this, a signal during run_loop
    # would unwind straight through `finally` (env restore only) and skip
    # prune, leaking this run's role tmux sessions (200-600 MB each) --
    # terminals only die on broker DELETE, never on process exit.
    previous_sigint = signal.signal(signal.SIGINT, _loop_signal_handler)
    previous_sigterm = signal.signal(signal.SIGTERM, _loop_signal_handler)
    try:
        exit_code = loop_core.run_loop(
            mailbox,
            args.max_iterations,
            runner,
            repo=repo,
        )
        return exit_code
    except KeyboardInterrupt:
        # SIGINT/SIGTERM arrived: prune first (in finally), then exit 130.
        return 130
    finally:
        # Restore the prior handlers and env, then prune this run's created
        # sessions. Prune lives in `finally` (not after the try) so a
        # signal or any exception still cleans up -- role tmux sessions
        # only die on broker DELETE, never on process exit.
        signal.signal(signal.SIGINT, previous_sigint)
        signal.signal(signal.SIGTERM, previous_sigterm)
        if previous_ids_env is None:
            os.environ.pop(SESSION_IDS_ENV_VAR, None)
        else:
            os.environ[SESSION_IDS_ENV_VAR] = previous_ids_env
        if not keep_sessions:
            created = list(getattr(runner, "created_session_ids", []) or [])
            created.extend(_read_session_ids_file(ids_file))
            _run_post_loop_session_prune(
                mailbox, getattr(args, "base_url", None), created,
                keep_unarchived=getattr(args, "keep_unarchived", False),
            )
            try:
                ids_file.unlink()
            except OSError:
                pass


def _loop_signal_handler(signum: int, frame: object) -> None:
    """SIGINT/SIGTERM handler installed by `command_loop`.

    Raises KeyboardInterrupt so the loop's `finally` runs prune. Kept at
    module scope so tests can invoke it directly; SIGINT and SIGTERM share
    this one handler.
    """
    raise KeyboardInterrupt


def omnigent_registry_path() -> Path:
    """Return the existing user-owned role registry path."""
    return (
        Path(os.environ.get("OMNIGENT_HOME", str(Path.home() / ".omnigent")))
        / "agents"
        / "trio-omnigent-roles"
        / "registry.json"
    )


def _scout_agent_id(entries: object) -> str | None:
    """Read a scout registration from either supported registry key."""
    if not isinstance(entries, dict):
        return None
    for key in ("trio-omnigent-scout", "scout"):
        entry = entries.get(key)
        if isinstance(entry, str) and entry.strip():
            return entry.strip()
        if isinstance(entry, dict):
            for field in ("agent_id", "agentId", "id"):
                value = entry.get(field)
                if isinstance(value, str) and value.strip():
                    return value.strip()
    return None


def check_live_session(
    config: dict[str, Any] | None,
    catalogs: dict[str, list[dict[str, Any]]],
    base_url: str,
) -> dict[str, Any]:
    """Probe session creation, snapshot, and item retrieval on demand."""
    path = omnigent_registry_path()
    if config is None:
        return {
            "check": "omnigent:session-api",
            "ok": False,
            "detail": "cannot resolve scout model because config is invalid",
        }
    try:
        entries = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        return {
            "check": "omnigent:session-api",
            "ok": False,
            "detail": f"scout agent registry unavailable at {path}: {exc}",
        }
    agent_id = os.environ.get("OMNIGENT_LIVE_SESSION_AGENT_ID", "").strip()
    agent_id = agent_id or _scout_agent_id(entries)
    try:
        provider = config["roles"]["scout"].get("provider")
        resolved = resolve_role(
            "scout",
            config,
            models=catalogs.get(provider, []),
        )
        client = _session_client(base_url)
        if not agent_id:
            listed = client.list_agents()
            rows = listed.get("data") if isinstance(listed, dict) else listed
            if not isinstance(rows, list):
                rows = []
            for row in rows:
                if not isinstance(row, dict):
                    continue
                name = str(row.get("name") or "")
                row_id = row.get("id") or row.get("agent_id")
                if name == "cursor-native-ui" and isinstance(row_id, str):
                    agent_id = row_id
                    break
        if not agent_id:
            return {
                "check": "omnigent:session-api",
                "ok": False,
                "detail": (
                    "no scout agent_id; set OMNIGENT_LIVE_SESSION_AGENT_ID "
                    "or expose cursor-native-ui on GET /v1/agents"
                ),
            }
        created = client.create_session(
            agent_id,
            resolved["model"],
            "Reply with the single word pong and stop.",
            "trioctl doctor",
        )
        if not isinstance(created, dict):
            raise TrioctlError("session create returned a non-object response")
        session_id = created.get("id") or created.get("session_id")
        if not isinstance(session_id, str) or not session_id:
            raise TrioctlError("session create response has no session id")
        snapshot = client.get_session(session_id)
        items = client.get_items(session_id)
        if isinstance(items, dict) and isinstance(items.get("items"), list):
            item_count = len(items["items"])
        elif isinstance(items, list):
            item_count = len(items)
        else:
            item_count = "received"
        status = _session_status(snapshot) or "unknown"
        return {
            "check": "omnigent:session-api",
            "ok": True,
            "detail": (
                f"{session_id}: status={status}, items={item_count}, "
                f"model={resolved['model']}"
            ),
        }
    except (TrioctlError, broker_http.BrokerHttpError) as exc:
        return {
            "check": "omnigent:session-api",
            "ok": False,
            "detail": str(exc),
        }


def command_doctor(args: argparse.Namespace) -> int:
    path = config_path(args.config)
    checks: list[dict[str, Any]] = []
    try:
        config = load_config(path)
    except TrioctlError as exc:
        config = None
        checks.append({"check": "config", "ok": False, "detail": str(exc)})
    else:
        checks.append({"check": "config", "ok": True, "detail": str(path)})

    providers = {
        spec.get("provider")
        for spec in (config or {}).get("roles", {}).values()
        if isinstance(spec, dict)
    }
    required_commands = {"omnigent"}
    required_commands.update(
        {"claude" if provider == "claude" else provider for provider in providers}
    )
    if "cursor" in required_commands:
        required_commands.remove("cursor")
        required_commands.add("cursor-agent")
    for command in sorted(required_commands):
        found = shutil.which(command)
        checks.append(
            {
                "check": f"command:{command}",
                "ok": found is not None,
                "detail": found or "not on PATH",
            }
        )
    try:
        detail = omnigent_contract()
        checks.append(
            {"check": "omnigent:session-contract", "ok": True, "detail": detail}
        )
    except TrioctlError as exc:
        checks.append(
            {
                "check": "omnigent:session-contract",
                "ok": False,
                "detail": str(exc),
            }
        )

    checks.append(check_cursor_approval_mode())

    prompt_repo = Path.cwd().resolve()
    try:
        prompt_dirs = {
            role: OmnigentRunner(repo=prompt_repo)._prompt_path(role).parent
            for role in ("lead", "evaluator")
        }
    except TrioctlError as exc:
        checks.append({"check": "prompts", "ok": False, "detail": str(exc)})
    else:
        resolved = sorted({str(directory) for directory in prompt_dirs.values()})
        checks.append(
            {"check": "prompts", "ok": True, "detail": ", ".join(resolved)}
        )

    catalogs: dict[str, list[dict[str, Any]]] = {}
    for provider, loader in (("codex", codex_models), ("cursor", cursor_models)):
        if provider not in providers:
            continue
        try:
            catalogs[provider] = loader(args.timeout)
            checks.append(
                {
                    "check": f"{provider}:model/list",
                    "ok": True,
                    "detail": f"{len(catalogs[provider])} available models",
                }
            )
        except TrioctlError as exc:
            checks.append(
                {"check": f"{provider}:model/list", "ok": False, "detail": str(exc)}
            )

    if config is not None:
        for role in ROLES:
            try:
                resolved = resolve_role(
                    role,
                    config,
                    models=catalogs.get(config["roles"][role].get("provider"), []),
                )
                effort = resolved.get("reasoning_effort") or resolved.get(
                    "model_effort"
                )
                detail = f"{resolved['model']} / {effort} ({resolved['source']})"
                if role == "docs" and config.get("_docs_role_fallback"):
                    detail += "; no [roles.docs] configured, using [roles.scout]"
                checks.append(
                    {
                        "check": f"role:{role}",
                        "ok": True,
                        "detail": detail,
                    }
                )
            except TrioctlError as exc:
                checks.append(
                    {"check": f"role:{role}", "ok": False, "detail": str(exc)}
                )

    registry = omnigent_registry_path()
    try:
        entries = json.loads(registry.read_text())
        if entries.get("_profile") != REGISTRY_PROFILE:
            raise TrioctlError(
                "registered role profile is stale; back up registry.json and "
                "re-register Lead/Evaluator from the current role configs"
            )
        # Only the two orchestration roles are durable Omnigent agents. Cursor
        # workers are ephemeral headless CLI runs, avoiding cursor-native's
        # one-chat-per-workspace transcript ownership collision.
        expected = {"trio-omnigent-lead", "trio-omnigent-evaluator"}
        missing = sorted(expected - set(entries))
        if missing:
            raise TrioctlError(f"missing: {', '.join(missing)}")
        obsolete = sorted(
            {"trio-omnigent-builder", "trio-omnigent-scout"} & set(entries)
        )
        if obsolete:
            raise TrioctlError(
                "obsolete persistent Cursor roles: "
                f"{', '.join(obsolete)}; remove them and restart Omnigent once"
            )
        checks.append({"check": "registry", "ok": True, "detail": str(registry)})
    except (OSError, json.JSONDecodeError, TypeError, TrioctlError) as exc:
        checks.append({"check": "registry", "ok": False, "detail": str(exc)})

    if getattr(args, "live_session", False):
        checks.append(
            check_live_session(
                config,
                catalogs,
                getattr(args, "base_url", broker_http.DEFAULT_BASE_URL),
            )
        )

    if args.json:
        print(
            json.dumps(
                {"ok": all(item["ok"] for item in checks), "checks": checks}, indent=2
            )
        )
    else:
        for item in checks:
            status = item.get("status") or ("PASS" if item["ok"] else "FAIL")
            print(f"{status} {item['check']}: {item['detail']}")
    return 0 if all(item["ok"] for item in checks) else 1


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(prog="trioctl")
    root.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    products = root.add_subparsers(dest="product", required=True)
    omni = products.add_parser("omnigent", help="manage the Omnigent Trio profile")
    commands = omni.add_subparsers(dest="command", required=True)

    configure = commands.add_parser(
        "configure", help="install the default user profile"
    )
    configure.add_argument("--config")
    configure.add_argument("--force", action="store_true")
    configure.set_defaults(func=command_configure)

    models = commands.add_parser(
        "models", help="query provider CLI live model catalogs"
    )
    models.add_argument(
        "--provider", choices=("all", "codex", "cursor"), default="cursor"
    )
    models.add_argument("--json", action="store_true")
    models.add_argument("--timeout", type=float, default=15.0)
    models.set_defaults(func=command_models)

    resolve = commands.add_parser("resolve", help="resolve one role's runtime model")
    resolve.add_argument("role", choices=ROLES)
    resolve.add_argument("--config")
    resolve.add_argument("--json", action="store_true")
    resolve.add_argument("--allow-fallback", action="store_true")
    resolve.set_defaults(func=command_resolve)

    run = commands.add_parser(
        "run", help="run one profile-resolved headless Cursor worker"
    )
    run.add_argument("role", choices=CURSOR_WORKER_ROLES)
    run.add_argument("--config")
    run.add_argument(
        "--prompt-file",
        default="-",
        help="task prompt file, or - to read stdin (default)",
    )
    run.add_argument("--workspace", default=".")
    run.add_argument("--timeout", type=float)
    run.set_defaults(func=command_run)

    loop = commands.add_parser(
        "loop",
        help="run loop-core with Omnigent Lead and Evaluator sessions",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "environment variables:\n"
            "  TRIO_OMNIGENT_IDLE_DWELL  seconds a session must stay idle\n"
            "                            before a live role wait returns\n"
            "                            (default 30). interval=0 skips it."
        ),
    )
    loop.add_argument("--mailbox", type=Path, default=Path("loop"))
    loop.add_argument("--max-iterations", type=int, default=10)
    loop.add_argument(
        "--wait-timeout",
        type=float,
        default=DEFAULT_LOOP_WAIT_TIMEOUT,
        help="maximum seconds to wait for each role turn",
    )
    loop.add_argument(
        "--base-url",
        default=broker_http.DEFAULT_BASE_URL,
    )
    loop.add_argument(
        "--runner-id",
        default=None,
        help=(
            "bind new sessions to this already-online runner; takes "
            "precedence over TRIO_OMNIGENT_RUNNER_ID. Default is a "
            "dedicated runner launched on --host-id / "
            "TRIO_OMNIGENT_HOST_ID (or the single online host)"
        ),
    )
    loop.add_argument(
        "--host-id",
        default=None,
        help=(
            "host that should launch a dedicated runner per role "
            "session; takes precedence over TRIO_OMNIGENT_HOST_ID"
        ),
    )
    loop.add_argument(
        "--keep-sessions",
        action="store_true",
        help=(
            "skip the default post-loop cleanup: by default, after the "
            "loop exits (any exit code), trioctl archives then deletes "
            "exactly the broker sessions this run created (Lead/Evaluator "
            "passes plus any tracked headless worker) -- never a session "
            "from an earlier run. Use `omnigent sessions prune --mailbox "
            "<dir>` for the manual/bulk form that matches by title prefix"
        ),
    )
    loop.add_argument(
        "--keep-unarchived",
        action="store_true",
        help=(
            "keep a session whose transcript could not be fully archived "
            "even after one retry, instead of deleting it with a partial "
            "archive; default deletes after retry (terminals only die on "
            "broker DELETE, never on process exit, so keeping leaks RAM)"
        ),
    )
    loop.set_defaults(func=command_loop)

    session = commands.add_parser(
        "session",
        help="create, wait for, or read one broker session",
    )
    session_commands = session.add_subparsers(
        dest="session_command",
        required=True,
    )

    session_create = session_commands.add_parser(
        "create",
        help="create one broker session",
    )
    session_create.add_argument("--agent-id", required=True)
    session_create.add_argument("--model", required=True)
    session_create.add_argument("--message", required=True)
    session_create.add_argument("--title")
    session_create.add_argument(
        "--runner-id",
        default=None,
