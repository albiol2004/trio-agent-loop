        return {"kind": "slice-eval"}
    return {}


# r14 S-1: Omnigent's cursor-native forwarder binds a new session to the
# first new chat under `~/.cursor/chats/<md5(cwd)>/` after its launch. Two
# sessions launched within ~10 s in the SAME cwd can bind each other's chat
# (diag 2026-09-27: lead 34ad got the slice-eval's chat and vice versa).
# trioctl therefore serialises session creation per workspace: a file lock
# keyed by the workspace realpath is held from just before create until the
# broker reports the session's `external_session_id` (the bound chat), or
# for at most TRIO_SAME_CWD_BIND_WAIT_S seconds. Different workspaces never
# wait on each other.
SAME_CWD_BIND_WAIT_ENV = "TRIO_SAME_CWD_BIND_WAIT_S"
DEFAULT_SAME_CWD_BIND_WAIT = 45.0
SAME_CWD_LOCK_DIR_ENV = "TRIO_SAME_CWD_LOCK_DIR"
SAME_CWD_BIND_POLL_ENV = "TRIO_SAME_CWD_BIND_POLL_S"


def _same_cwd_bind_wait() -> float:
    value = broker_http._env_float(SAME_CWD_BIND_WAIT_ENV, DEFAULT_SAME_CWD_BIND_WAIT)
    return value if value >= 0 else DEFAULT_SAME_CWD_BIND_WAIT


def _same_cwd_lock_dir() -> Path:
    """Per-user dir: the chat store is keyed by cwd alone, across repos/mailboxes."""
    env = os.environ.get(SAME_CWD_LOCK_DIR_ENV, "").strip()
    if env:
        return Path(env).expanduser()
    state = os.environ.get("XDG_STATE_HOME", "").strip()
    base = Path(state) if state else Path.home() / ".local" / "state"
    return base / "trio-agent-loop" / "cwd-locks"


def _session_chat_binding(client: Any, session_id: str) -> str | None:
    """The session's bound Cursor chat id, or None (unbound/unknown)."""
    method = getattr(client, "session_chat_binding", None)
    if callable(method):
        value = method(session_id)
        return value if isinstance(value, str) and value else None
    return None


def _same_lock_inode(fh: Any, path: Path) -> bool:
    """Whether the locked description *fh* is still the file at *path*."""
    try:
        held = os.fstat(fh.fileno())
        current = os.stat(path)
    except OSError:
        return False
    return (held.st_dev, held.st_ino) == (current.st_dev, current.st_ino)


def _prune_same_cwd_locks(directory: Path | None = None) -> list[Path]:
    """Loop start: unlink lock files whose workspace no longer exists (r14.1 F3).

    Each isolated slice-eval worktree has a unique path, so without this one
    lock file per dispatch accumulates. A file is removed only while THIS
    process holds its flock (non-blocking; a held lock is skipped) and its
    recorded workspace is gone. Unlinking under the lock is race-free
    because :meth:`_SameCwdGate.acquire` re-checks after every acquisition
    that its locked inode is still the one at the path and re-opens
    otherwise: a waiter that queued on the unlinked inode never treats that
    lock as exclusive, so it can never overlap a holder of a fresh file.
    Never raises; returns the removed paths.
    """
    import fcntl

    directory = directory or _same_cwd_lock_dir()
    removed: list[Path] = []
    try:
        candidates = sorted(directory.glob("*.lock"))
    except OSError:
        return removed
    for path in candidates:
        try:
            fh = open(path, "r+", encoding="utf-8")
        except OSError:
            continue
        try:
            try:
                fcntl.flock(fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
            except OSError:
                continue  # held (or unlockable): in use, keep it
            if not _same_lock_inode(fh, path):
                continue  # already replaced/removed by someone else
            fh.seek(0)
            parts = fh.readline().strip().split(" ", 1)
            workspace = parts[1] if len(parts) == 2 else ""
            if not workspace or os.path.lexists(workspace):
                continue  # unknown owner or live workspace: keep
            try:
                path.unlink()
            except OSError:
                continue
            removed.append(path)
        except (OSError, ValueError):
            continue
        finally:
            fh.close()
    return removed


class _SameCwdGate:
    """Per-workspace create serialisation (see SAME_CWD_BIND_WAIT_ENV).

    ``flock`` on a per-workspace file: exclusive across threads (each
    acquisition opens its own file description) and across processes.
    Released by whichever comes first: the bind watcher seeing the bound
    chat, the bounded wait, or a failed create. Never raises into the
    dispatch. A client without ``session_chat_binding`` is not gated.
    A lock acquired on an inode that is no longer at the path (unlinked by
    :func:`_prune_same_cwd_locks`) is dropped and the path re-opened.
    """

    def __init__(self, client: Any, workspace: str) -> None:
        self.client = client
        self.workspace = os.path.realpath(workspace)
        self.wait_s = _same_cwd_bind_wait()
        poll = broker_http._env_float(SAME_CWD_BIND_POLL_ENV, 0.5)
        self.poll = poll if poll > 0 else 0.5
        self.contended = False
        self.waited = 0.0
        self.session_id: str | None = None
        self._fh: Any = None
        self._release_lock = threading.Lock()
        self._watcher: threading.Thread | None = None
        self._stop = threading.Event()
        # Only clients that can report the binding get a bind wait.
        self.watchable = callable(getattr(client, "session_chat_binding", None))

    def _path(self) -> Path:
        key = hashlib.sha256(self.workspace.encode("utf-8")).hexdigest()[:24]
        return _same_cwd_lock_dir() / f"{key}.lock"

    def acquire(self) -> None:
        import fcntl

        if not self.watchable:
            # No way to see the bind (a test double or foreign client):
            # serialising the bare create would protect nothing.
            return
        try:
            path = self._path()
            path.parent.mkdir(parents=True, exist_ok=True)
            fh = open(path, "a+", encoding="utf-8")
        except OSError as exc:
            print(f"trioctl: same-cwd lock unavailable for {self.workspace}: {exc}; continuing",
                  file=sys.stderr)
            return
        start = time.monotonic()
        # A live holder releases within its create + bind wait; a hung one
        # must not stall the dispatch forever.
        cap = 2 * self.wait_s + 60.0
        while True:
            try:
                fcntl.flock(fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                if _same_lock_inode(fh, path):
                    break
                # The file was pruned while we queued on it: this lock
                # excludes nobody. Re-open the path (a fresh file) and retry.
                fh.close()
                try:
                    fh = open(path, "a+", encoding="utf-8")
                except OSError as exc:
                    print(f"trioctl: same-cwd lock unavailable for {self.workspace}: "
                          f"{exc}; continuing", file=sys.stderr)
                    return
                continue
            except BlockingIOError:
                self.contended = True
            except OSError as exc:
                print(f"trioctl: same-cwd lock failed for {self.workspace}: {exc}; continuing",
                      file=sys.stderr)
                fh.close()
                return
            if time.monotonic() - start >= cap:
                print(f"trioctl: same-cwd lock wait timed out ({self.workspace}); continuing",
                      file=sys.stderr)
                fh.close()
                self.waited = time.monotonic() - start
                return
            time.sleep(min(0.05, self.poll))
        self.waited = time.monotonic() - start
        self._fh = fh
        try:
            fh.seek(0)
            fh.truncate()
            fh.write(f"{os.getpid()} {self.workspace}\n")
            fh.flush()
        except OSError:
            pass

    def release(self) -> None:
        with self._release_lock:
            fh, self._fh = self._fh, None
        if fh is None:
            return
        try:
            fh.close()  # closing the description drops the flock
        except OSError:
            pass

    def _bind_wait(self, session_id: str) -> None:
        deadline = time.monotonic() + self.wait_s
        try:
            while True:
                try:
                    if _session_chat_binding(self.client, session_id):
                        return
                except Exception:  # noqa: BLE001 - a read blip keeps polling
                    pass
                now = time.monotonic()
                if now >= deadline or self._stop.is_set():
                    break
                self._stop.wait(min(self.poll, deadline - now))
            if not self._stop.is_set():
                print(
                    f"trioctl: same-cwd bind wait timed out for {session_id} "
                    f"({self.workspace}); continuing",
                    file=sys.stderr,
                )
        finally:
            self.release()

    def session_created(self, session_id: str) -> None:
        """Create callback: start the bind watcher as soon as the id exists."""
        self.session_id = session_id
        if not self.watchable or self._fh is None or self._watcher is not None:
            return
        self._watcher = threading.Thread(
            target=self._bind_wait, args=(session_id,), daemon=True,
            name=f"trioctl-bind-{session_id[:8]}",
        )
        self._watcher.start()

    def finish(self, session_id: str | None, failed: bool, keep: bool = False) -> None:
        """After create returned (or raised) in the dispatch thread.

        A dead start releases now. A kept session (uncertain delivery) or a
        live one keeps the watcher to its bind or deadline; a client without
        the create callback gets the same bind wait here, synchronously.
        """
        if failed and not keep:
            self._stop.set()
            self.release()
            return
        if self._watcher is not None:
            return
        if session_id and self.watchable and self._fh is not None and not failed:
            self._bind_wait(session_id)
            return
        self.release()


# --------------------------------------------------------------------------
# r15.x root-turn lock (r16 DESIGN §2). Every Trio actor that launches a
# cursor-agent whose project root is an aggregate root -- a loop's root-bound
# Lead/repair/evaluator turn, a degraded slice-eval, a non-isolated one-shot
# at a root with a live loop -- holds one per-user flock keyed by that root's
# realpath for its whole turn, so no two of them share the root's single
# project `.cursor/{mcp,hooks}.json` slot. The kernel drops the flock when
# its holder dies (no stale-lock recovery). Isolated builders/slice-evals
# (their own worktree, their own slot) never take it.
ROOT_TURN_WAIT_ENV = "TRIO_ROOT_TURN_WAIT_S"
