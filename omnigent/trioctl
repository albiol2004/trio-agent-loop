            "even after one retry, instead of deleting it with a partial "
            "archive; default deletes after retry (terminals only die on "
            "broker DELETE, never on process exit, so keeping leaks RAM)"
        ),
    )
    sessions_prune.add_argument(
        "--base-url",
        default=broker_http.DEFAULT_BASE_URL,
    )
    sessions_prune.set_defaults(func=command_sessions_prune)

    doctor = commands.add_parser(
        "doctor", help="validate commands, models, and registry"
    )
    doctor.add_argument("--config")
    doctor.add_argument("--json", action="store_true")
    doctor.add_argument("--timeout", type=float, default=15.0)
    doctor.add_argument("--live-session", action="store_true")
    doctor.add_argument(
        "--base-url",
        default=broker_http.DEFAULT_BASE_URL,
    )
    doctor.set_defaults(func=command_doctor)

    fix_approval_mode = commands.add_parser(
        "fix-approval-mode",
        help='set the Cursor CLI to approvalMode="unrestricted"',
    )
    fix_approval_mode.set_defaults(func=command_fix_approval_mode)
    return root


def main() -> int:
    args = parser().parse_args()
    try:
        return args.func(args)
    except TrioctlError as exc:
        print(f"trioctl: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
